#!/bin/sh

[ -e /lib/firmware/$FIRMWARE ] && exit 0

. /lib/functions/caldata.sh

board=$(board_name)

case "$FIRMWARE" in
"ath11k/IPQ6018/hw1.0/cal-ahb-c000000.wifi.bin")
	case "$board" in
	8devices,mango-dvk|\
	alfa-network,ap120c-ax)
		caldata_extract "0:ART" 0x1000 0x20000
		;;
	cambiumnetworks,xe3-4)
		caldata_extract "0:ART" 0x1000 0x10000
		;;
	anysafe,e1|\
	cmiot,ax18|\
	dptech,ap3000-2c|\
	glinet,gl-ax1800|\
	glinet,gl-axt1800|\
	linksys,mr7350|\
	linksys,mr7500|\
	netgear,rbr350|\
	netgear,rbs350|\
	netgear,wax214|\
	netgear,wax610y|\
	netgear,wax610|\
	philips,ly1800|\
	qihoo,360v6|\
	redmi,ax5|\
	sy,y6010|\
	xiaomi,ax1800|\
	zn,m2)
		caldata_extract "0:art" 0x1000 0x10000
		;;
	mikrotik,chateau-5g-r17-ax)
		# Calibration data lives in RouterBOOT's hard_config (tag 0x16,
		# LZ77 compressed); rb_hardconfig decompresses and exports it.
		#
		# Pass the blob through unmodified. The firmware validates the
		# board data itself and aborts on any change with
		#   phyrf_bdf.c:472 Assertion 0 failed
		#   qcom-q6v5-wcss-pil: fatal error received
		# even when the checksum at offset 0xa is corrected accordingly.
		caldata_sysfsload_from_file "/sys/firmware/mikrotik/hard_config/wlan_data/data_0" 0x0 0x10000
		;;
	tplink,eap610-outdoor|\
	tplink,eap620-hd-v2|\
	tplink,eap620-hd-v3|\
	tplink,eap623-outdoor-hd-v1|\
	tplink,eap625-outdoor-hd-v1)
		caldata_from_file "/tmp/factory_data/radio" 0 0x10000
		;;
	yuncore,fap650)
		caldata_extract "0:art" 0x1000 0x20000
		;;
	jdcloud,re-cs-02|\
	jdcloud,re-ss-01|\
	link,nn6000-v1|\
	link,nn6000-v2|\
	redmi,ax5-jdcloud)
		caldata_extract_mmc "0:ART" 0x1000 0x10000
		;;
	esac
	;;
"ath11k/IPQ6018/hw1.0/board.bin")
	case "$board" in
	mikrotik,chateau-5g-r17-ax)
		# Board data file: the same RouterBOOT hard_config blob (tag 0x16,
		# LZ77 compressed) as the cal data above, handed over unmodified as
		# the bare board.bin (ATH11K_DEFAULT_BOARD_FILE). ath11k requests
		# board-2.bin first and falls back to this once no container match
		# is found. The firmware validates the BDF and aborts on any change
		# (phyrf_bdf.c:472 Assertion 0 failed), so pass it through as-is.
		caldata_sysfsload_from_file "/sys/firmware/mikrotik/hard_config/wlan_data/data_0" 0x0 0x10000
		;;
	esac
	;;
"ath11k/QCN9074/hw1.0/cal-pci-0000:01:00.0.bin")
	case "$board" in
	anysafe,e1|\
	cambiumnetworks,xe3-4)
		caldata_extract "0:ART" 0x26800 0x20000
		;;
	linksys,mr7500)
		caldata_extract "0:art" 0x26800 0x20000
		;;
	jdcloud,re-cs-02)
		caldata_extract_mmc "0:ART" 0x26800 0x20000
		;;
	esac
	;;
*)
	exit 1
	;;
esac
