/dts-v1/;

#include "ipq8074-rbx750_850.dtsi"

/ {
	aliases {
		label-mac-device = &dp5;
	};
};

&switch {
	status = "okay";

	switch_lan_bmp = <(ESS_PORT2 | ESS_PORT4 | ESS_PORT5)>;
	switch_wan_bmp = <ESS_PORT1>;
	switch_mac_mode = <MAC_MODE_PSGMII>;

	qcom,port_phyinfo {
		port@1 {
			port_id = <1>;
			phy_address = <0>;
		};

		port@2 {
			port_id = <2>;
			phy_address = <1>;
		};

		port@4 {
			port_id = <4>;
			phy_address = <3>;
		};

		port@5 {
			port_id = <5>;
			phy_address = <4>;
		};
	};
};

&dp1 {
	status = "okay";
	phy-handle = <&phy0>;
	label = "wan";
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&macaddr_boarddata 1>;
};

&dp2 {
	status = "okay";
	phy-handle = <&phy1>;
	label = "lan3";
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&macaddr_boarddata 2>;
};

&dp4 {
	status = "okay";
	phy-handle = <&phy3>;
	label = "lan2";
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&macaddr_boarddata 1>;
};

&dp5 {
	status = "okay";
	phy-handle = <&phy4>;
	label = "lan1";
	nvmem-cell-names = "mac-address";
	nvmem-cells = <&macaddr_boarddata 0>;
};

&phys {
	phy4: ethernet-phy@4 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <4>;
	};
};

&wifi {
	status = "okay";
	qcom,ath11k-calibration-variant = "Netgear-RBK750";
};
