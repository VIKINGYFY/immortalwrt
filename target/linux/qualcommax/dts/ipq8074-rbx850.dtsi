/dts-v1/;

#include "ipq8074-rbx750_850.dtsi"

/ {
	aliases {
		label-mac-device = &dp1;
	};
};

&switch {
	status = "okay";

	switch_lan_bmp = <(ESS_PORT1 | ESS_PORT2 | ESS_PORT3 | ESS_PORT4)>;
	switch_wan_bmp = <0>;
	switch_mac_mode = <MAC_MODE_PSGMII>;

	qcom,port_phyinfo {
		port@1 {
			port_id = <1>;
			phy_address = <0>;
		};

		port@2 {
			port_id = <2>;
			phy_address = <1>;
		};

		port@3 {
			port_id = <3>;
			phy_address = <2>;
		};

		port@4 {
			port_id = <4>;
			phy_address = <3>;
		};
	};
};

&phys {
	phy2: ethernet-phy@2 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <2>;
	};
};

&wifi {
	qcom,ath11k-calibration-variant = "Netgear-RBK850";
};

&dp1 {
	status = "okay";
	phy-handle = <&phy0>;
	label = "lan1";
	nvmem-cells = <&macaddr_boarddata 0>;
	nvmem-cell-names = "mac-address";
};

&dp2 {
	status = "okay";
	phy-handle = <&phy1>;
	label = "lan2";
	nvmem-cells = <&macaddr_boarddata 1>;
	nvmem-cell-names = "mac-address";
};

&dp3 {
	status = "okay";
	phy-handle = <&phy2>;
	label = "lan3";
	nvmem-cells = <&macaddr_boarddata 2>;
	nvmem-cell-names = "mac-address";
};

&dp4 {
	status = "okay";
	phy-handle = <&phy3>;
	label = "lan4";
	nvmem-cells = <&macaddr_boarddata 3>;
	nvmem-cell-names = "mac-address";
};
