/dts-v1/;

#include "ipq8076-arista.dtsi"

/ {
	model = "Arista AP-C360";
	compatible = "arista,c360", "qcom,ipq8074";

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&tlmm 42 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_power_green: power-green {
			label = "green:power";
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			gpios = <&led_gpio 0 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		led_power_red: power-red {
			label = "red:power";
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_POWER;
			gpios = <&led_gpio 1 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_wlan2g_green: wlan2g-green {
			label = "green:wlan2g";
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WLAN_2GHZ;
			gpios = <&led_gpio 2 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_wlan5g_green: wlan5g-green {
			label = "green:wlan5g";
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WLAN_5GHZ;
			gpios = <&led_gpio 3 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_wlan6g_green: wlan6g-green {
			label = "green:wlan6g";
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WLAN_6GHZ;
			gpios = <&led_gpio 4 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_lan_green: lan-green {
			label = "green:lan";
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_LAN;
			gpios = <&led_gpio 5 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_lan_red: lan-red {
			label = "red:lan";
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_LAN;
			gpios = <&led_gpio 6 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_wan_green: wan-green {
			label = "green:wan";
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN;
			gpios = <&led_gpio 8 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_wan_red: wan-red {
			label = "red:wan";
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_WAN;
			gpios = <&led_gpio 9 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	reg_usb_0p9: regulator-usb-0p9 {
		compatible = "regulator-fixed";
		regulator-name = "usb_0p9";
		regulator-min-microvolt = <925000>;
		regulator-max-microvolt = <925000>;
		regulator-always-on;
	};

	reg_usb_1p8: regulator-usb-1p8 {
		compatible = "regulator-fixed";
		regulator-name = "usb_1p8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	reg_usb_3p3: regulator-usb-3p3 {
		compatible = "regulator-fixed";
		regulator-name = "usb_3p3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};
};

&{/chosen} {
	bootargs-append = " ubi.mtd=rootfs root=/dev/ubiblock0_0 rootfstype=squashfs rootwait";
};

&tlmm {
	mdio_extra_pins: mdio-extra-pins {
		phy-gpios {
			pins = "gpio25", "gpio44";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
		};

		phy-power {
			pins = "gpio29";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
			output-high;
		};
	};
};

&mdio {
	status = "okay";
	pinctrl-0 = <&mdio_pins>, <&mdio_extra_pins>;
	pinctrl-names = "default";

	phy0: ethernet-phy@0 {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <0>;
	};

	phy8: ethernet-phy@8 {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <8>;
	};
};

&switch {
	status = "okay";

	switch_lan_bmp = <ESS_PORT5>;
	switch_wan_bmp = <ESS_PORT6>;
	switch_mac_mode = <MAC_MODE_DISABLED>;
	switch_mac_mode1 = <MAC_MODE_USXGMII>;
	switch_mac_mode2 = <MAC_MODE_USXGMII>;

	qcom,port_phyinfo {
		port@5 {
			port_id = <5>;
			phy_address = <8>;
			compatible = "ethernet-phy-ieee802.3-c45";
			ethernet-phy-ieee802.3-c45;
		};

		port@6 {
			port_id = <6>;
			phy_address = <0>;
			compatible = "ethernet-phy-ieee802.3-c45";
			ethernet-phy-ieee802.3-c45;
		};
	};
};

&edma {
	status = "okay";
};

&dp5_syn {
	status = "okay";
	phy-mode = "usxgmii";
	phy-handle = <&phy8>;
	label = "lan";
	nvmem-cells = <&macaddr_lan>;
	nvmem-cell-names = "mac-address";
};

&dp6_syn {
	status = "okay";
	phy-mode = "usxgmii";
	phy-handle = <&phy0>;
	label = "wan";
	nvmem-cells = <&macaddr_wan>;
	nvmem-cell-names = "mac-address";
};

&qusb_phy_0 {
	status = "okay";
	vdd-supply = <&reg_usb_0p9>;
	vdda-pll-supply = <&reg_usb_1p8>;
	vdda-phy-dpdm-supply = <&reg_usb_3p3>;
};

&ssphy_0 {
	status = "okay";
	vdda-phy-supply = <&reg_usb_0p9>;
	vdda-pll-supply = <&reg_usb_1p8>;
};

&pcie0 {
	status = "okay";
	perst-gpio = <&tlmm 58 GPIO_ACTIVE_LOW>;

	pcie@0 {
		wifi@0,0 {
			status = "okay";
			compatible = "pci17cb,1104";
			qcom,ath11k-fw-memory-mode = <1>;
			qcom,ath11k-calibration-variant = "Arista-C360-9074";
			reg = <0x00010000 0 0 0 0>;
		};
	};
};

/* Keep the dedicated scan radio outside the client-serving ath11k topology. */
&pcie1 {
	status = "disabled";
};

&wifi {
	status = "okay";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,ath11k-calibration-variant = "Arista-C360";
};
