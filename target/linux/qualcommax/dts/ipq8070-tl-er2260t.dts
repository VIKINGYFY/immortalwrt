/dts-v1/;

#include "ipq8074.dtsi"
#include "ipq8074-ess.dtsi"
#include "ipq8074-nss.dtsi"
#include "ipq8074-common.dtsi"
#include "ipq8074-hk-cpu.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "TP-Link TL-ER2260T";
	compatible = "tplink,tl-er2260t", "qcom,ipq8074";

	aliases {
		label-mac-device = &swport1;
		serial0 = &blsp1_uart5;

		led-boot = &led_system_green;
		led-failsafe = &led_system_green;
		led-running = &led_system_green;
		led-upgrade = &led_system_green;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs-append = " root=/dev/ubiblock0_1 coherent_pool=2M swiotlb=noforce";
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&tlmm 50 GPIO_ACTIVE_LOW>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_system_green: system-green {
			label = "green:system";
			gpios = <&tlmm 21 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_GREEN>;
		};

		led_usb_green {
			label = "green:usb";
			gpios = <&tlmm 22 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_GREEN>;
		};

		led_sfp1_speed_green {
			label = "green:sfp1-10g";
			gpios = <&tlmm 52 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_GREEN>;
		};

		led_sfp1_speed_amber {
			label = "amber:sfp1-1g";
			gpios = <&tlmm 54 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_AMBER>;
		};

		led_sfp1_act_green {
			label = "green:sfp1-act";
			gpios = <&tlmm 51 GPIO_ACTIVE_LOW>;
			color = <LED_COLOR_ID_GREEN>;
		};

		led_sfp2_speed_green {
			label = "green:sfp2-10g";
			gpios = <&tlmm 56 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_GREEN>;
		};

		led_sfp2_speed_amber {
			label = "amber:sfp2-1g";
			gpios = <&tlmm 64 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_AMBER>;
		};

		led_sfp2_act_green {
			label = "green:sfp2-act";
			gpios = <&tlmm 55 GPIO_ACTIVE_LOW>;
			color = <LED_COLOR_ID_GREEN>;
		};
	};

	clocks {
		ref_50mhz_clk: ref-50mhz-clk {
			compatible = "fixed-clock";
			clock-frequency = <50000000>;
			#clock-cells = <0>;
		};
	};

	i2c-mux {
		compatible = "i2c-mux-gpio";
		i2c-parent = <&blsp1_i2c2>;
		#address-cells = <1>;
		#size-cells = <0>;
		mux-gpios = <&tlmm 29 GPIO_ACTIVE_HIGH>,
			    <&tlmm 30 GPIO_ACTIVE_HIGH>;
		idle-state = <0>;

		i2c_sfp1: i2c@2 {
			reg = <2>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		i2c_sfp2: i2c@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;
		};
	};

	sfp1: sfp-1 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c_sfp1>;
		maximum-power-milliwatt = <3000>;
		tx-disable-gpios = <&tlmm 60 GPIO_ACTIVE_HIGH>;
	};

	sfp2: sfp-2 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c_sfp2>;
		maximum-power-milliwatt = <3000>;
		tx-disable-gpios = <&tlmm 59 GPIO_ACTIVE_HIGH>;
	};
};

&cmn_pll {
	clocks = <&ref_50mhz_clk>,
		 <&gcc GCC_CMN_12GPLL_AHB_CLK>,
		 <&gcc GCC_CMN_12GPLL_SYS_CLK>;
};

&qpic_nand {
	status = "okay";

	/* Keep the legacy U-Boot fixup from replacing the SMEM parser node. */
	partitions {
		status = "disabled";
	};

	nand@0 {
		reg = <0>;

		nand-ecc-strength = <4>;
		nand-ecc-step-size = <512>;
		nand-bus-width = <8>;

		partitions {
			compatible = "qcom,smem-part";

			partition-0-art {
				label = "0:art";
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr: macaddr@10000d {
						compatible = "mac-base";
						reg = <0x10000d 0x6>;
						#nvmem-cell-cells = <1>;
					};
				};
			};
		};
	};
};

&mdio {
	status = "okay";
	pinctrl-0 = <&mdio_pins>;
	pinctrl-names = "default";
	reset-gpios = <&tlmm 37 GPIO_ACTIVE_LOW>;

	ethernet-phy-package@0 {
		compatible = "qcom,qca8075-package";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0>;

		qca8075_0: ethernet-phy@0 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <0>;
		};

		qca8075_1: ethernet-phy@1 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <1>;
		};

		qca8075_2: ethernet-phy@2 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <2>;
		};

		qca8075_3: ethernet-phy@3 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <3>;
		};
	};
};

&uniphy0 {
	status = "okay";
};

&uniphy1 {
	status = "okay";
};

&uniphy2 {
	status = "okay";
};

&switch {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			ethernet = <&edma>;
			phy-mode = "internal";

			fixed-link {
				speed = <1000>;
				full-duplex;
			};
		};

		swport1: port@1 {
			reg = <1>;
			label = "ge1";
			phy-handle = <&qca8075_0>;
			phy-mode = "psgmii";
			pcs-handle = <&uniphy0 0>;
			nvmem-cells = <&macaddr 0>;
			nvmem-cell-names = "mac-address";
		};

		swport2: port@2 {
			reg = <2>;
			label = "ge2";
			phy-handle = <&qca8075_1>;
			phy-mode = "psgmii";
			pcs-handle = <&uniphy0 1>;
			nvmem-cells = <&macaddr 0>;
			nvmem-cell-names = "mac-address";
		};

		swport3: port@3 {
			reg = <3>;
			label = "ge3";
			phy-handle = <&qca8075_2>;
			phy-mode = "psgmii";
			pcs-handle = <&uniphy0 2>;
			nvmem-cells = <&macaddr 0>;
			nvmem-cell-names = "mac-address";
		};

		swport4: port@4 {
			reg = <4>;
			label = "ge4";
			phy-handle = <&qca8075_3>;
			phy-mode = "psgmii";
			pcs-handle = <&uniphy0 3>;
			nvmem-cells = <&macaddr 0>;
			nvmem-cell-names = "mac-address";
		};

		swport5: port@5 {
			reg = <5>;
			label = "10ge2";
			sfp = <&sfp2>;
			phy-mode = "10gbase-r";
			managed = "in-band-status";
			pcs-handle = <&uniphy1 0>;
			nvmem-cells = <&macaddr 2>;
			nvmem-cell-names = "mac-address";
		};

		swport6: port@6 {
			reg = <6>;
			label = "10ge1";
			sfp = <&sfp1>;
			phy-mode = "10gbase-r";
			managed = "in-band-status";
			pcs-handle = <&uniphy2 0>;
			nvmem-cells = <&macaddr 1>;
			nvmem-cell-names = "mac-address";
		};
	};
};

&blsp1_i2c2 {
	status = "okay";
};

&edma {
	status = "okay";
};

&tlmm {
	/* Disable the hardware fast-blink override of the SYS LED. */
	sys-led-mode-hog {
		gpio-hog;
		gpios = <65 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "sys-led-mode";
	};
};
