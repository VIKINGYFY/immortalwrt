From: ViKing <viking.yfy@qq.com>
Date: Wed, 28 Oct 2026 13:34:14 +0800
Subject: [PATCH] net: dsa: support QCA ethertype tags and switch integration

The QCA8K header sits in place of the ethertype, so a conduit that finds
the IP header by parsing past the Ethernet header and VLAN tags cannot
offload the checksum or TSO of a tagged frame. The IPQ807x EDMA is such a
conduit for the QCA8337 behind PPE port 1 on the Asus RT-AX89X.

Add change_tag_protocol so a CPU port can select "qca-etype", and set the
header type in HEADER_CTRL to match. Register access and MIB autocast
frames carry the type as well: build them with it, and let the tagger drop
it on receive so the handlers keep their layout.

Merged from:
  0955-02-net-dsa-tag_qca-add-a-variant-behind-an-ethertype.patch
  0956-net-dsa-qca8k-support-the-qca-etype-tagging-protocol.patch

Based on work by:
  Julius Bairaktaris <julius@bairaktaris.de>

Original-commit: 0000000000000000000000000000000000000000

Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/drivers/net/dsa/qca/qca8k-8xxx.c
+++ b/drivers/net/dsa/qca/qca8k-8xxx.c
@@ -216,7 +216,8 @@ static void qca8k_rw_reg_ack_handler(str
 }
 
 static struct sk_buff *qca8k_alloc_mdio_header(enum mdio_cmd cmd, u32 reg, u32 *val,
-					       int priority, unsigned int len)
+					       int priority, unsigned int len,
+					       bool etype)
 {
 	struct qca_mgmt_ethhdr *mgmt_ethhdr;
 	unsigned int real_len;
@@ -261,7 +262,8 @@ static struct sk_buff *qca8k_alloc_mdio_
 	skb_reset_mac_header(skb);
 	skb_set_network_header(skb, skb->len);
 
-	mgmt_ethhdr = skb_push(skb, QCA_HDR_MGMT_HEADER_LEN + QCA_HDR_LEN);
+	mgmt_ethhdr = skb_push(skb, QCA_HDR_MGMT_HEADER_LEN + QCA_HDR_LEN +
+			       (etype ? QCA_ETYPE_HDR_LEN - QCA_HDR_LEN : 0));
 
 	hdr = FIELD_PREP(QCA_HDR_XMIT_VERSION, QCA_HDR_VERSION);
 	hdr |= FIELD_PREP(QCA_HDR_XMIT_PRIORITY, priority);
@@ -280,7 +282,12 @@ static struct sk_buff *qca8k_alloc_mdio_
 	if (cmd == MDIO_WRITE)
 		put_unaligned_le32(*val, &mgmt_ethhdr->mdio_data);
 
-	mgmt_ethhdr->hdr = htons(hdr);
+	if (etype) {
+		mgmt_ethhdr->hdr = htons(QCA_HDR_ETYPE);
+		put_unaligned_be16(hdr, mgmt_ethhdr + 1);
+	} else {
+		mgmt_ethhdr->hdr = htons(hdr);
+	}
 
 	data2 = skb_put_zero(skb, QCA_HDR_MGMT_DATA2_LEN + QCA_HDR_MGMT_PADDING_LEN);
 	if (cmd == MDIO_WRITE && len > QCA_HDR_MGMT_DATA1_LEN) {
@@ -317,7 +324,8 @@ static int qca8k_read_eth(struct qca8k_p
 	int ret;
 
 	skb = qca8k_alloc_mdio_header(MDIO_READ, reg, NULL,
-				      QCA8K_ETHERNET_MDIO_PRIORITY, len);
+				      QCA8K_ETHERNET_MDIO_PRIORITY, len,
+				      priv->etype_hdr);
 	if (!skb)
 		return -ENOMEM;
 
@@ -369,7 +377,8 @@ static int qca8k_write_eth(struct qca8k_
 	int ret;
 
 	skb = qca8k_alloc_mdio_header(MDIO_WRITE, reg, val,
-				      QCA8K_ETHERNET_MDIO_PRIORITY, len);
+				      QCA8K_ETHERNET_MDIO_PRIORITY, len,
+				      priv->etype_hdr);
 	if (!skb)
 		return -ENOMEM;
 
@@ -648,19 +657,22 @@ qca8k_phy_eth_command(struct qca8k_priv
 
 	/* Prealloc all the needed skb before the lock */
 	write_skb = qca8k_alloc_mdio_header(MDIO_WRITE, QCA8K_MDIO_MASTER_CTRL, &write_val,
-					    QCA8K_ETHERNET_PHY_PRIORITY, sizeof(write_val));
+					    QCA8K_ETHERNET_PHY_PRIORITY, sizeof(write_val),
+					    priv->etype_hdr);
 	if (!write_skb)
 		return -ENOMEM;
 
 	clear_skb = qca8k_alloc_mdio_header(MDIO_WRITE, QCA8K_MDIO_MASTER_CTRL, &clear_val,
-					    QCA8K_ETHERNET_PHY_PRIORITY, sizeof(clear_val));
+					    QCA8K_ETHERNET_PHY_PRIORITY, sizeof(clear_val),
+					    priv->etype_hdr);
 	if (!clear_skb) {
 		ret = -ENOMEM;
 		goto err_clear_skb;
 	}
 
 	read_skb = qca8k_alloc_mdio_header(MDIO_READ, QCA8K_MDIO_MASTER_CTRL, &clear_val,
-					   QCA8K_ETHERNET_PHY_PRIORITY, sizeof(clear_val));
+					   QCA8K_ETHERNET_PHY_PRIORITY, sizeof(clear_val),
+					   priv->etype_hdr);
 	if (!read_skb) {
 		ret = -ENOMEM;
 		goto err_read_skb;
@@ -1743,6 +1755,35 @@ qca8k_get_tag_protocol(struct dsa_switch
 	return DSA_TAG_PROTO_QCA;
 }
 
+static int qca8k_change_tag_protocol(struct dsa_switch *ds,
+				     enum dsa_tag_protocol proto)
+{
+	struct qca8k_priv *priv = ds->priv;
+	u32 val;
+	int ret;
+
+	switch (proto) {
+	case DSA_TAG_PROTO_QCA:
+		val = 0;
+		break;
+	case DSA_TAG_PROTO_QCA_ETYPE:
+		val = QCA8K_HEADER_CTRL_TYPE_LEN |
+		      FIELD_PREP(QCA8K_HEADER_CTRL_TYPE_VAL, QCA_HDR_ETYPE);
+		break;
+	default:
+		return -EPROTONOSUPPORT;
+	}
+
+	/* Written in the format the switch still expects */
+	ret = qca8k_write(priv, QCA8K_REG_HEADER_CTRL, val);
+	if (ret)
+		return ret;
+
+	priv->etype_hdr = proto == DSA_TAG_PROTO_QCA_ETYPE;
+
+	return 0;
+}
+
 static struct dsa_port *
 qca8k_preferred_default_local_cpu_port(struct dsa_switch *ds)
 {
@@ -1893,6 +1934,7 @@ static int qca8k_connect_tag_protocol(st
 
 	switch (proto) {
 	case DSA_TAG_PROTO_QCA:
+	case DSA_TAG_PROTO_QCA_ETYPE:
 		tagger_data = ds->tagger_data;
 
 		tagger_data->rw_reg_ack_handler = qca8k_rw_reg_ack_handler;
@@ -2122,6 +2164,7 @@ static const struct phylink_mac_ops qca8
 
 static const struct dsa_switch_ops qca8k_switch_ops = {
 	.get_tag_protocol	= qca8k_get_tag_protocol,
+	.change_tag_protocol	= qca8k_change_tag_protocol,
 	.setup			= qca8k_setup,
 	.get_strings		= qca8k_get_strings,
 	.get_ethtool_stats	= qca8k_get_ethtool_stats,
--- a/drivers/net/dsa/qca/qca8k.h
+++ b/drivers/net/dsa/qca/qca8k.h
@@ -149,6 +149,9 @@
 #define   QCA8K_PORT_STATUS_LINK_AUTO			BIT(9)
 #define   QCA8K_PORT_STATUS_LINK_PAUSE			BIT(10)
 #define   QCA8K_PORT_STATUS_FLOW_AUTO			BIT(12)
+#define QCA8K_REG_HEADER_CTRL				0x98
+#define   QCA8K_HEADER_CTRL_TYPE_LEN			BIT(16)
+#define   QCA8K_HEADER_CTRL_TYPE_VAL			GENMASK(15, 0)
 #define QCA8K_REG_PORT_HDR_CTRL(_i)			(0x9c + (_i * 4))
 #define   QCA8K_PORT_HDR_CTRL_RX_MASK			GENMASK(3, 2)
 #define   QCA8K_PORT_HDR_CTRL_TX_MASK			GENMASK(1, 0)
@@ -462,6 +465,7 @@ struct qca8k_priv {
 	struct device *dev;
 	struct gpio_desc *reset_gpio;
 	struct net_device *mgmt_conduit; /* Track if mdio/mib Ethernet is available */
+	bool etype_hdr; /* The header is behind QCA_HDR_ETYPE */
 	struct qca8k_mgmt_eth_data mgmt_eth_data;
 	struct qca8k_mib_eth_data mib_eth_data;
 	struct qca8k_mdio_cache mdio_cache;
--- a/include/linux/dsa/tag_qca.h
+++ b/include/linux/dsa/tag_qca.h
@@ -9,6 +9,12 @@ struct dsa_switch;
 struct sk_buff;
 
 #define QCA_HDR_LEN	2
+/* The header behind an ethertype, as the switch sends and takes it with
+ * QCA8K_HEADER_CTRL_TYPE_LEN set. A VLAN ethertype lets an Ethernet
+ * controller that parses past VLAN tags find the IP header behind it.
+ */
+#define QCA_HDR_ETYPE		ETH_P_8021AD
+#define QCA_ETYPE_HDR_LEN	4
 #define QCA_HDR_VERSION	0x2
 
 #define QCA_HDR_RECV_VERSION		GENMASK(15, 14)
--- a/include/net/dsa.h
+++ b/include/net/dsa.h
@@ -59,6 +59,7 @@ struct tc_action;
 #define DSA_TAG_PROTO_MXL862_8021Q_VALUE	31
 #define DSA_TAG_PROTO_RTL837X_8021AD_VALUE	34
 #define DSA_TAG_PROTO_RTL9303_8021AD_VALUE	35
+#define DSA_TAG_PROTO_QCA_ETYPE_VALUE		36
 
 enum dsa_tag_protocol {
 	DSA_TAG_PROTO_NONE		= DSA_TAG_PROTO_NONE_VALUE,
@@ -95,6 +96,7 @@ enum dsa_tag_protocol {
 	DSA_TAG_PROTO_MXL862_8021Q	= DSA_TAG_PROTO_MXL862_8021Q_VALUE,
 	DSA_TAG_PROTO_RTL837X_8021AD	= DSA_TAG_PROTO_RTL837X_8021AD_VALUE,
 	DSA_TAG_PROTO_RTL9303_8021AD	= DSA_TAG_PROTO_RTL9303_8021AD_VALUE,
+	DSA_TAG_PROTO_QCA_ETYPE		= DSA_TAG_PROTO_QCA_ETYPE_VALUE,
 };
 
 struct dsa_switch;
--- a/net/dsa/tag_qca.c
+++ b/net/dsa/tag_qca.c
@@ -11,17 +11,21 @@
 #include "tag.h"
 
 #define QCA_NAME "qca"
+#define QCA_ETYPE_NAME "qca-etype"
 
-static struct sk_buff *qca_tag_xmit(struct sk_buff *skb, struct net_device *dev)
+static struct sk_buff *__qca_tag_xmit(struct sk_buff *skb,
+				      struct net_device *dev, unsigned int len)
 {
 	struct dsa_port *dp = dsa_user_to_port(dev);
 	__be16 *phdr;
 	u16 hdr;
 
-	skb_push(skb, QCA_HDR_LEN);
+	skb_push(skb, len);
 
-	dsa_alloc_etype_header(skb, QCA_HDR_LEN);
+	dsa_alloc_etype_header(skb, len);
 	phdr = dsa_etype_header_pos_tx(skb);
+	if (len == QCA_ETYPE_HDR_LEN)
+		*phdr++ = htons(QCA_HDR_ETYPE);
 
 	/* Set the version field, and set destination port information */
 	hdr = FIELD_PREP(QCA_HDR_XMIT_VERSION, QCA_HDR_VERSION);
@@ -33,7 +37,19 @@ static struct sk_buff *qca_tag_xmit(stru
 	return skb;
 }
 
-static struct sk_buff *qca_tag_rcv(struct sk_buff *skb, struct net_device *dev)
+static struct sk_buff *qca_tag_xmit(struct sk_buff *skb, struct net_device *dev)
+{
+	return __qca_tag_xmit(skb, dev, QCA_HDR_LEN);
+}
+
+static struct sk_buff *qca_etype_tag_xmit(struct sk_buff *skb,
+					  struct net_device *dev)
+{
+	return __qca_tag_xmit(skb, dev, QCA_ETYPE_HDR_LEN);
+}
+
+static struct sk_buff *__qca_tag_rcv(struct sk_buff *skb,
+				     struct net_device *dev, unsigned int len)
 {
 	struct qca_tagger_data *tagger_data;
 	struct dsa_port *dp = dev->dsa_ptr;
@@ -47,10 +63,15 @@ static struct sk_buff *qca_tag_rcv(struc
 
 	tagger_data = ds->tagger_data;
 
-	if (unlikely(!pskb_may_pull(skb, QCA_HDR_LEN)))
+	if (unlikely(!pskb_may_pull(skb, len)))
 		return NULL;
 
 	phdr = dsa_etype_header_pos_rx(skb);
+	if (len == QCA_ETYPE_HDR_LEN) {
+		if (ntohs(*phdr) != QCA_HDR_ETYPE)
+			return NULL;
+		phdr++;
+	}
 	hdr = ntohs(*phdr);
 
 	/* Make sure the version is correct */
@@ -61,6 +82,17 @@ static struct sk_buff *qca_tag_rcv(struc
 	/* Get pk type */
 	pk_type = FIELD_GET(QCA_HDR_RECV_TYPE, hdr);
 
+	/* Register and MIB frames carry the type as well. Drop it, so that
+	 * their handlers see the layout of the plain header.
+	 */
+	if (len == QCA_ETYPE_HDR_LEN &&
+	    (pk_type == QCA_HDR_RECV_TYPE_RW_REG_ACK ||
+	     pk_type == QCA_HDR_RECV_TYPE_MIB)) {
+		skb_pull(skb, QCA_ETYPE_HDR_LEN - QCA_HDR_LEN);
+		dsa_strip_etype_header(skb, QCA_ETYPE_HDR_LEN - QCA_HDR_LEN);
+		skb_set_mac_header(skb, -ETH_HLEN);
+	}
+
 	/* Ethernet mgmt read/write packet */
 	if (pk_type == QCA_HDR_RECV_TYPE_RW_REG_ACK) {
 		if (likely(tagger_data->rw_reg_ack_handler))
@@ -83,12 +115,23 @@ static struct sk_buff *qca_tag_rcv(struc
 		return NULL;
 
 	/* Remove QCA tag and recalculate checksum */
-	skb_pull_rcsum(skb, QCA_HDR_LEN);
-	dsa_strip_etype_header(skb, QCA_HDR_LEN);
+	skb_pull_rcsum(skb, len);
+	dsa_strip_etype_header(skb, len);
 
 	return skb;
 }
 
+static struct sk_buff *qca_tag_rcv(struct sk_buff *skb, struct net_device *dev)
+{
+	return __qca_tag_rcv(skb, dev, QCA_HDR_LEN);
+}
+
+static struct sk_buff *qca_etype_tag_rcv(struct sk_buff *skb,
+					 struct net_device *dev)
+{
+	return __qca_tag_rcv(skb, dev, QCA_ETYPE_HDR_LEN);
+}
+
 static int qca_tag_connect(struct dsa_switch *ds)
 {
 	struct qca_tagger_data *tagger_data;
@@ -119,8 +162,29 @@ static const struct dsa_device_ops qca_n
 	.promisc_on_conduit = true,
 };
 
+DSA_TAG_DRIVER(qca_netdev_ops);
+
+static const struct dsa_device_ops qca_etype_netdev_ops = {
+	.name	= QCA_ETYPE_NAME,
+	.proto	= DSA_TAG_PROTO_QCA_ETYPE,
+	.connect = qca_tag_connect,
+	.disconnect = qca_tag_disconnect,
+	.xmit	= qca_etype_tag_xmit,
+	.rcv	= qca_etype_tag_rcv,
+	.needed_headroom = QCA_ETYPE_HDR_LEN,
+	.promisc_on_conduit = true,
+};
+
+DSA_TAG_DRIVER(qca_etype_netdev_ops);
+
+static struct dsa_tag_driver *dsa_tag_driver_array[] = {
+	&DSA_TAG_DRIVER_NAME(qca_netdev_ops),
+	&DSA_TAG_DRIVER_NAME(qca_etype_netdev_ops),
+};
+
 MODULE_DESCRIPTION("DSA tag driver for Qualcomm Atheros QCA8K switches");
 MODULE_LICENSE("GPL");
 MODULE_ALIAS_DSA_TAG_DRIVER(DSA_TAG_PROTO_QCA, QCA_NAME);
+MODULE_ALIAS_DSA_TAG_DRIVER(DSA_TAG_PROTO_QCA_ETYPE, QCA_ETYPE_NAME);
 
-module_dsa_tag_driver(qca_netdev_ops);
+module_dsa_tag_drivers(dsa_tag_driver_array);
