From: Stanislaw Pal <kuncy7@gmail.com>
Date: Wed, 11 Nov 2026 16:11:45 +0800
Subject: [PATCH] net: dsa: retain VLAN upper filtering across bridge transitions

Provide the generic opt-in contract for VLAN taggers to preserve upper membership and rollback CPU VLAN failures. Keep the QCA tagger consumer separate.

Split from:
  0963-net-dsa-qca-vlan-upper-transport.patch - net: dsa: retain VLAN upper filtering and QCA 8021Q transport

Previous merged from (0963-net-dsa-qca-vlan-upper-transport.patch):
  0963-net-dsa-retain-VLAN-upper-filtering-for-VLAN-taggers.patch
  0964-net-dsa-qca8k-carry-802.1Q-uppers-of-qca-8021q-ports.patch

Signed-off-by: Adriel Santos <adriel@adriel.eu>
Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
Signed-off-by: Stanislaw Pal <kuncy7@gmail.com>
Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/include/net/dsa.h
+++ b/include/net/dsa.h
@@ -417,6 +417,9 @@ struct dsa_switch {
 	/* Keep VLAN filtering enabled on ports not offloading any upper */
 	u32			needs_standalone_vlan_filtering:1;
 
+	/* Keep VLAN-upper RX filtering across bridge VLAN-awareness changes. */
+	u32			vlan_upper_filtering_always:1;
+
 	/* Pass .port_vlan_add and .port_vlan_del to drivers even for bridges
 	 * that have vlan_filtering=0. All drivers should ideally set this (and
 	 * then the option would get removed), but it is unknown whether this
--- a/net/dsa/user.c
+++ b/net/dsa/user.c
@@ -618,7 +618,15 @@ static int dsa_user_port_attr_set(struct
 		if (!dsa_port_offloads_bridge_dev(dp, attr->orig_dev))
 			return -EOPNOTSUPP;
 
-		ret = dsa_port_vlan_protocol(dp, attr->u.vlan_protocol, extack);
+		if (dp->ds->vlan_upper_filtering_always) {
+			if (attr->u.vlan_protocol != ETH_P_8021Q) {
+				NL_SET_ERR_MSG_MOD(extack, "VLAN tagger requires an 802.1Q bridge");
+				return -EINVAL;
+			}
+			ret = 0;
+		} else {
+			ret = dsa_port_vlan_protocol(dp, attr->u.vlan_protocol, extack);
+		}
 		break;
 	case SWITCHDEV_ATTR_ID_BRIDGE_MC_DISABLED:
 		if ((!dsa_port_offloads_bridge_dev(dp, attr->orig_dev) &&
@@ -1865,6 +1873,9 @@ static int dsa_user_vlan_rx_add_vid(stru
 		if (extack._msg)
 			netdev_err(dev, "CPU port %d: %s\n", dp->cpu_dp->index,
 				   extack._msg);
+		/* Only such a driver keeps uppers apart from bridge VLANs */
+		if (ds->vlan_upper_filtering_always)
+			dsa_port_vlan_del(dp, &vlan);
 		return ret;
 	}
 
@@ -2016,8 +2027,16 @@ static int dsa_user_clear_vlan(struct ne
 int dsa_user_manage_vlan_filtering(struct net_device *user,
 				   bool vlan_filtering)
 {
+	struct dsa_switch *ds = dsa_user_to_port(user)->ds;
 	int err;
 
+	if (ds->vlan_upper_filtering_always) {
+		/* Already installed uppers must not be replayed/refcounted twice. */
+		if (user->features & NETIF_F_HW_VLAN_CTAG_FILTER)
+			return 0;
+		vlan_filtering = true;
+	}
+
 	if (vlan_filtering) {
 		user->features |= NETIF_F_HW_VLAN_CTAG_FILTER;
 
@@ -2884,7 +2903,8 @@ void dsa_user_setup_tagger(struct net_de
 	    cpu_dp->tag_ops->needed_tailroom)
 		user->features &= ~(NETIF_F_HW_VLAN_CTAG_TX |
 				    NETIF_F_HW_VLAN_STAG_TX);
-	if (ds->needs_standalone_vlan_filtering)
+	if (ds->needs_standalone_vlan_filtering ||
+	    ds->vlan_upper_filtering_always)
 		user->features |= NETIF_F_HW_VLAN_CTAG_FILTER;
 
 	user->lltx = true;
