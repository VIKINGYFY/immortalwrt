+/* switchdev hands a VLAN on a user port to that port alone, so the other
+ * trees in its bridge, to which the port is foreign, never see it.
+ */
+static int
+dsa_user_foreign_tree_vlan(struct net_device *dev,
+			   struct switchdev_notifier_port_obj_info *info,
+			   bool add)
+{
+	struct net_device *br, *lower;
+	struct netlink_ext_ack *extack;
+	struct list_head *iter;
+	int err;
+
+	if (info->obj->id != SWITCHDEV_OBJ_ID_PORT_VLAN ||
+	    !dsa_user_dev_check(dev))
+		return 0;
+
+	br = netdev_master_upper_dev_get(dev);
+	if (!br || !netif_is_bridge_master(br))
+		return 0;
+
+	extack = switchdev_notifier_info_to_extack(&info->info);
+
+	netdev_for_each_lower_dev(br, lower, iter) {
+		if (!dsa_user_dev_check(lower) ||
+		    !dsa_foreign_dev_check(lower, dev))
+			continue;
+
+		if (add)
+			err = dsa_user_port_obj_add(lower, info->info.ctx,
+						    info->obj, extack);
+		else
+			err = dsa_user_port_obj_del(lower, info->info.ctx,
+						    info->obj);
+		if (err && err != -EOPNOTSUPP)
+			return err;
+	}
+
+	return 0;
+}
