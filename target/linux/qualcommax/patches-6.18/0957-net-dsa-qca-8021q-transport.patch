--- a/drivers/net/dsa/qca/qca8k-8xxx.c
+++ b/drivers/net/dsa/qca/qca8k-8xxx.c
@@ -19,6 +19,7 @@
 #include <linux/phylink.h>
 #include <linux/gpio/consumer.h>
 #include <linux/etherdevice.h>
+#include <linux/dsa/8021q.h>
 #include <linux/dsa/tag_qca.h>
 
 #include "qca8k.h"
@@ -1755,9 +1756,68 @@ qca8k_get_tag_protocol(struct dsa_switch
 	return DSA_TAG_PROTO_QCA;
 }
 
+/* With qca-8021q the switch tells the ports apart by VLAN, so it filters by
+ * VLAN on every port, and only register and MIB frames carry the header.
+ */
+static int qca8k_tag_8021q_set(struct dsa_switch *ds, bool enable)
+{
+	struct qca8k_priv *priv = ds->priv;
+	u32 fw = GENMASK(QCA8K_NUM_PORTS - 1, 0);
+	u32 mode = QCA8K_PORT_HDR_CTRL_MGMT;
+	struct dsa_port *dp;
+	int ret;
+
+	if (!enable) {
+		dsa_tag_8021q_unregister(ds);
+		mode = QCA8K_PORT_HDR_CTRL_ALL;
+		fw = dsa_cpu_ports(ds);
+	}
+
+	/* The bridge leaves flooding to the switch, and the port and VLAN
+	 * members keep it inside the bridge.
+	 */
+	ret = qca8k_rmw(priv, QCA8K_REG_GLOBAL_FW_CTRL1,
+			QCA8K_GLOBAL_FW_CTRL1_BC_DP_MASK |
+			QCA8K_GLOBAL_FW_CTRL1_MC_DP_MASK |
+			QCA8K_GLOBAL_FW_CTRL1_UC_DP_MASK,
+			FIELD_PREP(QCA8K_GLOBAL_FW_CTRL1_BC_DP_MASK, fw) |
+			FIELD_PREP(QCA8K_GLOBAL_FW_CTRL1_MC_DP_MASK, fw) |
+			FIELD_PREP(QCA8K_GLOBAL_FW_CTRL1_UC_DP_MASK, fw));
+	if (ret)
+		return ret;
+
+	dsa_switch_for_each_cpu_port(dp, ds) {
+		ret = qca8k_write(priv, QCA8K_REG_PORT_HDR_CTRL(dp->index),
+				  FIELD_PREP(QCA8K_PORT_HDR_CTRL_TX_MASK, mode) |
+				  FIELD_PREP(QCA8K_PORT_HDR_CTRL_RX_MASK, mode));
+		if (ret)
+			return ret;
+	}
+
+	dsa_switch_for_each_available_port(dp, ds) {
+		ret = qca8k_rmw(priv, QCA8K_PORT_LOOKUP_CTRL(dp->index),
+				QCA8K_PORT_LOOKUP_VLAN_MODE_MASK,
+				enable ? QCA8K_PORT_LOOKUP_VLAN_MODE_SECURE :
+					 QCA8K_PORT_LOOKUP_VLAN_MODE_NONE);
+		if (ret)
+			return ret;
+
+		/* The VLAN table decides what leaves a port tagged */
+		ret = qca8k_rmw(priv, QCA8K_REG_PORT_VLAN_CTRL1(dp->index),
+				QCA8K_PORT_VLAN_CTRL1_EG_MODE_MASK,
+				FIELD_PREP(QCA8K_PORT_VLAN_CTRL1_EG_MODE_MASK,
+					   QCA8K_PORT_VLAN_CTRL1_EG_UNTOUCH));
+		if (ret)
+			return ret;
+	}
+
+	return enable ? dsa_tag_8021q_register(ds, htons(ETH_P_8021Q)) : 0;
+}
+
 static int qca8k_change_tag_protocol(struct dsa_switch *ds,
 				     enum dsa_tag_protocol proto)
 {
+	bool tag_8021q = proto == DSA_TAG_PROTO_QCA_8021Q;
 	struct qca8k_priv *priv = ds->priv;
 	u32 val;
 	int ret;
@@ -1767,6 +1827,7 @@ static int qca8k_change_tag_protocol(str
 		val = 0;
 		break;
 	case DSA_TAG_PROTO_QCA_ETYPE:
+	case DSA_TAG_PROTO_QCA_8021Q:
 		val = QCA8K_HEADER_CTRL_TYPE_LEN |
 		      FIELD_PREP(QCA8K_HEADER_CTRL_TYPE_VAL, QCA_HDR_ETYPE);
 		break;
@@ -1774,12 +1835,18 @@ static int qca8k_change_tag_protocol(str
 		return -EPROTONOSUPPORT;
 	}
 
+	if (tag_8021q != !!ds->tag_8021q_ctx) {
+		ret = qca8k_tag_8021q_set(ds, tag_8021q);
+		if (ret)
+			return ret;
+	}
+
 	/* Written in the format the switch still expects */
 	ret = qca8k_write(priv, QCA8K_REG_HEADER_CTRL, val);
 	if (ret)
 		return ret;
 
-	priv->etype_hdr = proto == DSA_TAG_PROTO_QCA_ETYPE;
+	priv->etype_hdr = proto != DSA_TAG_PROTO_QCA;
 
 	return 0;
 }
@@ -1935,6 +2002,7 @@ static int qca8k_connect_tag_protocol(st
 	switch (proto) {
 	case DSA_TAG_PROTO_QCA:
 	case DSA_TAG_PROTO_QCA_ETYPE:
+	case DSA_TAG_PROTO_QCA_8021Q:
 		tagger_data = ds->tagger_data;
 
 		tagger_data->rw_reg_ack_handler = qca8k_rw_reg_ack_handler;
@@ -2112,6 +2180,7 @@ qca8k_setup(struct dsa_switch *ds)
