 #define QCA_NAME "qca"
 #define QCA_ETYPE_NAME "qca-etype"
+#define QCA_8021Q_NAME "qca-8021q"
 
 static struct sk_buff *__qca_tag_xmit(struct sk_buff *skb,
 				      struct net_device *dev, unsigned int len)
@@ -177,14 +181,77 @@ static const struct dsa_device_ops qca_e
 
 DSA_TAG_DRIVER(qca_etype_netdev_ops);
 
+/* The port, or the bridge it forwards in, as an 802.1Q VLAN that the switch
+ * adds on receive and strips on transmit, so the tag reads the same in both
+ * directions.
+ */
+static struct sk_buff *qca_8021q_tag_xmit(struct sk_buff *skb,
+					  struct net_device *dev)
+{
+	struct dsa_port *dp = dsa_user_to_port(dev);
+	u16 tx_vid = dsa_tag_8021q_standalone_vid(dp);
+
+	if (skb->offload_fwd_mark) {
+		struct net_device *br = dsa_port_bridge_dev_get(dp);
+
+		if (br_vlan_enabled(br))
+			return skb;
+
+		tx_vid = dsa_tag_8021q_bridge_vid(dsa_port_bridge_num_get(dp));
+	}
+
