Use ASID - 1 for local array slots and reject invalid or duplicate ASIDs.
Unregister child domains and drain their managed IRQs before freeing rproc;
unwind root registration and release its context after managed resources.

Signed-off-by: Ziyang Huang <hzyitc@outlook.com>
Signed-off-by: ViKing <viking.yfy@qq.com>
---
--- a/drivers/remoteproc/qcom_q6v5_mpd.c
+++ b/drivers/remoteproc/qcom_q6v5_mpd.c
@@ -34,6 +34,7 @@
 
 #define BUF_SIZE			35
 
+#define MAX_UPD				3
 #define MAX_FIRMWARE			3
 
 #define RPD_SWID		MPD_WCNSS_PAS_ID
@@ -44,8 +45,6 @@
 #define UPD_BOOT_INFO_SMEM_ID		507
 #define VERSION2			2
 
-static LIST_HEAD(upd_rproc_list);
-
 /**
  * struct userpd_boot_info_header - header of user pd bootinfo
  * @type:		type of bootinfo passing over smem
@@ -81,6 +80,7 @@ struct q6_wcss {
 	size_t mem_size;
 	const struct wcss_data *desc;
 	const char **firmware;
+	struct userpd *upd[MAX_UPD];
 };
 
 struct userpd {
@@ -88,6 +88,7 @@ struct userpd {
 	struct device *dev;
 	struct qcom_rproc_ssr ssr_subdev;
 	struct qcom_q6v5 q6;
+	void *irq_group;
 };
 
 struct wcss_data {
@@ -277,13 +278,12 @@ static void *q6_wcss_da_to_va(struct rpr
  */
 static int share_upd_bootinfo_to_q6(struct rproc *rproc)
 {
-	int ret;
+	int i, ret;
 	size_t size;
 	u16 cnt = 0, version;
 	void *ptr;
 	struct q6_wcss *wcss = rproc->priv;
 	struct userpd *upd;
-	struct rproc *upd_rproc;
 	struct userpd_boot_info upd_bootinfo = {0};
 	const struct firmware *fw;
 
@@ -308,16 +308,19 @@ static int share_upd_bootinfo_to_q6(stru
 	memcpy_toio(ptr, &version, sizeof(version));
 	ptr += sizeof(version);
 
-	list_for_each_entry(upd_rproc, &upd_rproc_list, node)
-		cnt++;
+	for (i = 0; i < ARRAY_SIZE(wcss->upd); i++)
+		if (wcss->upd[i])
+			cnt++;
 
 	/* No of elements */
 	cnt = (sizeof(upd_bootinfo) * cnt);
 	memcpy_toio(ptr, &cnt, sizeof(u16));
 	ptr += sizeof(u16);
 
-	list_for_each_entry(upd_rproc, &upd_rproc_list, node) {
-		upd = upd_rproc->priv;
+	for (i = 0; i < ARRAY_SIZE(wcss->upd); i++) {
+		upd = wcss->upd[i];
+		if (!upd)
+			continue;
 
 		/* TYPE */
 		upd_bootinfo.header.type = UPD_BOOT_INFO_HEADER_TYPE;
@@ -329,14 +332,14 @@ static int share_upd_bootinfo_to_q6(stru
 		/* Process ID */
 		upd_bootinfo.pid = upd->pd_asid + 1;
 
-		ret = request_firmware(&fw, upd_rproc->firmware, upd->dev);
+		ret = request_firmware(&fw, upd->q6.rproc->firmware, upd->dev);
 		if (ret < 0) {
 			dev_err(upd->dev, "request_firmware failed: %d\n",	ret);
 			return ret;
 		}
 
 		/* Load address */
-		upd_bootinfo.bootaddr = rproc_get_boot_addr(upd_rproc, fw);
+		upd_bootinfo.bootaddr = rproc_get_boot_addr(upd->q6.rproc, fw);
 
 		/* Firmware mem size */
 		upd_bootinfo.data_size = qcom_mdt_get_size(fw);
@@ -538,7 +541,7 @@ static int q6_get_outbound_irq(struct qc
 	struct qcom_smem_state *tmp_state;
 	unsigned  bit;
 
-	tmp_state = qcom_smem_state_get(&pdev->dev, int_name, &bit);
+	tmp_state = devm_qcom_smem_state_get(&pdev->dev, int_name, &bit);
 	if (IS_ERR(tmp_state))
 		return dev_err_probe(&pdev->dev, PTR_ERR(tmp_state),
 				     "failed to acquire %s state\n", int_name);
@@ -604,18 +607,32 @@ static int init_irq(struct qcom_q6v5 *q6
 	return 0;
 }
 
-static void q6_release_resources(void)
+static void q6_release_resources(struct q6_wcss *wcss)
 {
-	struct rproc *upd_rproc;
+	struct platform_device *pdev;
+	struct userpd *upd;
+	struct rproc *rproc;
+	int i;
+
+	for (i = ARRAY_SIZE(wcss->upd) - 1; i >= 0; i--) {
+		upd = wcss->upd[i];
+		if (!upd)
+			continue;
 
-	/* Release userpd resources */
-	list_for_each_entry(upd_rproc, &upd_rproc_list, node) {
-		rproc_del(upd_rproc);
-		rproc_free(upd_rproc);
+		pdev = to_platform_device(upd->dev);
+		rproc = upd->q6.rproc;
+		rproc_del(rproc);
+		qcom_remove_ssr_subdev(rproc, &upd->ssr_subdev);
+		/* Drain threaded IRQs before freeing their remoteproc context. */
+		devres_release_group(upd->dev, upd->irq_group);
+		wcss->upd[i] = NULL;
+		platform_set_drvdata(pdev, NULL);
+		of_platform_device_destroy(&pdev->dev, NULL);
+		rproc_free(rproc);
 	}
 }
 
-static int q6_register_userpd(struct platform_device *pdev,
+static int q6_register_userpd(struct q6_wcss *wcss,
 			      struct device_node *userpd_np)
 {
 	struct userpd *upd;
@@ -640,46 +657,68 @@ static int q6_register_userpd(struct pla
 		return ret;
 	}
 
-	dev_info(&pdev->dev, "%s node found\n", userpd_np->name);
+	dev_info(wcss->dev, "%s node found\n", userpd_np->name);
 
 	userpd_pdev = of_platform_device_create(userpd_np, userpd_np->name,
-						&pdev->dev);
+						wcss->dev);
 	if (!userpd_pdev)
-		return dev_err_probe(&pdev->dev, -ENODEV,
+		return dev_err_probe(wcss->dev, -ENODEV,
 				     "failed to create %s platform device\n",
 				     userpd_np->name);
 
-	userpd_pdev->dev.driver = pdev->dev.driver;
 	rproc = rproc_alloc(&userpd_pdev->dev, userpd_pdev->name, &wcss_ops,
 			    firmware_name, sizeof(*upd));
 	if (!rproc) {
 		ret = -ENOMEM;
-		goto free_rproc;
+		goto destroy_device;
 	}
 
 	upd = rproc->priv;
 	upd->dev = &userpd_pdev->dev;
+	upd->irq_group = devres_open_group(upd->dev, NULL, GFP_KERNEL);
+	if (!upd->irq_group) {
+		ret = -ENOMEM;
+		goto free_rproc;
+	}
 
 	ret = init_irq(&upd->q6, userpd_pdev, rproc,
 		       WCSS_CRASH_REASON, NULL, NULL);
 	if (ret)
 		goto free_rproc;
 
+	if (!upd->pd_asid || upd->pd_asid > ARRAY_SIZE(wcss->upd) ||
+	    wcss->upd[upd->pd_asid - 1]) {
+		ret = dev_err_probe(upd->dev, -EINVAL, "invalid or duplicate ASID %u\n",
+				    upd->pd_asid);
+		goto free_rproc;
+	}
+	devres_close_group(upd->dev, upd->irq_group);
+
 	rproc->auto_boot = false;
 	ret = rproc_add(rproc);
 	if (ret)
 		goto free_rproc;
 
-	list_add(&rproc->node, &upd_rproc_list);
+	wcss->upd[upd->pd_asid - 1] = upd;
 	platform_set_drvdata(userpd_pdev, rproc);
 	qcom_add_ssr_subdev(rproc, &upd->ssr_subdev, userpd_pdev->name);
 	return 0;
 
 free_rproc:
-	kfree(rproc);
+	if (upd->irq_group)
+		devres_release_group(upd->dev, upd->irq_group);
+	rproc_free(rproc);
+destroy_device:
+	of_platform_device_destroy(&userpd_pdev->dev, NULL);
 	return ret;
 }
 
+
+static void q6_free_rproc(void *data)
+{
+	rproc_free(data);
+}
+
 static int q6_wcss_probe(struct platform_device *pdev)
 {
 	struct q6_wcss *wcss;
@@ -704,6 +743,11 @@ static int q6_wcss_probe(struct platform
 	if (!rproc)
 		return -ENOMEM;
 
+	/* Registered first so managed IRQs and clocks are released before rproc. */
+	ret = devm_add_action_or_reset(&pdev->dev, q6_free_rproc, rproc);
+	if (ret)
+		return ret;
+
 	wcss = rproc->priv;
 	wcss->dev = &pdev->dev;
 	wcss->desc = of_device_get_match_data(&pdev->dev);
@@ -724,26 +768,30 @@ static int q6_wcss_probe(struct platform
 	rproc->auto_boot = false;
 	ret = rproc_add(rproc);
 	if (ret)
-		goto free_rproc;
+		goto remove_subdevs;
 
 	platform_set_drvdata(pdev, rproc);
 
 	/* Iterate over userpd child's and register with rproc */
 	for_each_available_child_of_node(pdev->dev.of_node, userpd_np) {
-		ret = q6_register_userpd(pdev, userpd_np);
+		ret = q6_register_userpd(wcss, userpd_np);
 		if (ret) {
-			/* release resources of successfully allocated userpd rproc's */
-			q6_release_resources();
-			return dev_err_probe(&pdev->dev, ret,
-					     "Failed to register userpd(%s)\n",
-					     userpd_np->name);
+			dev_err_probe(&pdev->dev, ret, "Failed to register userpd(%s)\n",
+				      userpd_np->name);
+			of_node_put(userpd_np);
+			q6_release_resources(wcss);
+			rproc_del(rproc);
+			platform_set_drvdata(pdev, NULL);
+			goto remove_subdevs;
 		}
 	}
 	return 0;
 
+remove_subdevs:
+	qcom_remove_ssr_subdev(rproc, &wcss->ssr_subdev);
+	qcom_remove_glink_subdev(rproc, &wcss->glink_subdev);
+	qcom_q6v5_deinit(&wcss->q6);
 free_rproc:
-	rproc_free(rproc);
-
 	return ret;
 }
 
@@ -752,10 +800,12 @@ static void q6_wcss_remove(struct platfo
 	struct rproc *rproc = platform_get_drvdata(pdev);
 	struct q6_wcss *wcss = rproc->priv;
 
-	qcom_q6v5_deinit(&wcss->q6);
-
+	q6_release_resources(wcss);
 	rproc_del(rproc);
-	rproc_free(rproc);
+	qcom_remove_ssr_subdev(rproc, &wcss->ssr_subdev);
+	qcom_remove_glink_subdev(rproc, &wcss->glink_subdev);
+	qcom_q6v5_deinit(&wcss->q6);
+	platform_set_drvdata(pdev, NULL);
 }
 
 static const struct wcss_data q6_ipq5332_res_init = {
