#!/bin/sh /etc/rc.common
# shellcheck shell=ash
# shellcheck disable=SC2034,SC2154

START=93

PROC_ROOT=${PROC_ROOT:-/proc}
IRQ_ROOT=${IRQ_ROOT:-${PROC_ROOT}/irq}
IRQ_FILE=${IRQ_FILE:-${PROC_ROOT}/interrupts}
SYS_ROOT=${SYS_ROOT:-/sys}
TASKSET=${TASKSET:-taskset}

log_status() {
	[ "$enable_log" = 1 ] || return 0
	logger -t smp_affinity "$*"
}

online_cpu() {
	local cpu="$1" range first last

	for range in $(printf '%s' "$online" | tr ',' ' '); do
		first="${range%-*}"
		last="${range#*-}"
		if [ "$cpu" -ge "$first" ] && [ "$cpu" -le "$last" ]; then
			printf '%s\n' "$cpu"
			return
		fi
	done
	# Keep the mapping valid if a CPU has been taken offline.
	printf '%s\n' "${online%%[-,]*}"
}

bind_irq() {
	local cpu="$2" path="$IRQ_ROOT/$1" current

	[ -r "$path/smp_affinity_list" ] || return 1
	read -r current < "$path/smp_affinity_list"
	if [ "$current" != "$cpu" ]; then
		echo "$cpu" > "$path/smp_affinity_list" || return 1
		changed=$((changed + 1))
	fi
	read -r current < "$path/smp_affinity_list"
	[ "$current" = "$cpu" ] || return 1
	if [ -r "$path/effective_affinity_list" ]; then
		read -r current < "$path/effective_affinity_list"
		# The kernel can defer migration until this IRQ fires again. A
		# matching requested mask is success; report pending effective moves.
		[ "$current" = "$cpu" ] || pending=$((pending + 1))
	fi
	return 0
}

bind_thread() {
	local pid="$1" cpu="$2" current comm

	read -r comm < "$PROC_ROOT/$pid/comm" || return 1
	case "$comm" in napi/eth0-[0-9]*) ;; *) return 1 ;; esac
	current="$(awk '/^Cpus_allowed_list:/ {print $2}' "$PROC_ROOT/$pid/status")"
	if [ "$current" != "$cpu" ]; then
		"$TASKSET" -p "$(printf '%x' "$((1 << cpu))")" "$pid" >/dev/null 2>&1 || return 1
		changed=$((changed + 1))
	fi
	current="$(awk '/^Cpus_allowed_list:/ {print $2}' "$PROC_ROOT/$pid/status")"
	[ "$current" = "$cpu" ]
}

bind_edma_threads() {
	local path comm pid count=0 rx_pid='' tx_pid='' threaded failed=0

	[ -r "$SYS_ROOT/class/net/eth0/threaded" ] || return 0
	read -r threaded < "$SYS_ROOT/class/net/eth0/threaded"
	[ "$threaded" = 1 ] || return 0

	# EDMA adds TX then RX NAPI; the kernel creates threads in reverse list
	# order, so RX has the lower PID. Both names can end in -0 on Linux 6.18
	# because threads are created before napi_enable() allocates NAPI IDs.
	# Require exactly two threads rather than guessing with an unknown layout.
	for path in "$PROC_ROOT"/[0-9]*/comm; do
		[ -r "$path" ] || continue
		read -r comm < "$path" || continue
		case "$comm" in napi/eth0-[0-9]*) ;; *) continue ;; esac
		case "${comm##*-}" in ''|*[!0-9]*) continue ;; esac
		pid="${path%/comm}"
		pid="${pid##*/}"
		count=$((count + 1))
		[ -n "$rx_pid" ] && [ "$pid" -ge "$rx_pid" ] || rx_pid="$pid"
		[ -n "$tx_pid" ] && [ "$pid" -le "$tx_pid" ] || tx_pid="$pid"
	done
	if [ "$count" -ne 2 ]; then
		log_status "EDMA threaded NAPI: expected 2 threads, found $count"
		return 1
	fi
	bind_thread "$rx_pid" "$(online_cpu 1)" || failed=1
	bind_thread "$tx_pid" "$(online_cpu 2)" || failed=1
	[ "$failed" -eq 0 ]
}

start() {
	local enable enable_log online irq cpu name changed=0 failed=0 pending=0 edma=0

	config_load smp_affinity
	config_get_bool enable general enable 1
	config_get_bool enable_log general enable_log 1
	[ "$enable" = 1 ] || return 0
	online="$(cat "$SYS_ROOT/devices/system/cpu/online")" || return 1
	[ -n "$online" ] || return 1

	# Bind only registered IRQs. Missing PPDU MAC3 on dual-radio IPQ60xx,
	# disabled Wi-Fi, or non-threaded NAPI must not hold up EDMA affinity.
	while read -r irq cpu name; do
		[ -n "$irq" ] || continue
		case "$name" in edma_*) edma=1 ;; esac
		cpu="$(online_cpu "$cpu")"
		if ! bind_irq "$irq" "$cpu"; then
			log_status "IRQ $irq ($name): affinity to CPU$cpu failed readback"
			failed=$((failed + 1))
		fi
	done <<EOF
$(awk '
	$1 ~ /^[0-9]+:$/ {
		name = $NF; sub(/:$/, "", name); cpu = -1
		if (name == "edma_rxdesc" || name == "edma_rxfill") cpu = 1
		else if (name == "edma_txcmpl") cpu = 2
		else if (name ~ /^reo2host-destination-ring[1-4]$/) cpu = substr(name, length(name)) - 1
		else if (name ~ /^wbm2host-tx-completions-ring[1-3]$/ || name ~ /^ppdu-end-interrupts-mac[1-3]$/) cpu = substr(name, length(name))
		if (cpu >= 0) {sub(/:$/, "", $1); print $1, cpu, name}
	}' "$IRQ_FILE")
EOF
	if [ "$edma" = 1 ] && ! bind_edma_threads; then
		failed=$((failed + 1))
	fi
	if [ "$changed" -gt 0 ] || [ "$failed" -gt 0 ]; then
		log_status "IRQ/NAPI affinity: changed=$changed failed=$failed pending=$pending"
	fi
	[ "$failed" -eq 0 ]
}
