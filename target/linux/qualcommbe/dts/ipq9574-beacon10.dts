/dts-v1/;

#include "ipq9574-common.dtsi"
#include "ipq9574-common-wifi.dtsi"

/ {
	model = "Nokia Beacon 10";
	compatible = "nokia,beacon10", "qcom,ipq9574";

	aliases {
		led-boot = &led_power_green;
		led-failsafe = &led_power_red;
		led-running = &led_power_green;
		led-upgrade = &led_power_amber;
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&keys_pins>;
		pinctrl-names = "default";

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&tlmm 50 GPIO_ACTIVE_LOW>;
			debounce-interval = <30>;
		};

		wps {
			label = "wps";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&tlmm 37 GPIO_ACTIVE_LOW>;
			debounce-interval = <30>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_power_red: power-red {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_POWER;
			gpios = <&tlmm 55 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_power_green: power-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			gpios = <&tlmm 22 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		led_power_amber: power-amber {
			color = <LED_COLOR_ID_AMBER>;
			function = LED_FUNCTION_POWER;
			gpios = <&tlmm 57 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};
};

&mdio {
	pinctrl-0 = <&mdio_pins>;
	pinctrl-names = "default";
	clock-frequency = <6250000>;
	reset-gpios = <&tlmm 60 GPIO_ACTIVE_LOW>;
	reset-delay-us = <10000>;
	reset-post-delay-us = <20000>;
	status = "okay";

	ethernet-phy-package@0 {
		compatible = "qcom,qca8075-package";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0>;
		qcom,package-mode = "qsgmii";

		qca8075_0: ethernet-phy@0 {
			reg = <0>;
		};

		qca8075_1: ethernet-phy@1 {
			reg = <1>;
		};
	};

	rtl8221b: ethernet-phy@7 {
		compatible = "ethernet-phy-id001c.c849",
			     "ethernet-phy-ieee802.3-c22";
		reg = <7>;
	};

	rtl8261n: ethernet-phy@8 {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <8>;
		reset-gpios = <&tlmm 17 GPIO_ACTIVE_LOW>;
		reset-assert-us = <200000>;
		reset-deassert-us = <150000>;
		reset-before-id-read;
	};
};

&pcie2 {
	pinctrl-0 = <&pcie2_default>;
	pinctrl-names = "default";
	perst-gpios = <&tlmm 29 GPIO_ACTIVE_LOW>;
	wake-gpios = <&tlmm 30 GPIO_ACTIVE_LOW>;
	status = "okay";

	pcie@0,0 {
		device_type = "pci";
		reg = <0 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		wifi@0,0 {
			compatible = "pci17cb,1104";
			reg = <0 0 0 0 0>;
			qcom,calibration-variant = "Nokia-Beacon-10-5G";
		};
	};
};

&pcie2_phy {
	status = "okay";
};

&pcie3 {
	pinctrl-0 = <&pcie3_default>;
	pinctrl-names = "default";
	perst-gpios = <&tlmm 32 GPIO_ACTIVE_LOW>;
	wake-gpios = <&tlmm 33 GPIO_ACTIVE_LOW>;
	status = "okay";

	pcie@0,0 {
		device_type = "pci";
		reg = <0 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		wifi@0,0 {
			compatible = "pci17cb,1104";
			reg = <0 0 0 0 0>;
			qcom,calibration-variant = "Nokia-Beacon-10-6G";
		};
	};
};

&pcie3_phy {
	status = "okay";
};

&pcs0 {
	status = "okay";
};

&pcs1 {
	status = "okay";
};

&pcs2 {
	status = "okay";
};

&qcom_ppe {
	status = "okay";

	ethernet-ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;
			label = "lan3";
			nvmem-cells = <&macaddr_ri 4>;
			nvmem-cell-names = "mac-address";
			phy-mode = "qsgmii";
			phy-handle = <&qca8075_0>;
			pcs-handle = <&pcs0_ch0>;
			managed = "in-band-status";
			clocks = <&nsscc NSS_CC_PORT1_MAC_CLK>,
				 <&nsscc NSS_CC_PORT1_RX_CLK>,
				 <&nsscc NSS_CC_PORT1_TX_CLK>;
			clock-names = "mac", "rx", "tx";
			resets = <&nsscc PORT1_MAC_ARES>,
				 <&nsscc PORT1_RX_ARES>,
				 <&nsscc PORT1_TX_ARES>;
			reset-names = "mac", "rx", "tx";
		};

		port@2 {
			reg = <2>;
			label = "lan2";
			nvmem-cells = <&macaddr_ri 3>;
			nvmem-cell-names = "mac-address";
			phy-mode = "qsgmii";
			phy-handle = <&qca8075_1>;
			pcs-handle = <&pcs0_ch1>;
			managed = "in-band-status";
			clocks = <&nsscc NSS_CC_PORT2_MAC_CLK>,
				 <&nsscc NSS_CC_PORT2_RX_CLK>,
				 <&nsscc NSS_CC_PORT2_TX_CLK>;
			clock-names = "mac", "rx", "tx";
			resets = <&nsscc PORT2_MAC_ARES>,
				 <&nsscc PORT2_RX_ARES>,
				 <&nsscc PORT2_TX_ARES>;
			reset-names = "mac", "rx", "tx";
		};

		port@5 {
			reg = <5>;
			label = "lan1";
			nvmem-cells = <&macaddr_ri 2>;
			nvmem-cell-names = "mac-address";
			phy-mode = "2500base-x";
			phy-handle = <&rtl8221b>;
			pcs-handle = <&pcs1_ch0>;
			clocks = <&nsscc NSS_CC_PORT5_MAC_CLK>,
				 <&nsscc NSS_CC_PORT5_RX_CLK>,
				 <&nsscc NSS_CC_PORT5_TX_CLK>;
			clock-names = "mac", "rx", "tx";
			resets = <&nsscc PORT5_MAC_ARES>,
				 <&nsscc PORT5_RX_ARES>,
				 <&nsscc PORT5_TX_ARES>;
			reset-names = "mac", "rx", "tx";
		};

		port@6 {
			reg = <6>;
			label = "wan";
			nvmem-cells = <&macaddr_ri 1>;
			nvmem-cell-names = "mac-address";
			phy-mode = "usxgmii";
			phy-handle = <&rtl8261n>;
			pcs-handle = <&pcs2_ch0>;
			managed = "in-band-status";
			clocks = <&nsscc NSS_CC_PORT6_MAC_CLK>,
				 <&nsscc NSS_CC_PORT6_RX_CLK>,
				 <&nsscc NSS_CC_PORT6_TX_CLK>;
			clock-names = "mac", "rx", "tx";
			resets = <&nsscc PORT6_MAC_ARES>,
				 <&nsscc PORT6_RX_ARES>,
				 <&nsscc PORT6_TX_ARES>;
			reset-names = "mac", "rx", "tx";
		};
	};
};

&rpm_requests {
	regulators {
		s1 {
			regulator-boot-on;
			regulator-always-on;
		};

		s2 {
			regulator-min-microvolt = <700000>;
			regulator-max-microvolt = <1000000>;
			regulator-boot-on;
			regulator-always-on;
		};
	};
};

&sdhc_1 {
	#address-cells = <1>;
	#size-cells = <0>;
	bus-width = <8>;
	max-frequency = <384000000>;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	mmc-hs400-enhanced-strobe;
	non-removable;
	pinctrl-0 = <&sdc_default_state>;
	pinctrl-names = "default";
	status = "okay";

	card@0 {
		compatible = "mmc-card";
		reg = <0>;

		partitions {
			compatible = "gpt-partitions";

			partition-ri {
				partname = "RI";

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr_ri: mac-address@440 {
						compatible = "mac-base";
						reg = <0x440 0x11>;
						#nvmem-cell-cells = <1>;
					};
				};
			};
		};
	};
};

&tlmm {
	keys_pins: keys-state {
		pins = "gpio37", "gpio50";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};
};

&wifi0 {
	qcom,calibration-variant = "Nokia-Beacon-10";
};
