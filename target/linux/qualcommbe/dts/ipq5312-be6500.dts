/dts-v1/;

#include "ipq5332-common.dtsi"
#include "ipq5332-common-qca8386.dtsi"
#include "ipq5332-common-wifi.dtsi"

#include <dt-bindings/clock/qcom,ipq5332-cmn-pll.h>
#include <dt-bindings/clock/qcom,ipq5332-gcc.h>
#include <dt-bindings/clock/qcom,ipq5332-nsscc.h>

/ {
	model = "Xiaomi BE6500";
	compatible = "xiaomi,be6500", "qcom,ipq5332";

	aliases {
		led-boot = &led_status_orange;
		led-failsafe = &led_status_orange;
		led-running = &led_status_orange;
		led-upgrade = &led_status_orange;
	};

	chosen {
		bootargs-append = " root=/dev/ubiblock0_1";
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		button-mesh {
			label = "mesh";
			gpios = <&tlmm 16 GPIO_ACTIVE_LOW>;
			linux,code = <BTN_9>;
			linux,input-type = <EV_KEY>;
			debounce-interval = <60>;
		};

		button-reset {
			label = "reset";
			gpios = <&tlmm 43 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&led_pins>;
		pinctrl-names = "default";

		led_status_orange: status-orange {
			color = <LED_COLOR_ID_ORANGE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 32 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		led_status_white: status-white {
			color = <LED_COLOR_ID_WHITE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 30 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};
};

&ref_48mhz_clk {
	clock-div = <1>;
	clock-mult = <2>;
};

&xo_clk {
	clock-frequency = <24000000>;
};

&mdio {
	status = "okay";
	/* The active vendor Linux DT resets QCA8386 through GPIO45. */
	phy-reset-gpios = <&tlmm 45 GPIO_ACTIVE_LOW>;
};

&qca8386 {
	ports {
		port@1 {
			label = "lan1";
		};

		port@2 {
			label = "lan2";
		};

		port@3 {
			label = "lan3";
		};

		port@4 {
			label = "wan";
			nvmem-cells = <&base_macaddr 0>;
			nvmem-cell-names = "mac-address";
		};
	};
};

&qcom_ppe {
	status = "okay";
	/* Default EDMA page-fragment RX allocator for comparison build. */

	ethernet-ports {
		#address-cells = <1>;
		#size-cells = <0>;
	};
};

&ppe_qca8386 {
	nvmem-cells = <&base_macaddr 1>;
	nvmem-cell-names = "mac-address";
};

&qpic_nand {
	status = "okay";

	pinctrl-0 = <&qspi_pins>;
	pinctrl-names = "default";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;
		nand-ecc-engine = <&qpic_nand>;
		nand-ecc-strength = <8>;
		nand-ecc-step-size = <512>;
		nand-bus-width = <8>;

		partitions {
			compatible = "qcom,smem-part";

			partition-0-art {
				label = "0:art";
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					base_macaddr: mac-address@0 {
						compatible = "mac-base";
						reg = <0x0 0x6>;
						#nvmem-cell-cells = <1>;
					};
				};
			};
		};
	};
};

&tlmm {
	button_pins: button-pins {
		pins = "gpio16", "gpio43";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	led_pins: led-pins {
		pins = "gpio30", "gpio32";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
		output-low;
	};
};

&wifi1 {
	qcom,board-id = <2>;

	nvmem-cells = <&base_macaddr 4>;
	nvmem-cell-names = "mac-address";
};

&wifi0 {
	qcom,board-id = <18>;

	nvmem-cells = <&base_macaddr 3>;
	nvmem-cell-names = "mac-address";
};
