/dts-v1/;

#include "ipq5332.dtsi"
#include <dt-bindings/clock/qcom,qca8k-nsscc.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/net/qcom,qca808x.h>
#include <dt-bindings/reset/qcom,qca8k-nsscc.h>

/ {
	model = "JDCloud RE-CS-08";
	compatible = "jdcloud,re-cs-08", "qcom,ipq5332";

	aliases {
		serial0 = &blsp1_uart0;
		ethernet0 = &ppe_sfp;
		ethernet1 = &ppe_qca8386;
		led-boot = &led_system_blue;
		led-failsafe = &led_system_red;
		led-running = &led_system_green;
		led-upgrade = &led_system_red;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	clocks {
		qca8386_rx_312p5m: qca8386-rx-312p5m {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <312500000>;
		};

		qca8386_tx_312p5m: qca8386-tx-312p5m {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <312500000>;
		};
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		button-wps {
			label = "wps";
			gpios = <&tlmm 31 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
			debounce-interval = <60>;
		};

		button-reset {
			label = "reset";
			gpios = <&tlmm 32 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&led_pins>;
		pinctrl-names = "default";

		led_system_red: system-red {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 24 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_system_green: system-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 33 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led_system_blue: system-blue {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 49 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		sfp-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN;
			gpios = <&tlmm 36 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	/* QWRT identifies GPIO45 as RX_LOS and GPIO34 as TX_DISABLE. */
	sfp0: sfp-0 {
		compatible = "sff,sfp";
		i2c-bus = <&blsp1_i2c1>;
		pinctrl-0 = <&sfp_pins>;
		pinctrl-names = "default";
		los-gpios = <&tlmm 45 GPIO_ACTIVE_HIGH>;
		tx-disable-gpios = <&tlmm 34 GPIO_ACTIVE_HIGH>;
	};
};

&blsp1_uart0 {
	status = "okay";

	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
};

&blsp1_i2c1 {
	clock-frequency = <400000>;
	status = "okay";

	pinctrl-0 = <&i2c1_pins>;
	pinctrl-names = "default";
};

&q6_region {
	reg = <0x0 0x4a900000 0x0 0x800000>;
};

&sleep_clk {
	clock-frequency = <32000>;
};

&ref_48mhz_clk {
	clock-div = <1>;
	clock-mult = <2>;
};

&xo_clk {
	clock-frequency = <24000000>;
};

&xo_board {
	clock-div = <2>;
	clock-mult = <1>;
};

&mdio {
	status = "okay";
	clocks = <&gcc GCC_MDIO_AHB_CLK>,
		 <&gcc GCC_UNIPHY0_AHB_CLK>,
		 <&gcc GCC_UNIPHY0_SYS_CLK>,
		 <&gcc GCC_UNIPHY1_AHB_CLK>,
		 <&gcc GCC_UNIPHY1_SYS_CLK>;
	clock-names = "gcc_mdio_ahb_clk",
		      "uniphy0_ahb_clk", "uniphy0_sys_clk",
		      "uniphy1_ahb_clk", "uniphy1_sys_clk";
	phy-reset-gpios = <&tlmm 51 GPIO_ACTIVE_LOW>;
	mdio_clk_fixup;

	qca8386_nsscc: clock-controller@18 {
		compatible = "qcom,qca8386-nsscc", "qcom,qca8084-nsscc";
		reg = <0x18>;
		clocks = <&cmn_pll IPQ5332_ETH_50MHZ_CLK>,
			 <0>, <0>,
			 <&qca8386_rx_312p5m>, <&qca8386_tx_312p5m>,
			 <&qca8386_rx_312p5m>, <&qca8386_tx_312p5m>;
		#clock-cells = <1>;
		#reset-cells = <1>;
	};

	qca8386_phy_package: ethernet-phy-package@1 {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "qcom,qca8084-package";
		reg = <1>;
		clocks = <&qca8386_nsscc NSS_CC_APB_BRIDGE_CLK>,
			 <&qca8386_nsscc NSS_CC_AHB_CLK>,
			 <&qca8386_nsscc NSS_CC_SEC_CTRL_AHB_CLK>,
			 <&qca8386_nsscc NSS_CC_TLMM_CLK>,
			 <&qca8386_nsscc NSS_CC_TLMM_AHB_CLK>,
			 <&qca8386_nsscc NSS_CC_CNOC_AHB_CLK>,
			 <&qca8386_nsscc NSS_CC_MDIO_AHB_CLK>;
		clock-names = "apb_bridge",
			      "ahb",
			      "sec_ctrl_ahb",
			      "tlmm",
			      "tlmm_ahb",
			      "cnoc_ahb",
			      "mdio_ahb";
		resets = <&qca8386_nsscc NSS_CC_GEPHY_FULL_ARES>;
		qcom,phy-addr-fixup = <1 2 3 4 5 6 7>;
		qcom,package-mode = <QCA808X_PCS1_SGMII_MAC_PCS0_SGMII_MAC>;
		qcom,pcs1-sgmii-plus;

		qca8386_phy1: ethernet-phy@1 {
			compatible = "ethernet-phy-id004d.d180";
			reg = <1>;
			clocks = <&qca8386_nsscc NSS_CC_GEPHY0_SYS_CLK>,
				 <&qca8386_nsscc NSS_CC_MAC1_TX_CLK>,
				 <&qca8386_nsscc NSS_CC_MAC1_RX_CLK>,
				 <&qca8386_nsscc NSS_CC_MAC1_GEPHY0_TX_CLK>,
				 <&qca8386_nsscc NSS_CC_MAC1_GEPHY0_RX_CLK>;
			clock-names = "phy", "mac_tx", "mac_rx",
				      "gephy_tx", "gephy_rx";
			resets = <&qca8386_nsscc NSS_CC_GEPHY0_SYS_ARES>;
		};

		qca8386_phy2: ethernet-phy@2 {
			compatible = "ethernet-phy-id004d.d180";
			reg = <2>;
			clocks = <&qca8386_nsscc NSS_CC_GEPHY1_SYS_CLK>,
				 <&qca8386_nsscc NSS_CC_MAC2_TX_CLK>,
				 <&qca8386_nsscc NSS_CC_MAC2_RX_CLK>,
				 <&qca8386_nsscc NSS_CC_MAC2_GEPHY1_TX_CLK>,
				 <&qca8386_nsscc NSS_CC_MAC2_GEPHY1_RX_CLK>;
			clock-names = "phy", "mac_tx", "mac_rx",
				      "gephy_tx", "gephy_rx";
			resets = <&qca8386_nsscc NSS_CC_GEPHY1_SYS_ARES>;
		};

		qca8386_phy3: ethernet-phy@3 {
			compatible = "ethernet-phy-id004d.d180";
			reg = <3>;
			clocks = <&qca8386_nsscc NSS_CC_GEPHY2_SYS_CLK>,
				 <&qca8386_nsscc NSS_CC_MAC3_TX_CLK>,
				 <&qca8386_nsscc NSS_CC_MAC3_RX_CLK>,
				 <&qca8386_nsscc NSS_CC_MAC3_GEPHY2_TX_CLK>,
				 <&qca8386_nsscc NSS_CC_MAC3_GEPHY2_RX_CLK>;
			clock-names = "phy", "mac_tx", "mac_rx",
				      "gephy_tx", "gephy_rx";
			resets = <&qca8386_nsscc NSS_CC_GEPHY2_SYS_ARES>;
		};

		qca8386_phy4: ethernet-phy@4 {
			compatible = "ethernet-phy-id004d.d180";
			reg = <4>;
			clocks = <&qca8386_nsscc NSS_CC_GEPHY3_SYS_CLK>,
				 <&qca8386_nsscc NSS_CC_MAC4_TX_CLK>,
				 <&qca8386_nsscc NSS_CC_MAC4_RX_CLK>,
				 <&qca8386_nsscc NSS_CC_MAC4_GEPHY3_TX_CLK>,
				 <&qca8386_nsscc NSS_CC_MAC4_GEPHY3_RX_CLK>;
			clock-names = "phy", "mac_tx", "mac_rx",
				      "gephy_tx", "gephy_rx";
			resets = <&qca8386_nsscc NSS_CC_GEPHY3_SYS_ARES>;
		};

		/* PCS1 is the QCA8386 switch CPU SerDes (MDIO base + 5). */
		qca8386_pcs1: pcs-phy@6 {
			compatible = "qcom,qca8k-pcs-phy";
			reg = <6>;
			clocks = <&qca8386_nsscc NSS_CC_SRDS1_SYS_CLK>,
				 <&qca8386_rx_312p5m>, <&qca8386_tx_312p5m>,
				 <&qca8386_nsscc NSS_CC_MAC0_TX_CLK>,
				 <&qca8386_nsscc NSS_CC_MAC0_RX_CLK>,
				 <&qca8386_nsscc NSS_CC_MAC0_TX_SRDS1_CLK>,
				 <&qca8386_nsscc NSS_CC_MAC0_RX_SRDS1_CLK>;
			clock-names = "pcs", "pcs_rx_root", "pcs_tx_root",
				      "mac_tx", "mac_rx",
				      "mac_tx_serdes", "mac_rx_serdes";
			resets = <&qca8386_nsscc NSS_CC_SRDS1_SYS_ARES>,
				 <&qca8386_nsscc NSS_CC_XPCS_ARES>;
			reset-names = "pcs", "xpcs";
		};
	};

	qca8386: switch@10 {
		compatible = "qca,qca8386";
		reg = <0x10>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				label = "cpu";
				ethernet = <&ppe_qca8386>;
				dsa-tag-protocol = "qca_4b";
				phy-mode = "2500base-x";

				fixed-link {
					speed = <2500>;
					full-duplex;
				};
			};

			port@1 {
				reg = <1>;
				label = "wan";
				phy-mode = "sgmii";
				phy-handle = <&qca8386_phy1>;
			};

			port@2 {
				reg = <2>;
				label = "lan1";
				phy-mode = "sgmii";
				phy-handle = <&qca8386_phy2>;
			};

			port@3 {
				reg = <3>;
				label = "lan2";
				phy-mode = "sgmii";
				phy-handle = <&qca8386_phy3>;
			};

			port@4 {
				reg = <4>;
				label = "lan3";
				phy-mode = "sgmii";
				phy-handle = <&qca8386_phy4>;
			};
		};
	};
};

&pcs0 {
	status = "okay";
};

&pcs1 {
	status = "okay";
};

&qcom_ppe {
	status = "okay";

	ethernet-ports {
		#address-cells = <1>;
		#size-cells = <0>;

		ppe_qca8386: port@1 {
			reg = <1>;
			label = "switch";
			phy-mode = "2500base-x";
			pcs-handle = <&pcs0_ch0>;
			clocks = <&nsscc NSS_CC_PORT1_MAC_CLK>,
				 <&nsscc NSS_CC_PORT1_RX_CLK>,
				 <&nsscc NSS_CC_PORT1_TX_CLK>;
			clock-names = "mac",
				      "rx",
				      "tx";
			resets = <&nsscc NSS_CC_PORT1_MAC_CLK_ARES>,
				 <&nsscc NSS_CC_PORT1_RX_CLK_ARES>,
				 <&nsscc NSS_CC_PORT1_TX_CLK_ARES>;
			reset-names = "mac",
				      "rx",
				      "tx";

			fixed-link {
				speed = <2500>;
				full-duplex;
			};
		};

		ppe_sfp: port@2 {
			reg = <2>;
			label = "sfp";
			phy-mode = "2500base-x";
			managed = "in-band-status";
			sfp = <&sfp0>;
			pcs-handle = <&pcs1_ch0>;
			clocks = <&nsscc NSS_CC_PORT2_MAC_CLK>,
				 <&nsscc NSS_CC_PORT2_RX_CLK>,
				 <&nsscc NSS_CC_PORT2_TX_CLK>;
			clock-names = "mac",
				      "rx",
				      "tx";
			resets = <&nsscc NSS_CC_PORT2_MAC_CLK_ARES>,
				 <&nsscc NSS_CC_PORT2_RX_CLK_ARES>,
				 <&nsscc NSS_CC_PORT2_TX_CLK_ARES>;
			reset-names = "mac",
				      "rx",
				      "tx";
		};
	};
};

&pcie1 {
	status = "okay";

	pinctrl-0 = <&pcie1_pins>;
	pinctrl-names = "default";

	/delete-property/ phys;
	/delete-property/ phy-names;

	pcie@0 {
		phys = <&pcie1_phy>;
		reset-gpios = <&tlmm 47 GPIO_ACTIVE_LOW>;
		wake-gpios = <&tlmm 48 GPIO_ACTIVE_LOW>;
	};
};

&pcie1_phy {
	status = "okay";
};

&sdhc {
	status = "okay";

	#address-cells = <1>;
	#size-cells = <0>;
	bus-width = <4>;
	max-frequency = <192000000>;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	non-removable;
	pinctrl-0 = <&sdc_default_state>;
	pinctrl-names = "default";

	card@0 {
		compatible = "mmc-card";
		reg = <0>;

		block {
			compatible = "block-device";

			partitions {
				factory: block-partition-factory {
					partname = "factory";
				};

				hlos: block-partition-hlos {
					partname = "0:HLOS";
				};

				rootfs: block-partition-rootfs {
					partname = "rootfs";
				};

				rootfs_data: block-partition-rootfs-data {
					partname = "rootfs_data";
				};
			};
		};
	};
};

&tlmm {
	i2c1_pins: i2c1-state {
		pins = "gpio29", "gpio30";
		function = "blsp1_i2c0";
		drive-strength = <16>;
		bias-pull-up;
	};

	pcie1_pins: pcie1-default-state {
		clkreq-n-pins {
			pins = "gpio46";
			function = "pcie1_clk";
			drive-strength = <8>;
			bias-pull-up;
		};

		perst-n-pins {
			pins = "gpio47";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
			output-low;
		};

		wake-n-pins {
			pins = "gpio48";
			function = "pcie1_wake";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	sfp_pins: sfp-default-state {
		rx-pins {
			pins = "gpio45";
			function = "gpio";
			bias-disable;
		};

		tx-disable-pins {
			pins = "gpio34";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
			output-low;
		};
	};

	button_pins: button-pins {
		pins = "gpio31", "gpio32";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	led_pins: led-pins {
		pins = "gpio24", "gpio33", "gpio36", "gpio49";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};

	sdc_default_state: sdc-default-state {
		clk-pins {
			pins = "gpio13";
			function = "sdc_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cmd-pins {
			pins = "gpio12";
			function = "sdc_cmd";
			drive-strength = <8>;
			bias-pull-up;
		};

		data-pins {
			pins = "gpio8", "gpio9", "gpio10", "gpio11";
			function = "sdc_data";
			drive-strength = <8>;
			bias-pull-up;
		};
	};
};
