/* IPQ9574 AHB radio resources for boards with additional PCIe radios. */

/* The IPQ9574 AHB firmware requires its M3 dump at this fixed address. */
/ {
	reserved-memory {
		m3_dump: m3-dump@4db00000 {
			reg = <0x0 0x4db00000 0x0 0x00100000>;
			no-map;
		};
	};
};

&q6v5_wcss {
	firmware-name = "ath11k/IPQ9574/hw1.0/q6_fw.mdt",
			"ath11k/IPQ9574/hw1.0/m3_fw.mdt";
};

&wifi0 {
	status = "okay";

	clocks = <&xo_board_clk>;
	clock-names = "xo";
	memory-region = <&q6_region>, <&q6_region>, <&m3_dump>;
	memory-region-names = "host-ddr-mem", "bdf", "m3-dump";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-offset = <0x00c00000>;
};

/* Boards using a different PCIe radio override these defaults. */
&pcie2 {
	pinctrl-0 = <&pcie2_default>;
	pinctrl-names = "default";

	pcie@0,0 {
		device_type = "pci";
		reg = <0x0 0x0 0x0 0x0 0x0>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		wifi2: wifi@0 {
			compatible = "pci17cb,1109";
			reg = <0x0 0x0 0x0 0x0 0x0>;
			qcom,num-radios = <1>;
			qcom,ath12k-fw-memory-mode = <1>;
		};
	};
};

&pcie3 {
	pinctrl-0 = <&pcie3_default>;
	pinctrl-names = "default";

	pcie@0,0 {
		device_type = "pci";
		reg = <0x0 0x0 0x0 0x0 0x0>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		wifi3: wifi@0 {
			compatible = "pci17cb,1109";
			reg = <0x0 0x0 0x0 0x0 0x0>;
			qcom,num-radios = <1>;
			qcom,ath12k-fw-memory-mode = <1>;
		};
	};
};
