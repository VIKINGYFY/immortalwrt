/dts-v1/;

#include "ipq5300-be3600-pro-wired-common.dtsi"

/ {
	model = "Xiaomi BE3600 Pro Wired (5-Ports)";
	compatible = "xiaomi,be3600-pro-wired-p5", "qcom,ipq5332";
};

&mdio {
	status = "okay";

	wan_phy: ethernet-phy@1 {
		compatible = "ethernet-phy-id001c.c849";
		reg = <1>;
		realtek,led-link-select = <0x27 0 0>;
	};

	rtl837x: rtl837x-dsa@29 {
		compatible = "realtek,rtl8372n";
		reg = <29>;
		#address-cells = <1>;
		#size-cells = <0>;
		realtek,preserve-boot-config;
		realtek,rtl8372n-led-init;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@8 {
				reg = <8>;
				label = "cpu";
				ethernet = <&ppe_switch>;
				phy-mode = "usxgmii";

				fixed-link {
					speed = <10000>;
					full-duplex;
				};
			};

			port@7 {
				reg = <7>;
				label = "lan1";
				phy-mode = "internal";
				phy-handle = <&rtl837x_phy7>;
			};

			port@6 {
				reg = <6>;
				label = "lan2";
				phy-mode = "internal";
				phy-handle = <&rtl837x_phy6>;
			};

			port@5 {
				reg = <5>;
				label = "lan3";
				phy-mode = "internal";
				phy-handle = <&rtl837x_phy5>;
			};

			port@4 {
				reg = <4>;
				label = "lan4";
				phy-mode = "internal";
				phy-handle = <&rtl837x_phy4>;
			};
		};

		mdio {
			#address-cells = <1>;
			#size-cells = <0>;

			rtl837x_phy4: ethernet-phy@4 {
				compatible = "ethernet-phy-ieee802.3-c45";
				reg = <4>;
			};

			rtl837x_phy5: ethernet-phy@5 {
				compatible = "ethernet-phy-ieee802.3-c45";
				reg = <5>;
			};

			rtl837x_phy6: ethernet-phy@6 {
				compatible = "ethernet-phy-ieee802.3-c45";
				reg = <6>;
			};

			rtl837x_phy7: ethernet-phy@7 {
				compatible = "ethernet-phy-ieee802.3-c45";
				reg = <7>;
			};
		};
	};
};

&qcom_ppe {
	ethernet-ports {
		ppe_switch: port@1 {
			fixed-link {
				speed = <10000>;
				full-duplex;
			};
		};

		ppe_wan: port@2 {
			label = "wan";
			phy-handle = <&wan_phy>;
		};
	};
};
