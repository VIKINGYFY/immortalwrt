#include "ipq9554-be7000.dts"

/ {
	model = "Xiaomi BE7000 ES";
	compatible = "xiaomi,be7000-es", "qcom,ipq9574";
};

&wifi0 {
	qcom,calibration-variant = "Xiaomi-BE7000-ES";
};

&wifi1 {
	qcom,calibration-variant = "Xiaomi-BE7000-ES";
	memory-region = <&qcn9274_pcie2_region>;
	memory-region-names = "host-ddr-mem";
};
