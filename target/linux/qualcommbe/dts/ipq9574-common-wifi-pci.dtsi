/* Three PCIe radios in the AP-AL02 WSI ring. Board files enable the
 * controllers and provide reset GPIOs, calibration and MACs.
 */

/delete-node/ &q6_region;

&q6v5_wcss {
	status = "disabled";
	/delete-property/ memory-region;
};

&pcie1 {
	pinctrl-0 = <&pcie1_default>;
	pinctrl-names = "default";

	pcie@0,0 {
		device_type = "pci";
		reg = <0x0 0x0 0x0 0x0 0x0>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		wifi1: wifi@0 {
			compatible = "pci17cb,1109";
			reg = <0x0 0x0 0x0 0x0 0x0>;
			qcom,num-radios = <1>;
			qcom,ath12k-fw-memory-mode = <1>;
			qcom,rx-skb-slab;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					wifi1_wsi_tx: endpoint {
						remote-endpoint = <&wifi2_wsi_rx>;
					};
				};

				port@1 {
					reg = <1>;

					wifi1_wsi_rx: endpoint {
						remote-endpoint = <&wifi3_wsi_tx>;
					};
				};
			};
		};
	};
};

&pcie2 {
	pinctrl-0 = <&pcie2_default>;
	pinctrl-names = "default";

	pcie@0,0 {
		device_type = "pci";
		reg = <0x0 0x0 0x0 0x0 0x0>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		wifi2: wifi@0 {
			compatible = "pci17cb,1109";
			reg = <0x0 0x0 0x0 0x0 0x0>;
			qcom,wsi-controller;
			qcom,num-radios = <1>;
			qcom,ath12k-fw-memory-mode = <1>;
			qcom,rx-skb-slab;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					wifi2_wsi_tx: endpoint {
						remote-endpoint = <&wifi3_wsi_rx>;
					};
				};

				port@1 {
					reg = <1>;

					wifi2_wsi_rx: endpoint {
						remote-endpoint = <&wifi1_wsi_tx>;
					};
				};
			};
		};
	};
};

&pcie3 {
	pinctrl-0 = <&pcie3_default>;
	pinctrl-names = "default";

	pcie@0,0 {
		device_type = "pci";
		reg = <0x0 0x0 0x0 0x0 0x0>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		wifi3: wifi@0 {
			compatible = "pci17cb,1109";
			reg = <0x0 0x0 0x0 0x0 0x0>;
			qcom,num-radios = <1>;
			qcom,ath12k-fw-memory-mode = <1>;
			qcom,rx-skb-slab;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					wifi3_wsi_tx: endpoint {
						remote-endpoint = <&wifi1_wsi_rx>;
					};
				};

				port@1 {
					reg = <1>;

					wifi3_wsi_rx: endpoint {
						remote-endpoint = <&wifi2_wsi_tx>;
					};
				};
			};
		};
	};
};
