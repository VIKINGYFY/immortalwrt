 	},
 };
 
@@ -1244,7 +1244,7 @@ static struct clk_rcg2 nss_cc_mac4_rx_cl
 		.name = "nss_cc_mac4_rx_clk_src",
 		.parent_data = nss_cc_uniphy0_tx_uniphy1_tx312p5m_data,
