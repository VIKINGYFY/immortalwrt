From: OpenWrt community <openwrt-devel@lists.openwrt.org>
Subject: [PATCH] clk: qcom: qca8k: query RCG status in prepare context

The QCA8084 NSS clock registers are accessed over MDIO. Move their RCG
status reads out of the atomic enable-lock context, retaining all rate
and parent operations. MMIO-backed controllers keep their existing ops.

Based on Quarx2k/OpenWRT-BE7000 9511 at aa53ea738ce2.

Original author was not recorded in the imported patch.
[viking.yfy@qq.com: complete imported patch metadata]
Signed-off-by: ViKing <viking.yfy@qq.com>
---
--- a/drivers/clk/qcom/clk-rcg.h
+++ b/drivers/clk/qcom/clk-rcg.h
@@ -189,9 +189,11 @@ struct clk_rcg2_gfx3d {
 	container_of(to_clk_rcg2(_hw), struct clk_rcg2_gfx3d, rcg)
 
 extern const struct clk_ops clk_rcg2_ops;
+extern const struct clk_ops clk_rcg2_prepare_ops;
 extern const struct clk_ops clk_rcg2_gp_ops;
 extern const struct clk_ops clk_rcg2_floor_ops;
 extern const struct clk_ops clk_rcg2_fm_ops;
+extern const struct clk_ops clk_rcg2_fm_prepare_ops;
 extern const struct clk_ops clk_rcg2_mux_closest_ops;
 extern const struct clk_ops clk_edp_pixel_ops;
 extern const struct clk_ops clk_byte_ops;
--- a/drivers/clk/qcom/clk-rcg2.c
+++ b/drivers/clk/qcom/clk-rcg2.c
@@ -811,6 +811,20 @@ const struct clk_ops clk_rcg2_ops = {
 };
 EXPORT_SYMBOL_GPL(clk_rcg2_ops);
 
+/* MDIO register accesses require the sleepable prepare context. */
+const struct clk_ops clk_rcg2_prepare_ops = {
+	.is_prepared = clk_rcg2_is_enabled,
+	.get_parent = clk_rcg2_get_parent,
+	.set_parent = clk_rcg2_set_parent,
+	.recalc_rate = clk_rcg2_recalc_rate,
+	.determine_rate = clk_rcg2_determine_rate,
+	.set_rate = clk_rcg2_set_rate,
+	.set_rate_and_parent = clk_rcg2_set_rate_and_parent,
+	.get_duty_cycle = clk_rcg2_get_duty_cycle,
+	.set_duty_cycle = clk_rcg2_set_duty_cycle,
+};
+EXPORT_SYMBOL_GPL(clk_rcg2_prepare_ops);
+
 const struct clk_ops clk_rcg2_gp_ops = {
 	.is_enabled = clk_rcg2_is_enabled,
 	.get_parent = clk_rcg2_get_parent,
@@ -849,6 +863,20 @@ const struct clk_ops clk_rcg2_fm_ops = {
 };
 EXPORT_SYMBOL_GPL(clk_rcg2_fm_ops);
 
+/* MDIO register accesses require the sleepable prepare context. */
+const struct clk_ops clk_rcg2_fm_prepare_ops = {
+	.is_prepared = clk_rcg2_is_enabled,
+	.get_parent = clk_rcg2_get_parent,
+	.set_parent = clk_rcg2_set_parent,
+	.recalc_rate = clk_rcg2_recalc_rate,
+	.determine_rate = clk_rcg2_fm_determine_rate,
+	.set_rate = clk_rcg2_fm_set_rate,
+	.set_rate_and_parent = clk_rcg2_fm_set_rate_and_parent,
+	.get_duty_cycle = clk_rcg2_get_duty_cycle,
+	.set_duty_cycle = clk_rcg2_set_duty_cycle,
+};
+EXPORT_SYMBOL_GPL(clk_rcg2_fm_prepare_ops);
+
 const struct clk_ops clk_rcg2_mux_closest_ops = {
 	.determine_rate = __clk_mux_determine_rate_closest,
 	.get_parent = clk_rcg2_get_parent,
--- a/drivers/clk/qcom/nsscc-qca8k.c
+++ b/drivers/clk/qcom/nsscc-qca8k.c
@@ -314,7 +314,7 @@ static struct clk_rcg2 nss_cc_mac1_tx_cl
 		.name = "nss_cc_mac1_tx_clk_src",
 		.parent_data = nss_cc_uniphy1_rx_tx312p5m_data,
 		.num_parents = ARRAY_SIZE(nss_cc_uniphy1_rx_tx312p5m_data),
-		.ops = &clk_rcg2_fm_ops,
+		.ops = &clk_rcg2_fm_prepare_ops,
 	},
 };
 
@@ -451,7 +451,7 @@ static struct clk_rcg2 nss_cc_mac1_rx_cl
 		.name = "nss_cc_mac1_rx_clk_src",
 		.parent_data = nss_cc_uniphy1_tx312p5m_prx_data,
 		.num_parents = ARRAY_SIZE(nss_cc_uniphy1_tx312p5m_prx_data),
-		.ops = &clk_rcg2_ops,
+		.ops = &clk_rcg2_prepare_ops,
 	},
 };
 
@@ -570,7 +570,7 @@ static struct clk_rcg2 nss_cc_mac2_tx_cl
 		.name = "nss_cc_mac2_tx_clk_src",
 		.parent_data = nss_cc_uniphy1_rx_tx312p5m_data,
