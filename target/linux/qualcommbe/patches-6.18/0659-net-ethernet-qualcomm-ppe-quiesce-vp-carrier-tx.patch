From: ViKing <viking.yfy@qq.com>
Subject: [PATCH] net: ethernet: qualcomm: ppe: quiesce VP carrier TX

Publish a private-producer gate while completion NAPI is live. Close the
gate and synchronize every carrier TX queue before disabling completion.
Recheck under the TX queue lock so an earlier port selection cannot submit
after stop. Keep the original GSO skb on a concurrent-close fallback.

Do not wake stopped carrier queues from completions after netif_running
has been cleared. Preserve the existing IRQ rearm serialization and the
completion allowance for descriptors published before stop.

Signed-off-by: ViKing <viking.yfy@qq.com>
---
--- a/drivers/net/ethernet/qualcomm/ppe/edma_tx.c
+++ b/drivers/net/ethernet/qualcomm/ppe/edma_tx.c
@@ -277,6 +277,7 @@ u32 edma_tx_complete(u32 work_to_do, str
 					   edma_tx_avail_desc(txdesc_ring),
 					   EDMA_TX_TSO_SEG_MAX,
 					   edma_ctx->tx_requeue_stop ||
+					   !netif_running(txcmpl_ring->napi.dev) ||
 					   !netif_carrier_ok(txcmpl_ring->napi.dev));
 	}
 
@@ -997,9 +998,18 @@ int edma_tx_vp_inject(u32 vp_id, struct
 			rcu_read_unlock();
 			return -ENOMEM;
 		}
-		dev_kfree_skb_any(skb);
-
 		__netif_tx_lock(txq, cpu);
+		if (unlikely(!netif_running(dev) ||
+			     !READ_ONCE(port_priv->vp_tx_enabled))) {
+			__netif_tx_unlock(txq);
+			kfree_skb_list(segs);
+			rcu_read_unlock();
+			return -ENETDOWN;
+		}
+		/* Only consume the original after the carrier accepts this list.
+		 * On a concurrent close the caller retains it for software routing.
+		 */
+		dev_kfree_skb_any(skb);
 		edma_tx_xmit_segs(dev, segs, txdesc_ring, NULL, vp_id);
 		__netif_tx_unlock(txq);
 
@@ -1011,6 +1021,12 @@ int edma_tx_vp_inject(u32 vp_id, struct
 	 * exactly as the stack serialises ndo_start_xmit.
 	 */
 	__netif_tx_lock(txq, cpu);
+	if (unlikely(!netif_running(dev) ||
+		     !READ_ONCE(port_priv->vp_tx_enabled))) {
+		__netif_tx_unlock(txq);
+		rcu_read_unlock();
+		return -ENETDOWN;
+	}
 	ret = edma_tx_ring_xmit(dev, skb, txdesc_ring, NULL, vp_id);
 	__netif_tx_unlock(txq);
 
--- a/drivers/net/ethernet/qualcomm/ppe/edma_port.c
+++ b/drivers/net/ethernet/qualcomm/ppe/edma_port.c
@@ -113,7 +113,8 @@ static int edma_port_open(struct net_dev
 	edma_cfg_tx_napi_enable(port_id);
 	edma_cfg_tx_enable_interrupts(port_id);
 
-	netif_start_queue(netdev);
+	WRITE_ONCE(port_priv->vp_tx_enabled, true);
+	netif_tx_start_all_queues(netdev);
 
 	return 0;
 }
@@ -127,9 +128,15 @@ static int edma_port_close(struct net_de
 	if (!port_priv)
 		return -EINVAL;
 
-	netif_stop_queue(netdev);
-
-	/* 20ms delay would provide a plenty of margin to take care of in-flight packets. */
+	/* Close the private producer before synchronizing all carrier queues.
+	 * An injector selected before this store rechecks it under its TX lock.
+	 */
+	WRITE_ONCE(port_priv->vp_tx_enabled, false);
+	netif_tx_disable(netdev);
+
+	/* Let already-published descriptors complete with NAPI still enabled.
+	 * The producer synchronization above does not depend on this delay.
+	 */
 	msleep(20);
 
 	ppe_port  = port_priv->ppe_port;
--- a/drivers/net/ethernet/qualcomm/ppe/edma_port.h
+++ b/drivers/net/ethernet/qualcomm/ppe/edma_port.h
@@ -84,6 +84,7 @@ struct edma_port_pcpu_stats {
  * @txr_map: Tx ring per-core mapping
  * @br_offload: Port is bridged in hardware, written under RTNL and read
  * in the Rx path to mark received packets as hardware forwarded
+ * @vp_tx_enabled: Private injection may borrow the port while TX NAPI is live
  * @flags: Feature flags
  */
 /* Bridge flood bitmaps of the port for the TX forwarding offload,
@@ -102,6 +103,7 @@ struct edma_port_priv {
 	struct edma_port_pcpu_stats pcpu_stats;
 	struct edma_txdesc_ring *txr_map[EDMA_PORT_MAX_CORE];
 	bool br_offload;
+	bool vp_tx_enabled;
 	u32 br_flood[EDMA_PORT_FLOOD_MAX];
 	unsigned long flags;
 };
