From: ViKing <viking.yfy@qq.com>
Date: Sat, 29 Aug 2026 00:29:12 +0800
Subject: [PATCH] net: ethernet: qualcomm: ppe: add QCA8386 L2 statistics

Expose one read-only snapshot containing the PPE physical-port and L2 VSI
counters together with the QCA8386 DSA user-port MIB counters. This permits
comparison of switch-local L2 traffic with traffic crossing the PPE conduit
without changing the forwarding path or ATH tag configuration.

The output explicitly treats WAN-to-LAN routing as L3; switch MIB activity
alone is not evidence that an L3 flow was offloaded.

Signed-off-by: ViKing <viking.yfy@qq.com>
---
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_debugfs.c
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_debugfs.c
@@ -9,12 +9,18 @@
 #include <linux/debugfs.h>
 #include <linux/dev_printk.h>
 #include <linux/device.h>
+#include <linux/ethtool.h>
 #include <linux/netdevice.h>
 #include <linux/regmap.h>
+#include <linux/rtnetlink.h>
 #include <linux/seq_file.h>
+#include <linux/slab.h>
 #include <linux/string.h>
+#include <net/dsa.h>
+#include <net/net_namespace.h>
 
 #include "edma.h"
+#include "edma_port.h"
 #include "ppe.h"
 #include "ppe_config.h"
 #include "ppe_debugfs.h"
@@ -932,6 +938,218 @@ static const struct file_operations ppe_
 	.release = single_release,
 };
 
+static const char * const ppe_qca8386_mib_names[] = {
+	"tx_packets",
+	"tx_bytes",
+	"rx_packets",
+	"rx_bytes",
+	"RxGoodByte",
+	"TxByte",
+	"RXUnicast",
+	"TXUnicast",
+	"RxBroad",
+	"TxBroad",
+	"RxMulti",
+	"TxMulti",
+	"Filtered",
+	"RxOverFlow",
+	"RxFcsErr",
+	"RxAlignErr",
+	"TxUnderRun",
+	"TxCollision",
+};
+
+static bool ppe_qca8386_stat_get(const u8 *names, const u64 *values,
+				 int count, const char *wanted, u64 *value)
+{
+	int i;
+
+	for (i = 0; i < count; i++) {
+		const char *name = (const char *)names + i * ETH_GSTRING_LEN;
+
+		if (!strncmp(name, wanted, ETH_GSTRING_LEN)) {
+			*value = values[i];
+			return true;
+		}
+	}
+
+	return false;
+}
+
+static int ppe_qca8386_ppe_stats_show(struct seq_file *seq,
+				      struct ppe_device *ppe_dev)
+{
+	u32 rx, rx_drop, tx, tx_drop;
+	u32 rx_reg, tx_reg, tx_drop_reg;
+	int i, ret;
+
+	seq_puts(seq, "[ppe-physical-ports]\n");
+	for (i = 0; i < PPE_PHY_PORT_RX_CNT_TBL_ENTRIES; i++) {
+		rx = 0;
+		rx_drop = 0;
+		tx = 0;
+		tx_drop = 0;
+		rx_reg = PPE_PHY_PORT_RX_CNT_TBL_ADDR +
+			 PPE_PHY_PORT_RX_CNT_TBL_INC * i;
+		tx_reg = PPE_PORT_TX_COUNTER_TBL_ADDR +
+			 PPE_PORT_TX_COUNTER_TBL_INC * i;
+		tx_drop_reg = PPE_PORT_TX_DROP_CNT_TBL_ADDR +
+			      PPE_PORT_TX_DROP_CNT_TBL_INC * i;
+
+		ret = ppe_pkt_cnt_get(ppe_dev, rx_reg, PPE_PKT_CNT_SIZE_5WORD,
+				      &rx, &rx_drop);
+		if (ret)
+			return ret;
+		ret = ppe_pkt_cnt_get(ppe_dev, tx_reg, PPE_PKT_CNT_SIZE_3WORD,
+				      &tx, NULL);
+		if (ret)
+			return ret;
+		ret = ppe_pkt_cnt_get(ppe_dev, tx_drop_reg,
+				      PPE_PKT_CNT_SIZE_3WORD, &tx_drop, NULL);
+		if (ret)
+			return ret;
+
+		if (i == 1 || rx || rx_drop || tx || tx_drop)
+			seq_printf(seq,
+				   "port=%d rx_packets=%u rx_drop=%u tx_packets=%u tx_drop=%u\n",
+				   i, rx, rx_drop, tx, tx_drop);
+	}
+
+	seq_puts(seq, "[ppe-l2-vsi]\n");
+	return ppe_l2_counter_get(ppe_dev, seq);
+}
+
+static void ppe_qca8386_dsa_port_show(struct seq_file *seq,
+				      struct net_device *netdev,
+				      struct dsa_port *dp,
+				      struct net_device *conduit,
+				      int ppe_port_id)
+{
+	const struct ethtool_ops *ops = netdev->ethtool_ops;
+	struct ethtool_stats stats = { .cmd = ETHTOOL_GSTATS };
+	u64 *values;
+	u8 *names;
+	u64 value;
+	int count;
+	int i;
+
+	if (!ops || !ops->get_sset_count || !ops->get_strings ||
+	    !ops->get_ethtool_stats) {
+		seq_printf(seq, "dev=%s switch_port=%d stats=unsupported\n",
+			   netdev->name, dp->index);
+		return;
+	}
+
+	count = ops->get_sset_count(netdev, ETH_SS_STATS);
+	if (count <= 0 || count > 256) {
+		seq_printf(seq, "dev=%s switch_port=%d stats=count-error:%d\n",
+			   netdev->name, dp->index, count);
+		return;
+	}
+
+	names = kcalloc(count, ETH_GSTRING_LEN, GFP_KERNEL);
+	values = kcalloc(count, sizeof(*values), GFP_KERNEL);
+	if (!names || !values) {
+		seq_printf(seq, "dev=%s switch_port=%d stats=no-memory\n",
+			   netdev->name, dp->index);
+		goto free_stats;
+	}
+
+	stats.n_stats = count;
+	ops->get_strings(netdev, ETH_SS_STATS, names);
+	ops->get_ethtool_stats(netdev, &stats, values);
+
+	seq_printf(seq,
+		   "dev=%s switch_port=%d carrier=%u conduit=%s ppe_port=%d\n",
+		   netdev->name, dp->index, netif_carrier_ok(netdev),
+		   conduit->name, ppe_port_id);
+	for (i = 0; i < ARRAY_SIZE(ppe_qca8386_mib_names); i++) {
+		if (!ppe_qca8386_stat_get(names, values, count,
+					  ppe_qca8386_mib_names[i], &value))
+			continue;
+		seq_printf(seq, "  %s=%llu\n", ppe_qca8386_mib_names[i],
+			   (unsigned long long)value);
+	}
+
+free_stats:
+	kfree(values);
+	kfree(names);
+}
+
+static void ppe_qca8386_dsa_stats_show(struct seq_file *seq,
+				       struct ppe_device *ppe_dev)
+{
+	struct edma_port_priv *conduit_priv;
+	struct net_device *netdev;
+	bool found = false;
+
+	seq_puts(seq, "[qca8386-dsa-port-mib]\n");
+	rtnl_lock();
+	for_each_netdev(&init_net, netdev) {
+		struct net_device *conduit;
+		struct dsa_port *dp;
+
+		if (!dsa_user_dev_check(netdev))
+			continue;
+
+		dp = dsa_port_from_netdev(netdev);
+		if (IS_ERR(dp) || !dp->cpu_dp || !dp->cpu_dp->tag_ops ||
+		    dp->cpu_dp->tag_ops->proto != DSA_TAG_PROTO_QCA_4B)
+			continue;
+
+		conduit = dsa_port_to_conduit(dp);
+		if (!conduit || !edma_port_dev_check(conduit))
+			continue;
+
+		conduit_priv = netdev_priv(conduit);
+		if (!conduit_priv->ppe_port ||
+		    conduit_priv->ppe_port->ppe_dev != ppe_dev)
+			continue;
+
+		found = true;
+		ppe_qca8386_dsa_port_show(seq, netdev, dp, conduit,
+					  conduit_priv->ppe_port->port_id);
+	}
+	rtnl_unlock();
+
+	if (!found)
+		seq_puts(seq, "no-qca4b-dsa-user-ports\n");
+}
+
+static int ppe_qca8386_l2_stats_show(struct seq_file *seq, void *data)
+{
+	struct ppe_device *ppe_dev = seq->private;
+	int ret;
+
+	if (!ppe_athtag_supported(ppe_dev))
+		return -EOPNOTSUPP;
+
+	seq_puts(seq, "scope=ppe-and-qca8386-switch-counters\n");
+	seq_puts(seq, "counter_mode=absolute\n");
+	seq_puts(seq, "l3_flow_counter=/sys/kernel/debug/ppe/active_flows\n");
+	seq_puts(seq, "note=wan-lan-routing-is-l3-switch-mib-is-not-l3-offload-proof\n");
+
+	ret = ppe_qca8386_ppe_stats_show(seq, ppe_dev);
+	if (ret)
+		return ret;
+	ppe_qca8386_dsa_stats_show(seq, ppe_dev);
+
+	return 0;
+}
+
+static int ppe_qca8386_l2_stats_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, ppe_qca8386_l2_stats_show, inode->i_private);
+}
+
+static const struct file_operations ppe_qca8386_l2_stats_fops = {
+	.owner = THIS_MODULE,
+	.open = ppe_qca8386_l2_stats_open,
+	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+
 void ppe_debugfs_setup(struct ppe_device *ppe_dev)
 {
 	struct ppe_debugfs_entry *entry;
@@ -963,6 +1181,10 @@ void ppe_debugfs_setup(struct ppe_device
 		debugfs_create_file("qca8386_athtag", 0400,
 				    ppe_dev->debugfs_root, ppe_dev,
 				    &ppe_athtag_fops);
+	if (ppe_athtag_supported(ppe_dev))
+		debugfs_create_file("qca8386_l2_stats", 0400,
+				    ppe_dev->debugfs_root, ppe_dev,
+				    &ppe_qca8386_l2_stats_fops);
 
 	/* TODO: Do we have to be so agressive and remove __all__ debugfs entries? */
 	ret = edma_debugfs_setup(ppe_dev);
