From: Akshay Kakatkar <me@kakatkarakshay.dev>
Date: Sat, 1 Aug 2026 04:30:00 +0530
Subject: [PATCH] net: ethernet: qualcomm: ppe: program the flow path MTU

APPE and MPPE extend the 5-tuple flow entries with a per-flow path MTU,
a check-type selector and a VPN id. The driver never writes them, so
every installed flow carries a path MTU of zero. The check type only
selects whether the length is compared at L2 or L3, it does not disable
the comparison, so every packet exceeds the path MTU of its own flow. A
flow failing that check is de-accelerated and falls through to the route
lookup, which holds no entry and reports L3 no-route to the CPU. No flow
ever accelerates a packet, while its counters and the flow-miss CPU code
both stay at zero.

Store the egress path MTU with the flow and program it for both address
families. Both 5-tuple tables split the field into eleven low bits and
three high bits, but place it at different offsets: IPv4 keeps it after
the L4 ports in words four and five, while IPv6 keeps it below its wide
address in words two and three.

Link: https://github.com/everything411/qsdk/blob/4d49909b60dd04642026da43018d26c813e079b5/qca/src/qca-ssdk/include/hsl/hppe/hppe_flow_reg.h
Link: https://github.com/everything411/qsdk/blob/4d49909b60dd04642026da43018d26c813e079b5/qca/src/qca-ssdk/src/adpt/hppe/adpt_hppe_flow.c
Link: https://github.com/everything411/qsdk/blob/4d49909b60dd04642026da43018d26c813e079b5/qca/src/qca-nss-ppe/drv/ppe_drv/ppe_drv_flow.c
Signed-off-by: Akshay Kakatkar <me@kakatkarakshay.dev>
---
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_regs.h
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_regs.h
@@ -693,6 +693,16 @@
 #define PPE_FLOW_W3_L4_DPORT_LO			GENMASK(31, 28)
 #define PPE_FLOW_W4_L4_DPORT_HI			GENMASK(11, 0)
 
+/* The per-flow path MTU is 14 bits, split into an 11-bit low half and
+ * a 3-bit high half. The check-type bit compares the L3 length.
+ */
+#define PPE_FLOW_PMTU_LO_BITS			11
+#define PPE_FLOW_PMTU_MAX			GENMASK(13, 0)
+#define PPE_FLOW_W4_VPN_ID			GENMASK(19, 12)
+#define PPE_FLOW_W4_PMTU_CHECK_L3		BIT(20)
+#define PPE_FLOW_W4_PMTU_LO			GENMASK(31, 21)
+#define PPE_FLOW_W5_PMTU_HI			GENMASK(2, 0)
+
 /* An IPv6 flow entry (entry type 1) spans two flow table entries: 9
  * words. Words 0 and 1 match the IPv4 layout and the L4 ports sit at
  * the IPv4 positions of words 3 and 4; the 128-bit address is stored
@@ -700,6 +710,10 @@
  */
 #define PPE_FLOW_V6_W4_IP_ADDR_0		GENMASK(31, 12)
 #define PPE_FLOW_V6_W8_IP_ADDR_4		GENMASK(11, 0)
+#define PPE_FLOW_V6_W2_VPN_ID			GENMASK(19, 12)
+#define PPE_FLOW_V6_W2_PMTU_CHECK_L3		BIT(20)
+#define PPE_FLOW_V6_W2_PMTU_LO			GENMASK(31, 21)
+#define PPE_FLOW_V6_W3_PMTU_HI			GENMASK(2, 0)
 
 #define PPE_FLOW_FWD_TYPE_FORWARD		0
 #define PPE_FLOW_FWD_TYPE_SNAT			1
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flow.h
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flow.h
@@ -50,6 +50,7 @@ struct ppe_flow_nexthop {
  * @host_index: Source host-table index returned by hardware.
  * @nat_port: Translated source port of SNAT flows, translated
  * destination port of DNAT flows.
+ * @pmtu: Path MTU of the egress device of the flow.
  */
 struct ppe_flow_entry {
 	union {
@@ -64,6 +65,7 @@ struct ppe_flow_entry {
 	u16 nexthop;
 	u16 host_index;
 	__be16 nat_port;
+	u16 pmtu;
 };
 
 int ppe_flow_hw_init(struct ppe_device *ppe_dev);
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flow.c
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flow.c
@@ -135,6 +135,7 @@ static void ppe_host_entry_pack(const st
 static void ppe_flow_entry_pack(const struct ppe_flow_entry *flow, u32 *val)
 {
 	u16 dport = be16_to_cpu(flow->dport);
+	u32 pmtu, pmtu_lo, pmtu_hi;
 
 	/* Match QWRT: index the source host, keep the destination inline,
 	 * add disabled, then enable after every dependency exists.
@@ -170,6 +171,19 @@ static void ppe_flow_entry_pack(const st
 				    ip & GENMASK(19, 0));
 		val[3] |= FIELD_PREP(PPE_FLOW_W3_IP_ADDR_HI, ip >> 20);
 	}
+
+	pmtu = min_t(u32, flow->pmtu, PPE_FLOW_PMTU_MAX);
+	pmtu_lo = pmtu & GENMASK(PPE_FLOW_PMTU_LO_BITS - 1, 0);
+	pmtu_hi = pmtu >> PPE_FLOW_PMTU_LO_BITS;
+	if (flow->is_ipv6) {
+		val[2] |= PPE_FLOW_V6_W2_PMTU_CHECK_L3;
+		val[2] |= FIELD_PREP(PPE_FLOW_V6_W2_PMTU_LO, pmtu_lo);
+		val[3] |= FIELD_PREP(PPE_FLOW_V6_W3_PMTU_HI, pmtu_hi);
+	} else {
+		val[4] |= PPE_FLOW_W4_PMTU_CHECK_L3;
+		val[4] |= FIELD_PREP(PPE_FLOW_W4_PMTU_LO, pmtu_lo);
+		val[5] |= FIELD_PREP(PPE_FLOW_W5_PMTU_HI, pmtu_hi);
+	}
 }
 
 int ppe_host_entry_add(struct ppe_device *ppe_dev,
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flowtable.c
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flowtable.c
@@ -2195,6 +2195,8 @@ static int ppe_ft_flow_replace(struct pp
 		goto err_tdev;
 	}
 
+	flow->entry.pmtu = odev->mtu;
+
 	/* The PPPoE L3 interface carries the session ID, so it needs
 	 * the source MAC rewrite of the rule to be complete.
 	 */
