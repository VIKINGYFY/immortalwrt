+/* Match QSDK hppe_reg_tbl_set(): all defined words in ascending address
+ * order. Bulk MMIO is still a sequence of word writes, not an atomic bus
+ * transaction. Verify the row before publishing ownership or freeing the
+ * dependencies of a withdrawn key. These tables are safe to read and are
+ * already exposed by flow_rows; no packet or counter table is touched here.
+ */
+static int ppe_xlt_write_verify(struct ppe_device *ppe_dev, u32 reg,
+				const u32 *value, size_t count)
+{
+	static struct ratelimit_state rate =
+		RATELIMIT_STATE_INIT_FLAGS(rate, 60 * HZ, 4,
+					   RATELIMIT_MSG_ON_RELEASE);
+	u32 readback[4] = {}, expected[4] = {};
+	int ret, write_err, read_err = -ENODATA;
+
+	if (!count || count > ARRAY_SIZE(readback))
+		return -EINVAL;
+	memcpy(expected, value, count * sizeof(*value));
+	write_err = regmap_bulk_write(ppe_dev->regmap, reg, value, count);
+	ret = write_err;
+	if (!ret) {
+		read_err = regmap_bulk_read(ppe_dev->regmap, reg, readback, count);
+		ret = read_err;
+		if (!ret && memcmp(expected, readback, count * sizeof(*value)))
+			ret = -EIO;
+	}
+	if (ret && __ratelimit(&rate))
+		dev_warn(ppe_dev->dev,
+			 "XLT verify failed: reg=%#x words=%zu write=%d read=%d err=%d expected=%08x/%08x/%08x/%08x actual=%08x/%08x/%08x/%08x\n",
+			 reg, count, write_err, read_err, ret,
+			 expected[0], expected[1], expected[2], expected[3],
+			 readback[0], readback[1], readback[2], readback[3]);
+
+	return ret;
+}
