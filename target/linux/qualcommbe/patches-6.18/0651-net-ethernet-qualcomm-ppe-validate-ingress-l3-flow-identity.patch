From: ViKing <viking.yfy@qq.com>
Subject: [PATCH] net: qualcomm: ppe: validate ingress L3 flow identity

Bind routed IPv4 and IPv6 entries to the L3 interface selected by their
physical port, VLAN slot, PPPoE session or ingress VP. Hold the input PPPoE
session independently of its reverse flow. Narrow its physical port mask
and expose the expected identity beside the existing hardware readback.

Tunnel decapsulation retains its existing tunnel-key admission. Its tunnel
interface namespace is not a plain routed source L3 interface.

Signed-off-by: ViKing <viking.yfy@qq.com>
---
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flow.c
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flow.c
@@ -182,6 +182,10 @@
 	val[0] |= FIELD_PREP(PPE_FLOW_W0_HOST_INDEX, flow->host_index);
 	val[0] |= FIELD_PREP(PPE_FLOW_W0_PROTOCOL_TYPE, flow->proto);
 	val[0] |= FIELD_PREP(PPE_FLOW_W0_AGE, 3);
+	if (flow->src_l3_if_valid) {
+		val[0] |= PPE_FLOW_W0_SRC_L3_IF_VALID;
+		val[0] |= FIELD_PREP(PPE_FLOW_W0_SRC_L3_IF, flow->src_l3_if);
+	}
 	val[0] |= FIELD_PREP(PPE_FLOW_W0_FWD_TYPE, flow->fwd_type);
 	val[1] = FIELD_PREP(PPE_FLOW_W1_NEXT_HOP, flow->nexthop);
 	val[1] |= FIELD_PREP(PPE_FLOW_W1_L4_PORT,
@@ -603,15 +607,16 @@
  * @sid: PPPoE session ID
  * @peer: PPPoE peer/server MAC address
  * @l3_if: L3 interface assigned to the terminated packets
+ * @port: Physical ingress port below the session
  *
- * Match the session on every PPE ingress port by SID and peer MAC, as
- * the vendor interface-lifecycle transaction does. Both unicast and
- * multicast session traffic resolves to the PPPoE L3 interface.
+ * Match SID and peer only on the port owned by this session. Both unicast
+ * and multicast session traffic resolves to the PPPoE L3 interface.
  *
  * Return: 0 on success, negative error code on failure.
  */
 int ppe_pppoe_session_set(struct ppe_device *ppe_dev, int index,
-			  bool enable, u16 sid, const u8 *peer, int l3_if)
+			  bool enable, u16 sid, const u8 *peer, int l3_if,
+			  int port)
 {
 	u32 ext2_mask = PPE_PPPOE_SESSION_EXT2_L3_IF_VALID |
 			PPE_PPPOE_SESSION_EXT2_L3_IF;
@@ -621,6 +626,9 @@
 
 	if (index >= ppe_dev->variant->num_pppoe_sessions)
 		return -EINVAL;
+	if (enable && (port < 0 || port >= ppe_dev->num_ports ||
+		       !(BIT(port) & FIELD_MAX(PPE_PPPOE_SESSION_PORT_BITMAP))))
+		return -EINVAL;
 
 	base_reg = PPE_PPPOE_SESSION_ADDR + PPE_PPPOE_SESSION_INC * index;
 	ext_reg = PPE_PPPOE_SESSION_EXT_ADDR +
@@ -647,8 +655,7 @@
 	}
 
 	val = FIELD_PREP(PPE_PPPOE_SESSION_SESSION_ID, sid) |
-	      FIELD_PREP(PPE_PPPOE_SESSION_PORT_BITMAP,
-			 FIELD_MAX(PPE_PPPOE_SESSION_PORT_BITMAP));
+	      FIELD_PREP(PPE_PPPOE_SESSION_PORT_BITMAP, BIT(port));
 	ext = PPE_PPPOE_SESSION_EXT_MC_VALID |
 	      PPE_PPPOE_SESSION_EXT_UC_VALID |
 	      PPE_PPPOE_SESSION_EXT_SMAC_VALID |
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flow.h
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flow.h
@@ -55,6 +55,8 @@
  * @pmtu: Path MTU of the egress device of the flow.
  * @priority: Internal priority selected by the flow QoS result.
  * @priority_valid: Whether the rule carries an explicit priority action.
+ * @src_l3_if: Ingress routing interface selected by port, VLAN, PPPoE or VP.
+ * @src_l3_if_valid: Restrict hits to that ingress routing interface.
  */
 struct ppe_flow_entry {
 	union {
@@ -72,6 +74,8 @@
 	u16 pmtu;
 	u8 priority;
 	bool priority_valid;
+	u8 src_l3_if;
+	bool src_l3_if_valid;
 };
 
 int ppe_flow_hw_init(struct ppe_device *ppe_dev);
@@ -85,7 +89,8 @@
 int ppe_vsi_l3_if_set(struct ppe_device *ppe_dev, int vsi, int l3_if);
 int ppe_port_l3_if_set(struct ppe_device *ppe_dev, int port, int l3_if);
 int ppe_pppoe_session_set(struct ppe_device *ppe_dev, int index,
-			  bool enable, u16 sid, const u8 *peer, int l3_if);
+			  bool enable, u16 sid, const u8 *peer, int l3_if,
+			  int port);
 int ppe_pub_ip_set(struct ppe_device *ppe_dev, int index, __be32 addr);
 int ppe_nexthop_set(struct ppe_device *ppe_dev, int index,
 		    const struct ppe_flow_nexthop *nh);
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flowtable.c
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flowtable.c
@@ -24,6 +24,7 @@
 #include <linux/ip.h>
 #include <linux/netdevice.h>
 #include <linux/ppp_channel.h>
+#include <linux/ppp_defs.h>
 #include <linux/rcupdate.h>
 #include <linux/regmap.h>
 #include <linux/rhashtable.h>
@@ -189,6 +190,7 @@
  * @my_mac: Router MAC slot held by the flow, negative when none.
  * @pub_ip: Public IP slot held by the flow, negative when none.
  * @pppoe: PPPoE session slot held by the flow, negative when none.
+ * @ingress_pppoe: Independently held PPPoE ingress session.
  * @vlan: VLAN uplink slot held by the flow, negative when none.
  * @core_egress_port: Core-role egress port held by an RTL DSA flow.
  * @eport: Egress PPE port of the flow.
@@ -209,6 +211,7 @@
 	int my_mac;
 	int pub_ip;
 	int pppoe;
+	int ingress_pppoe;
 	int vlan;
 	int core_egress_port;
 	int tunnel;
@@ -272,6 +275,7 @@
 	PPE_FT_REJECT_EGRESS_VP,
 	PPE_FT_REJECT_NAT,
 	PPE_FT_REJECT_PPPOE,
+	PPE_FT_REJECT_INGRESS_L3,
 	PPE_FT_REJECT_RESOURCE,
 	PPE_FT_REJECT_MAX,
 };
@@ -286,6 +290,7 @@
 	[PPE_FT_REJECT_EGRESS_VP] = "output_vp",
 	[PPE_FT_REJECT_NAT] = "nat",
 	[PPE_FT_REJECT_PPPOE] = "pppoe",
+	[PPE_FT_REJECT_INGRESS_L3] = "input_l3",
 	[PPE_FT_REJECT_RESOURCE] = "resource",
 };
 
@@ -404,6 +409,7 @@
 	__be16 sport;
 	__be16 dport;
 	int pppoe_sid;
+	int ingress_pppoe_sid;
 	int ingress_svid;
 	int ingress_vid;
 	unsigned int ingress_tags;
@@ -926,7 +932,7 @@
 	session_touched = true;
 	ret = ppe_pppoe_session_set(ft->ppe_dev, index, true,
 				    session->sid, session->peer,
-				    ppe_ft_pppoe_l3_if(ft, index));
+				    ppe_ft_pppoe_l3_if(ft, index), session->port);
 	if (ret)
 		goto err_cleanup;
 
@@ -943,7 +949,7 @@
 err_cleanup:
 	if (session_touched) {
 		cleanup_ret = ppe_pppoe_session_set(ft->ppe_dev, index,
-						    false, 0, NULL, 0);
+						    false, 0, NULL, 0, 0);
 		if (cleanup_ret)
 			cleanup_err = cleanup_ret;
 	}
@@ -1039,7 +1045,7 @@
 	WARN_ON_ONCE(session->connected);
 	if (session->hw_active) {
 		ret = ppe_pppoe_session_set(ft->ppe_dev, index, false,
-					    0, NULL, 0);
+					    0, NULL, 0, 0);
 		cleanup_ret = ppe_l3_if_clear(ft->ppe_dev,
 					      ppe_ft_pppoe_l3_if(ft, index));
 		if (!ret)
@@ -1159,7 +1165,7 @@
 		ret = 0;
 		if (session->hw_active) {
 			ret = ppe_pppoe_session_set(ft->ppe_dev, i, false,
-						    0, NULL, 0);
+						    0, NULL, 0, 0);
 			cleanup_ret = ppe_l3_if_clear(ft->ppe_dev,
 						      ppe_ft_pppoe_l3_if(ft, i));
 			if (!ret)
@@ -2239,6 +2245,7 @@
 	ppe_ft_my_mac_put(ft, flow->my_mac);
 	ppe_ft_my_mac_put(ft, flow->ingress_my_mac);
 	ppe_ft_pppoe_put(ft, flow->pppoe);
+	ppe_ft_pppoe_put(ft, flow->ingress_pppoe);
 	ppe_ft_vlan_put(ft, flow->vlan);
 	ppe_ft_core_port_put(ft, flow->core_egress_port, false);
 	ppe_ft_pub_ip_put(ft, flow->pub_ip);
@@ -2457,6 +2464,7 @@
 	      BIT_ULL(FLOW_DISSECTOR_KEY_PORTS) |
 	      BIT_ULL(FLOW_DISSECTOR_KEY_VLAN) |
 	      BIT_ULL(FLOW_DISSECTOR_KEY_CVLAN) |
+	      BIT_ULL(FLOW_DISSECTOR_KEY_PPPOE) |
 	      PPE_FT_TUNNEL_KEYS))
 		return -EOPNOTSUPP;
 
@@ -2471,6 +2479,7 @@
 	flow->my_mac = -1;
 	flow->pub_ip = -1;
 	flow->pppoe = -1;
+	flow->ingress_pppoe = -1;
 	flow->vlan = -1;
 	flow->core_egress_port = -1;
 	flow->tunnel = -1;
@@ -2479,6 +2488,7 @@
 	nh.svid = -1;
 	nh.cvid = -1;
 	data.pppoe_sid = -1;
+	data.ingress_pppoe_sid = -1;
 	data.ingress_svid = -1;
 	data.ingress_vid = -1;
 	data.ingress_dsa = false;
@@ -2601,6 +2611,22 @@
 		}
 	}
 
+	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_PPPOE)) {
+		struct flow_match_pppoe match;
+
+		flow_rule_match_pppoe(rule, &match);
+		if (match.mask->session_id != htons(0xffff) ||
+		    match.mask->type != htons(0xffff) ||
+		    match.mask->ppp_proto != htons(0xffff) ||
+		    match.key->type != htons(ETH_P_PPP_SES) ||
+		    match.key->ppp_proto != htons(flow->entry.is_ipv6 ?
+						 PPP_IPV6 : PPP_IP)) {
+			ret = -EOPNOTSUPP;
+			goto err_free;
+		}
+		data.ingress_pppoe_sid = ntohs(match.key->session_id);
+	}
+
 	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_META)) {
 		struct flow_match_meta match;
 
@@ -3174,6 +3200,73 @@
 		}
 	}
 
+	/* Pin the input interface independently of the output rule. PPPoE
+	 * lookup overrides the VLAN/port L3 binding; a VP owns its own binding.
+	 */
+	reject_reason = PPE_FT_REJECT_INGRESS_L3;
+	if (!tunnel_flow || tunnel_encap) {
+		int src_l3_if = flow->ivp >= 0 ?
+			ppe_ft_vp_l3_if(ft, flow->ivp) : iport;
+
+		if (flow->vlan >= 0)
+			src_l3_if = ppe_ft_vlan_l3_if(ft, flow->vlan);
+		if (data.ingress_pppoe_sid >= 0) {
+			int physical = flow->ivp >= 0 ?
+				ppe_vp_physical_port(ft->ppe_dev, flow->ivp) : iport;
+			int session_index = -1;
+
+			for (i = 0; i < PPE_FT_PPPOE_SESSIONS; i++) {
+				struct ppe_ft_pppoe *session = &ft->pppoe[i];
+
+				if (!session->connected || session->poisoned ||
+				    session->sid != data.ingress_pppoe_sid ||
+				    session->port != physical ||
+				    session->svid != data.ingress_svid ||
+				    session->cvid != data.ingress_vid)
+					continue;
+				if (session_index >= 0) {
+					ret = -EOPNOTSUPP;
+					goto err_vlan;
+				}
+				session_index = i;
+			}
+			if (session_index < 0) {
+				ret = -ENOTCONN;
+				goto err_vlan;
+			}
+			ret = ppe_ft_pppoe_activate(ft, session_index);
+			if (ret)
+				goto err_vlan;
+			ft->pppoe[session_index].ref.refcnt++;
+			flow->ingress_pppoe = session_index;
+			src_l3_if = ppe_ft_pppoe_l3_if(ft, session_index);
+		}
+		if (src_l3_if < 0 || src_l3_if >= PPE_IN_L3_IF_TBL_ENTRIES) {
+			ret = -EOPNOTSUPP;
+			goto err_vlan;
+		}
+		flow->entry.src_l3_if = src_l3_if;
+		flow->entry.src_l3_if_valid = true;
+
+		/* Bind the MAC to the selected interface even when an ingress VP
+		 * already holds it. PPPoE can override that VP's L3 interface.
+		 */
+		if (is_valid_ether_addr(data.eth.ingress)) {
+			if (flow->ingress_my_mac < 0) {
+				flow->ingress_my_mac =
+					ppe_ft_my_mac_get(ft, data.eth.ingress);
+				if (flow->ingress_my_mac < 0) {
+					ret = flow->ingress_my_mac;
+					goto err_vlan;
+				}
+			}
+			ret = ppe_l3_if_my_mac_set(ft->ppe_dev, src_l3_if,
+						   flow->ingress_my_mac, true);
+			if (ret)
+				goto err_vlan;
+		}
+	}
+
 	/* A PPPoE push routes the flow through the L3 interface of its
 	 * session, which encapsulates on egress; the session table
 	 * entry of the slot terminates the reverse direction, whose
@@ -3357,6 +3450,7 @@
 err_pppoe:
 	ppe_ft_pppoe_put(ft, flow->pppoe);
 err_vlan:
+	ppe_ft_pppoe_put(ft, flow->ingress_pppoe);
 	ppe_ft_vlan_put(ft, flow->vlan);
 err_ingress_my_mac:
 	ppe_ft_my_mac_put(ft, flow->ingress_my_mac);
@@ -4105,6 +4199,9 @@
 			   flow->nexthop,
 			   flow->my_mac, flow->pub_ip, packets,
 			   (unsigned long long)bytes);
+		seq_printf(seq, "  input_l3 expected:%u valid:%u pppoe_slot:%d\n",
+			   flow->entry.src_l3_if, flow->entry.src_l3_if_valid,
+			   flow->ingress_pppoe);
 		ppe_ft_debug_words(seq, "flow_raw", f, flow_words);
 		seq_printf(seq,
 			   "  flow_dec read:%d qos_read:%d valid:%u type:%u host_dst:%u host:%u proto:%lu age:%lu src_l3_valid:%u src_l3:%lu fwd:%lu nexthop:%u nat_l4:%lu profile:%u service:%lu",
@@ -4592,7 +4689,7 @@
 		if (!ft->pppoe[i].ref.refcnt)
 			continue;
 		if (ft->pppoe[i].hw_active) {
-			ppe_pppoe_session_set(ft->ppe_dev, i, false, 0, NULL, 0);
+			ppe_pppoe_session_set(ft->ppe_dev, i, false, 0, NULL, 0, 0);
 			ppe_l3_if_clear(ft->ppe_dev,
 					ppe_ft_pppoe_l3_if(ft, i));
 		}
