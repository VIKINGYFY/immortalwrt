+/* Keep source-check failures attributable without logging every punt. The
+ * validity flag belongs to the primary descriptor; the code and flow index
+ * belong to the coherent secondary ring, as in QSDK EDMA v2.
+ */
+static void edma_rx_ingress_check_debug(struct edma_rxdesc_ring *ring,
+					struct edma_rxdesc_pri *desc)
+{
+	static struct ratelimit_state rate =
+		RATELIMIT_STATE_INIT_FLAGS(rate, 60 * HZ, 1,
+					   RATELIMIT_MSG_ON_RELEASE);
+	static atomic_t pending = ATOMIC_INIT(0);
+	struct edma_rxdesc_sec *sec;
+	u32 flags, flow, code, src, dst;
+	unsigned int index;
+
+	flags = le32_to_cpu((__force __le32)desc->word1);
+	if (!(flags & EDMA_RXDESC_CPU_CODE_VALID))
+		return;
+	index = desc - (struct edma_rxdesc_pri *)ring->pdesc;
+	sec = EDMA_RXDESC_SEC_DESC(ring, index);
+	code = FIELD_GET(EDMA_RXSDESC_CPU_CODE,
+			 le32_to_cpu((__force __le32)sec->word5));
+	if (code != 89)
+		return;
+	atomic_inc(&pending);
+	if (!__ratelimit(&rate))
+		return;
+	flow = le32_to_cpu((__force __le32)sec->word3);
+	src = EDMA_RXDESC_SRC_INFO_GET(desc);
+	dst = EDMA_RXDESC_DST_INFO_GET(desc);
+	dev_warn(edma_ctx->ppe_dev->dev,
+		 "ingress check punt: code=%u interval-packets=%u src=%04x dst=%04x flow=%lu valid=%u vlan=%08x/%08x offsets=%08x/%08x\n",
+		 code, (u32)atomic_xchg(&pending, 0), src, dst,
+		 FIELD_GET(EDMA_RXSDESC_FLOW_INDEX, flow),
+		 !!(flow & EDMA_RXSDESC_FLOW_VALID),
+		 le32_to_cpu((__force __le32)sec->word6),
+		 le32_to_cpu((__force __le32)sec->word7),
+		 le32_to_cpu((__force __le32)desc->word7),
+		 le32_to_cpu((__force __le32)sec->word4));
+}
