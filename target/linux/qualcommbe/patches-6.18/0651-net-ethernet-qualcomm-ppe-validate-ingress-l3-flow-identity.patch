+/* Bounded, on-demand XLT hit evidence; no per-packet logging or writes. */
+static void ppe_ft_xlt_count_show(struct seq_file *seq,
+				  struct ppe_flowtable *ft, int index)
+{
+	u32 rule[4] = {}, action[3] = {}, count[3] = {};
+	u32 eg_rule[2] = {}, eg_action[3] = {};
+	int rule_err, action_err, count_err;
+	int eg_rule_err, eg_action_err;
+	u32 reg, counter_id;
+	u64 bytes;
+
+	reg = PPE_XLT_RULE_TBL_ADDR + PPE_XLT_RULE_TBL_INC * index;
+	rule_err = regmap_bulk_read(ft->ppe_dev->regmap, reg, rule,
+				    ARRAY_SIZE(rule));
+	reg = PPE_XLT_ACTION_TBL_ADDR + PPE_XLT_ACTION_TBL_INC * index;
+	action_err = regmap_bulk_read(ft->ppe_dev->regmap, reg, action,
+				      ARRAY_SIZE(action));
+	reg = PPE_XLT_CNT_TBL_ADDR + PPE_XLT_CNT_TBL_INC * index;
+	count_err = regmap_bulk_read(ft->ppe_dev->regmap, reg, count,
+				     ARRAY_SIZE(count));
+	counter_id = FIELD_GET(PPE_XLT_ACTION_W1_CNT_ID_LO, action[1]) |
+		     FIELD_GET(PPE_XLT_ACTION_W2_CNT_ID_HI, action[2]) << 3;
+	bytes = count[1] | (u64)FIELD_GET(PPE_XLT_CNT_W2_BYTES_HI, count[2]) << 32;
+	seq_printf(seq,
+		   " xlt:%d read:%d/%d/%d valid:%u counter_en:%u counter_id:%u vsi:%lu strip:%lu/%lu packets:%u bytes:%llu\n",
+		   index, rule_err, action_err, count_err,
+		   !!(rule[0] & PPE_XLT_RULE_W0_VALID),
+		   !!(action[1] & PPE_XLT_ACTION_W1_CNT_EN), counter_id,
+		   FIELD_GET(PPE_XLT_ACTION_W1_VSI, action[1]),
+		   FIELD_GET(PPE_XLT_ACTION_W0_XLT_SVID_CMD, action[0]),
+		   FIELD_GET(PPE_XLT_ACTION_W0_XLT_CVID_CMD, action[0]),
+		   count[0], (unsigned long long)bytes);
+	ppe_ft_debug_words(seq, "  ingress_rule", rule, ARRAY_SIZE(rule));
+	ppe_ft_debug_words(seq, "  ingress_action", action, ARRAY_SIZE(action));
+	reg = PPE_EG_XLT_RULE_TBL_ADDR + PPE_EG_XLT_RULE_TBL_INC * index;
+	eg_rule_err = regmap_bulk_read(ft->ppe_dev->regmap, reg, eg_rule,
+				       ARRAY_SIZE(eg_rule));
+	reg = PPE_EG_XLT_ACTION_TBL_ADDR + PPE_EG_XLT_ACTION_TBL_INC * index;
+	eg_action_err = regmap_bulk_read(ft->ppe_dev->regmap, reg, eg_action,
+					 ARRAY_SIZE(eg_action));
+	seq_printf(seq, "  egress xlt:%d read:%d/%d valid:%u ports:%#lx vsi:%lu\n",
+		   index, eg_rule_err, eg_action_err,
+		   !!(eg_rule[0] & PPE_EG_XLT_RULE_W0_VALID),
+		   FIELD_GET(PPE_EG_XLT_RULE_W0_PORT_BITMAP, eg_rule[0]),
+		   FIELD_GET(PPE_EG_XLT_RULE_W0_VSI, eg_rule[0]));
+	ppe_ft_debug_words(seq, "  egress_rule", eg_rule, ARRAY_SIZE(eg_rule));
+	ppe_ft_debug_words(seq, "  egress_action", eg_action, ARRAY_SIZE(eg_action));
+}
+
+static void ppe_ft_l3_counter_show(struct seq_file *seq,
+				   struct ppe_flowtable *ft, int l3_if)
+{
+	u32 row[5] = {}, reg, drop_packets;
+	u64 bytes, drop_bytes;
+	int ret;
+
+	reg = PPE_RT_IF_CNT_TBL_ADDR + PPE_RT_IF_CNT_TBL_INC * l3_if;
+	ret = regmap_bulk_read(ft->ppe_dev->regmap, reg, row, ARRAY_SIZE(row));
+	if (ret) {
+		seq_printf(seq, "l3_counter index:%d read:%d\n", l3_if, ret);
+		return;
+	}
+	bytes = row[1] |
+		(u64)FIELD_GET(PPE_RT_IF_CNT_W2_BYTES_HI, row[2]) << 32;
+	drop_packets = FIELD_GET(PPE_RT_IF_CNT_W2_DROP_PACKETS_LO, row[2]) |
+		FIELD_GET(PPE_RT_IF_CNT_W3_DROP_PACKETS_HI, row[3]) << 24;
+	drop_bytes = FIELD_GET(PPE_RT_IF_CNT_W3_DROP_BYTES_LO, row[3]) |
+		(u64)FIELD_GET(PPE_RT_IF_CNT_W4_DROP_BYTES_HI, row[4]) << 24;
+	seq_printf(seq,
+		   "l3_counter index:%d read:0 packets:%u bytes:%llu drop_packets:%u drop_bytes:%llu\n",
+		   l3_if, row[0], bytes, drop_packets, drop_bytes);
+}
+
+static int ppe_ft_vlan_ingress_show(struct seq_file *seq, void *data)
+{
+	struct ppe_flowtable *ft = seq->private;
+	int i;
+
+	mutex_lock(&ft->lock);
+	for (i = 0; i < PPE_L3_VLAN_UPLINKS; i++) {
+		const struct ppe_ft_vlan *vlan = &ft->vlans[i];
+
+		if (!vlan->ref.refcnt)
+			continue;
+		seq_printf(seq,
+			   "vlan index:%d port:%u svid:%d cvid:%d ref:%u poisoned:%u l3:%d",
+			   i, vlan->port, vlan->svid, vlan->cvid,
+			   vlan->ref.refcnt, vlan->poisoned,
+			   ppe_ft_vlan_l3_if(ft, i));
+		ppe_ft_xlt_count_show(seq, ft, ppe_ft_vlan_xlt(i));
+		ppe_ft_l3_counter_show(seq, ft, ppe_ft_vlan_l3_if(ft, i));
+	}
+	for (i = 1; i < ft->ppe_dev->num_ports; i++) {
+		const struct ppe_ft_vlan_port *port = &ft->vlan_ports[i];
+
+		if (!port->refs || port->saved_l3 < 0)
+			continue;
+		seq_printf(seq, "fallback port:%d ref:%u poisoned:%u l3:%d",
+			   i, port->refs, port->poisoned, port->saved_l3);
+		ppe_ft_xlt_count_show(seq, ft, ppe_ft_vlan_port_xlt(i));
+		ppe_ft_l3_counter_show(seq, ft, port->saved_l3);
+	}
+	for (i = 0; i < PPE_FT_PPPOE_SESSIONS; i++)
+		if (ft->pppoe[i].hw_active)
+			ppe_ft_l3_counter_show(seq, ft, ppe_ft_pppoe_l3_if(ft, i));
+	mutex_unlock(&ft->lock);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(ppe_ft_vlan_ingress);
