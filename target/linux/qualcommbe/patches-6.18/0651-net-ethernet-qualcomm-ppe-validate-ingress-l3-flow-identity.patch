+			   vsi, vsi_err, !!(vsi_row & PPE_L3_VSI_L3_IF_VALID),
+			   FIELD_GET(PPE_L3_VSI_L3_IF_INDEX, vsi_row), vsi_row);
+		reg = PPE_IN_L3_IF_TBL_ADDR + PPE_IN_L3_IF_TBL_INC * vlan_l3;
+		l3_err = regmap_bulk_read(ft->ppe_dev->regmap, reg, l3,
+					  ARRAY_SIZE(l3));
+		seq_printf(seq,
+			   "  input_vlan_l3 index:%d read:%d bitmap:%02lx v4_route:%u v6_route:%u pppoe:%u raw:%08x/%08x/%08x\n",
+			   vlan_l3, l3_err,
+			   FIELD_GET(PPE_IN_L3_IF_W1_MAC_BITMAP, l3[1]),
+			   !!(l3[0] & PPE_IN_L3_IF_W0_IPV4_UC_ROUTE_EN),
+			   !!(l3[0] & PPE_IN_L3_IF_W0_IPV6_UC_ROUTE_EN),
+			   !!(l3[1] & PPE_IN_L3_IF_W1_PPPOE_EN),
+			   l3[0], l3[1], l3[2]);
+	}
+}
