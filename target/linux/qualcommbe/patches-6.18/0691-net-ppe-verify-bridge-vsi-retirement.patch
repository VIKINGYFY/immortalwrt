+static int ppe_bridge_mdb_member_del(struct ppe_bridge *pb,
+				     struct ppe_bridge_mdb *mdb, int port)
+{
+	int ret;
+
+	mdb->ports &= ~BIT(port);
+	if (mdb->ports) {
+		ret = ppe_bridge_mdb_hw_update(pb, mdb);
+	} else {
+		ret = ppe_bridge_mdb_hw_remove(pb, mdb);
+		if (!ret || ret == -ENOENT) {
+			hash_del(&mdb->node);
+			kfree(mdb);
+			return 0;
+		}
+	}
+
+	if (ret)
+		mdb->ports |= BIT(port);
+
+	return ret;
+}
+
+static int ppe_bridge_mdb_port_flush(struct ppe_bridge *pb, int vsi, int port)
+{
+	struct ppe_bridge_mdb *mdb;
+	struct hlist_node *tmp;
+	int bkt, ret;
+
+	hash_for_each_safe(pb->mdb_ht, bkt, tmp, mdb, node) {
+		if (mdb->vsi != vsi)
+			continue;
+
+		if (mdb->ports & BIT(port))
+			ret = ppe_bridge_mdb_member_del(pb, mdb, port);
+		else if (pb->ports[port].mrouter)
+			ret = ppe_bridge_mdb_hw_update(pb, mdb);
+		else
+			continue;
+
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
