+/* A cookie only exists after the hardware membership is installed. The
+ * bridge and VID stay stable while any cookie of the VSI is published.
+ */
+static void ppe_bridge_fdb_member_set(struct ppe_bridge *pb, int vsi,
+				      int port, bool present)
+{
+	u32 cookie = 0;
+
+	spin_lock_bh(&pb->fdb_cookie_lock);
+	if (present) {
+		cookie = ++pb->next_fdb_cookie;
+		if (!cookie)
+			cookie = ++pb->next_fdb_cookie;
+	}
+	pb->vsis[vsi].fdb_cookie[port] = cookie;
+	spin_unlock_bh(&pb->fdb_cookie_lock);
+}
+
+static u32 ppe_bridge_fdb_member_find(struct ppe_bridge *pb,
+				      struct net_device *br, int port,
+				      u16 vid, u8 *vsi)
+{
+	u32 cookie = 0;
+	int i;
+
+	spin_lock_bh(&pb->fdb_cookie_lock);
+	for (i = 0; i < ARRAY_SIZE(pb->vsis); i++) {
+		struct ppe_bridge_vsi *v = &pb->vsis[i];
+
+		if (!v->fdb_cookie[port] || v->br != br || v->vid != vid)
+			continue;
+
+		cookie = v->fdb_cookie[port];
+		*vsi = i;
+		break;
+	}
+	spin_unlock_bh(&pb->fdb_cookie_lock);
+
+	return cookie;
+}
+
+/* Preserve the VSI number after an uncertain hardware transition. Park
+ * the datapath if possible even if some of its ingress keys still exist.
+ */
+static void ppe_bridge_vsi_quarantine(struct ppe_bridge *pb, int vsi, int err)
+{
+	struct ppe_bridge_vsi *v = &pb->vsis[vsi];
+	int ret;
+
+	if (v->poisoned)
+		return;
+
+	v->poisoned = true;
+	spin_lock_bh(&pb->fdb_cookie_lock);
+	memset(v->fdb_cookie, 0, sizeof(v->fdb_cookie));
+	spin_unlock_bh(&pb->fdb_cookie_lock);
+
+	ret = ppe_vsi_members_set(pb->ppe_dev, vsi, BIT(0), BIT(0), BIT(0), BIT(0));
+	dev_err(pb->ppe_dev->dev, "quarantined bridge VSI %d: error %d, park %d\n",
+		vsi, err, ret);
+}
