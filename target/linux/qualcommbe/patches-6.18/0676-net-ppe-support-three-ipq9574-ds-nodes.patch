From: ViKing <viking.yfy@qq.com>
Date: Mon, 02 Nov 2026 21:10:45 +0800
Subject: [PATCH] net: ppe: provide three Direct Switch nodes on IPQ9574

A three-chip QCN9274 MLO group exhausts the fixed two-node transport and
the last radio falls back with -ENOSPC. IPQ9574 reserves host RX fill
rings 4..7 and already describes interrupts for DS rings 1..3.

Size the transport for three nodes and select the active count by PPE
compatible. Use that count for allocation, IRQ lookup, fault handling,
statistics and removal. Keep IPQ5332 at its existing two nodes so it does
not request nonexistent third-ring interrupts.

Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/drivers/net/ethernet/qualcomm/ppe/ppe_ds.c
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_ds.c
@@ -27,7 +27,7 @@
 #include "ppe_regs.h"
 #include "ppe_vp.h"
 
-#define PPE_DS_NODES		2
+#define PPE_DS_MAX_NODES	3
 #define PPE_DS_BATCH		64
 #define PPE_DS_QUEUES		8
 #define PPE_DS_QUEUE_BASE	32
@@ -68,8 +68,9 @@
 
 struct ppe_ds_provider {
 	struct ppe_device *ppe_dev;
-	struct qcom_ppe_ds *nodes[PPE_DS_NODES];
-	int irqs[PPE_DS_NODES][PPE_DS_IRQ_COUNT];
+	struct qcom_ppe_ds *nodes[PPE_DS_MAX_NODES];
+	int irqs[PPE_DS_MAX_NODES][PPE_DS_IRQ_COUNT];
+	u8 num_nodes;
 	bool removing;
 };
 
@@ -445,7 +446,7 @@
 	provider = ppe_ds_provider;
 	if (!provider || provider->ppe_dev != ppe_dev)
 		goto unlock;
-	for (i = 0; i < PPE_DS_NODES; i++) {
+	for (i = 0; i < provider->num_nodes; i++) {
 		ds = provider->nodes[i];
 		if (!ds || !READ_ONCE(ds->running))
 			continue;
@@ -633,10 +634,10 @@
 		ret = -EOPNOTSUPP;
 		goto unlock;
 	}
-	for (node = 0; node < PPE_DS_NODES; node++)
+	for (node = 0; node < provider->num_nodes; node++)
 		if (!provider->nodes[node])
 			break;
-	if (node == PPE_DS_NODES) {
+	if (node == provider->num_nodes) {
 		ret = -ENOSPC;
 		goto unlock;
 	}
@@ -1029,7 +1030,7 @@
 	int i;
 
 	mutex_lock(&ppe_ds_lock);
-	for (i = 0; i < PPE_DS_NODES; i++) {
+	for (i = 0; i < provider->num_nodes; i++) {
 		ds = provider->nodes[i];
 		if (!ds) {
 			seq_printf(seq, "node:%d unregistered\n", i);
@@ -1068,6 +1069,11 @@
 	if (!provider)
 		return -ENOMEM;
 	provider->ppe_dev = ppe_dev;
+	/* Ring 0 is reserved; IPQ9574 host RX fill rings start at 4, leaving
+	 * rings 1..3 for three discrete radios. IPQ5332 exposes two DS rings.
+	 */
+	provider->num_nodes = of_device_is_compatible(ppe_dev->dev->of_node,
+						    "qcom,ipq9574-ppe") ? 3 : 2;
 	/* QSDK's SPF-bypass service retains L3/flow lookup, but prevents
 	 * bridge forwarding of unauthorised/missing wireless flows.
 	 */
@@ -1096,7 +1102,7 @@
 		ret = -ENODEV;
 		goto free_provider;
 	}
-	for (node = 0; node < PPE_DS_NODES; node++) {
+	for (node = 0; node < provider->num_nodes; node++) {
 		for (i = 0; i < PPE_DS_IRQ_COUNT; i++) {
 			snprintf(name, sizeof(name), "%s_%u", irq_names[i], node + 1);
 			ret = of_irq_get_byname(np, name);
@@ -1139,7 +1145,7 @@
 		/* Managed consumers are gone; disarm any orphan before VP and
 		 * port teardown. Debugfs still owns the provider until destroy.
 		 */
-		for (i = 0; i < PPE_DS_NODES; i++)
+		for (i = 0; i < provider->num_nodes; i++)
 			if (provider->nodes[i])
 				ppe_ds_detach(provider->nodes[i]);
 	}
@@ -1164,7 +1170,7 @@
 	 * own unproven DMA, not a live WLAN control path. Detach them while
 	 * supplier MMIO is still valid, before devres can release it.
 	 */
-	for (i = 0; i < PPE_DS_NODES; i++) {
+	for (i = 0; i < provider->num_nodes; i++) {
 		if (!provider->nodes[i])
 			continue;
 		ppe_ds_detach(provider->nodes[i]);
