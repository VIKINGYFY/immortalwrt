From: VKing <noreply@openwrt.local>
Date: Mon, 24 Aug 2026 16:03:46 +0800
Subject: [PATCH] net: ethernet: qualcomm: ppe: expire failed neighbours

Once installed, hardware flows bypass software neighbour validation. A
failed ARP or NDP entry can therefore leave traffic using a stale next-hop
rewrite until the normal flow timeout.

Snapshot failed Ethernet neighbours in the atomic netevent notifier and
defer processing to a workqueue. Mark matching netfilter flows for teardown
so the core issues the ordinary hardware destroy transactions on its next
GC pass. Expose event, allocation-failure and marked-row counters in
resource_stats, and report only events which mark live rows for teardown.

Signed-off-by: VKing <noreply@openwrt.local>
---
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flowtable.c
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flowtable.c
@@ -22,6 +22,7 @@
 #include <linux/if_arp.h>
 #include <linux/if_vlan.h>
 #include <linux/ip.h>
+#include <linux/llist.h>
 #include <linux/netdevice.h>
 #include <linux/ppp_channel.h>
 #include <linux/rcupdate.h>
@@ -30,13 +31,16 @@
 #include <linux/rtnetlink.h>
 #include <linux/seq_file.h>
 #include <linux/tc_act/tc_csum.h>
+#include <linux/workqueue.h>
 #include <net/flow_offload.h>
 #include <net/ip6_tunnel.h>
 #include <net/ip6_route.h>
 #include <net/ip_tunnels.h>
 #include <net/ipv6.h>
 #include <net/lwtunnel.h>
+#include <net/netevent.h>
 #include <net/neighbour.h>
+#include <net/netfilter/nf_flow_table.h>
 #include <net/tcp.h>

 #include "edma_port.h"
@@ -202,6 +206,16 @@
 	u64 bytes;
 };

+/**
+ * struct ppe_ft_neigh_event - Deferred failed-neighbour notification.
+ * @node: Lockless queue linkage from the atomic notifier.
+ * @addr: Failed Ethernet neighbour address.
+ */
+struct ppe_ft_neigh_event {
+	struct llist_node node;
+	u8 addr[ETH_ALEN];
+};
+
 #define PPE_FT_TUNNELS	PPE_TUNNEL_ENTRIES

 struct ppe_ft_tunnel {
@@ -294,6 +308,9 @@
  * @pppoe: Refcounted PPPoE session slots.
  * @vlans: Refcounted VLAN uplink slots.
  * @ppp_nb: PPP channel lifecycle notifier.
+ * @neigh_nb: Neighbour lifecycle notifier.
+ * @neigh_work: Deferred failed-neighbour flow teardown.
+ * @neigh_events: Failed-neighbour snapshots awaiting process context.
  * @block_cb_list: Flow block callbacks bound to the PPE ports.
  * @hosts: Refcount of the flows sharing a source host entry.
  */
@@ -328,6 +345,12 @@
 	struct ppe_ft_tunnel_underlay tunnel_underlays[PPE_FT_TUNNEL_UNDERLAYS];
 	struct ppe_ft_tunnel_pppoe_port tunnel_pppoe_ports[PPE_PORT_ID_COUNT];
 	struct notifier_block ppp_nb;
+	struct notifier_block neigh_nb;
+	struct work_struct neigh_work;
+	struct llist_head neigh_events;
+	atomic_long_t neigh_failed_events;
+	atomic_long_t neigh_event_drops;
+	atomic_long_t neigh_flow_teardowns;
 	struct list_head block_cb_list;
 };

@@ -998,6 +1021,126 @@
 	return NOTIFY_DONE;
 }

+static struct flow_offload *ppe_ft_nf_flow(unsigned long cookie)
+{
+	struct flow_offload_tuple *tuple = (void *)cookie;
+	struct flow_offload_tuple_rhash *tuplehash;
+	enum flow_offload_tuple_dir dir = tuple->dir;
+
+	if (WARN_ON_ONCE(dir >= FLOW_OFFLOAD_DIR_MAX))
+		return NULL;
+
+	tuplehash = container_of(tuple, struct flow_offload_tuple_rhash, tuple);
+	tuplehash -= dir;
+
+	return container_of(tuplehash, struct flow_offload, tuplehash[0]);
+}
+
+/* Mark every hardware flow which rewrites to a failed neighbour. Netfilter
+ * owns the flow lifetime and will issue the ordinary destroy transaction on
+ * its next GC pass, keeping the software and hardware tables synchronized.
+ */
+static unsigned int ppe_ft_neigh_teardown(struct ppe_flowtable *ft,
+					  const u8 *addr)
+{
+	struct rhashtable_iter iter;
+	struct ppe_ft_flow *flow;
+	unsigned int marked = 0;
+
+	rhashtable_walk_enter(&ft->flows, &iter);
+	rhashtable_walk_start(&iter);
+	mutex_lock(&ft->lock);
+	while ((flow = rhashtable_walk_next(&iter))) {
+		struct flow_offload *nf_flow;
+
+		if (IS_ERR(flow)) {
+			if (PTR_ERR(flow) == -EAGAIN)
+				continue;
+			break;
+		}
+
+		if (!ether_addr_equal(ft->nexthops[flow->nexthop].key.mac,
+				      addr))
+			continue;
+
+		nf_flow = ppe_ft_nf_flow(flow->cookie);
+		if (!nf_flow || test_bit(NF_FLOW_TEARDOWN, &nf_flow->flags))
+			continue;
+
+		flow_offload_teardown(nf_flow);
+		marked++;
+	}
+	mutex_unlock(&ft->lock);
+	rhashtable_walk_stop(&iter);
+	rhashtable_walk_exit(&iter);
+
+	return marked;
+}
+
+static void ppe_ft_neigh_work(struct work_struct *work)
+{
+	struct ppe_flowtable *ft = container_of(work, struct ppe_flowtable,
+						 neigh_work);
+	struct ppe_ft_neigh_event *event, *tmp;
+	struct llist_node *head;
+
+	head = llist_del_all(&ft->neigh_events);
+	llist_for_each_entry_safe(event, tmp, head, node) {
+		unsigned int marked;
+
+		marked = ppe_ft_neigh_teardown(ft, event->addr);
+		if (marked) {
+			atomic_long_add(marked, &ft->neigh_flow_teardowns);
+			dev_warn_ratelimited(ft->ppe_dev->dev,
+					     "PPE: failed neighbour %pM; tearing down %u hardware flows\n",
+				 event->addr, marked);
+		}
+		kfree(event);
+	}
+}
+
+static void ppe_ft_neigh_events_purge(struct ppe_flowtable *ft)
+{
+	struct ppe_ft_neigh_event *event, *tmp;
+	struct llist_node *head;
+
+	head = llist_del_all(&ft->neigh_events);
+	llist_for_each_entry_safe(event, tmp, head, node)
+		kfree(event);
+}
+
+static int ppe_ft_neigh_event(struct notifier_block *nb,
+			      unsigned long event, void *ptr)
+{
+	struct ppe_flowtable *ft = container_of(nb, struct ppe_flowtable,
+						 neigh_nb);
+	struct neighbour *neigh = ptr;
+	struct ppe_ft_neigh_event *failed;
+
+	if (event != NETEVENT_NEIGH_UPDATE ||
+	    !(READ_ONCE(neigh->nud_state) & NUD_FAILED) ||
+	    !neigh->dev || neigh->dev->addr_len != ETH_ALEN)
+		return NOTIFY_DONE;
+
+	failed = kmalloc(sizeof(*failed), GFP_ATOMIC);
+	if (!failed) {
+		atomic_long_inc(&ft->neigh_event_drops);
+		return NOTIFY_DONE;
+	}
+
+	neigh_ha_snapshot((char *)failed->addr, neigh, neigh->dev);
+	if (is_zero_ether_addr(failed->addr)) {
+		kfree(failed);
+		return NOTIFY_DONE;
+	}
+
+	atomic_long_inc(&ft->neigh_failed_events);
+	llist_add(&failed->node, &ft->neigh_events);
+	schedule_work(&ft->neigh_work);
+
+	return NOTIFY_DONE;
+}
+
 /* The reserved resources a VLAN uplink slot owns; its L3 interface
  * region starts where the PPPoE one ends.
  */
@@ -3505,6 +3648,10 @@
 		   ft->ppe_dev->variant->num_nexthop_entries,
 		   ft->nexthop_allocs, ft->nexthop_reuses, ft->nexthop_frees);
 	mutex_unlock(&ft->lock);
+	seq_printf(seq, "neighbour failed:%ld dropped:%ld teardown:%ld\n",
+		   atomic_long_read(&ft->neigh_failed_events),
+		   atomic_long_read(&ft->neigh_event_drops),
+		   atomic_long_read(&ft->neigh_flow_teardowns));

 	return 0;
 }
@@ -3694,6 +3841,8 @@
 	mutex_init(&ft->lock);
 	INIT_LIST_HEAD(&ft->block_cb_list);
 	INIT_LIST_HEAD(&ft->zombies);
+	init_llist_head(&ft->neigh_events);
+	INIT_WORK(&ft->neigh_work, ppe_ft_neigh_work);

 	ret = rhashtable_init(&ft->flows, &ppe_ft_params);
 	if (ret) {
@@ -3704,6 +3853,7 @@

 	hash_init(ft->hosts);
 	ft->ppp_nb.notifier_call = ppe_ft_ppp_event;
+	ft->neigh_nb.notifier_call = ppe_ft_neigh_event;
 	ppe_dev->flowtable = ft;

 	ret = ppp_register_channel_notifier(&ft->ppp_nb);
@@ -3715,6 +3865,16 @@
 		return ret;
 	}

+	ret = register_netevent_notifier(&ft->neigh_nb);
+	if (ret) {
+		ppp_unregister_channel_notifier(&ft->ppp_nb);
+		ppe_dev->flowtable = NULL;
+		rhashtable_destroy(&ft->flows);
+		kfree(ft->nexthops);
+		kfree(ft);
+		return ret;
+	}
+
 	/* The notifier reports only future channel transitions; adopt the
 	 * PPP devices that connected before it was registered (probe
 	 * deferral, driver load after the WAN came up). A session the
@@ -3755,6 +3915,9 @@
 		return;

 	WARN_ON(!list_empty(&ft->block_cb_list));
+	unregister_netevent_notifier(&ft->neigh_nb);
+	cancel_work_sync(&ft->neigh_work);
+	ppe_ft_neigh_events_purge(ft);
 	ppp_unregister_channel_notifier(&ft->ppp_nb);
 	ppe_ft_flow_drain(ft);
 	mutex_lock(&ft->lock);
