From 7f190abcbd604f5c6a14e9279c1e22bdac3432cc Mon Sep 17 00:00:00 2001
From: ViKing <viking.yfy@qq.com>
Date: Fri, 28 Aug 2026 11:25:11 +0800
Subject: [PATCH] net: dsa: qca8k: preserve QCA 802.1Q egress tags

QSDK programs the per-port and routed egress VLAN modes as untouched.
Without those settings QCA8386 strips the standalone service VID before
frames reach the CPU, so the DSA tagger interprets payload bytes as a VLAN
TCI and drops traffic.

Preserve secure lookup for VLAN-unaware bridges and keep QCA 802.1Q
traffic on the CPU/PPE path as in QSDK. Remove the temporary protocol,
register and bridge-state info logs now that the hardware path is stable;
register programming failures remain visible as errors.

Signed-off-by: ViKing <viking.yfy@qq.com>
---
 drivers/net/dsa/qca/qca8k-8xxx.c   |  3 ---
 drivers/net/dsa/qca/qca8k-common.c | 37 ++++++++++++++++++++++++++++++++++++-
 drivers/net/dsa/qca/qca8k.h        |  5 +++++
 3 files changed, 41 insertions(+), 4 deletions(-)

--- a/drivers/net/dsa/qca/qca8k-8xxx.c
+++ b/drivers/net/dsa/qca/qca8k-8xxx.c
@@ -1934,9 +1934,6 @@ static int qca8k_change_tag_protocol(str
 		qca8k_tag_8021q_teardown(ds);
 
 	priv->proto = proto;
-	dev_info(priv->dev,
-		 "QCA8K debug: tag protocol %u, header %u, CPU RX/TX %u/%u\\n",
-		 proto, hdr_type, rx_mode, tx_mode);
 
 	return 0;
 }
--- a/drivers/net/dsa/qca/qca8k-common.c
+++ b/drivers/net/dsa/qca/qca8k-common.c
@@ -484,9 +484,9 @@ void qca8k_tag_8021q_setup(struct dsa_sw
 {
 	struct qca8k_priv *priv = ds->priv;
 	struct dsa_port *dp, *dpcpu;
+	int ret;
 	u16 vid;
 
-	dev_info(priv->dev, "QCA8K debug: configuring 802.1Q DSA port VIDs\\n");
 	qca8k_rmw(priv, QCA8K_SERVICE_TAG_CTL,
 		  QCA8K_SERVICE_TAG_MASK | QCA8K_SERVICE_TAG_STAG,
 			DSA_TAG_8021Q_VLAN_PROTO | QCA8K_SERVICE_TAG_STAG);
@@ -495,6 +495,25 @@ void qca8k_tag_8021q_setup(struct dsa_sw
 			QCA8K_PKT_EDIT_TO_CPU_VID_CHG_EN);
 
 	dsa_switch_for_each_port(dp, ds) {
+		if (dsa_port_is_user(dp) || dsa_port_is_cpu(dp)) {
+			ret = qca8k_rmw(priv,
+					QCA8K_REG_PORT_VLAN_CTRL1(dp->index),
+					QCA8K_PORT_VLAN_EGMODE_MASK,
+					QCA8K_PORT_VLAN_EGMODE(0x3));
+			if (ret)
+				dev_err(priv->dev,
+					"Failed to preserve egress VLAN mode on port %d (%d)\n",
+					dp->index, ret);
+
+			ret = qca8k_rmw(priv, QCA8K_ROUTE_EGRESS_VLAN,
+					QCA8K_ROUTE_EGRESS_VLAN_MASK(dp->index),
+					QCA8K_ROUTE_EGRESS_VLAN_VAL(dp->index, 0x3));
+			if (ret)
+				dev_err(priv->dev,
+					"Failed to preserve routed VLAN mode on port %d (%d)\n",
+					dp->index, ret);
+		}
+
 		if (dsa_port_is_user(dp) || dsa_port_is_cpu(dp))
 			qca8k_rmw(priv, QCA8K_PORT_LOOKUP_CTRL(dp->index),
 				  QCA8K_PORT_LOOKUP_VLAN_MODE_MASK,
@@ -680,6 +699,9 @@ static int qca8k_port_configure_learning
 {
 	struct qca8k_priv *priv = ds->priv;
 
+	if (priv->proto == DSA_TAG_PROTO_QCA_8021Q)
+		return 0;
+
 	if (learning)
 		return regmap_set_bits(priv->regmap,
 				       QCA8K_PORT_LOOKUP_CTRL(port),
@@ -794,6 +816,8 @@ int qca8k_port_bridge_flags(struct dsa_s
 		if (ret)
 			return ret;
 	}
+	if (priv->proto == DSA_TAG_PROTO_QCA_8021Q)
+		return 0;
 
 	if (flags.mask & BR_ISOLATED) {
 		struct dsa_port *dp = dsa_to_port(ds, port);
@@ -819,6 +843,9 @@ int qca8k_port_bridge_join(struct dsa_sw
 {
 	struct qca8k_priv *priv = ds->priv;
 
+	if (priv->proto == DSA_TAG_PROTO_QCA_8021Q)
+		return 0;
+
 	return qca8k_update_port_member(priv, port, bridge.dev, true);
 }
 
@@ -828,6 +855,9 @@ void qca8k_port_bridge_leave(struct dsa_
 	struct qca8k_priv *priv = ds->priv;
 	int err;
 
+	if (priv->proto == DSA_TAG_PROTO_QCA_8021Q)
+		return;
+
 	err = qca8k_update_port_member(priv, port, bridge.dev, false);
 	if (err)
 		dev_err(priv->dev,
@@ -1127,6 +1157,11 @@ int qca8k_port_vlan_filtering(struct dsa
 	struct qca8k_priv *priv = ds->priv;
 	int ret;
 
+	if (priv->proto == DSA_TAG_PROTO_QCA_8021Q && !vlan_filtering)
+		return qca8k_rmw(priv, QCA8K_PORT_LOOKUP_CTRL(port),
+				   QCA8K_PORT_LOOKUP_VLAN_MODE_MASK,
+				   QCA8K_PORT_LOOKUP_VLAN_MODE_SECURE);
+
 	if (vlan_filtering) {
 		ret = qca8k_rmw(priv, QCA8K_PORT_LOOKUP_CTRL(port),
 				QCA8K_PORT_LOOKUP_VLAN_MODE_MASK,
--- a/drivers/net/dsa/qca/qca8k.h
+++ b/drivers/net/dsa/qca/qca8k.h
@@ -205,6 +205,8 @@
 #define   QCA8K_PORT_VLAN_SVID_MASK			GENMASK(11, 0)
 #define   QCA8K_PORT_VLAN_SVID(x)			FIELD_PREP(QCA8K_PORT_VLAN_SVID_MASK, x)
 #define QCA8K_REG_PORT_VLAN_CTRL1(_i)			(0x424 + (_i * 8))
+#define   QCA8K_PORT_VLAN_EGMODE_MASK			GENMASK(13, 12)
+#define   QCA8K_PORT_VLAN_EGMODE(x)			FIELD_PREP(QCA8K_PORT_VLAN_EGMODE_MASK, x)
 #define   QCA8K_PORT_VLAN_CORE_PORT_EN			BIT(9)
 #define   QCA8K_PORT_VLAN_TLS_MODE			BIT(7)
 #define   QCA8K_PORT_VLAN_PROP_EN			BIT(6)
@@ -344,6 +346,9 @@
 #define QCA8K_EGRESS_VLAN(x)				(0x0c70 + (4 * (x / 2)))
 #define QCA8K_PKT_EDIT_CTRL				0x0c00
 #define   QCA8K_PKT_EDIT_TO_CPU_VID_CHG_EN		BIT(1)
+#define QCA8K_ROUTE_EGRESS_VLAN				0x0c80
+#define   QCA8K_ROUTE_EGRESS_VLAN_MASK(_i)		(0x3 << ((_i) * 4))
+#define   QCA8K_ROUTE_EGRESS_VLAN_VAL(_i, _val)		((_val) << ((_i) * 4))
 
 /* L3 registers */
 #define QCA8K_HROUTER_CONTROL				0xe00
