From: ViKing <viking.yfy@qq.com>
Date: Tue, 17 Nov 2026 00:21:41 +0800
Subject: [PATCH] net: ppe: read flow byte counters consistently

Use a bounded high-low-high read of the free-running 40-bit byte count.
Reject I/O failures and unstable carry samples before publishing any delta,
following the hardened AX flow-counter path.

Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flow.c
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flow.c
@@ -467,21 +467,34 @@
 		       u64 *bytes)
 {
 	u32 reg = PPE_FLOW_CNT_TBL_ADDR + PPE_FLOW_CNT_TBL_INC * index;
-	u32 val[3];
-	int ret;
+	u32 pkts, lo, hi, hi2;
+	int ret, i;
 
 	if (index < 0 || index >= ppe_dev->variant->num_flow_entries)
 		return -EINVAL;
-
-	ret = regmap_bulk_read(ppe_dev->regmap, reg, val, ARRAY_SIZE(val));
-	if (ret)
-		return ret;
-
-	*packets = val[0];
-	*bytes = (u64)FIELD_GET(PPE_FLOW_CNT_W2_BYTE_CNT_HI, val[2]) << 32 |
-		 val[1];
-
-	return 0;
+	ret = regmap_read(ppe_dev->regmap, reg, &pkts);
+	if (ret)
+		return ret;
+
+	/* Bulk MMIO reads do not provide a coherent 40-bit snapshot. */
+	for (i = 0; i < 3; i++) {
+		ret = regmap_read(ppe_dev->regmap, reg + 8, &hi);
+		if (ret)
+			return ret;
+		ret = regmap_read(ppe_dev->regmap, reg + 4, &lo);
+		if (ret)
+			return ret;
+		ret = regmap_read(ppe_dev->regmap, reg + 8, &hi2);
+		if (ret)
+			return ret;
+		if ((hi & PPE_FLOW_CNT_W2_BYTE_CNT_HI) !=
+		    (hi2 & PPE_FLOW_CNT_W2_BYTE_CNT_HI))
+			continue;
+		*packets = pkts;
+		*bytes = (u64)FIELD_GET(PPE_FLOW_CNT_W2_BYTE_CNT_HI, hi) << 32 | lo;
+		return 0;
+	}
+	return -EAGAIN;
 }
 
