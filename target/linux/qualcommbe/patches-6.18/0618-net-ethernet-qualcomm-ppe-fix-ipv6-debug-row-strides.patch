From: ViKing <viking.yfy@qq.com>
Subject: [PATCH] net: ethernet: qualcomm: ppe: fix IPv6 debug row strides

Use the MPPE IPv6 flow and host table strides when flow_rows reads raw
hardware entries. The IPv6 views use 0x40 and 0x20 byte strides,
respectively, while the IPv4 views remain 0x20 and 0x10. This only corrects
diagnostics; flow operation and counter access stay on their existing
QSDK-compatible paths.

Signed-off-by: ViKing <viking.yfy@qq.com>
---
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_regs.h
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_regs.h
@@ -684,6 +684,7 @@
 #define PPE_HOST_KEY_TYPE_IPV6			2
 #define PPE_HOST_V6_W0_IP_ADDR_0		GENMASK(31, 22)
 #define PPE_HOST_V6_W4_IP_ADDR_4		GENMASK(21, 0)
+#define PPE_HOST_V6_TBL_INC			0x20
 
 /* L3 flow table, keyed by the hardware-hashed 5-tuple. One IP address
  * of the tuple is inline, the other is referenced in the host table.
@@ -737,6 +738,7 @@
 #define PPE_FLOW_V6_W2_PMTU_CHECK_L3		BIT(20)
 #define PPE_FLOW_V6_W2_PMTU_LO			GENMASK(31, 21)
 #define PPE_FLOW_V6_W3_PMTU_HI			GENMASK(2, 0)
+#define PPE_FLOW_V6_TBL_INC			0x40
 
 #define PPE_FLOW_FWD_TYPE_FORWARD		0
 #define PPE_FLOW_FWD_TYPE_SNAT			1
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flowtable.c
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flowtable.c
@@ -3255,6 +3255,7 @@ static int ppe_ft_flow_rows_show(struct
 		int flow_err, host_err, nh_err, in_err, eg_err;
 		int my_mac_err = 0, pub_ip_err = 0;
 		int flow_words, host_words;
+		u32 flow_inc, host_inc;
 		bool key_match, source_match;
 		u8 l3_if;
 
@@ -3267,11 +3268,15 @@ static int ppe_ft_flow_rows_show(struct
 		flow_words = flow->entry.is_ipv6 ? ARRAY_SIZE(f) :
 			PPE_FLOW_TBL_WORDS;
 		host_words = flow->entry.is_ipv6 ? ARRAY_SIZE(h) : 4;
-		reg = PPE_FLOW_TBL_ADDR + PPE_FLOW_TBL_INC * flow->index;
+		flow_inc = flow->entry.is_ipv6 ? PPE_FLOW_V6_TBL_INC :
+			PPE_FLOW_TBL_INC;
+		host_inc = flow->entry.is_ipv6 ? PPE_HOST_V6_TBL_INC :
+			PPE_HOST_TBL_INC;
+		reg = PPE_FLOW_TBL_ADDR + flow_inc * flow->index;
 		flow_err = regmap_bulk_read(ft->ppe_dev->regmap, reg, f,
 					    flow_words);
 		hw_host = FIELD_GET(PPE_FLOW_W0_HOST_INDEX, f[0]);
-		reg = PPE_HOST_TBL_ADDR + PPE_HOST_TBL_INC * hw_host;
+		reg = PPE_HOST_TBL_ADDR + host_inc * hw_host;
 		host_err = regmap_bulk_read(ft->ppe_dev->regmap, reg, h,
 					    host_words);
 		hw_nh = FIELD_GET(PPE_FLOW_W1_NEXT_HOP, f[1]);
@@ -3464,6 +3469,7 @@ static int ppe_ft_flows_show(struct seq_
 	rhashtable_walk_start(&iter);
 	while ((flow = rhashtable_walk_next(&iter))) {
 		u32 w0 = 0, packets = 0;
+		u32 flow_inc;
 		u64 bytes = 0;
 
 		if (IS_ERR(flow)) {
@@ -3472,8 +3478,10 @@ static int ppe_ft_flows_show(struct seq_
 			break;
 		}
 
+		flow_inc = flow->entry.is_ipv6 ? PPE_FLOW_V6_TBL_INC :
+			PPE_FLOW_TBL_INC;
 		regmap_read(ft->ppe_dev->regmap,
-			    PPE_FLOW_TBL_ADDR + PPE_FLOW_TBL_INC * flow->index,
+			    PPE_FLOW_TBL_ADDR + flow_inc * flow->index,
 			    &w0);
 		ppe_flow_stats_get(ft->ppe_dev, flow->index, &packets, &bytes);
 
