From a3c5584785118b2493e97e2ddaab03d058f84d9a Mon Sep 17 00:00:00 2001
From: ViKing <viking.yfy@qq.com>
Date: Fri, 28 Aug 2026 15:56:44 +0800
Subject: [PATCH] net: phy: sfp: expand I2C presence diagnostics

Add temporary transition-based diagnostics for SFP cages that infer
module presence through EEPROM I2C reads. Report adapter capabilities,
configured control signals, LOS changes, I2C result changes, and module
insertion or removal without logging every empty-cage NAK.

Signed-off-by: ViKing <viking.yfy@qq.com>
---
 drivers/net/phy/sfp.c | 49 ++++++++++++++++++++++++++++++++++++++-----
 1 file changed, 44 insertions(+), 5 deletions(-)

--- a/drivers/net/phy/sfp.c
+++ b/drivers/net/phy/sfp.c
@@ -263,7 +263,11 @@ struct sfp {
 	 * Access rules: st_mutex held (updated from the poll/state machine).
 	 */
 	bool i2c_present;
+	bool i2c_probe_logged;
+	bool i2c_state_logged;
 	u8 i2c_present_nak;
+	unsigned int i2c_debug_state;
+	int i2c_probe_last_ret;
 	unsigned long i2c_present_next;
 
 	/* Access rules:
@@ -888,11 +892,9 @@ static int sfp_read(struct sfp *sfp, boo
  * I2C read of the EEPROM identifier (an empty cage NAKs). Used as the presence
  * source on boards that do not wire MOD_DEF0 to a GPIO.
  */
-static bool sfp_module_present_i2c(struct sfp *sfp)
+static int sfp_module_present_i2c(struct sfp *sfp, u8 *id)
 {
-	u8 id;
-
-	return sfp_read(sfp, false, SFP_PHYS_ID, &id, sizeof(id)) == sizeof(id);
+	return sfp_read(sfp, false, SFP_PHYS_ID, id, sizeof(*id));
 }
 
 /* get_state variant for boards without a MOD_DEF0 GPIO. Instead of assuming
@@ -904,15 +906,43 @@ static bool sfp_module_present_i2c(struc
 static unsigned int sfp_i2c_get_state(struct sfp *sfp)
 {
 	unsigned int state = sfp_gpio_get_state(sfp);
+	unsigned int debug_mask = SFP_F_LOS | SFP_F_TX_FAULT;
+	u8 id = 0;
+	int ret;
+
+	if (!sfp->i2c_state_logged ||
+	    ((state ^ sfp->i2c_debug_state) & debug_mask)) {
+		dev_info(sfp->dev,
+			 "SFP debug: signal state changed: los=%u tx-fault=%u\n",
+			 !!(state & SFP_F_LOS), !!(state & SFP_F_TX_FAULT));
+		sfp->i2c_debug_state = state;
+		sfp->i2c_state_logged = true;
+	}
 
 	if (time_after_eq(jiffies, sfp->i2c_present_next)) {
-		if (sfp_module_present_i2c(sfp)) {
+		ret = sfp_module_present_i2c(sfp, &id);
+		if (!sfp->i2c_probe_logged || ret != sfp->i2c_probe_last_ret) {
+			dev_info(sfp->dev,
+				 "SFP debug: I2C probe ret=%d id=0x%02x\n",
+				 ret, id);
+			sfp->i2c_probe_last_ret = ret;
+			sfp->i2c_probe_logged = true;
+		}
+
+		if (ret == sizeof(id)) {
+			if (!sfp->i2c_present)
+				dev_info(sfp->dev,
+					 "SFP debug: module detected via I2C id=0x%02x\n",
+					 id);
 			sfp->i2c_present = true;
 			sfp->i2c_present_nak = 0;
 		} else if (sfp->i2c_present &&
 			   ++sfp->i2c_present_nak >= R_PROBE_ABSENT) {
 			sfp->i2c_present = false;
 			sfp->i2c_present_nak = 0;
+			dev_info(sfp->dev,
+				 "SFP debug: module removed, last I2C ret=%d\n",
+				 ret);
 		}
 		sfp->i2c_present_next = jiffies + T_PROBE_PRESENT;
 	}
@@ -3241,10 +3271,19 @@ static int sfp_probe(struct platform_dev
 			sfp->i2c_block_size = sfp->i2c_max_block_size;
 			sfp->i2c_present_next = jiffies;
 			sfp->need_poll = true;
+			dev_info(sfp->dev,
+				 "SFP debug: I2C detect on %s funcs=%#llx block=%zu\n",
+				 dev_name(&sfp->i2c->dev),
+				 (unsigned long long)i2c_get_functionality(sfp->i2c),
+				 sfp->i2c_block_size);
 		} else {
 			sfp->get_state = sff_gpio_get_state;
 		}
 	}
+	dev_info(sfp->dev,
+		 "SFP debug: gpios mod-def0=%u los=%u tx-fault=%u tx-disable=%u\n",
+		 !!sfp->gpio[GPIO_MODDEF0], !!sfp->gpio[GPIO_LOS],
+		 !!sfp->gpio[GPIO_TX_FAULT], !!sfp->gpio[GPIO_TX_DISABLE]);
 
 	device_property_read_u32(&pdev->dev, "maximum-power-milliwatt",
 				 &sfp->max_power_mW);
