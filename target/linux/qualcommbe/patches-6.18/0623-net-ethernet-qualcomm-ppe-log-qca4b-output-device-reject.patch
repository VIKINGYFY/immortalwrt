From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ViKing <viking.yfy@qq.com>
Date: Fri, 28 Aug 2026 22:15:12 +0800
Subject: [PATCH] net: ethernet: qualcomm: ppe log QCA4B output rejection

Log the output device, DSA port and tag protocol, VLAN state, conduit and PPE
port mapping when a flow is rejected before egress resolution. Keep QCA4B
fail-closed while its PPE ATH/VP mapping is not implemented.

Signed-off-by: ViKing <viking.yfy@qq.com>
---
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flowtable.c
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flowtable.c
@@ -1920,6 +1920,45 @@ static void ppe_ft_flow_release(struct p
 	kfree(flow);
 }
 
+static void ppe_ft_debug_output_device(struct ppe_flowtable *ft,
+					       struct net_device *dev)
+{
+	struct edma_port_priv *conduit_priv = NULL;
+	struct dsa_port *dp = NULL;
+	struct net_device *conduit = NULL;
+	bool vlan_filtering = false;
+	int dp_index = -1;
+	int conduit_port = -1;
+	int proto = -1;
+
+	if (dsa_user_dev_check(dev)) {
+		dp = dsa_port_from_netdev(dev);
+		if (!IS_ERR(dp)) {
+			dp_index = dp->index;
+			vlan_filtering = dsa_port_is_vlan_filtering(dp);
+			conduit = dsa_port_to_conduit(dp);
+			if (conduit && edma_port_dev_check(conduit)) {
+				conduit_priv = netdev_priv(conduit);
+				if (conduit_priv->ppe_port)
+					conduit_port = conduit_priv->ppe_port->port_id;
+			}
+			if (dp->cpu_dp && dp->cpu_dp->tag_ops)
+				proto = dp->cpu_dp->tag_ops->proto;
+		}
+	}
+
+	dev_info_ratelimited(ft->ppe_dev->dev,
+			     "PPE debug: reject output device dev=%s ifindex=%d "
+			     "type=%u dsa_proto=%d dp_index=%d vlan_filtering=%u "
+			     "conduit=%s conduit_edma=%u conduit_ppe_port=%d "
+			     "candidate_vp=%d\n",
+			     dev ? dev->name : "<null>", dev ? dev->ifindex : 0,
+			     dev ? dev->type : 0, proto,
+			     dp_index, vlan_filtering, conduit ? conduit->name : "<none>",
+			     conduit && conduit_priv ? 1 : 0, conduit_port,
+			     dp_index >= 0 ? PPE_VP_PORT_BASE + dp_index : -1);
+}
+
 static int ppe_ft_dsa_port(struct net_device *dev, struct dsa_port **dpp)
 {
 	struct dsa_port *dp;
@@ -2324,6 +2363,7 @@ static int ppe_ft_flow_replace(struct pp
 	    ppe_ft_dsa_port(odev, NULL) < 0 &&
 	    (!ft->ppe_dev->variant->has_vports ||
 	     odev->type != ARPHRD_ETHER || !odev->ieee80211_ptr)) {
+		ppe_ft_debug_output_device(ft, odev);
 		ret = -EOPNOTSUPP;
 		goto err_tdev;
 	}
