@@ -160,6 +160,7 @@
 			txdesc_stats[i].dma_map_errors = stats->dma_map_errors;
 			txdesc_stats[i].queue_stops = stats->queue_stops;
 			txdesc_stats[i].queue_restarts = stats->queue_restarts;
+
 		} while (u64_stats_fetch_retry(&stats->syncp, start));
 	}
 
