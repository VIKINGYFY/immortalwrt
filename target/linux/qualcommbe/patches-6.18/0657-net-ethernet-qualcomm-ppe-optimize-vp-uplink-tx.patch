@@ -724,7 +698,7 @@
 }
 
 /**
- * edma_tx_ring_xmit - Transmit a packet.
+ * edma_tx_ring_enqueue - Prepare a packet under its carrier TX queue lock.
  * @netdev: Netdevice.
  * @skb: Socket Buffer.
  * @txdesc_ring: Tx Descriptor ring.
@@ -735,21 +709,19 @@
  *
  * Return 0 on success, negative error code on failure.
  */
-enum edma_tx_status edma_tx_ring_xmit(struct net_device *netdev,
+static enum edma_tx_status edma_tx_ring_enqueue(struct net_device *netdev,
 				      struct sk_buff *skb, struct edma_txdesc_ring *txdesc_ring,
-				struct edma_port_tx_stats *stats, int src_vp)
+				struct edma_port_tx_stats *stats, int src_vp,
+				      u32 num_tx_desc_needed)
 {
 	struct edma_txdesc_stats *txdesc_stats = &txdesc_ring->txdesc_stats;
 	struct edma_port_priv *port_priv = netdev_priv(netdev);
-	u32 num_tx_desc_needed = 0, num_desc_filled = 0;
-	struct ppe_device *ppe_dev = edma_ctx->ppe_dev;
+	u32 num_desc_filled = 0;
 	struct ppe_port *port = port_priv->ppe_port;
-	struct regmap *regmap = ppe_dev->regmap;
 	struct edma_txdesc_pri *txdesc = NULL;
 	struct netdev_queue *nq;
 	int port_id = port->port_id;
 	u32 hw_next_to_use = 0, start_idx, queue_id;
-	u32 reg;
 
 	hw_next_to_use = txdesc_ring->prod_idx;
 	start_idx = hw_next_to_use;
@@ -782,7 +754,6 @@
 		EDMA_TXDESC_ENDIAN_SET(txdesc);
 		num_desc_filled++;
 	} else {
-		num_tx_desc_needed = edma_tx_num_descs_for_sg(skb);
 
 		/* HW does not support TSO for packets with more than 32 segments.
 		 * HW hangs up if it sees more than 32 segments. Kernel Perform GSO
@@ -863,12 +834,79 @@
 		u64_stats_update_end(&stats->syncp);
 	}
 
+	return EDMA_TX_OK;
+}
+
+/* Publish only complete packets, after DMA mappings and BQL accounting.
+ * Callers hold the carrier TX queue lock across enqueue and publication.
+ */
+static void edma_tx_ring_publish(struct edma_txdesc_ring *ring)
+{
+	u32 reg = EDMA_BASE_OFFSET + EDMA_REG_TXDESC_PROD_IDX(ring->id);
+
 	dsb(st);
+	regmap_write(edma_ctx->ppe_dev->regmap, reg, ring->prod_idx);
+}
 
-	reg = EDMA_BASE_OFFSET + EDMA_REG_TXDESC_PROD_IDX(txdesc_ring->id);
-	regmap_write(regmap, reg, txdesc_ring->prod_idx);
+enum edma_tx_status edma_tx_ring_xmit(struct net_device *netdev,
+				      struct sk_buff *skb,
+				      struct edma_txdesc_ring *ring,
+				      struct edma_port_tx_stats *stats,
+				      int src_vp)
+{
+	enum edma_tx_status ret;
+
+	ret = edma_tx_ring_enqueue(netdev, skb, ring, stats, src_vp,
+				   skb_is_nonlinear(skb) ?
+				   edma_tx_num_descs_for_sg(skb) : 1);
+	if (ret == EDMA_TX_OK)
+		edma_tx_ring_publish(ring);
+	return ret;
+}
+
+/* Consume a software GSO list. Publish at most 32 descriptors at a time
+ * and before refreshing an insufficient cached descriptor count. A failed
+ * segment keeps its existing drop semantics; earlier successes still reach
+ * hardware, including when the last segment fails to map.
+ */
+#define EDMA_TX_BATCH_DESC_MAX 32
 
-	return EDMA_TX_OK;
+void edma_tx_xmit_segs(struct net_device *dev, struct sk_buff *segs,
+		       struct edma_txdesc_ring *ring,
+		       struct edma_port_tx_stats *stats, int src_vp)
+{
+	u32 pending_descs = 0;
+
+	while (segs) {
+		struct sk_buff *skb = segs;
+		u32 needed = edma_tx_num_descs_for_sg(skb);
+		u32 start;
+
+		segs = segs->next;
+		skb->next = NULL;
+		if (pending_descs &&
+		    (pending_descs + needed > EDMA_TX_BATCH_DESC_MAX ||
+		     needed > ring->avail_desc)) {
+			edma_tx_ring_publish(ring);
+			pending_descs = 0;
+		}
+
+		start = ring->prod_idx;
+		if (unlikely(edma_tx_ring_enqueue(dev, skb, ring, stats,
+						  src_vp, needed) != EDMA_TX_OK)) {
+			dev_kfree_skb_any(skb);
+			if (stats) {
+				u64_stats_update_begin(&stats->syncp);
+				stats->tx_drops++;
+				u64_stats_update_end(&stats->syncp);
+			}
+			continue;
+		}
+		pending_descs += (ring->prod_idx - start) & EDMA_TX_RING_SIZE_MASK;
+	}
+
+	if (pending_descs)
+		edma_tx_ring_publish(ring);
 }
 
