From: ViKing <viking.yfy@qq.com>
Subject: [PATCH] net: qualcomm: ppe: account offloaded bridge and VLAN traffic

Attribute each validated hardware flow-counter delta to the software bridge
and VLAN interfaces bypassed on its input and output paths. Keep physical
port MIB accounting separate. Release upper references on unregister,
flow teardown and quarantine, including unregister during rule creation.
Seed the counter baseline before enabling a reused hardware index and
expose upper counts beside the existing flow diagnostics.

Signed-off-by: ViKing <viking.yfy@qq.com>
---
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flow_account.h
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flow_account.h
@@ -0,0 +1,104 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Copyright (c) 2026 ViKing */
+
+#ifndef _PPE_FLOW_ACCOUNT_H_
+#define _PPE_FLOW_ACCOUNT_H_
+
+#include <linux/if_vlan.h>
+#include <linux/netdevice.h>
+
+/* Only software uppers bypassed by this flow are held. Physical and DSA
+ * ports already have hardware MIBs; adding the same delta would double it.
+ */
+struct ppe_flow_account {
+	struct net_device *upper[3];
+	u8 count;
+};
+
+static void ppe_flow_account_bind(struct ppe_flow_account *account,
+				  struct net_device *dev, int svid, int cvid)
+{
+	struct net_device *master;
+	const __be16 proto[] = { htons(ETH_P_8021AD), htons(ETH_P_8021Q) };
+	const int vid[] = { svid, cvid };
+	int i;
+
+	rcu_read_lock();
+	master = netdev_master_upper_dev_get_rcu(dev);
+	if (master && netif_is_bridge_master(master)) {
+		dev = master;
+		dev_hold(dev);
+		account->upper[account->count++] = dev;
+	}
+	for (i = 0; i < ARRAY_SIZE(vid); i++) {
+		if (vid[i] < 0)
+			continue;
+		dev = __vlan_find_dev_deep_rcu(dev, proto[i], vid[i]);
+		if (!dev)
+			break;
+		dev_hold(dev);
+		account->upper[account->count++] = dev;
+	}
+	rcu_read_unlock();
+}
+
+static void ppe_flow_account_put(struct ppe_flow_account *account)
+{
+	while (account->count)
+		dev_put(account->upper[--account->count]);
+}
+
+/* With no explicit device, close the race between path lookup and the
+ * flow lock: an unregister notifier can run before the flow is published.
+ */
+static void ppe_flow_account_prune(struct ppe_flow_account *account,
+				   const struct net_device *dev)
+{
+	int i = 0;
+
+	while (i < account->count) {
+		struct net_device *upper = account->upper[i];
+
+		if (dev ? upper == dev :
+		    READ_ONCE(upper->reg_state) != NETREG_REGISTERED) {
+			dev_put(upper);
+			account->upper[i] = account->upper[--account->count];
+		} else {
+			i++;
+		}
+	}
+}
+
+static void ppe_flow_account_update(const struct ppe_flow_account *account,
+				    bool rx, u32 packets, u64 bytes)
+{
+	int i;
+
+	local_bh_disable();
+	for (i = 0; i < account->count; i++) {
+		struct net_device *dev = account->upper[i];
+
+		if (READ_ONCE(dev->reg_state) != NETREG_REGISTERED ||
+		    !netif_running(dev))
+			continue;
+		if (is_vlan_dev(dev)) {
+			struct vlan_pcpu_stats *s;
+
+			s = this_cpu_ptr(vlan_dev_priv(dev)->vlan_pcpu_stats);
+			u64_stats_update_begin(&s->syncp);
+			u64_stats_add(rx ? &s->rx_packets : &s->tx_packets, packets);
+			u64_stats_add(rx ? &s->rx_bytes : &s->tx_bytes, bytes);
+			u64_stats_update_end(&s->syncp);
+		} else if (netif_is_bridge_master(dev) && dev->tstats) {
+			struct pcpu_sw_netstats *s = this_cpu_ptr(dev->tstats);
+
+			u64_stats_update_begin(&s->syncp);
+			u64_stats_add(rx ? &s->rx_packets : &s->tx_packets, packets);
+			u64_stats_add(rx ? &s->rx_bytes : &s->tx_bytes, bytes);
+			u64_stats_update_end(&s->syncp);
+		}
+	}
+	local_bh_enable();
+}
+
+#endif /* _PPE_FLOW_ACCOUNT_H_ */
