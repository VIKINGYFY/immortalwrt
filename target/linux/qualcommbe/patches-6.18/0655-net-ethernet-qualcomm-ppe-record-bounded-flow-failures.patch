+static void ppe_ft_record_reject(struct ppe_flowtable *ft, unsigned long cookie,
+				 const struct ppe_ft_flow *flow,
+				 const struct ppe_ft_data *data,
+				 const struct ppe_flow_nexthop *nh,
+				 enum ppe_ft_reject_reason reason,
+				 const char *detail, unsigned int line,
+				 int iport, int output_ifindex,
+				 bool tuple_valid, int error)
+{
+	struct ppe_ft_reject next = {
+		.cookie = cookie, .reason = reason, .detail = detail, .line = line,
+		.error = error, .input_ifindex = data->ingress_ifindex,
+		.output_ifindex = output_ifindex, .iport = iport,
+		.eport = flow ? flow->eport : -1,
+		.ivp = flow ? flow->ivp : -1, .vp = flow ? flow->vp : -1,
+		.isvid = data->ingress_svid, .icvid = data->ingress_cvid,
+		.esvid = nh->svid, .ecvid = nh->cvid,
+		.isid = data->ingress_pppoe_sid, .esid = data->pppoe_sid,
+		.tuple_valid = tuple_valid,
+	};
+
+	if (!error)
+		return;
+	if (tuple_valid && flow)
+		next.entry = flow->entry;
+	/* Called only after replace has dropped the resource mutex. */
+	spin_lock_bh(&ft->reject_lock);
+	next.time_ns = ktime_get_ns();
+	next.count = ft->last_reject.count + 1;
+	ft->last_reject = next;
+	spin_unlock_bh(&ft->reject_lock);
+}
