From: ViKing <viking.yfy@qq.com>
Subject: [PATCH] net: ethernet: qualcomm: ppe: record bounded flow failures

Keep one timestamped resource failure with an owned copy of the installing
flow tuple, cookie, ports and VLAN identities. Independently retain the last
failed hardware command, raw result and errno under flow_lock. Expose both
on demand in resource_stats, distinguishing command-write failures from
polling and avoiding per-packet logs or unbounded allocations.

Record a separate bounded rejection snapshot, including pre-resource
failures, monotonic time, branch, errno and owned flow/port/VLAN/PPPoE
identity. Count ingress MY_MAC, VLAN and PPPoE resource failures as well.

Signed-off-by: ViKing <viking.yfy@qq.com>
---
---
--- a/drivers/net/ethernet/qualcomm/ppe/ppe.h
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe.h
@@ -60,6 +60,17 @@
 	bool has_vports;
 };
 
+/* Last failed indirect command, protected by flow_lock. No packet logging. */
+struct ppe_hw_failure {
+	u64 time_ns;
+	u64 count;
+	u32 command;
+	u32 result;
+	u32 address;
+	int error;
+	bool polled;
+};
+
 /**
  * struct ppe_device - PPE device private data.
  * @dev: PPE device structure.
@@ -100,6 +111,7 @@
 	/* Serialize the L3 flow operation registers. */
 	struct mutex flow_lock;
 	u8 flow_cmd_id;
+	struct ppe_hw_failure last_hw_failure;
 	/* Serialize the APPE tunnel command and table registers. */
 	struct mutex tunnel_lock;
 	/* Serialize tunnel object ID and dedicated VP allocation. */
