From: ViKing <viking.yfy@qq.com>
Date: Wed, 11 Nov 2026 16:11:45 +0800
Subject: [PATCH] net: ppe: serialize indexed L3 hardware transactions

Serialize table operations and retain hardware-selected indices, readback and command-result validation independently of software flow topology.

Split from:
  0651-net-ppe-flow-identity-and-topology.patch - net: ethernet: qualcomm: own DSA and PPPoE flow identity and topology

Merged from:
  0651-net-ppe-flow-identity-and-topology.patch - net: ethernet: qualcomm: own DSA and PPPoE flow identity and topology
  0662-net-ethernet-qualcomm-ppe-serialize-L3-table-rows.patch - net: ethernet: qualcomm: ppe: serialize complete L3 rows

Previous merged from (0651-net-ppe-flow-identity-and-topology.patch):
  0651-net-ethernet-qualcomm-ppe-define-flow-identity-and-transport.patch
  0652-net-ethernet-qualcomm-ppe-manage-dsa-pppoe-flow-lifecycle.patch

Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/drivers/net/ethernet/qualcomm/ppe/ppe.h
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe.h
@@ -99,6 +99,7 @@ struct ppe_device {
 	u8 fdb_cmd_id;
 	/* Serialize the L3 flow operation registers. */
 	struct mutex flow_lock;
+	struct mutex l3_if_lock;
 	u8 flow_cmd_id;
 	/* Serialize the APPE tunnel command and table registers. */
 	struct mutex tunnel_lock;
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flow.c
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flow.c
@@ -24,10 +24,12 @@
 #include "ppe_config.h"
 #include "ppe_flow.h"
 #include "ppe_regs.h"
+#include "ppe_vp.h"
 
 /* Issue an operation and return the hardware-selected table index. */
 static int ppe_flow_op_issue(struct ppe_device *ppe_dev, u32 op_type,
-			     bool by_index, int index)
+			     bool by_index, int index,
+			     struct ppe_flow_op_result *result)
 {
 	u32 val, cmd_id;
 	int ret;
@@ -41,6 +43,10 @@ static int ppe_flow_op_issue(struct ppe_
 		val |= PPE_FLOW_OP_MODE |
 		       FIELD_PREP(PPE_FLOW_OP_ENTRY_INDEX, index);
 
+	if (result) {
+		result->command = val;
+		result->result_reg = PPE_FLOW_TBL_OP_RSLT_ADDR;
+	}
 	ret = regmap_write(ppe_dev->regmap, PPE_FLOW_TBL_OP_ADDR, val);
 	if (ret)
 		return ret;
@@ -62,8 +68,15 @@ static int ppe_flow_op_issue(struct ppe_
 			FIELD_GET(PPE_FLOW_OP_RSLT_VALID_CNT, val), 10, 10000);
 	if (ret)
 		return ret;
+	if (result) {
+		result->result = val;
+		result->result_valid = true;
+	}
 	if (val & PPE_FLOW_OP_RSLT_FAIL)
 		return -ENOENT;
+	/* A wrapped command ID alone cannot prove an indexed retirement. */
+	if (by_index && FIELD_GET(PPE_FLOW_OP_RSLT_ENTRY_INDEX, val) != index)
+		return -EIO;
 	return FIELD_GET(PPE_FLOW_OP_RSLT_ENTRY_INDEX, val);
 }
 
@@ -105,7 +118,8 @@ static int ppe_flow_read_op_issue(struct
 }
 
 static int ppe_host_op_issue(struct ppe_device *ppe_dev, u32 op_type,
-			     bool by_index, int index)
+			     bool by_index, int index,
+			     struct ppe_flow_op_result *result)
 {
 	u32 val, cmd_id;
 	int ret;
@@ -119,6 +133,10 @@ static int ppe_host_op_issue(struct ppe_
 		val |= PPE_HOST_OP_MODE |
 		       FIELD_PREP(PPE_HOST_OP_ENTRY_INDEX, index);
 
+	if (result) {
+		result->command = val;
+		result->result_reg = PPE_HOST_TBL_OP_RSLT_ADDR;
+	}
 	ret = regmap_write(ppe_dev->regmap, PPE_HOST_TBL_OP_ADDR, val);
 	if (ret)
 		return ret;
@@ -136,8 +154,15 @@ static int ppe_host_op_issue(struct ppe_
 			FIELD_GET(PPE_HOST_OP_RSLT_VALID_CNT, val), 10, 10000);
 	if (ret)
 		return ret;
+	if (result) {
+		result->result = val;
+		result->result_valid = true;
+	}
 	if (val & PPE_HOST_OP_RSLT_FAIL)
 		return -ENOENT;
+	/* A wrapped command ID alone cannot prove an indexed retirement. */
+	if (by_index && FIELD_GET(PPE_HOST_OP_RSLT_ENTRY_INDEX, val) != index)
+		return -EIO;
 	return FIELD_GET(PPE_HOST_OP_RSLT_ENTRY_INDEX, val);
 }
 
@@ -182,6 +207,10 @@ static void ppe_flow_entry_pack(const st
 	val[0] |= FIELD_PREP(PPE_FLOW_W0_HOST_INDEX, flow->host_index);
 	val[0] |= FIELD_PREP(PPE_FLOW_W0_PROTOCOL_TYPE, flow->proto);
 	val[0] |= FIELD_PREP(PPE_FLOW_W0_AGE, 3);
+	if (flow->src_l3_if_valid) {
+		val[0] |= PPE_FLOW_W0_SRC_L3_IF_VALID;
+		val[0] |= FIELD_PREP(PPE_FLOW_W0_SRC_L3_IF, flow->src_l3_if);
+	}
 	val[0] |= FIELD_PREP(PPE_FLOW_W0_FWD_TYPE, flow->fwd_type);
 	val[1] = FIELD_PREP(PPE_FLOW_W1_NEXT_HOP, flow->nexthop);
 	val[1] |= FIELD_PREP(PPE_FLOW_W1_L4_PORT,
@@ -225,20 +254,26 @@ static void ppe_flow_entry_pack(const st
 }
 
 int ppe_host_entry_add(struct ppe_device *ppe_dev,
-		       const struct ppe_flow_entry *flow)
+		       const struct ppe_flow_entry *flow,
+		       struct ppe_flow_op_result *result)
 {
 	u32 host[PPE_HOST_TBL_OP_DATA_WORDS] = {};
 	int ret;
 
+	memset(result, 0, sizeof(*result));
+	result->index = -1;
 	ppe_host_entry_pack(flow, host);
 	mutex_lock(&ppe_dev->flow_lock);
 	ret = regmap_bulk_write(ppe_dev->regmap, PPE_HOST_TBL_OP_DATA_ADDR,
 				host, ARRAY_SIZE(host));
 	if (!ret)
-		ret = ppe_host_op_issue(ppe_dev, PPE_FDB_OP_TYPE_ADD, false, 0);
+		ret = ppe_host_op_issue(ppe_dev, PPE_FDB_OP_TYPE_ADD, false, 0,
+					 result);
 	mutex_unlock(&ppe_dev->flow_lock);
 	if (ret >= ppe_dev->variant->num_host_entries)
 		return -ERANGE;
+	if (ret >= 0)
+		result->index = ret;
 	return ret;
 }
 
@@ -250,43 +285,44 @@ int ppe_host_entry_del(struct ppe_device
 		return -EINVAL;
 
 	mutex_lock(&ppe_dev->flow_lock);
-	ret = ppe_host_op_issue(ppe_dev, PPE_FDB_OP_TYPE_DEL, true, index);
+	ret = ppe_host_op_issue(ppe_dev, PPE_FDB_OP_TYPE_DEL, true, index, NULL);
 	mutex_unlock(&ppe_dev->flow_lock);
 	return ret < 0 ? ret : 0;
 }
 
 int ppe_flow_entry_add(struct ppe_device *ppe_dev,
-		       const struct ppe_flow_entry *flow)
+		       const struct ppe_flow_entry *flow,
+		       struct ppe_flow_op_result *result)
 {
 	u32 qos[PPE_QOS_MAPPING_TBL_WORDS] = {};
 	u32 val[PPE_FLOW_TBL_OP_DATA_WORDS] = {};
 	u32 reg;
-	int del_ret, qos_ret, ret;
+	int ret;
 
+	memset(result, 0, sizeof(*result));
+	result->index = -1;
 	ppe_flow_entry_pack(flow, val);
 	mutex_lock(&ppe_dev->flow_lock);
 	ret = regmap_bulk_write(ppe_dev->regmap, PPE_FLOW_TBL_OP_DATA_ADDR,
 				val, ARRAY_SIZE(val));
 	if (!ret)
-		ret = ppe_flow_op_issue(ppe_dev, PPE_FDB_OP_TYPE_ADD, false, 0);
+		ret = ppe_flow_op_issue(ppe_dev, PPE_FDB_OP_TYPE_ADD, false, 0,
+					 result);
 	if (ret >= 0 && ret < ppe_dev->variant->num_flow_entries) {
+		/* Preserve the installed row even when the side-table write fails.
+		 * Only the flowtable can retain or release all of its dependencies.
+		 */
+		result->index = ret;
 		reg = PPE_QOS_MAPPING_TBL_ADDR +
 		      PPE_QOS_MAPPING_TBL_INC * ret;
 		if (flow->priority_valid)
 			qos[0] = PPE_QOS_MAPPING_W0_INT_PRI_EN |
 				 FIELD_PREP(PPE_QOS_MAPPING_W0_INT_PRI,
 					    flow->priority);
-		qos_ret = regmap_bulk_write(ppe_dev->regmap, reg, qos,
-					    ARRAY_SIZE(qos));
-		if (qos_ret) {
-			del_ret = ppe_flow_op_issue(ppe_dev, PPE_FDB_OP_TYPE_DEL,
-						    true, ret);
-			if (del_ret < 0 && del_ret != -ENOENT)
-				dev_err(ppe_dev->dev,
-					"failed to remove flow %d after QoS write error: %d\n",
-					ret, del_ret);
-			ret = qos_ret;
-		}
+		ret = regmap_bulk_write(ppe_dev->regmap, reg, qos,
+					ARRAY_SIZE(qos));
+		if (!ret)
+			ret = result->index;
 	}
 	mutex_unlock(&ppe_dev->flow_lock);
 	if (ret >= ppe_dev->variant->num_flow_entries)
@@ -397,7 +433,7 @@ int ppe_flow_entry_del(struct ppe_device
 		return -EINVAL;
 
 	mutex_lock(&ppe_dev->flow_lock);
-	ret = ppe_flow_op_issue(ppe_dev, PPE_FDB_OP_TYPE_DEL, true, index);
+	ret = ppe_flow_op_issue(ppe_dev, PPE_FDB_OP_TYPE_DEL, true, index, NULL);
 	if (ret >= 0 || ret == -ENOENT) {
 		reg = PPE_QOS_MAPPING_TBL_ADDR +
 		      PPE_QOS_MAPPING_TBL_INC * index;
@@ -457,14 +493,12 @@ int ppe_my_mac_set(struct ppe_device *pp
 		   bool valid)
 {
 	u32 reg = PPE_MY_MAC_TBL_ADDR + PPE_MY_MAC_TBL_INC * index;
-	u32 my_mac_mask;
 	u32 val[2] = {};
 	int i, ret;
 
 	if (index < 0 || index >= PPE_MY_MAC_TBL_ENTRIES)
 		return -EINVAL;
 
-	my_mac_mask = FIELD_PREP(PPE_IN_L3_IF_W1_MAC_BITMAP, BIT(index));
 	if (valid) {
 		val[0] = (u32)addr[2] << 24 | addr[3] << 16 |
 			 addr[4] << 8 | addr[5];
@@ -476,10 +510,7 @@ int ppe_my_mac_set(struct ppe_device *pp
 		 * interface which used its previous address.
 		 */
 		for (i = 0; i < PPE_IN_L3_IF_TBL_ENTRIES; i++) {
-			reg = PPE_IN_L3_IF_TBL_ADDR +
-			      PPE_IN_L3_IF_TBL_INC * i + sizeof(u32);
-			ret = regmap_update_bits(ppe_dev->regmap, reg,
-						 my_mac_mask, 0);
+			ret = ppe_l3_if_my_mac_set(ppe_dev, i, index, false);
 			if (ret)
 				return ret;
 		}
@@ -515,10 +546,12 @@ int ppe_l3_if_set(struct ppe_device *ppe
 	u32 reg;
 	int ret;
 
+	mutex_lock(&ppe_dev->l3_if_lock);
+
 	reg = PPE_IN_L3_IF_TBL_ADDR + PPE_IN_L3_IF_TBL_INC * index;
 	ret = regmap_bulk_read(ppe_dev->regmap, reg, in, ARRAY_SIZE(in));
 	if (ret)
-		return ret;
+		goto unlock;
 
 	in[0] &= ~(PPE_IN_L3_IF_W0_MRU | PPE_IN_L3_IF_W0_MTU |
 		   PPE_IN_L3_IF_W0_TTL_DEC_BYPASS |
@@ -549,7 +582,7 @@ int ppe_l3_if_set(struct ppe_device *ppe
 
 	ret = regmap_bulk_write(ppe_dev->regmap, reg, in, ARRAY_SIZE(in));
 	if (ret)
-		return ret;
+		goto unlock;
 
 	eg[0] = (u32)addr[2] << 24 | addr[3] << 16 | addr[4] << 8 | addr[5];
 	eg[1] = FIELD_PREP(PPE_EG_L3_IF_W1_MAC_ADDR_HI,
@@ -562,22 +595,54 @@ int ppe_l3_if_set(struct ppe_device *ppe
 
 	reg = PPE_EG_L3_IF_TBL_ADDR + PPE_EG_L3_IF_TBL_INC * index;
 
-	return regmap_bulk_write(ppe_dev->regmap, reg, eg, ARRAY_SIZE(eg));
+	ret = regmap_bulk_write(ppe_dev->regmap, reg, eg, ARRAY_SIZE(eg));
+unlock:
+	mutex_unlock(&ppe_dev->l3_if_lock);
+	return ret;
 }
 
 int ppe_l3_if_my_mac_set(struct ppe_device *ppe_dev, int index, int my_mac,
 			 bool enable)
 {
-	u32 reg = PPE_IN_L3_IF_TBL_ADDR + PPE_IN_L3_IF_TBL_INC * index +
-		  sizeof(u32);
-	u32 mask;
+	u32 reg = PPE_IN_L3_IF_TBL_ADDR + PPE_IN_L3_IF_TBL_INC * index;
+	u32 val[3], readback[3], mask;
+	int ret;
 
-	if (my_mac < 0 || my_mac >= PPE_MY_MAC_TBL_ENTRIES)
+	if (index < 0 || index >= PPE_IN_L3_IF_TBL_ENTRIES ||
+	    my_mac < 0 || my_mac >= PPE_MY_MAC_TBL_ENTRIES)
 		return -EINVAL;
 
+	mutex_lock(&ppe_dev->l3_if_lock);
 	mask = FIELD_PREP(PPE_IN_L3_IF_W1_MAC_BITMAP, BIT(my_mac));
-	return regmap_update_bits(ppe_dev->regmap, reg, mask,
-				  enable ? mask : 0);
+	ret = regmap_bulk_read(ppe_dev->regmap, reg, val, ARRAY_SIZE(val));
+	if (ret)
+		goto unlock;
+	if (!!(val[1] & mask) == enable) {
+		ret = 0;
+		goto unlock;
+	}
+
+	/* Use the SSDK table transaction, preserving route/MTU/PPPoE state.
+	 * A successful MMIO write alone does not prove that the binding stuck.
+	 */
+	val[1] = (val[1] & ~mask) | (enable ? mask : 0);
+	ret = regmap_bulk_write(ppe_dev->regmap, reg, val, ARRAY_SIZE(val));
+	if (ret)
+		goto unlock;
+	ret = regmap_bulk_read(ppe_dev->regmap, reg, readback, ARRAY_SIZE(readback));
+	if (ret)
+		goto unlock;
+	if ((readback[1] & mask) != (val[1] & mask)) {
+		dev_err_ratelimited(ppe_dev->dev,
+				    "L3 MAC binding mismatch: l3=%d mac=%d want=%08x read=%08x\n",
+				    index, my_mac, val[1], readback[1]);
+		ret = -EIO;
+		goto unlock;
+	}
+
+unlock:
+	mutex_unlock(&ppe_dev->l3_if_lock);
+	return ret;
 }
 
 int ppe_l3_if_clear(struct ppe_device *ppe_dev, int index)
@@ -586,13 +651,18 @@ int ppe_l3_if_clear(struct ppe_device *p
 	u32 reg;
 	int ret;
 
+	mutex_lock(&ppe_dev->l3_if_lock);
+
 	reg = PPE_IN_L3_IF_TBL_ADDR + PPE_IN_L3_IF_TBL_INC * index;
 	ret = regmap_bulk_write(ppe_dev->regmap, reg, val, ARRAY_SIZE(val));
 	if (ret)
-		return ret;
+		goto unlock;
 
 	reg = PPE_EG_L3_IF_TBL_ADDR + PPE_EG_L3_IF_TBL_INC * index;
-	return regmap_bulk_write(ppe_dev->regmap, reg, val, ARRAY_SIZE(val));
+	ret = regmap_bulk_write(ppe_dev->regmap, reg, val, ARRAY_SIZE(val));
+unlock:
+	mutex_unlock(&ppe_dev->l3_if_lock);
+	return ret;
 }
 
 /**
@@ -603,15 +673,16 @@ int ppe_l3_if_clear(struct ppe_device *p
  * @sid: PPPoE session ID
  * @peer: PPPoE peer/server MAC address
  * @l3_if: L3 interface assigned to the terminated packets
+ * @port: Physical ingress port or virtual port below the session
  *
- * Match the session on every PPE ingress port by SID and peer MAC, as
- * the vendor interface-lifecycle transaction does. Both unicast and
- * multicast session traffic resolves to the PPPoE L3 interface.
+ * Match SID and peer on the physical or virtual port owned by this session.
+ * Both unicast and multicast traffic resolves to the PPPoE L3 interface.
  *
  * Return: 0 on success, negative error code on failure.
  */
 int ppe_pppoe_session_set(struct ppe_device *ppe_dev, int index,
-			  bool enable, u16 sid, const u8 *peer, int l3_if)
+			  bool enable, u16 sid, const u8 *peer, int l3_if,
+			  int port)
 {
 	u32 ext2_mask = PPE_PPPOE_SESSION_EXT2_L3_IF_VALID |
 			PPE_PPPOE_SESSION_EXT2_L3_IF;
@@ -619,7 +690,13 @@ int ppe_pppoe_session_set(struct ppe_dev
 	u32 val, ext, ext1, ext2;
 	int ret = 0, err;
 
-	if (index >= ppe_dev->variant->num_pppoe_sessions)
+	if (index < 0 || index >= ppe_dev->variant->num_pppoe_sessions)
+		return -EINVAL;
+	if (enable && (!peer || l3_if < 0 ||
+		       l3_if >= PPE_IN_L3_IF_TBL_ENTRIES || port < 0 ||
+		       ((unsigned int)port >= ppe_dev->num_ports &&
+			(port < PPE_VP_PORT_BASE ||
+			 port >= PPE_VP_PORT_BASE + PPE_VP_SLOTS))))
 		return -EINVAL;
 
 	base_reg = PPE_PPPOE_SESSION_ADDR + PPE_PPPOE_SESSION_INC * index;
@@ -646,9 +723,12 @@ int ppe_pppoe_session_set(struct ppe_dev
 		return ret;
 	}
 
-	val = FIELD_PREP(PPE_PPPOE_SESSION_SESSION_ID, sid) |
-	      FIELD_PREP(PPE_PPPOE_SESSION_PORT_BITMAP,
-			 FIELD_MAX(PPE_PPPOE_SESSION_PORT_BITMAP));
+	val = FIELD_PREP(PPE_PPPOE_SESSION_SESSION_ID, sid);
+	if (port >= PPE_VP_PORT_BASE)
+		val |= FIELD_PREP(PPE_PPPOE_SESSION_PORT_TYPE, 1) |
+		       FIELD_PREP(PPE_PPPOE_SESSION_PORT_BITMAP, port);
+	else
+		val |= FIELD_PREP(PPE_PPPOE_SESSION_PORT_BITMAP, BIT(port));
 	ext = PPE_PPPOE_SESSION_EXT_MC_VALID |
 	      PPE_PPPOE_SESSION_EXT_UC_VALID |
 	      PPE_PPPOE_SESSION_EXT_SMAC_VALID |
@@ -694,13 +774,26 @@ rollback:
 int ppe_vsi_l3_if_set(struct ppe_device *ppe_dev, int vsi, int l3_if)
 {
 	u32 reg = PPE_L3_VSI_ADDR + PPE_L3_VSI_INC * vsi;
-	u32 val = 0;
+	u32 mask = PPE_L3_VSI_L3_IF_VALID | PPE_L3_VSI_L3_IF_INDEX;
+	u32 val = 0, readback;
+	int ret;
+
+	if (vsi < 0 || vsi >= PPE_VSI_TBL_ENTRIES ||
+	    l3_if >= PPE_IN_L3_IF_TBL_ENTRIES)
+		return -EINVAL;
 
 	if (l3_if >= 0)
 		val = PPE_L3_VSI_L3_IF_VALID |
 		      FIELD_PREP(PPE_L3_VSI_L3_IF_INDEX, l3_if);
 
-	return regmap_write(ppe_dev->regmap, reg, val);
+	ret = regmap_update_bits(ppe_dev->regmap, reg, mask, val);
+	if (ret)
+		return ret;
+	ret = regmap_read(ppe_dev->regmap, reg, &readback);
+	if (ret)
+		return ret;
+
+	return (readback & mask) == val ? 0 : -EIO;
 }
 
 /**
@@ -716,9 +809,13 @@ int ppe_port_l3_if_set(struct ppe_device
 	u32 reg = PPE_L3_VP_PORT_TBL_ADDR + PPE_L3_VP_PORT_TBL_INC * port;
 	u32 mask = PPE_L3_VP_PORT_W0_L3_IF_VALID |
 		   PPE_L3_VP_PORT_W0_L3_IF_INDEX;
-	u32 val[4];
+	u32 val[4], readback;
 	int ret;
 
+	if (port < 0 || port >= PPE_L3_VP_PORT_TBL_ENTRIES ||
+	    l3_if >= PPE_IN_L3_IF_TBL_ENTRIES)
+		return -EINVAL;
+
 	ret = regmap_bulk_read(ppe_dev->regmap, reg, val, ARRAY_SIZE(val));
 	if (ret)
 		return ret;
@@ -729,7 +826,14 @@ int ppe_port_l3_if_set(struct ppe_device
 		val[0] |= PPE_L3_VP_PORT_W0_L3_IF_VALID |
 			  FIELD_PREP(PPE_L3_VP_PORT_W0_L3_IF_INDEX, l3_if);
 
-	return regmap_bulk_write(ppe_dev->regmap, reg, val, ARRAY_SIZE(val));
+	ret = regmap_bulk_write(ppe_dev->regmap, reg, val, ARRAY_SIZE(val));
+	if (ret)
+		return ret;
+	ret = regmap_read(ppe_dev->regmap, reg, &readback);
+	if (ret)
+		return ret;
+
+	return (readback & mask) == (val[0] & mask) ? 0 : -EIO;
 }
 
 /**
@@ -800,6 +904,7 @@ int ppe_flow_hw_init(struct ppe_device *
 	int type, ret;
 
 	mutex_init(&ppe_dev->flow_lock);
+	mutex_init(&ppe_dev->l3_if_lock);
 
 	/* The result register resets to command id 0, so start the rolling
 	 * id at 1: otherwise the first operation's completion poll matches
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flow.h
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flow.h
@@ -17,6 +17,15 @@
 
 struct ppe_device;
 
+/* Copied command completion, owned by one caller and never read back twice. */
+struct ppe_flow_op_result {
+	u32 command;
+	u32 result;
+	u32 result_reg;
+	int index;
+	bool result_valid;
+};
+
 /**
  * struct ppe_flow_nexthop - Next hop configuration of a flow.
  * @port: Egress PPE port.
@@ -55,6 +64,8 @@ struct ppe_flow_nexthop {
  * @pmtu: Path MTU of the egress device of the flow.
  * @priority: Internal priority selected by the flow QoS result.
  * @priority_valid: Whether the rule carries an explicit priority action.
+ * @src_l3_if: Ingress routing interface selected by port, VLAN, PPPoE or VP.
+ * @src_l3_if_valid: Restrict hits to that ingress routing interface.
  */
 struct ppe_flow_entry {
 	union {
@@ -72,6 +83,8 @@ struct ppe_flow_entry {
 	u16 pmtu;
 	u8 priority;
 	bool priority_valid;
+	u8 src_l3_if;
+	bool src_l3_if_valid;
 };
 
 int ppe_flow_hw_init(struct ppe_device *ppe_dev);
