From: ViKing <viking.yfy@qq.com>
Date: Wed, 11 Nov 2026 16:11:45 +0800
Subject: [PATCH] net: ppe: own RX buffers and NAPI during teardown

Balance RX DMA mapping and partial-frame lifetime. Serialize NAPI completion and interrupt rearming, and retain bounded low-memory allocation with diagnostics.

Split from:
  0642-net-ethernet-qualcomm-ppe-fix-edma-resource-lifecycle.patch - net: ethernet: qualcomm: ppe: fix EDMA resource lifecycle
  0643-net-ethernet-qualcomm-ppe-bound-low-memory-rx-allocation.patch - net: ethernet: qualcomm: ppe: bound low-memory RX allocation

Merged from:
  0642-net-ethernet-qualcomm-ppe-fix-edma-resource-lifecycle.patch - net: ethernet: qualcomm: ppe: fix EDMA resource lifecycle
  0643-net-ethernet-qualcomm-ppe-bound-low-memory-rx-allocation.patch - net: ethernet: qualcomm: ppe: bound low-memory RX allocation

Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/drivers/net/ethernet/qualcomm/ppe/edma_cfg_rx.c
+++ b/drivers/net/ethernet/qualcomm/ppe/edma_cfg_rx.c
@@ -43,22 +43,6 @@ static u32 edma_rx_ring_queue_map[][EDMA
 						{ 6, 14, 22, 30 },
 						{ 7, 15, 23, 31 }};
 
-static void edma_cfg_rx_unmap_buffer(struct device *dev,
-				     struct edma_rxfill_ring *rxfill_ring,
-				     dma_addr_t dma_addr)
-{
-	u32 dma_map_size;
-
-	if (rxfill_ring->page_mode) {
-		dma_unmap_page(dev, dma_addr, PAGE_SIZE, DMA_FROM_DEVICE);
-		return;
-	}
-
-	dma_map_size = rxfill_ring->alloc_size -
-		       EDMA_RX_SKB_HEADROOM - NET_IP_ALIGN;
-	dma_unmap_single(dev, dma_addr, dma_map_size, DMA_FROM_DEVICE);
-}
-
 u32 edma_cfg_rx_rps_bitmap_cores = EDMA_RX_DEFAULT_BITMAP;
 
 static int edma_cfg_rx_desc_rings_reset_queue_mapping(void)
@@ -428,7 +412,10 @@ static void edma_cfg_rx_fill_ring_cleanu
 	struct regmap *regmap = ppe_dev->regmap;
 	struct device *dev = ppe_dev->dev;
 	u16 cons_idx, curr_idx;
-	u32 data, reg;
+	u32 data = 0, reg;
+
+	if (!rxfill_ring->desc)
+		return;
 
 	/* Get RxFill ring producer index */
 	curr_idx = rxfill_ring->prod_idx & EDMA_RXFILL_PROD_IDX_MASK;
@@ -457,7 +444,7 @@ static void edma_cfg_rx_fill_ring_cleanu
 		}
 
 		dma_addr = EDMA_RXFILL_BUFFER_ADDR_GET(rxfill_desc);
-		edma_cfg_rx_unmap_buffer(dev, rxfill_ring, dma_addr);
+		edma_rx_dma_unmap(rxfill_ring, dma_addr);
 		dev_kfree_skb_any(skb);
 	}
 
@@ -516,7 +503,10 @@ static void edma_cfg_rx_desc_ring_cleanu
 	struct ppe_device *ppe_dev = edma_ctx->ppe_dev;
 	struct regmap *regmap = ppe_dev->regmap;
 	struct device *dev = ppe_dev->dev;
-	u32 prod_idx, cons_idx, reg;
+	u32 prod_idx = 0, cons_idx, reg;
+
+	if (!rxdesc_ring->pdesc)
+		return;
 
 	/* Get Rxdesc consumer & producer indices */
 	cons_idx = rxdesc_ring->cons_idx & EDMA_RXDESC_CONS_IDX_MASK;
@@ -544,10 +534,17 @@ static void edma_cfg_rx_desc_ring_cleanu
 		}
 
 		dma_addr = EDMA_RXDESC_BUFFER_ADDR_GET(rxdesc_pri);
-		edma_cfg_rx_unmap_buffer(dev, rxdesc_ring->rxfill, dma_addr);
+		edma_rx_dma_unmap(rxdesc_ring->rxfill, dma_addr);
 		dev_kfree_skb_any(skb);
 	}
 
+	/* Reassembled segments have already been unmapped by RX reap. */
+	dev_kfree_skb_any(rxdesc_ring->head);
+	rxdesc_ring->head = NULL;
+	rxdesc_ring->last = NULL;
+	rxdesc_ring->pdesc_head = NULL;
+	rxdesc_ring->vp_punt_src = -1;
+
 	/* Update the consumer index */
 	reg = EDMA_BASE_OFFSET + EDMA_REG_RXDESC_CONS_IDX(rxdesc_ring->ring_id);
 	regmap_write(regmap, reg, cons_idx);
@@ -572,7 +569,8 @@ static int edma_cfg_rx_rings_setup(void)
 	struct edma_hw_info *hw_info = edma_ctx->hw_info;
 	struct edma_ring_info *rxfill = hw_info->rxfill;
 	struct edma_ring_info *rx = hw_info->rx;
-	u32 ring_idx, alloc_size, buf_len;
+	u32 alloc_size, buf_len;
+	int ring_idx;
 
 	/* Set buffer allocation size */
 	if (edma_ctx->rx_buf_size) {
@@ -623,6 +621,7 @@ static int edma_cfg_rx_rings_setup(void)
 		rxdesc_ring = &edma_ctx->rx_rings[ring_idx];
 		rxdesc_ring->count = EDMA_RX_RING_SIZE;
 		rxdesc_ring->ring_id = rx->ring_start + ring_idx;
+		spin_lock_init(&rxdesc_ring->irq_lock);
 		rxdesc_ring->vp_punt_src = -1;
 
 		if (queue_id > EDMA_CPU_PORT_QUEUE_MAX(EDMA_RX_QUEUE_START)) {
@@ -804,11 +803,11 @@ void edma_cfg_rx_rings_cleanup(void)
 	u32 i;
 
 	/* Free RxFill ring descriptors */
-	for (i = 0; i < rxfill->num_rings; i++)
+	for (i = 0; edma_ctx->rxfill_rings && i < rxfill->num_rings; i++)
 		edma_cfg_rx_fill_ring_cleanup(&edma_ctx->rxfill_rings[i]);
 
 	/* Free Rx completion ring descriptors */
-	for (i = 0; i < rx->num_rings; i++)
+	for (i = 0; edma_ctx->rx_rings && i < rx->num_rings; i++)
 		edma_cfg_rx_desc_ring_cleanup(&edma_ctx->rx_rings[i]);
 
 	kfree(edma_ctx->rxfill_rings);
@@ -853,13 +852,17 @@ void edma_cfg_rx_disable_interrupts(void
 	struct ppe_device *ppe_dev = edma_ctx->ppe_dev;
 	struct regmap *regmap = ppe_dev->regmap;
 	struct edma_ring_info *rx = hw_info->rx;
+	unsigned long flags;
 	u32 i, reg;
 
 	for (i = 0; i < rx->num_rings; i++) {
 		struct edma_rxdesc_ring *rxdesc_ring =
 				&edma_ctx->rx_rings[i];
+		spin_lock_irqsave(&rxdesc_ring->irq_lock, flags);
+		rxdesc_ring->irq_enabled = false;
 		reg = EDMA_BASE_OFFSET + EDMA_REG_RXDESC_INT_MASK(rxdesc_ring->ring_id);
 		regmap_write(regmap, reg, EDMA_MASK_INT_CLEAR);
+		spin_unlock_irqrestore(&rxdesc_ring->irq_lock, flags);
 	}
 }
 
@@ -874,13 +877,17 @@ void edma_cfg_rx_enable_interrupts(void)
 	struct ppe_device *ppe_dev = edma_ctx->ppe_dev;
 	struct regmap *regmap = ppe_dev->regmap;
 	struct edma_ring_info *rx = hw_info->rx;
+	unsigned long flags;
 	u32 i, reg;
 
 	for (i = 0; i < rx->num_rings; i++) {
 		struct edma_rxdesc_ring *rxdesc_ring =
 				&edma_ctx->rx_rings[i];
+		spin_lock_irqsave(&rxdesc_ring->irq_lock, flags);
+		rxdesc_ring->irq_enabled = true;
 		reg = EDMA_BASE_OFFSET + EDMA_REG_RXDESC_INT_MASK(rxdesc_ring->ring_id);
 		regmap_write(regmap, reg, edma_ctx->intr_info.intr_mask_rx);
+		spin_unlock_irqrestore(&rxdesc_ring->irq_lock, flags);
 	}
 }
 
@@ -900,10 +907,11 @@ void edma_cfg_rx_napi_disable(void)
 
 		rxdesc_ring = &edma_ctx->rx_rings[i];
 
-		if (!rxdesc_ring->napi_added)
+		if (!rxdesc_ring->napi_enabled)
 			continue;
 
 		napi_disable(&rxdesc_ring->napi);
+		rxdesc_ring->napi_enabled = false;
 	}
 }
 
@@ -923,10 +931,11 @@ void edma_cfg_rx_napi_enable(void)
 
 		rxdesc_ring = &edma_ctx->rx_rings[i];
 
-		if (!rxdesc_ring->napi_added)
+		if (!rxdesc_ring->napi_added || rxdesc_ring->napi_enabled)
 			continue;
 
 		napi_enable(&rxdesc_ring->napi);
+		rxdesc_ring->napi_enabled = true;
 	}
 }
 
@@ -949,7 +958,10 @@ void edma_cfg_rx_napi_delete(void)
 		if (!rxdesc_ring->napi_added)
 			continue;
 
-		napi_disable(&rxdesc_ring->napi);
+		if (rxdesc_ring->napi_enabled) {
+			napi_disable(&rxdesc_ring->napi);
+			rxdesc_ring->napi_enabled = false;
+		}
 		netif_napi_del(&rxdesc_ring->napi);
 		rxdesc_ring->napi_added = false;
 	}
--- a/drivers/net/ethernet/qualcomm/ppe/edma_debugfs.c
+++ b/drivers/net/ethernet/qualcomm/ppe/edma_debugfs.c
@@ -108,6 +108,9 @@ static int edma_debugfs_rx_rings_stats_s
 	}
 
 	seq_puts(m, "\n#EDMA RX fill rings stats:\n\n");
+	seq_printf(m, "rx_allocator=%s rxfill_rings=%u\n",
+		   edma_ctx->rx_slab ? "slab" : "page_frag",
+		   rxfill->num_rings);
 	for (i = 0; i < rxfill->num_rings; i++) {
 		seq_printf(m, "\t\tEDMA RX fill %d ring stats:\n", i + rxfill->ring_start);
 		seq_printf(m, "\t\t rxfill[%d]:alloc_failed = %llu\n",
@@ -317,13 +320,10 @@ static const struct file_operations edma
 /**
  * edma_debugfs_teardown - EDMA debugfs teardown.
  *
- * EDMA debugfs teardown and free stats memory.
+ * EDMA debugfs teardown.
  */
 void edma_debugfs_teardown(void)
 {
-	/* Free EDMA miscellaneous stats memory */
-	edma_err_stats_free();
-
 	debugfs_remove_recursive(edma_dentry);
 	edma_dentry = NULL;
 	stats_dentry = NULL;
@@ -361,12 +361,6 @@ int edma_debugfs_setup(struct ppe_device
 		goto debugfs_dir_failed;
 	}
 
-	/* Allocate memory for EDMA miscellaneous stats */
-	if (edma_err_stats_alloc() < 0) {
-		pr_err("Unable to allocate miscellaneous percpu stats\n");
-		goto debugfs_dir_failed;
-	}
-
 	if (!debugfs_create_file("err_stats", 0444, stats_dentry,
 				 NULL, &edma_debugfs_misc_file_ops)) {
 		pr_err("Unable to create EDMA miscellaneous statistics file entry in debugfs\n");
--- a/drivers/net/ethernet/qualcomm/ppe/edma_rx.c
+++ b/drivers/net/ethernet/qualcomm/ppe/edma_rx.c
@@ -28,6 +28,20 @@
 static bool edma_rx_deliver_vp(struct edma_rxdesc_pri *rxdesc_pri,
 			       struct sk_buff *skb);
 
+static struct sk_buff *edma_rx_alloc_skb(unsigned int len)
+{
+	struct sk_buff *skb;
+
+	if (!edma_ctx->rx_slab)
+		return dev_alloc_skb(len);
+
+	skb = __alloc_skb(len + NET_SKB_PAD, GFP_ATOMIC,
+			  SKB_ALLOC_RX, NUMA_NO_NODE);
+	if (skb)
+		skb_reserve(skb, NET_SKB_PAD);
+	return skb;
+}
+
 static int edma_rx_alloc_buffer_list(struct edma_rxfill_ring *rxfill_ring, int alloc_count)
 {
 	struct edma_rxfill_stats *rxfill_stats = &rxfill_ring->rxfill_stats;
@@ -54,7 +68,7 @@ static int edma_rx_alloc_buffer_list(str
 
 		rxfill_desc = EDMA_RXFILL_DESC(rxfill_ring, prod_idx);
 
-		skb = dev_alloc_skb(rx_alloc_size);
+		skb = edma_rx_alloc_skb(rx_alloc_size);
 		if (unlikely(!skb)) {
 			u64_stats_update_begin(&rxfill_stats->syncp);
 			++rxfill_stats->alloc_failed;
@@ -120,6 +134,18 @@ static int edma_rx_alloc_buffer_list(str
 	return num_alloc;
 }
 
+void edma_rx_dma_unmap(struct edma_rxfill_ring *ring, dma_addr_t dma)
+{
+	struct device *dev = edma_ctx->ppe_dev->dev;
+
+	if (ring->page_mode)
+		dma_unmap_page(dev, dma, PAGE_SIZE, DMA_FROM_DEVICE);
+	else
+		dma_unmap_single(dev, dma,
+				 ring->alloc_size - EDMA_RX_SKB_HEADROOM - NET_IP_ALIGN,
+				 DMA_FROM_DEVICE);
+}
+
 /**
  * edma_rx_alloc_buffer - EDMA Rx alloc buffer.
  * @rxfill_ring: EDMA Rxfill ring
@@ -634,12 +660,10 @@ static struct net_device *edma_rx_get_sr
 static int edma_rx_reap(struct edma_rxdesc_ring *rxdesc_ring, int budget)
 {
 	struct edma_rxdesc_stats *rxdesc_stats = &rxdesc_ring->rxdesc_stats;
-	u32 alloc_size = rxdesc_ring->rxfill->alloc_size;
 	bool page_mode = rxdesc_ring->rxfill->page_mode;
 	struct ppe_device *ppe_dev = edma_ctx->ppe_dev;
 	struct edma_rxdesc_pri *next_rxdesc_pri;
 	struct regmap *regmap = ppe_dev->regmap;
-	struct device *dev = ppe_dev->dev;
 	u32 prod_idx, cons_idx, end_idx;
 	u32 work_to_do, work_done = 0;
 	struct sk_buff *next_skb;
@@ -675,17 +699,11 @@ static int edma_rx_reap(struct edma_rxde
 		struct net_device *ndev;
 		struct sk_buff *skb;
 		dma_addr_t dma_addr;
-		u32 dma_map_size;
 
 		skb = next_skb;
 		rxdesc_pri = next_rxdesc_pri;
 		dma_addr = EDMA_RXDESC_BUFFER_ADDR_GET(rxdesc_pri);
-		dma_map_size = alloc_size - EDMA_RX_SKB_HEADROOM - NET_IP_ALIGN;
-
-		if (!page_mode)
-			dma_unmap_single(dev, dma_addr, dma_map_size, DMA_FROM_DEVICE);
-		else
-			dma_unmap_page(dev, dma_addr, PAGE_SIZE, DMA_FROM_DEVICE);
+		edma_rx_dma_unmap(rxdesc_ring->rxfill, dma_addr);
 
 		/* Update consumer index. */
 		cons_idx = (cons_idx + 1) & EDMA_RX_RING_SIZE_MASK;
@@ -811,6 +829,7 @@ int edma_rx_napi_poll(struct napi_struct
 	struct edma_rxdesc_ring *rxdesc_ring = (struct edma_rxdesc_ring *)napi;
 	struct ppe_device *ppe_dev = edma_ctx->ppe_dev;
 	struct regmap *regmap = ppe_dev->regmap;
+	unsigned long flags;
 	int work_done = 0;
 	u32 status, reg;
 
@@ -825,10 +844,13 @@ int edma_rx_napi_poll(struct napi_struct
 		status = status & EDMA_RXDESC_RING_INT_STATUS_MASK;
 	} while (likely(status));
 
-	napi_complete(napi);
-
-	reg = EDMA_BASE_OFFSET + EDMA_REG_RXDESC_INT_MASK(rxdesc_ring->ring_id);
-	regmap_write(regmap, reg, edma_ctx->intr_info.intr_mask_rx);
+	/* Hold through completion: stop cannot race the final IRQ rearm. */
+	spin_lock_irqsave(&rxdesc_ring->irq_lock, flags);
+	if (napi_complete_done(napi, work_done) && rxdesc_ring->irq_enabled) {
+		reg = EDMA_BASE_OFFSET + EDMA_REG_RXDESC_INT_MASK(rxdesc_ring->ring_id);
+		regmap_write(regmap, reg, edma_ctx->intr_info.intr_mask_rx);
+	}
+	spin_unlock_irqrestore(&rxdesc_ring->irq_lock, flags);
 
 	return work_done;
 }
@@ -847,14 +869,18 @@ irqreturn_t edma_rx_handle_irq(int irq,
 	struct edma_rxdesc_ring *rxdesc_ring = (struct edma_rxdesc_ring *)ctx;
 	struct ppe_device *ppe_dev = edma_ctx->ppe_dev;
 	struct regmap *regmap = ppe_dev->regmap;
+	unsigned long flags;
 	u32 reg;
 
-	if (likely(napi_schedule_prep(&rxdesc_ring->napi))) {
+	spin_lock_irqsave(&rxdesc_ring->irq_lock, flags);
+	if (rxdesc_ring->irq_enabled && napi_schedule_prep(&rxdesc_ring->napi)) {
 		/* Disable RxDesc interrupt. */
 		reg = EDMA_BASE_OFFSET + EDMA_REG_RXDESC_INT_MASK(rxdesc_ring->ring_id);
 		regmap_write(regmap, reg, EDMA_MASK_INT_DISABLE);
 		__napi_schedule(&rxdesc_ring->napi);
 	}
 
+	spin_unlock_irqrestore(&rxdesc_ring->irq_lock, flags);
+
 	return IRQ_HANDLED;
 }
--- a/drivers/net/ethernet/qualcomm/ppe/edma_rx.h
+++ b/drivers/net/ethernet/qualcomm/ppe/edma_rx.h
@@ -277,6 +277,10 @@ struct edma_rxdesc_ring {
 	struct edma_rxdesc_stats rxdesc_stats;
 	struct edma_rxfill_ring *rxfill;
 	bool napi_added;
+	bool napi_enabled;
+	/* Serialize poll completion/IRQ scheduling with the final stop mask. */
+	spinlock_t irq_lock;
+	bool irq_enabled;
 	dma_addr_t pdma;
 	dma_addr_t sdma;
 	struct sk_buff *head;
@@ -289,6 +293,7 @@ extern int edma_rx_mitigation_timer;
 extern int edma_rx_mitigation_pkt_cnt;
 
 irqreturn_t edma_rx_handle_irq(int irq, void *ctx);
+void edma_rx_dma_unmap(struct edma_rxfill_ring *ring, dma_addr_t dma);
 int edma_rx_alloc_buffer(struct edma_rxfill_ring *rxfill_ring, int alloc_count);
 int edma_rx_napi_poll(struct napi_struct *napi, int budget);
 #endif
