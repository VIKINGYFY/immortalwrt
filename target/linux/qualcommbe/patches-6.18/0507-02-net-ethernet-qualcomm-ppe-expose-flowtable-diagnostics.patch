+static const char *ppe_ft_reason_name(bool cpu, int code)
+{
+	if (cpu) {
+		switch (code) {
+		case 148:
+			return "L3 route host mismatch action";
+		case 162:
+			return "L3 no-route action";
+		case 163:
+			return "L3 no-route next-hop invalid action";
+		case 167:
+			return "L3 flow miss action";
+		default:
+			return NULL;
+		}
+	}
+
+	switch (code) {
+	case 73:
+		return "L3 no-route action drop";
+	case 74:
+		return "L3 no-route next-hop invalid action drop";
+	case 77:
+		return "L3 flow action drop";
+	case 78:
+		return "L3 flow miss action drop";
+	case 80:
+		return "L2 MTU checking fail drop";
+	default:
+		return NULL;
+	}
+}
+
+static int ppe_ft_reason_counters_show(struct seq_file *seq, void *data)
+{
+	struct ppe_flowtable *ft = seq->private;
+	int index;
+
+	for (index = 0; index < PPE_DROP_CPU_CNT_TBL_ENTRIES; index++) {
+		u32 row[PPE_DROP_CPU_CNT_TBL_WORDS] = {};
+		u32 reg = PPE_DROP_CPU_CNT_TBL_ADDR +
+			  index * PPE_DROP_CPU_CNT_TBL_INC;
+		bool cpu = index < PPE_CPU_CODE_CNT_ENTRIES;
+		int offset = index - PPE_CPU_CODE_CNT_ENTRIES;
+		int code = cpu ? index : offset / PPE_DROP_CODE_PORTS;
+		int port = cpu ? -1 : offset % PPE_DROP_CODE_PORTS;
+		const char *name = ppe_ft_reason_name(cpu, code);
+		u64 bytes;
+		int err;
+
+		err = regmap_bulk_read(ft->ppe_dev->regmap, reg, row,
+				       ARRAY_SIZE(row));
+		bytes = (u64)row[2] << 32 | row[1];
+		if (!err && !row[0] && !bytes && !name)
+			continue;
+
+		if (cpu) {
+			seq_printf(seq, "cpu code:%d read:%d packets:%u",
+				   code, err, row[0]);
+			seq_printf(seq, " bytes:%llu name:%s\n",
+				   (unsigned long long)bytes,
+				   name ?: "unlabelled");
+		} else {
+			seq_printf(seq,
+				   "drop code:%d port:%d index:%d read:%d packets:%u",
+				   code, port, index, err, row[0]);
+			seq_printf(seq, " bytes:%llu name:%s\n",
+				   (unsigned long long)bytes,
+				   name ?: "unlabelled");
+		}
+	}
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(ppe_ft_reason_counters);
+
+/* Read-only debugfs view of the offloaded flows: the offload callback
+ * counters and block-bind state, then one line per installed flow with
+ * its hardware row index, the live VALID bit and the hit counters read
+ * back from the hardware. The walk runs under RCU (flows are freed
+ * through kfree_rcu) and the reads use the non-sleeping MMIO regmap.
+ * The brief zombie-count snapshot takes the flowtable mutex.
+ */
+static int ppe_ft_flows_show(struct seq_file *seq, void *data)
+{
+	struct ppe_flowtable *ft = seq->private;
+	struct rhashtable_iter iter;
+	struct ppe_ft_flow *flow;
+	struct list_head *pos;
+	int zombies = 0;
+
+	mutex_lock(&ft->lock);
+	list_for_each(pos, &ft->zombies)
+		zombies++;
+	mutex_unlock(&ft->lock);
+
+	seq_printf(seq,
+		   "bound:%d replace:%ld unsupported:%ld failed:%ld destroy:%ld zombies:%d\n",
+		   !list_empty(&ft->block_cb_list),
+		   atomic_long_read(&ft->replace_calls),
+		   atomic_long_read(&ft->replace_unsupported),
+		   atomic_long_read(&ft->replace_failed),
+		   atomic_long_read(&ft->destroy_calls), zombies);
+
+	rhashtable_walk_enter(&ft->flows, &iter);
+	rhashtable_walk_start(&iter);
+	while ((flow = rhashtable_walk_next(&iter))) {
+		u32 w0 = 0, packets = 0;
+		u64 bytes = 0;
+
+		if (IS_ERR(flow)) {
+			if (PTR_ERR(flow) == -EAGAIN)
+				continue;
+			break;
+		}
+
+		regmap_read(ft->ppe_dev->regmap,
+			    PPE_FLOW_TBL_ADDR + PPE_FLOW_TBL_INC * flow->index,
+			    &w0);
+		ppe_flow_stats_get(ft->ppe_dev, flow->index, &packets, &bytes);
+
+		seq_printf(seq, "%pI4:%u -> %pI4:%u",
+			   &flow->entry.sip,
+			   be16_to_cpu(flow->entry.sport),
+			   &flow->entry.dip,
+			   be16_to_cpu(flow->entry.dport));
+		seq_printf(seq,
+			   " proto:%u index:%d valid:%u host:%u host_dst:%u nexthop:%u packets:%u bytes:%llu\n",
+			   flow->entry.proto, flow->index,
+			   !!(w0 & PPE_FLOW_W0_VALID), flow->entry.host_index,
+			   !!(w0 & PPE_FLOW_W0_HOST_INDEX_TYPE), flow->nexthop,
+			   packets, (unsigned long long)bytes);
+	}
+	rhashtable_walk_stop(&iter);
+	rhashtable_walk_exit(&iter);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(ppe_ft_flows);
+
+/**
+ * ppe_flowtable_debugfs_init - Expose the flowtable state in debugfs
+ * @ppe_dev: PPE device
+ *
+ * Called by the PPE debugfs setup once the root directory exists.
+ * ppe_flowtable_destroy() removes the file again before the flowtable
+ * is freed, ahead of the recursive root removal.
+ */
+void ppe_flowtable_debugfs_init(struct ppe_device *ppe_dev)
+{
+	struct ppe_flowtable *ft = ppe_dev->flowtable;
+
+	if (!ft)
+		return;
+
+	ft->debugfs = debugfs_create_file("flows", 0400,
+					  ppe_dev->debugfs_root, ft,
+					  &ppe_ft_flows_fops);
+	debugfs_create_atomic_t("active_flows", 0400,
+				ppe_dev->debugfs_root, &ft->flows.nelems);
+	ft->debugfs_reasons = debugfs_create_file("reason_counters", 0400,
+						  ppe_dev->debugfs_root, ft,
+						  &ppe_ft_reason_counters_fops);
+}
+
 static int ppe_ft_block_cb(enum tc_setup_type type, void *type_data,
 			   void *cb_priv)
