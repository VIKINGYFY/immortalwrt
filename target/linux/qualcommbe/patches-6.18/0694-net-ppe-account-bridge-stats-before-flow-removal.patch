From: ViKing <viking.yfy@qq.com>
Date: Sun, 22 Nov 2026 15:45:25 +0800
Subject: [PATCH] net: ethernet: qualcomm: ppe: account upper stats before flow removal

Software bridge and VLAN counters receive PPE deltas through the flow
stats callback. A rule removed between polls can still have unsampled
traffic when its hardware row is deleted.

Read the remaining delta for a live rule after checking row ownership
and egress validity. Share the delta baseline with ordinary stats
callbacks. Keep retirement independent of counter read success and skip
accounting for failed publication.

Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flowtable.c
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flowtable.c
@@ -2750,9 +2750,54 @@ static void ppe_ft_flow_forget(struct pp
 	kfree_rcu(flow, rcu);
 }
 
+static bool ppe_ft_flow_egress_ready(struct ppe_flowtable *ft,
+				     struct ppe_ft_flow *flow)
+{
+	struct ppe_ft_dsa_path dsa = { .vid = -1 };
+
+	/* Flow hits are counted at ingress even if egress cannot deliver. */
+	if (!test_bit(flow->eport, ft->ppe_dev->carrier_ok))
+		return false;
+
+	return !flow->egress_dev ||
+	       (netif_carrier_ok(flow->egress_dev) &&
+		ppe_ft_dsa_resolve(flow->egress_dev, &dsa) >= 0 &&
+		dsa.vid == flow->egress_vid);
+}
+
+static int ppe_ft_flow_collect_stats(struct ppe_flowtable *ft,
+				     struct ppe_ft_flow *flow,
+				     struct flow_stats *stats)
+{
+	u32 packets, delta_packets;
+	u64 bytes, delta_bytes;
+	int ret;
+
+	lockdep_assert_held(&ft->lock);
+
+	ret = ppe_flow_stats_get(ft->ppe_dev, flow->index, &packets, &bytes);
+	if (ret || (packets == flow->packets && bytes == flow->bytes))
+		return ret;
+
+	/* The hardware byte counter is 40 bits wide and wraps. */
+	delta_packets = packets - flow->packets;
+	delta_bytes = (bytes - flow->bytes) & GENMASK_ULL(39, 0);
+	ppe_flow_account_update(&flow->rx_account, true,
+				delta_packets, delta_bytes);
+	ppe_flow_account_update(&flow->tx_account, false,
+				delta_packets, delta_bytes);
+	if (stats)
+		flow_stats_update(stats, delta_bytes, delta_packets, 0,
+				  jiffies, FLOW_ACTION_HW_STATS_DELAYED);
+
+	flow->packets = packets;
+	flow->bytes = bytes;
+	return 0;
+}
+
 /* Delete only while the hardware row still matches this software owner. */
 static bool ppe_ft_flow_hw_del(struct ppe_flowtable *ft,
-			       struct ppe_ft_flow *flow)
+			       struct ppe_ft_flow *flow, bool account)
 {
 	int ret;
 
@@ -2780,6 +2825,13 @@ static bool ppe_ft_flow_hw_del(struct pp
 		return false;
 	}
 
+	/* Fold the last delta before the verified hardware row is removed.
+	 * Counter read errors must not prevent retiring the row.
+	 */
+	if (account && (flow->rx_account.count || flow->tx_account.count) &&
+	    ppe_ft_flow_egress_ready(ft, flow))
+		ppe_ft_flow_collect_stats(ft, flow, NULL);
+
 	ret = ppe_flow_entry_del(ft->ppe_dev, flow->index);
 	if (!ret || ret == -ENOENT) {
 		ppe_ft_flow_owner_clear(ft, flow);
@@ -2924,7 +2976,7 @@ static int ppe_ft_flow_refresh(struct pp
 		/* The cookie now describes a different request. Withdraw
 		 * the verified old owner before installing the replacement.
 		 */
-		if (!ppe_ft_flow_hw_del(ft, old))
+		if (!ppe_ft_flow_hw_del(ft, old, true))
 			return -EIO;
 		atomic_long_inc(&ft->flow_rule_replaces);
 	} else {
@@ -4258,7 +4310,7 @@ err_added_flow:
 	}
 	goto err_host;
 err_hw_flow:
-	if (!ppe_ft_flow_hw_del(ft, flow)) {
+	if (!ppe_ft_flow_hw_del(ft, flow, false)) {
 		/* The quarantined flow retains its next-hop reference so the
 		 * shared row cannot be released or reused underneath it.
 		 */
@@ -4330,7 +4382,7 @@ static void ppe_ft_flow_destroy_locked(s
 	rhashtable_remove_fast(&ft->flows, &flow->node, ppe_ft_params);
 	ppe_ft_flow_count_dec(ft, flow);
 
-	if (ppe_ft_flow_hw_del(ft, flow)) {
+	if (ppe_ft_flow_hw_del(ft, flow, true)) {
 		ppe_ft_flow_deps_put(ft, flow);
 	} else {
 		ppe_ft_flow_quarantine(ft, flow);
@@ -4378,7 +4430,7 @@ static void ppe_ft_invalidate_locked(str
 				     struct ppe_ft_flow *flow)
 {
 	lockdep_assert_held(&ft->lock);
-	if (ppe_ft_flow_hw_del(ft, flow)) {
+	if (ppe_ft_flow_hw_del(ft, flow, true)) {
 		ppe_ft_flow_forget(ft, flow);
 	} else {
 		rhashtable_remove_fast(&ft->flows, &flow->node, ppe_ft_params);
@@ -4416,10 +4468,6 @@ static int ppe_ft_flow_stats(struct ppe_
 			     struct flow_cls_offload *f)
 {
 	struct ppe_ft_flow *flow;
-	struct ppe_ft_dsa_path dsa = { .vid = -1 };
-	int dsa_mode = -1;
-	u32 packets;
-	u64 bytes;
 	int ret;
 
 	/* Serialize the identity read with replacement and deletion. A counter
@@ -4433,24 +4481,10 @@ static int ppe_ft_flow_stats(struct ppe_
 		return -ENOENT;
 	}
 
-	if (flow->egress_dev)
-		dsa_mode = ppe_ft_dsa_resolve(flow->egress_dev, &dsa);
-	if (flow->egress_dev &&
-	    (!netif_carrier_ok(flow->egress_dev) || dsa_mode < 0 ||
-	     dsa.vid != flow->egress_vid)) {
-		mutex_unlock(&ft->lock);
-		return 0;
-	}
-
-	/* Hardware-forwarded packets never revalidate the route in
-	 * software, and the hit counter of a flow counts at ingress
-	 * lookup whether or not egress delivery still works: a flow
-	 * whose egress link is down must not be reported as active, or
-	 * it would refresh its conntrack timeout forever while
-	 * black-holing. Going quiet instead lets the flowtable expire
-	 * and re-offload it.
+	/* Leave a flow with unusable egress quiet so the flowtable can
+	 * expire it instead of refreshing its conntrack timeout.
 	 */
-	if (!test_bit(flow->eport, ft->ppe_dev->carrier_ok)) {
+	if (!ppe_ft_flow_egress_ready(ft, flow)) {
 		mutex_unlock(&ft->lock);
 		return 0;
 	}
@@ -4473,22 +4507,7 @@ static int ppe_ft_flow_stats(struct ppe_
 		return ret;
 	}
 
-	ret = ppe_flow_stats_get(ft->ppe_dev, flow->index, &packets, &bytes);
-	if (!ret && (packets != flow->packets || bytes != flow->bytes)) {
-		u64 delta_bytes = (bytes - flow->bytes) & GENMASK_ULL(39, 0);
-		u32 delta_packets = packets - flow->packets;
-
-		/* The hardware byte counter is 40 bits wide and wraps. */
-		ppe_flow_account_update(&flow->rx_account, true,
-					delta_packets, delta_bytes);
-		ppe_flow_account_update(&flow->tx_account, false,
-					delta_packets, delta_bytes);
-		flow_stats_update(&f->stats,
-				  delta_bytes, delta_packets, 0, jiffies,
-				  FLOW_ACTION_HW_STATS_DELAYED);
-		flow->packets = packets;
-		flow->bytes = bytes;
-	}
+	ret = ppe_ft_flow_collect_stats(ft, flow, &f->stats);
 
 	mutex_unlock(&ft->lock);
 
