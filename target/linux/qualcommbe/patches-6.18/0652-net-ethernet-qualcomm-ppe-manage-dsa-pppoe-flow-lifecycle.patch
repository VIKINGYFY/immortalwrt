+/* The parser has one slot for each TPID, not two interchangeable tags. */
+static int ppe_ft_vlan_add(__be16 proto, u16 vid, int *svid, int *cvid)
+{
+	int *slot;
+
+	if (vid >= VLAN_VID_MASK)
+		return -EOPNOTSUPP;
+	if (proto == htons(ETH_P_8021AD))
+		slot = svid;
+	else if (proto == htons(ETH_P_8021Q))
+		slot = cvid;
+	else
+		return -EOPNOTSUPP;
+	if (*slot >= 0)
+		return -EOPNOTSUPP;
+	*slot = vid;
+
+	return 0;
+}
 
