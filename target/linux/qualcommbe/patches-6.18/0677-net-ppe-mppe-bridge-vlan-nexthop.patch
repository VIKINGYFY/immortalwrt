From: ViKing <viking.yfy@qq.com>
Date: Fri, 27 Nov 2026 13:57:57 +0800
Subject: [PATCH] net: ppe: encode MPPE bridge VLAN next hops

Enable bridge next hops only on IPQ5332, as selected by QSDK
PPE_DRV_BRIDGE_NEXT_HOP. Keep FAL_FLOW_BRIDGE forwarding and its source
port check. Encode the MPPE bridge next-hop valid bit and index separately
from routed next hops, preserving Ethernet MACs and TTL/Hop Limit.

PPE bridge VLAN handling includes admission and mode changes.

Merged from:
  0677-net-ppe-mppe-bridge-vlan-nexthop.patch - net: ppe: encode MPPE bridge VLAN next hops
  0690-net-ppe-validate-active-bridge-vlan-mode.patch - net: ethernet: qualcomm: ppe: validate active bridge VLAN mode

Previous split from (0677-net-ppe-mppe-bridge-vlan-nexthop.patch):
  0677-net-ppe-mppe-rtl837x-bridge-full.patch ([PATCH] net: ppe: offload cross-tree RTL837x bridge flows on MPPE)

Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/Documentation/networking/qualcomm-ppe-offload.rst
+++ b/Documentation/networking/qualcomm-ppe-offload.rst
@@ -111,7 +111,9 @@ explicit destination bypasses those chec
    BR_FLOOD/BR_MCAST_FLOOD/BR_BCAST_FLOOD gate membership in the
    per-VSI flood bitmaps.
 
-VLAN-aware bridging backs each VLAN of a bridge with its own VSI.
+VLAN-aware bridging backs each 802.1Q VLAN of a bridge with its own VSI.
+PPE ports use software forwarding for other VLAN protocols. Detach
+offloaded PPE ports before changing a bridge's VLAN filtering mode.
 Ingress VLAN translation rules, matching by port bitmap so they scale
 with VLANs rather than ports times VLANs, assign tagged and
 PVID-untagged packets to the VSI; per-VSI egress tag modes provide
--- a/drivers/net/ethernet/qualcomm/ppe/ppe.c
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe.c
@@ -341,6 +341,7 @@ static const struct ppe_variant ppe_vari
 	.num_flow_entries	= 2048,
 	.num_host_entries	= 768,
 	.num_nexthop_entries	= 768,
+	.has_bridge_nexthop	= true,
 	.shaper_clock_khz	= 200000,
 	.has_tunnel_engine	= true,
 	.has_vports		= true,
--- a/drivers/net/ethernet/qualcomm/ppe/ppe.h
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe.h
@@ -58,6 +58,9 @@ struct ppe_variant {
 	 * VAPs. APPE and MPPE; consumed by the virtual-port offload work.
 	 */
 	bool has_vports;
+
+	/* MPPE can select VLAN-only next hops for transparent bridge flows. */
+	bool has_bridge_nexthop;
 };
 
 /**
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_bridge.c
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_bridge.c
@@ -831,8 +831,15 @@ static int ppe_bridge_port_join(struct p
 	bool vlan_aware = br_vlan_enabled(br);
 	int port = ppe_bridge_port_id(dev);
 	int vsi = -1, ret;
+	u16 proto;
 
-	if (!vlan_aware) {
+	if (vlan_aware) {
+		ret = br_vlan_get_proto(br, &proto);
+		if (ret)
+			return ret;
+		if (proto != ETH_P_8021Q)
+			return 0;
+	} else {
 		/* Failure to back the bridge with a VSI is not an
 		 * error, the bridge stays a software bridge for all
 		 * its ports.
@@ -1430,6 +1437,7 @@ static int ppe_bridge_attr_set(struct ne
 	struct edma_port_priv *port_priv = netdev_priv(dev);
 	struct ppe_bridge *pb = port_priv->ppe_port->ppe_dev->bridge;
 	int port = ppe_bridge_port_id(dev);
+	bool vlan_aware = pb->ports[port].vsi < 0;
 
 	if (!pb->ports[port].bridge)
 		return -EOPNOTSUPP;
@@ -1452,10 +1460,24 @@ static int ppe_bridge_attr_set(struct ne
 		return ppe_bridge_ageing_time_set(pb, dev,
 						  attr->u.ageing_time);
 	case SWITCHDEV_ATTR_ID_BRIDGE_VLAN_FILTERING:
-		/* The bridge is offloaded in the mode it had when its
-		 * first port joined, refuse changing it mid-flight.
-		 */
-		return -EOPNOTSUPP;
+		if (attr->orig_dev != pb->ports[port].bridge)
+			return -EOPNOTSUPP;
+		if (attr->u.vlan_filtering == vlan_aware)
+			return 0;
+
+		NL_SET_ERR_MSG_MOD(extack,
+				   "Detach PPE bridge ports before changing VLAN filtering");
+		return -EBUSY;
+	case SWITCHDEV_ATTR_ID_BRIDGE_VLAN_PROTOCOL:
+		if (attr->orig_dev != pb->ports[port].bridge)
+			return -EOPNOTSUPP;
+		if (!vlan_aware ||
+		    attr->u.vlan_protocol == ETH_P_8021Q)
+			return 0;
+
+		NL_SET_ERR_MSG_MOD(extack,
+				   "PPE VLAN filtering requires the 802.1Q protocol");
+		return -EBUSY;
 	default:
 		return -EOPNOTSUPP;
 	}
@@ -1776,6 +1798,10 @@ int ppe_bridge_setup(struct ppe_device *
 		goto err_netdev_nb;
 
 	pb->switchdev_blocking_nb.notifier_call = ppe_bridge_switchdev_blocking_event;
+	/* Reject unsupported bridge-wide mode changes before a DSA
+	 * member can apply them to its hardware.
+	 */
+	pb->switchdev_blocking_nb.priority = 1;
 	ret = register_switchdev_blocking_notifier(&pb->switchdev_blocking_nb);
 	if (ret)
 		goto err_switchdev_nb;
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flow.c
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flow.c
@@ -212,9 +212,13 @@ static void ppe_flow_entry_pack(const st
 		val[0] |= FIELD_PREP(PPE_FLOW_W0_SRC_L3_IF, flow->src_l3_if);
 	}
 	val[0] |= FIELD_PREP(PPE_FLOW_W0_FWD_TYPE, flow->fwd_type);
-	if (flow->fwd_type == PPE_FLOW_FWD_TYPE_BRIDGE)
+	if (flow->fwd_type == PPE_FLOW_FWD_TYPE_BRIDGE) {
 		val[1] = FIELD_PREP(PPE_FLOW_W1_BRIDGE_PORT, flow->bridge_port);
-	else
+		if (flow->bridge_nexthop_valid)
+			val[1] |= PPE_FLOW_W1_BRIDGE_NH_VALID |
+				  FIELD_PREP(PPE_FLOW_W1_BRIDGE_NEXT_HOP,
+					     flow->nexthop);
+	} else
 		val[1] = FIELD_PREP(PPE_FLOW_W1_NEXT_HOP, flow->nexthop);
 	val[1] |= FIELD_PREP(PPE_FLOW_W1_L4_PORT,
 			     be16_to_cpu(flow->nat_port));
@@ -884,7 +888,8 @@ int ppe_nexthop_set(struct ppe_device *p
 	if (index < 0 || index >= ppe_dev->variant->num_nexthop_entries)
 		return -EINVAL;
 
-	val[0] = PPE_NEXTHOP_W0_TYPE;
+	/* QSDK bridge next hops leave the L3/VSI selector at zero. */
+	val[0] = nh->vlan_only ? 0 : PPE_NEXTHOP_W0_TYPE;
 	val[0] |= FIELD_PREP(PPE_NEXTHOP_W0_PORT, nh->port);
 	val[0] |= FIELD_PREP(PPE_NEXTHOP_W0_POST_L3_IF, nh->l3_if);
 	if (nh->svid >= 0) {
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flow.h
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flow.h
@@ -37,6 +37,7 @@ struct ppe_flow_op_result {
  * @dnat_ip: Translated destination address of DNAT flows.
  */
 struct ppe_flow_nexthop {
+	bool vlan_only;
 	u8 port;
 	u8 l3_if;
 	u8 mac[ETH_ALEN];
@@ -67,6 +68,7 @@ struct ppe_flow_nexthop {
  * @src_l3_if: Ingress routing interface selected by port, VLAN, PPPoE or VP.
  * @src_l3_if_valid: Restrict hits to that ingress routing interface.
  * @bridge_port: Egress physical or virtual port of a transparent bridge flow.
+ * @bridge_nexthop_valid: Use an MPPE VLAN-only next hop in bridge mode.
  */
 struct ppe_flow_entry {
 	union {
@@ -87,6 +89,7 @@ struct ppe_flow_entry {
 	u8 src_l3_if;
 	bool src_l3_if_valid;
 	u8 bridge_port;
+	bool bridge_nexthop_valid;
 };
 
 int ppe_flow_hw_init(struct ppe_device *ppe_dev);
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_regs.h
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_regs.h
@@ -779,6 +779,8 @@
 #define PPE_FLOW_W0_FWD_TYPE			GENMASK(31, 29)
 #define PPE_FLOW_W1_NEXT_HOP			GENMASK(11, 0)
 #define PPE_FLOW_W1_BRIDGE_PORT			GENMASK(7, 0)
+#define PPE_FLOW_W1_BRIDGE_NH_VALID		BIT(11)
+#define PPE_FLOW_W1_BRIDGE_NEXT_HOP		GENMASK(23, 12)
 #define PPE_FLOW_W1_L4_PORT			GENMASK(27, 12)
 #define PPE_FLOW_W1_DE_ACCE			BIT(28)
 #define PPE_FLOW_W1_COPY_TO_CPU			BIT(29)
