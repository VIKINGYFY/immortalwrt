+static void edma_irq_names_free(void)
+{
+	struct edma_hw_info *hw_info = edma_ctx->hw_info;
+	u32 i;
+
+	if (edma_rxdesc_irq_name) {
+		for (i = 0; i < hw_info->rx->num_rings; i++)
+			kfree(edma_rxdesc_irq_name[i]);
+		kfree(edma_rxdesc_irq_name);
+		edma_rxdesc_irq_name = NULL;
+	}
+
+	if (edma_txcmpl_irq_name) {
+		for (i = 0; i < hw_info->txcmpl->num_rings; i++)
+			kfree(edma_txcmpl_irq_name[i]);
+		kfree(edma_txcmpl_irq_name);
+		edma_txcmpl_irq_name = NULL;
+	}
+}
+
+static void edma_irq_unregister(void)
+{
+	struct device *dev = edma_ctx->ppe_dev->dev;
+	u32 i;
+
+	if (edma_ctx->misc_irq_registered) {
+		synchronize_irq(edma_ctx->intr_info.intr_misc);
+		free_irq(edma_ctx->intr_info.intr_misc, dev);
+		edma_ctx->misc_irq_registered = false;
+	}
+
+	while (edma_ctx->rxdesc_irqs_registered) {
+		i = --edma_ctx->rxdesc_irqs_registered;
+		synchronize_irq(edma_ctx->intr_info.intr_rx[i]);
+		free_irq(edma_ctx->intr_info.intr_rx[i],
+			 &edma_ctx->rx_rings[i]);
+	}
+
+	while (edma_ctx->txcmpl_irqs_registered) {
+		i = --edma_ctx->txcmpl_irqs_registered;
+		synchronize_irq(edma_ctx->intr_info.intr_txcmpl[i]);
+		free_irq(edma_ctx->intr_info.intr_txcmpl[i],
+			 &edma_ctx->txcmpl_rings[i]);
+	}
+
+	edma_irq_names_free();
+}
