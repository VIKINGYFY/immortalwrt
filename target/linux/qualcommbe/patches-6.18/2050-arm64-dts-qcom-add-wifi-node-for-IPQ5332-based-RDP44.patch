From 0d2a58e0bea5cee085a6f4b44f95dac8c1381c6f Mon Sep 17 00:00:00 2001
From: JiaY-shi <shi05275@163.com>
Date: Thu, 05 Nov 2026 17:38:33 +0800
Subject: [PATCH] arm64: dts: qcom: use dynamic auxiliary WiFi memory on RDP441

RDP441 is based on IPQ5332. It has inbuilt AHB bus based IPQ5332 WiFi
device.

Describe and add WiFi node for RDP441. Also, reserve the memory
required by IPQ5332 firmware.

Depends-On: [PATCH V2 0/2] mailbox: tmel-qmp: Introduce QCOM TMEL QMP mailbox driver
Depends-On: [PATCH V3 0/8] Add new driver for WCSS secure PIL loading
Link: https://lore.kernel.org/lkml/20241231054900.2144961-1-quic_srichara@quicinc.com/
Link: https://lore.kernel.org/lkml/20250107101647.2087358-1-quic_gokulsri@quicinc.com/

Keep the 48 MiB Q6 window and its fixed host DDR view. Allocate M3 dump,
CALDB and shared MLO memory dynamically when requested by firmware.

Signed-off-by: Raj Kumar Bhagat <quic_rajkbhag@quicinc.com>
Signed-off-by: ViKing <viking.yfy@qq.com>
---
--- a/arch/arm64/boot/dts/qcom/ipq5332-rdp441.dts
+++ b/arch/arm64/boot/dts/qcom/ipq5332-rdp441.dts
@@ -2,7 +2,7 @@
 /*
  * IPQ5332 AP-MI01.2 board device tree source
  *
- * Copyright (c) 2022-2023 Qualcomm Innovation Center, Inc. All rights reserved.
+ * Copyright (c) 2022-2025 Qualcomm Innovation Center, Inc. All rights reserved.
  */
 
 /dts-v1/;
@@ -12,6 +12,23 @@
 / {
 	model = "Qualcomm Technologies, Inc. IPQ5332 MI01.2";
 	compatible = "qcom,ipq5332-ap-mi01.2", "qcom,ipq5332";
+
+	/* Q6 retains its fixed 48 MiB firmware window. M3 dump, CALDB and
+	 * shared MLO memory are allocated through DMA when requested.
+	 */
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		q6_region: wcss@4a900000 {
+			reg = <0x0 0x4a900000 0x0 0x03000000>;
+			no-map;
+		};
+
+
+	};
 };
 
 &blsp1_i2c1 {
@@ -139,3 +156,12 @@
 		};
 	};
 };
+
+&wifi0 {
+	qcom,ath12k-fw-memory-mode = <1>;
+	memory-region = <&q6_region>, <&q6_region>;
+	memory-region-names = "q6-region", "host-ddr-mem";
+	qcom,host-ddr-offset = <0x00c00000>;
+	qcom,rproc = <&q6v5_wcss>;
+	status = "okay";
+};
--- a/arch/arm64/boot/dts/qcom/ipq5332.dtsi
+++ b/arch/arm64/boot/dts/qcom/ipq5332.dtsi
@@ -997,6 +997,119 @@
 			};
 		};
 
