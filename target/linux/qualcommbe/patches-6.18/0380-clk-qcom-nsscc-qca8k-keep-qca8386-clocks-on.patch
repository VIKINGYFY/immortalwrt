 		.parent_data = nss_cc_uniphy1_tx312p5m_data,
 		.num_parents = ARRAY_SIZE(nss_cc_uniphy1_tx312p5m_data),
+		.flags = CLK_IS_CRITICAL,
 		.ops = &clk_rcg2_mux_closest_ops,
 	},
 };
