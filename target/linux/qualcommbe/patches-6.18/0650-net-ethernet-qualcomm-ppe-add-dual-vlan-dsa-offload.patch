+/**
+ * ppe_port_vlan_type_set - Select the ingress and egress QinQ role of a port
+ * @ppe_dev: PPE device
+ * @port: PPE port
+ * @core: Treat the outer provider tag as an S-tag in both directions
+ *
+ * Return: 0 on success, negative error code on failure.
+ */
+int ppe_port_vlan_type_set(struct ppe_device *ppe_dev, int port, bool core)
+{
+	u32 reg, role = core ? PPE_PORT_PARSING_REG_PORT_ROLE : 0;
+	int ret;
+
+	if (port < 0 || port >= PPE_PORT_PARSING_REG_ENTRIES ||
+	    port >= PPE_PORT_EG_VLAN_TBL_ENTRIES)
+		return -EINVAL;
+
+	reg = PPE_PORT_PARSING_REG_ADDR + PPE_PORT_PARSING_REG_INC * port;
+	ret = regmap_update_bits(ppe_dev->regmap, reg,
+				 PPE_PORT_PARSING_REG_PORT_ROLE, role);
+	if (ret)
+		return ret;
+
+	reg = PPE_PORT_EG_VLAN_TBL_ADDR + PPE_PORT_EG_VLAN_TBL_INC * port;
+
+	return regmap_update_bits(ppe_dev->regmap, reg,
+				  PPE_PORT_EG_VLAN_TBL_VLAN_TYPE,
+				  core ? PPE_PORT_EG_VLAN_TBL_VLAN_TYPE : 0);
+}
