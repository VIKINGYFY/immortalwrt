+/**
+ * ppe_port_vlan_ingress_type_set - Select the ingress QinQ role of a port
+ * @ppe_dev: PPE device
+ * @port: PPE port
+ * @core: Treat a single provider tag as an S-tag
+ *
+ * Return: 0 on success, negative error code on failure.
+ */
+int ppe_port_vlan_ingress_type_set(struct ppe_device *ppe_dev, int port,
+				   bool core)
+{
+	u32 reg, role = core ? PPE_PORT_PARSING_REG_PORT_ROLE : 0;
+
+	if (port < 0 || port >= PPE_PORT_PARSING_REG_ENTRIES)
+		return -EINVAL;
+
+	reg = PPE_PORT_PARSING_REG_ADDR + PPE_PORT_PARSING_REG_INC * port;
+
+	return regmap_update_bits(ppe_dev->regmap, reg,
+				  PPE_PORT_PARSING_REG_PORT_ROLE, role);
+}
+
+/**
+ * ppe_port_vlan_egress_type_set - Select the egress QinQ role of a port
+ * @ppe_dev: PPE device
+ * @port: PPE port
+ * @core: Emit a single provider tag from the S-tag slot
+ *
+ * Return: 0 on success, negative error code on failure.
+ */
+int ppe_port_vlan_egress_type_set(struct ppe_device *ppe_dev, int port,
+				  bool core)
+{
+	u32 reg;
+
+	if (port < 0 || port >= PPE_PORT_EG_VLAN_TBL_ENTRIES)
+		return -EINVAL;
+
+	reg = PPE_PORT_EG_VLAN_TBL_ADDR + PPE_PORT_EG_VLAN_TBL_INC * port;
+
+	return regmap_update_bits(ppe_dev->regmap, reg,
+				  PPE_PORT_EG_VLAN_TBL_VLAN_TYPE,
+				  core ? PPE_PORT_EG_VLAN_TBL_VLAN_TYPE : 0);
+}
