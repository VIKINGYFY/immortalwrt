+static void airoha_qdma_decode_pon_control(u32 msg0,
+					  struct airoha_pon_ctrl_rx_info *info)
+{
+	/* Translate QDMA fields into protocol-neutral control metadata. */
+	info->id = FIELD_GET(QDMA_ETH_RXMSG_GEM_MASK, msg0);
+	info->channel = FIELD_GET(QDMA_ETH_RXMSG_CHANNEL_MASK, msg0);
+	info->oam = !!(msg0 & QDMA_ETH_RXMSG_OAM_MASK);
+	info->no_mic = !!(msg0 & QDMA_ETH_RXMSG_NO_MIC_MASK);
+}
+
+static bool airoha_qdma_is_pon_control(struct airoha_gdm_dev *dev,
+				       u32 msg0)
+{
+	const struct airoha_pon_link_ops *ops;
+	struct airoha_pon_ctrl_rx_info info;
+	bool matched = false;
+	void *priv;
+
+	if (!(dev->flags & AIROHA_PRIV_F_PON))
+		return false;
+
+	airoha_qdma_decode_pon_control(msg0, &info);
+	if (info.oam)
+		return true;
+
+	/* The ITU-T path also matches the active OMCC ID for control frames. */
+	rcu_read_lock();
+	ops = READ_ONCE(dev->pon_link_ops);
+	priv = READ_ONCE(dev->pon_link_priv);
+	if (ops && ops->match_control && priv)
+		matched = ops->match_control(priv, &info);
+	rcu_read_unlock();
+
+	return matched;
+}
+
 static struct sk_buff *airoha_qdma_build_rx_skb(struct airoha_queue *q,
 						struct airoha_qdma_desc *desc,
 						struct airoha_queue_entry *e,
-						struct net_device *netdev)
+						struct net_device *netdev,
+						bool pon_control)
 {
 	u32 msg2 = le32_to_cpu(READ_ONCE(desc->msg2));
 	int qid = q - &q->qdma->q_rx[0];
 	struct sk_buff *skb;
 
-	if (FIELD_GET(QDMA_ETH_RXMSG_AGG_COUNT_MASK, msg2) > 1) { /* LRO */
+	/* Raw OMCI and OAM PDUs bypass Ethernet LRO and eth_type_trans(). */
+	if (!pon_control &&
+	    FIELD_GET(QDMA_ETH_RXMSG_AGG_COUNT_MASK, msg2) > 1) { /* LRO */
 		skb = airoha_qdma_lro_rx_skb(q, desc, e);
 		if (!skb)
 			return NULL;
@@ -885,11 +928,35 @@ static struct sk_buff *airoha_qdma_build_rx_skb(struct airoha_queue *q,
 	skb_mark_for_recycle(skb);
 	skb->dev = netdev;
 	skb_record_rx_queue(skb, qid);
-	skb->protocol = eth_type_trans(skb, netdev);
+	skb->protocol = pon_control ? 0 : eth_type_trans(skb, netdev);
 
 	return skb;
 }
 
+static void airoha_qdma_dispatch_pon_control(struct airoha_gdm_dev *dev,
+					      struct net_device *netdev,
+					      struct sk_buff *skb, u32 msg0)
+{
+	const struct airoha_pon_link_ops *ops;
+	struct airoha_pon_ctrl_rx_info info;
+	void *priv;
+
+	/* AN7581 marks valid 44/48-byte OMCI PDUs as Ethernet runts. */
+	/* The control layer validates protocol, OMCC ID, length, and MIC status. */
+
+	airoha_qdma_decode_pon_control(msg0, &info);
+
+	/* RCU keeps controller private data alive through NAPI callbacks. */
+	rcu_read_lock();
+	ops = READ_ONCE(dev->pon_link_ops);
+	priv = READ_ONCE(dev->pon_link_priv);
+	if (ops && ops->rx_control && priv)
+		ops->rx_control(priv, skb, &info);
+	else
+		dev_kfree_skb(skb);
+	rcu_read_unlock();
+}
