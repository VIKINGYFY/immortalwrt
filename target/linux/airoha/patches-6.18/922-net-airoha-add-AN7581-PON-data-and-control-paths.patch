-				   struct net_device *netdev)
+static void airoha_pon_skb_vlan(struct sk_buff *skb, u16 *vlan_id,
+				 u8 *pbit)
 {
-	struct airoha_gdm_dev *dev = netdev_priv(netdev);
-	u32 nr_frags, tag, msg0, msg1, len;
+	struct vlan_ethhdr vlan_header;
+	const struct vlan_ethhdr *header;
+	u16 tci;
+
+	*vlan_id = AIROHA_PON_VID_ANY;
+	*pbit = 0;
+	if (skb_vlan_tag_present(skb)) {
+		*vlan_id = skb_vlan_tag_get_id(skb);
+		*pbit = skb_vlan_tag_get_prio(skb);
+		return;
+	}
+	header = skb_header_pointer(skb, 0, sizeof(vlan_header), &vlan_header);
+	if (!header || !eth_type_vlan(header->h_vlan_proto))
+		return;
+
+	tci = ntohs(header->h_vlan_TCI);
+	*vlan_id = tci & VLAN_VID_MASK;
+	*pbit = (tci & VLAN_PRIO_MASK) >> VLAN_PRIO_SHIFT;
+}
+
+static u32 airoha_pon_select_flow(struct airoha_gdm_dev *dev,
+				  struct sk_buff *skb)
+{
+	const struct airoha_pon_flow_table *table;
+	const struct airoha_pon_flow_entry *fallback = NULL;
+	u16 vlan_id;
+	u8 pbit;
+	unsigned int i;
+
+	airoha_pon_skb_vlan(skb, &vlan_id, &pbit);
+	table = rcu_dereference(dev->pon_flow_table);
+	if (!table)
+		return 0;
+	for (i = 0; i < table->count; i++) {
+		const struct airoha_pon_flow_entry *entry = &table->entries[i];
+
+		if (!(entry->pbit_mask & BIT(pbit)))
+			continue;
+		if (entry->vlan_id == vlan_id)
+			return entry->tag;
+		if (entry->vlan_id == AIROHA_PON_VID_ANY && !fallback)
+			fallback = entry;
+	}
+
+	return fallback ? fallback->tag : 0;
+}
