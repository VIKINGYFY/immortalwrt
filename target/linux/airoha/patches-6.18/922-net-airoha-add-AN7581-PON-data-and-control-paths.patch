+int airoha_eth_pon_register_controller(
+	struct net_device *netdev, const struct airoha_pon_link_ops *ops,
+	void *priv)
+{
+	struct airoha_gdm_dev *dev;
+	int ret = 0;
+
+	if (!netdev || !ops || !ops->start || !ops->stop || !priv ||
+	    netdev->netdev_ops != &airoha_netdev_ops)
+		return -EINVAL;
+	dev = netdev_priv(netdev);
+	if (!(dev->flags & AIROHA_PRIV_F_PON))
+		return -EOPNOTSUPP;
+
+	/* RTNL serializes controller registration and interface state. */
+	/* The controller takes line ownership while the interface is down. */
+	rtnl_lock();
+	if (netif_running(netdev))
+		ret = -EBUSY;
+	else if (dev->pon_link_ops)
+		ret = -EEXIST;
+	else {
+		WRITE_ONCE(dev->pon_link_priv, priv);
+		/* Publishing ops marks the fully initialized private context. */
+		WRITE_ONCE(dev->pon_link_ops, ops);
+	}
+	rtnl_unlock();
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(airoha_eth_pon_register_controller);
