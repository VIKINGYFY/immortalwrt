+	stats->rx_runt_frames = atomic64_read(&dev->pon_stats.rx_runt_frames);
+	stats->rx_long_frames = atomic64_read(&dev->pon_stats.rx_long_frames);
+	for (i = 0; i < AIROHA_PON_MAX_QDMA_CHANNELS; i++) {
+		stats->tx_channel_packets[i] =
+			atomic64_read(&dev->pon_stats.tx_channel_packets[i]);
+		stats->rx_channel_packets[i] =
+			atomic64_read(&dev->pon_stats.rx_channel_packets[i]);
+	}
+	stats->last_tx_msg0 = READ_ONCE(dev->pon_stats.last_tx_msg0);
+	stats->last_tx_msg1 = READ_ONCE(dev->pon_stats.last_tx_msg1);
