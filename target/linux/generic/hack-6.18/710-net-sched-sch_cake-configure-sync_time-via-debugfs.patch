From: Jonas Köppeler <j.koeppeler@tu-berlin.de>
Date: Tue, 17 Nov 2026 00:31:18 +0800
Subject: [PATCH] net: sched: cake: expose synchronization interval through debugfs

Allow runtime tuning of the cake_mq synchronization interval. Keep the
directory in module state so unload removes it and its data pointer.

The module-lifetime repair follows JuliusBairaktaris/openwrt-ppe-nss
a7c55c46af50b361de33d979db28f8d9faccf985.

Signed-off-by: Jonas Köppeler <j.koeppeler@tu-berlin.de>
Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/net/sched/sch_cake.c
+++ b/net/sched/sch_cake.c
@@ -72,6 +72,7 @@
 #include <net/pkt_cls.h>
 #include <net/tcp.h>
 #include <net/flow_dissector.h>
+#include <linux/debugfs.h>
 
 #if IS_ENABLED(CONFIG_NF_CONNTRACK)
 #include <net/netfilter/nf_conntrack_core.h>
@@ -82,6 +83,8 @@
 #define CAKE_QUEUES (1024)
 #define CAKE_FLOW_MASK 63
 #define CAKE_FLOW_NAT_FLAG 64
+static u64 g_sync_time_ns = 200*NSEC_PER_USEC;
+static struct dentry *cake_mq_debugfs;
 
 /* struct cobalt_params - contains codel and blue parameters
  * @interval:	codel initial drop rate
@@ -2219,7 +2222,7 @@ static struct sk_buff *cake_dequeue(stru
 	u32 len;
 
 	if (q->config->is_shared && q->rate_ns &&
-	    now - q->last_checked_active >= q->config->sync_time) {
+	    now - q->last_checked_active >= g_sync_time_ns) {
 		struct net_device *dev = qdisc_dev(sch);
 		struct cake_sched_data *other_priv;
 		u64 new_rate = q->config->rate_bps;
@@ -3621,8 +3624,13 @@ static int __init cake_module_init(void)
 		return ret;
 
 	ret = register_qdisc(&cake_mq_qdisc_ops);
-	if (ret)
+	if (ret) {
 		unregister_qdisc(&cake_qdisc_ops);
+	} else {
+		cake_mq_debugfs = debugfs_create_dir("cake_mq", NULL);
+
+		debugfs_create_u64("sync_time_ns", 0644, cake_mq_debugfs, &g_sync_time_ns);
+	}
 
 	return ret;
 }
@@ -3631,6 +3639,7 @@ static void __exit cake_module_exit(void
 {
 	unregister_qdisc(&cake_qdisc_ops);
 	unregister_qdisc(&cake_mq_qdisc_ops);
+	debugfs_remove_recursive(cake_mq_debugfs);
 }
 
 module_init(cake_module_init)
