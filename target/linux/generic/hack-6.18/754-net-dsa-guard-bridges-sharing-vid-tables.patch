From: ViKing <viking.yfy@qq.com>
Date: Sat, 21 Nov 2026 15:06:52 +0800
Subject: [PATCH] net: dsa: guard bridges sharing VID-indexed hardware tables

Some switches share their VLAN, FDB and MDB keys across the chip.
Permit concurrent offload when bridges use disjoint 802.1Q VIDs.
Keep VID 1 reserved for native port traffic during concurrent offload.
When a bridge cannot use hardware, leave the port in software.
Validate live changes before they can reuse an active hardware VID.

Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/include/linux/if_bridge.h
+++ b/include/linux/if_bridge.h
@@ -113,6 +113,9 @@
 
 #if IS_ENABLED(CONFIG_BRIDGE) && IS_ENABLED(CONFIG_BRIDGE_VLAN_FILTERING)
 bool br_vlan_enabled(const struct net_device *dev);
+bool br_vlan_has_vid(const struct net_device *dev, u16 vid);
+bool br_vlan_has_overlap(const struct net_device *dev,
+			 const struct net_device *other, u16 reserved_vid);
 int br_vlan_get_pvid(const struct net_device *dev, u16 *p_pvid);
 int br_vlan_get_pvid_rcu(const struct net_device *dev, u16 *p_pvid);
 int br_vlan_get_proto(const struct net_device *dev, u16 *p_proto);
@@ -124,6 +127,18 @@
 int br_mst_get_info(const struct net_device *dev, u16 msti, unsigned long *vids);
 int br_mst_get_state(const struct net_device *dev, u16 msti, u8 *state);
 #else
+static inline bool br_vlan_has_vid(const struct net_device *dev, u16 vid)
+{
+	return false;
+}
+
+static inline bool br_vlan_has_overlap(const struct net_device *dev,
+				       const struct net_device *other,
+				       u16 reserved_vid)
+{
+	return false;
+}
+
 static inline bool br_vlan_enabled(const struct net_device *dev)
 {
 	return false;
--- a/include/net/dsa.h
+++ b/include/net/dsa.h
@@ -450,6 +450,9 @@
 	 */
 	u32			fdb_isolation:1;
 
+	/* All bridge databases share the VID key, with VID 1 also native. */
+	u32			vid_only_fdb:1;
+
 	/* Drivers that have global DSCP mapping settings must set this to
 	 * true to automatically apply the settings to all ports.
 	 */
--- a/net/bridge/br_vlan.c
+++ b/net/bridge/br_vlan.c
@@ -927,6 +927,41 @@
 }
 EXPORT_SYMBOL_GPL(br_vlan_enabled);
 
+bool br_vlan_has_vid(const struct net_device *dev, u16 vid)
+{
+	struct net_bridge *br = netdev_priv(dev);
+
+	ASSERT_RTNL();
+
+	/* A newly attached port will acquire the bridge's default PVID. */
+	return vid && (br->default_pvid == vid ||
+		       br_vlan_find(br_vlan_group(br), vid));
+}
+EXPORT_SYMBOL_GPL(br_vlan_has_vid);
+
+bool br_vlan_has_overlap(const struct net_device *dev,
+			 const struct net_device *other, u16 reserved_vid)
+{
+	struct net_bridge *br = netdev_priv(dev);
+	struct net_bridge_vlan_group *vg = br_vlan_group(br);
+	struct net_bridge_vlan *v;
+
+	ASSERT_RTNL();
+
+	if (br_vlan_has_vid(dev, reserved_vid) ||
+	    br_vlan_has_vid(other, reserved_vid) ||
+	    br_vlan_has_vid(other, br->default_pvid))
+		return true;
+	if (!vg)
+		return false;
+	list_for_each_entry(v, &vg->vlan_list, vlist)
+		if (br_vlan_has_vid(other, v->vid))
+			return true;
+
+	return false;
+}
+EXPORT_SYMBOL_GPL(br_vlan_has_overlap);
+
 int br_vlan_get_proto(const struct net_device *dev, u16 *p_proto)
 {
 	struct net_bridge *br = netdev_priv(dev);
--- a/net/dsa/port.c
+++ b/net/dsa/port.c
@@ -368,6 +368,8 @@
 {
 	struct net_device *brport_dev = dsa_port_to_bridge_port(dp);
 	struct net_device *br = dsa_port_bridge_dev_get(dp);
+	struct dsa_switch *ds = dp->ds;
+	bool vlan_filtering = br_vlan_enabled(br);
 	int err;
 
 	err = dsa_port_inherit_brport_flags(dp, extack);
@@ -378,7 +380,15 @@
 	if (err && err != -EOPNOTSUPP)
 		return err;
 
-	err = dsa_port_vlan_filtering(dp, br_vlan_enabled(br), extack);
+	/* A filtered standalone port can still have a native VID which is
+	 * invalid for its new bridge. Let the driver resync the port's VLAN
+	 * state even when the filtering bit already matches.
+	 */
+	if (vlan_filtering && ds->vid_only_fdb &&
+	    ds->needs_standalone_vlan_filtering && dsa_port_is_vlan_filtering(dp))
+		err = ds->ops->port_vlan_filtering(ds, dp->index, true, extack);
+	else
+		err = dsa_port_vlan_filtering(dp, vlan_filtering, extack);
 	if (err && err != -EOPNOTSUPP)
 		return err;
 
@@ -484,6 +494,72 @@
 		dsa_port_can_configure_learning(dp);
 }
 
+/* VID 1 is also used by the drivers for native traffic on standalone
+ * and VLAN-unaware ports. Keep it out of shared-VID multi-bridge operation.
+ */
+#define DSA_SHARED_NATIVE_VID	1
+
+static bool dsa_bridge_uses_c_vids(const struct net_device *br)
+{
+	u16 proto;
+
+	return br_vlan_enabled(br) && !br_vlan_get_proto(br, &proto) &&
+	       proto == ETH_P_8021Q;
+}
+
+static int dsa_port_check_bridge_db(struct dsa_port *dp, struct net_device *br,
+				    struct netlink_ext_ack *extack)
+{
+	struct dsa_port *peer;
+
+	if (!dp->ds->vid_only_fdb)
+		return 0;
+
+	dsa_switch_for_each_user_port(peer, dp->ds) {
+		struct net_device *other = dsa_port_bridge_dev_get(peer);
+
+		if (!other || other == br)
+			continue;
+		if (!dsa_bridge_uses_c_vids(br) || !dsa_bridge_uses_c_vids(other) ||
+		    br_vlan_has_overlap(br, other, DSA_SHARED_NATIVE_VID)) {
+			NL_SET_ERR_MSG_MOD(extack,
+					   "Hardware bridges need 802.1Q filtering and distinct non-native VIDs");
+			return -EOPNOTSUPP;
+		}
+	}
+
+	return 0;
+}
+
+int dsa_port_shared_vlan_check(struct dsa_port *dp, u16 vid,
+			       struct netlink_ext_ack *extack)
+{
+	struct net_device *br = dsa_port_bridge_dev_get(dp);
+	struct dsa_port *peer;
+
+	if (!dp->ds->vid_only_fdb || !br)
+		return 0;
+
+	dsa_switch_for_each_user_port(peer, dp->ds) {
+		struct net_device *other = dsa_port_bridge_dev_get(peer);
+
+		if (!other || other == br)
+			continue;
+		if (!vid || vid == DSA_SHARED_NATIVE_VID ||
+		    br_vlan_has_vid(other, vid)) {
+			if (vid)
+				NL_SET_ERR_MSG_MOD(extack,
+						   "VID conflicts with another bridge in the shared hardware database");
+			else
+				NL_SET_ERR_MSG_MOD(extack,
+						   "802.1Q filtering is required while multiple hardware bridges share the switch");
+			return -EBUSY;
+		}
+	}
+
+	return 0;
+}
+
 int dsa_port_bridge_join(struct dsa_port *dp, struct net_device *br,
 			 struct netlink_ext_ack *extack)
 {
@@ -498,6 +574,10 @@
 	if (br_mst_enabled(br) && !dsa_port_supports_mst(dp))
 		return -EOPNOTSUPP;
 
+	err = dsa_port_check_bridge_db(dp, br, extack);
+	if (err)
+		return err;
+
 	/* Here the interface is already bridged. Reflect the current
 	 * configuration so that drivers can program their chips accordingly.
 	 */
@@ -817,7 +897,7 @@
 	if (!apply)
 		return -EINVAL;
 
-	if (dsa_port_is_vlan_filtering(dp) == vlan_filtering)
+	if (old_vlan_filtering == vlan_filtering)
 		return 0;
 
 	err = ds->ops->port_vlan_filtering(ds, dp->index, vlan_filtering,
--- a/net/dsa/port.h
+++ b/net/dsa/port.h
@@ -26,6 +26,8 @@
 int dsa_port_enable(struct dsa_port *dp, struct phy_device *phy);
 void dsa_port_disable_rt(struct dsa_port *dp);
 void dsa_port_disable(struct dsa_port *dp);
+int dsa_port_shared_vlan_check(struct dsa_port *dp, u16 vid,
+			      struct netlink_ext_ack *extack);
 int dsa_port_bridge_join(struct dsa_port *dp, struct net_device *br,
 			 struct netlink_ext_ack *extack);
 void dsa_port_pre_bridge_leave(struct dsa_port *dp, struct net_device *br);
--- a/net/dsa/user.c
+++ b/net/dsa/user.c
@@ -584,6 +584,43 @@
 	return phylink_mii_ioctl(p->dp->pl, ifr, cmd);
 }
 
+struct dsa_shared_vlan_check {
+	struct net_device *bridge;
+	struct netlink_ext_ack *extack;
+	u16 vid;
+};
+
+static int dsa_user_check_shared_vlan_lower(struct net_device *lower,
+					    struct netdev_nested_priv *priv)
+{
+	struct dsa_shared_vlan_check *check = priv->data;
+	struct dsa_port *dp;
+
+	if (!dsa_user_dev_check(lower))
+		return 0;
+
+	dp = dsa_user_to_port(lower);
+	if (!dsa_port_offloads_bridge_dev(dp, check->bridge))
+		return 0;
+
+	return dsa_port_shared_vlan_check(dp, check->vid, check->extack);
+}
+
+/* Validate across all DSA chips in this bridge before changing any of them. */
+static int dsa_user_check_shared_vlan(struct net_device *bridge, u16 vid,
+				     struct netlink_ext_ack *extack)
+{
+	struct dsa_shared_vlan_check check = {
+		.bridge = bridge,
+		.extack = extack,
+		.vid = vid,
+	};
+	struct netdev_nested_priv priv = { .data = &check };
+
+	return netdev_walk_all_lower_dev(bridge, dsa_user_check_shared_vlan_lower,
+					&priv);
+}
+
 static int dsa_user_port_attr_set(struct net_device *dev, const void *ctx,
 				  const struct switchdev_attr *attr,
 				  struct netlink_ext_ack *extack)
@@ -719,6 +756,10 @@
 		}
 	}
 
+	err = dsa_port_shared_vlan_check(dp, vlan->vid, extack);
+	if (err)
+		return err;
+
 	return dsa_port_vlan_add(dp, vlan, extack);
 }
 
@@ -731,6 +772,7 @@
 {
 	struct dsa_port *dp = dsa_user_to_port(dev);
 	struct switchdev_obj_port_vlan vlan;
+	int err;
 
 	/* Do nothing if this is a software bridge */
 	if (!dp->bridge)
@@ -742,6 +784,10 @@
 	}
 
 	vlan = *SWITCHDEV_OBJ_PORT_VLAN(obj);
+	err = dsa_user_check_shared_vlan(dsa_port_bridge_dev_get(dp), vlan.vid,
+					 extack);
+	if (err)
+		return err;
 
 	/* Even though drivers often handle CPU membership in special ways,
 	 * it doesn't make sense to program a PVID, so clear this flag.
@@ -1836,6 +1882,13 @@
 	struct dsa_vlan *v;
 	int ret;
 
+	/* VID 0 is the priority-tag RX filter, not a separate VLAN. */
+	if (vid) {
+		ret = dsa_port_shared_vlan_check(dp, vid, &extack);
+		if (ret)
+			return ret;
+	}
+
 	/* User port... */
 	ret = dsa_port_vlan_add(dp, &vlan, &extack);
 	if (ret) {
@@ -4115,6 +4168,7 @@
 					     unsigned long event, void *ptr)
 {
 	struct net_device *dev = switchdev_notifier_info_to_dev(ptr);
+	struct switchdev_notifier_port_attr_info *info;
 	int err;
 
 	switch (event) {
@@ -4131,6 +4185,16 @@
 							    dsa_user_port_obj_del);
 		return notifier_from_errno(err);
 	case SWITCHDEV_PORT_ATTR_SET:
+		info = ptr;
+		if (netif_is_bridge_master(dev) &&
+		    ((info->attr->id == SWITCHDEV_ATTR_ID_BRIDGE_VLAN_FILTERING &&
+		      !info->attr->u.vlan_filtering) ||
+		     (info->attr->id == SWITCHDEV_ATTR_ID_BRIDGE_VLAN_PROTOCOL &&
+		      info->attr->u.vlan_protocol != ETH_P_8021Q))) {
+			err = dsa_user_check_shared_vlan(dev, 0, info->info.extack);
+			if (err)
+				return notifier_from_errno(err);
+		}
 		err = switchdev_handle_port_attr_set(dev, ptr,
 						     dsa_user_dev_check,
 						     dsa_user_port_attr_set);
