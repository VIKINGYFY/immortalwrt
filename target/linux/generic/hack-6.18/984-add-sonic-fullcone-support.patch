+static spinlock_t nf_nat_fullcone_locks[CONNTRACK_LOCKS];
+/* Protect translated-source buckets, including check-and-publish. */
+static spinlock_t nf_nat_manip_src_locks[CONNTRACK_LOCKS];
 
