+/* Only port-based conntrack protocols have a reversible fullcone key.
+ * ICMP ids live in a different tuple field and GRE keys need their helper;
+ * do not advertise fullcone semantics for those protocols.
+ */
+static bool nf_nat_fullcone_supported(const struct nf_conn *ct)
+{
+	if (!IS_ENABLED(CONFIG_NF_NAT_FULLCONE) || ct->master || nfct_help(ct))
+		return false;
+
+	switch (nf_ct_protonum(ct)) {
+	case IPPROTO_TCP:
+	case IPPROTO_UDP:
+#if IS_ENABLED(CONFIG_NF_CT_PROTO_UDPLITE)
+	case IPPROTO_UDPLITE:
+#endif
+#if IS_ENABLED(CONFIG_NF_CT_PROTO_SCTP)
+	case IPPROTO_SCTP:
+#endif
+		return true;
+	default:
+		return false;
+	}
+}
+
+unsigned int
+nf_nat_setup_info(struct nf_conn *ct,
+		  const struct nf_nat_range2 *range,
+		  enum nf_nat_manip_type maniptype)
+{
+	struct nf_nat_range2 filtered_range = *range;
+	spinlock_t *lock = NULL;
+	unsigned int ret, h;
+
+	if (nf_ct_is_confirmed(ct))
+		return NF_ACCEPT;
+	if (WARN_ON(nf_nat_initialized(ct, maniptype)))
+		return NF_DROP;
+
+	if (!nf_nat_fullcone_supported(ct))
+		filtered_range.flags &= ~NF_NAT_RANGE_FULLCONE;
+
+	if (maniptype == NF_NAT_MANIP_SRC) {
+		ct->nat_fullcone = !!(filtered_range.flags & NF_NAT_RANGE_FULLCONE);
+		if (ct->nat_fullcone) {
+			h = hash_by_src(nf_ct_net(ct), nf_ct_zone(ct),
+					&ct->tuplehash[IP_CT_DIR_ORIGINAL].tuple);
+			lock = &nf_nat_fullcone_locks[h % CONNTRACK_LOCKS];
+			spin_lock_bh(lock);
+		}
+	}
+
+	ret = __nf_nat_setup_info(ct, &filtered_range, maniptype);
+	if (lock)
+		spin_unlock_bh(lock);
+	return ret;
 }
 EXPORT_SYMBOL(nf_nat_setup_info);
 
