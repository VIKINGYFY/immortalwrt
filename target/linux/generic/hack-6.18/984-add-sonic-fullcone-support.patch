+
+static bool nf_nat_is_fullcone(const struct nf_conn *ct)
+{
+#if IS_ENABLED(CONFIG_NF_NAT_FULLCONE)
+	return ct->nat_fullcone;
+#else
+	return false;
+#endif
+}
+
+#if IS_ENABLED(CONFIG_NF_NAT_FULLCONE)
+static bool
+same_source_endpoint(const struct nf_conntrack_tuple *a,
+		     const struct nf_conntrack_tuple *b)
+{
+	return a->src.l3num == b->src.l3num &&
+	       a->dst.protonum == b->dst.protonum &&
+	       nf_inet_addr_cmp(&a->src.u3, &b->src.u3) &&
+	       a->src.u.all == b->src.u.all;
+}
+
+static bool
+same_nat_zone(const struct nf_conn *ct,
+	      const struct nf_conntrack_zone *zone)
+{
+	return nf_ct_zone_equal(ct, zone, IP_CT_DIR_ORIGINAL) &&
+	       nf_ct_zone_equal(ct, zone, IP_CT_DIR_REPLY);
+}
+
+static bool
+same_reply_dst(const struct nf_conn *ct,
+	       const struct nf_conntrack_tuple *tuple)
+{
+	const struct nf_conntrack_tuple *t =
+		&ct->tuplehash[IP_CT_DIR_REPLY].tuple;
+
+	return t->src.l3num == tuple->src.l3num &&
+	       t->dst.protonum == tuple->dst.protonum &&
+	       nf_inet_addr_cmp(&t->dst.u3, &tuple->dst.u3) &&
+	       t->dst.u.all == tuple->dst.u.all;
+}
+
+/* Ordinary NAT bindings reserve their endpoint against fullcone too.
+ * Only fullcone bindings belonging to the same internal endpoint may share
+ * a public endpoint. Ordinary NAT keeps its usual five-tuple sharing.
+ * The translated bucket lock protects both object lifetime and ownership.
+ * A matching owner determines the policy for every binding of this endpoint.
+ */
+static bool
+__nf_nat_used_3_tuple(const struct nf_conntrack_tuple *tuple,
+		    const struct nf_conn *ignored_conntrack)
+{
+	const struct nf_conntrack_zone *zone = nf_ct_zone(ignored_conntrack);
+	struct net *net = nf_ct_net(ignored_conntrack);
+	struct nf_conntrack_tuple reply;
+	const struct nf_conn *ct;
+	unsigned int h;
+
+	nf_ct_invert_tuple(&reply, tuple);
+	h = hash_by_src(net, zone, tuple);
+	lockdep_assert_held(&nf_nat_manip_src_locks[h % CONNTRACK_LOCKS]);
+	hlist_for_each_entry_rcu(ct, &nf_nat_by_manip_src[h], nat_by_manip_src) {
+		if (ct == ignored_conntrack || !same_reply_dst(ct, &reply) ||
+		    !net_eq(net, nf_ct_net(ct)) || !same_nat_zone(ct, zone))
+			continue;
+
+		if (!ct->nat_fullcone && !ignored_conntrack->nat_fullcone)
+			return false;
+		if (ct->nat_fullcone && ignored_conntrack->nat_fullcone &&
+		    same_source_endpoint(&ct->tuplehash[IP_CT_DIR_ORIGINAL].tuple,
+			&ignored_conntrack->tuplehash[IP_CT_DIR_ORIGINAL].tuple))
+			return false;
+		return true;
+	}
+	return false;
+}
+#endif
+
+static bool
+nf_nat_used_3_tuple(const struct nf_conntrack_tuple *tuple,
+		    const struct nf_conn *ct)
+{
+#if IS_ENABLED(CONFIG_NF_NAT_FULLCONE)
+	unsigned int h = hash_by_src(nf_ct_net(ct), nf_ct_zone(ct), tuple);
+	spinlock_t *lock = &nf_nat_manip_src_locks[h % CONNTRACK_LOCKS];
+	bool used;
+
+	spin_lock_bh(lock);
+	used = __nf_nat_used_3_tuple(tuple, ct);
+	spin_unlock_bh(lock);
+	return used;
+#else
+	return false;
+#endif
+}
