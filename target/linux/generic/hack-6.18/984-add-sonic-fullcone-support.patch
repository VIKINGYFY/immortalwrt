+unsigned int
+nf_nat_setup_info(struct nf_conn *ct,
+		  const struct nf_nat_range2 *range,
+		  enum nf_nat_manip_type maniptype)
+{
+	struct nf_nat_range2 filtered_range = *range;
+#if IS_ENABLED(CONFIG_NF_NAT_FULLCONE)
+	spinlock_t *lock = NULL;
+	unsigned int ret, h;
+#endif
+
+	if (nf_ct_is_confirmed(ct))
+		return NF_ACCEPT;
+	if (WARN_ON(nf_nat_initialized(ct, maniptype)))
+		return NF_DROP;
+
+	if (!nf_nat_fullcone_supported(ct))
+		filtered_range.flags &= ~NF_NAT_RANGE_FULLCONE;
+
+#if IS_ENABLED(CONFIG_NF_NAT_FULLCONE)
+	if (maniptype == NF_NAT_MANIP_SRC) {
+		ct->nat_fullcone = !!(filtered_range.flags & NF_NAT_RANGE_FULLCONE);
+		if (ct->nat_fullcone) {
+			h = hash_by_src(nf_ct_net(ct), nf_ct_zone(ct),
+					&ct->tuplehash[IP_CT_DIR_ORIGINAL].tuple);
+			lock = &nf_nat_fullcone_locks[h % CONNTRACK_LOCKS];
+			spin_lock_bh(lock);
+		}
+	}
+
+	ret = __nf_nat_setup_info(ct, &filtered_range, maniptype);
+	if (lock)
+		spin_unlock_bh(lock);
+	return ret;
+#else
+	return __nf_nat_setup_info(ct, &filtered_range, maniptype);
+#endif
 }
