From: ViKing <viking.yfy@qq.com>
Date: Sat, 07 Nov 2026 13:53:07 +0800
Subject: [PATCH] netfilter: flowtable: invalidate changed bridge port policies

A cached bridge flow can keep transmitting after its egress VLAN is deleted
or its PVID changes. This is observable across the independent RTL8372 trees
on BE3600 P8: a flow learned with both ports in VID 100 bypasses the bridge
checks after one port moves to VID 200. Retire affected paths on switchdev
VLAN, filtering, protocol, STP and isolation changes. Include cached upper
interfaces when matching the changed device, and handle device topology,
address and MTU notifications as well. Emit a device notification after
the bridge software VLAN commit too, closing the relearning interval
while switchdev programs the hardware.

Keep bridge flow caching and routed hardware offload enabled. Only paths
using the changed interface are retired and can be rebuilt by normal traffic.

Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/net/netfilter/nf_flow_table_core.c
+++ b/net/netfilter/nf_flow_table_core.c
@@ -14,6 +14,7 @@
 #include <net/netfilter/nf_conntrack_core.h>
 #include <net/netfilter/nf_conntrack_l4proto.h>
 #include <net/netfilter/nf_conntrack_tuple.h>
+#include <net/switchdev.h>
 
 static DEFINE_MUTEX(flowtable_lock);
 static LIST_HEAD(flowtables);
@@ -776,6 +777,19 @@ int nf_flow_table_init(struct nf_flowtab
 }
 EXPORT_SYMBOL_GPL(nf_flow_table_init);
 
+static bool nf_flow_tuple_uses_dev(const struct flow_offload_tuple *tuple,
+				   const struct net_device *dev)
+{
+	int i;
+
+	if (tuple->iifidx == dev->ifindex)
+		return true;
+	for (i = 0; i < tuple->num_uppers; i++)
+		if (tuple->upper_ifidx[i] == dev->ifindex)
+			return true;
+	return false;
+}
+
 static void nf_flow_table_do_cleanup(struct nf_flowtable *flow_table,
 				     struct flow_offload *flow, void *data)
 {
@@ -787,8 +801,8 @@ static void nf_flow_table_do_cleanup(str
 	}
 
 	if (net_eq(nf_ct_net(flow->ct), dev_net(dev)) &&
-	    (flow->tuplehash[0].tuple.iifidx == dev->ifindex ||
-	     flow->tuplehash[1].tuple.iifidx == dev->ifindex))
+	    (nf_flow_tuple_uses_dev(&flow->tuplehash[0].tuple, dev) ||
+	     nf_flow_tuple_uses_dev(&flow->tuplehash[1].tuple, dev)))
 		flow_offload_teardown(flow);
 }
 
@@ -877,10 +891,16 @@ static int nf_flow_table_netdev_event(st
 {
 	struct net_device *dev = netdev_notifier_info_to_dev(ptr);
 
-	if (event != NETDEV_DOWN)
-		return NOTIFY_DONE;
-
-	nf_flow_table_cleanup(dev);
+	switch (event) {
+	case NETDEV_DOWN:
+	case NETDEV_UNREGISTER:
+	case NETDEV_CHANGEUPPER:
+	case NETDEV_CHANGEADDR:
+	case NETDEV_CHANGEMTU:
+	case NETDEV_CHANGEINFODATA:
+		nf_flow_table_cleanup(dev);
+		break;
+	}
 
 	return NOTIFY_DONE;
 }
@@ -889,6 +909,46 @@ static struct notifier_block flow_offloa
 	.notifier_call	= nf_flow_table_netdev_event,
 };
 
+/* Bridge flowtables bypass the bridge VLAN and STP checks on cache hits.
+ * Retire both software and hardware directions before reusing a changed
+ * port policy; the real device alone does not identify stacked paths.
+ */
+static int nf_flow_table_switchdev_event(struct notifier_block *this,
+					unsigned long event, void *ptr)
+{
+	struct switchdev_notifier_port_attr_info *attr_info = ptr;
+	struct switchdev_notifier_port_obj_info *obj_info = ptr;
+	struct net_device *dev = switchdev_notifier_info_to_dev(ptr);
+
+	switch (event) {
+	case SWITCHDEV_PORT_OBJ_ADD:
+	case SWITCHDEV_PORT_OBJ_DEL:
+		if (obj_info->obj->id != SWITCHDEV_OBJ_ID_PORT_VLAN)
+			return NOTIFY_DONE;
+		break;
+	case SWITCHDEV_PORT_ATTR_SET:
+		switch (attr_info->attr->id) {
+		case SWITCHDEV_ATTR_ID_PORT_STP_STATE:
+		case SWITCHDEV_ATTR_ID_PORT_BRIDGE_FLAGS:
+		case SWITCHDEV_ATTR_ID_BRIDGE_VLAN_FILTERING:
+		case SWITCHDEV_ATTR_ID_BRIDGE_VLAN_PROTOCOL:
+			break;
+		default:
+			return NOTIFY_DONE;
+		}
+		break;
+	default:
+		return NOTIFY_DONE;
+	}
+
+	nf_flow_table_cleanup(dev);
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block flow_offload_switchdev_notifier = {
+	.notifier_call = nf_flow_table_switchdev_event,
+};
+
 static int __init nf_flow_table_module_init(void)
 {
 	int ret;
@@ -909,8 +969,14 @@ static int __init nf_flow_table_module_i
 	if (ret)
 		goto out_bpf;
 
+	ret = register_switchdev_blocking_notifier(&flow_offload_switchdev_notifier);
+	if (ret)
+		goto out_netdev;
+
 	return 0;
 
+out_netdev:
+	unregister_netdevice_notifier(&flow_offload_netdev_notifier);
 out_bpf:
 	nf_flow_table_offload_exit();
 out_offload:
@@ -920,6 +986,7 @@ out_offload:
 
 static void __exit nf_flow_table_module_exit(void)
 {
+	unregister_switchdev_blocking_notifier(&flow_offload_switchdev_notifier);
 	unregister_netdevice_notifier(&flow_offload_netdev_notifier);
 	rcu_barrier();
 	nf_flow_table_offload_exit();
--- a/net/bridge/br_vlan.c
+++ b/net/bridge/br_vlan.c
@@ -1931,6 +1931,11 @@ void br_vlan_notify(const struct net_bri
 	/* right now notifications are done only with rtnl held */
 	ASSERT_RTNL();
 
+	/* Flush paths after the software membership/PVID commit as well.
+	 * A flow can be relearned while switchdev programs the hardware.
+	 */
+	call_netdevice_notifiers(NETDEV_CHANGEINFODATA, p ? p->dev : br->dev);
+
 	if (p) {
 		ifindex = p->dev->ifindex;
 		vg = nbp_vlan_group(p);
