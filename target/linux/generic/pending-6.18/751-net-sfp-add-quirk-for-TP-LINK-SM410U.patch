From 163d7cf204f72c056fb7c9e0d79f5dfa8efbb5f0 Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Tue, 21 Apr 2026 01:27:19 +0100
Subject: [PATCH] net: sfp: describe TP-LINK SM410U 1G and 2.5G modes

The TP-LINK SM410U is a 1G/2.5G copper module based on RealTek RTL8221B,
but doesn't offer access to the PHY over I2C. A generic fixed-2.5G quirk
hides its supported 1G line rate and prevents selecting the corresponding
SGMII host mode.

Give the module a dedicated capability fixup with SGMII and 2500BASE-X
host interfaces. Keep host-side autonegotiation disabled because there is
no PHY or in-band status source to drive it.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
Signed-off-by: ViKing <viking.yfy@qq.com>
---
--- a/drivers/net/phy/sfp.c
+++ b/drivers/net/phy/sfp.c
@@ -492,6 +492,27 @@ static void sfp_quirk_oem_2_5g(const str
 	sfp_quirk_disable_autoneg(id, caps);
 }
 
+static void sfp_quirk_tp_link_sm410u(const struct sfp_eeprom_id *id,
+				     struct sfp_module_caps *caps)
+{
+	/* The RTL8221B PHY is not exposed over I2C, so host-side in-band
+	 * negotiation is unavailable. The module supports 1G and 2.5G copper;
+	 * allow a forced SGMII or 2500BASE-X host mode for those line rates.
+	 */
+	linkmode_zero(caps->link_modes);
+	linkmode_set_bit(ETHTOOL_LINK_MODE_1000baseT_Full_BIT,
+			 caps->link_modes);
+	linkmode_set_bit(ETHTOOL_LINK_MODE_2500baseT_Full_BIT,
+			 caps->link_modes);
+	linkmode_set_bit(ETHTOOL_LINK_MODE_Pause_BIT, caps->link_modes);
+	linkmode_set_bit(ETHTOOL_LINK_MODE_Asym_Pause_BIT, caps->link_modes);
+
+	phy_interface_zero(caps->interfaces);
+	__set_bit(PHY_INTERFACE_MODE_SGMII, caps->interfaces);
+	__set_bit(PHY_INTERFACE_MODE_2500BASEX, caps->interfaces);
+	sfp_quirk_disable_autoneg(id, caps);
+}
+
 static void sfp_quirk_ubnt_uf_instant(const struct sfp_eeprom_id *id,
 				      struct sfp_module_caps *caps)
 {
@@ -611,6 +632,7 @@ static const struct sfp_quirk sfp_quirks
 	SFP_QUIRK_F("Turris", "RTSFP-10G", sfp_fixup_rollball),
 
 	SFP_QUIRK_S("ZOERAX", "SFP-2.5G-T", sfp_quirk_oem_2_5g),
+	SFP_QUIRK_S("TP-LINK", "TL-SM410U", sfp_quirk_tp_link_sm410u),
 };
 
 static size_t sfp_strlen(const char *str, size_t maxlen)
