From: JiaY-shi <shi05275@163.com>
Date: Tue, 1 Sep 2026 00:20:00 +0800
Subject: [PATCH] procfs: guard self links against missing fs info

proc_self_get_link() and proc_thread_self_get_link() assume that the
procfs superblock always has a valid proc_fs_info.  If path resolution
observes a procfs inode while the superblock private data is unavailable,
proc_pid_ns() dereferences a NULL s_fs_info and panics the kernel.

Return ENOENT for the stale link instead.  This is consistent with the
existing handling for a task that is not visible in the procfs PID
namespace and prevents a userspace path lookup from crashing the system.

Signed-off-by: JiaY-shi <shi05275@163.com>
---
 fs/proc/self.c        | 12 +++++++++---
 fs/proc/thread_self.c | 14 ++++++++++----
 2 files changed, 19 insertions(+), 7 deletions(-)

--- a/fs/proc/self.c
+++ b/fs/proc/self.c
@@ -12,10 +12,16 @@ static const char *proc_self_get_link(st
 				      struct inode *inode,
 				      struct delayed_call *done)
 {
-	struct pid_namespace *ns = proc_pid_ns(inode->i_sb);
-	pid_t tgid = task_tgid_nr_ns(current, ns);
+	struct proc_fs_info *fs_info = proc_sb_info(inode->i_sb);
+	struct pid_namespace *ns;
+	pid_t tgid;
 	char *name;
 
+	if (unlikely(!fs_info))
+		return ERR_PTR(-ENOENT);
+	ns = fs_info->pid_ns;
+	tgid = task_tgid_nr_ns(current, ns);
+
 	if (!tgid)
 		return ERR_PTR(-ENOENT);
 	/* max length of unsigned int in decimal + NULL term */
--- a/fs/proc/thread_self.c
+++ b/fs/proc/thread_self.c
@@ -12,11 +12,17 @@ static const char *proc_thread_self_get_
 					     struct inode *inode,
 					     struct delayed_call *done)
 {
-	struct pid_namespace *ns = proc_pid_ns(inode->i_sb);
-	pid_t tgid = task_tgid_nr_ns(current, ns);
-	pid_t pid = task_pid_nr_ns(current, ns);
+	struct proc_fs_info *fs_info = proc_sb_info(inode->i_sb);
+	struct pid_namespace *ns;
+	pid_t tgid, pid;
 	char *name;
 
+	if (unlikely(!fs_info))
+		return ERR_PTR(-ENOENT);
+	ns = fs_info->pid_ns;
+	tgid = task_tgid_nr_ns(current, ns);
+	pid = task_pid_nr_ns(current, ns);
+
 	if (!pid)
 		return ERR_PTR(-ENOENT);
 	name = kmalloc(10 + 6 + 10 + 1, dentry ? GFP_KERNEL : GFP_ATOMIC);
