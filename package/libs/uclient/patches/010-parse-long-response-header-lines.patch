From: Filip Michalski <filip.michalski92@gmail.com>
Date: Tue, 24 Nov 2026 00:01:40 +0800
Subject: [PATCH] uclient-http: consume and bound long response header lines

Consume response header fragments as they arrive so a line larger than the
stream buffer can continue reading. Preserve folded and LF-only headers,
leave buffered body bytes for the data parser and reset a partial line
when the request is reused.

Limit individual logical lines to 64 KiB and report unsupported responses
through the invalid-response error path. Preserve numeric values of
existing public errors.

Merged from:
- a78817c2d20b (uclient-http: consume response headers across stream buffers)
- a991e52ac981 (uclient-http: bound header lines and report invalid responses)

Signed-off-by: Filip Michalski <filip.michalski92@gmail.com>
Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/uclient-http.c
+++ b/uclient-http.c
@@ -34,6 +34,9 @@
 #include "uclient-utils.h"
 #include "uclient-backend.h"
 
+/* Use Python http.client's 64 KiB limit for each logical header line. */
+#define HTTP_MAX_HEADER_LINE (64 * 1024)
+
 enum auth_type {
 	AUTH_TYPE_UNKNOWN,
 	AUTH_TYPE_NONE,
@@ -121,6 +124,8 @@
 
 	struct blob_buf headers;
 	struct blob_buf meta;
+	char *header_buf;
+	size_t header_len;
 };
 
 enum {
@@ -254,6 +259,7 @@
 	uh->disconnect = false;
 	uh->connection_close = false;
 	uh->state = HTTP_STATE_INIT;
+	uh->header_len = 0;
 
 	if (uh->auth_type == AUTH_TYPE_UNKNOWN && !uh->uc.url->auth)
 		uh->auth_type = AUTH_TYPE_NONE;
@@ -818,6 +824,62 @@
 	uclient_notify_eof(uh);
 }
 
+static char *uclient_http_read_header_line(struct uclient_http *uh)
+{
+	char *data, *sep, *buf;
+	int len;
+	size_t end;
+
+	while ((data = ustream_get_read_buf(uh->us, &len)) && len) {
+		if (uh->header_len && uh->header_buf[uh->header_len - 1] == '\n') {
+			end = uh->header_len - 1;
+			if (end && uh->header_buf[end - 1] == '\r')
+				end--;
+
+			/* A following whitespace character continues the previous header. */
+			if (isspace((unsigned char)*data) && *data != '\r' && *data != '\n') {
+				memset(uh->header_buf + end, ' ', uh->header_len - end);
+			} else {
+				uh->header_buf[end] = 0;
+				uh->header_len = 0;
+				return uh->header_buf;
+			}
+		}
+
+		sep = memchr(data, '\n', len);
+		if (sep)
+			len = sep + 1 - data;
+
+		if ((size_t)len > HTTP_MAX_HEADER_LINE - uh->header_len) {
+			uclient_http_error(uh, UCLIENT_ERROR_INVALID_RESPONSE);
+			return NULL;
+		}
+
+		/* Consume fragments so a long line cannot fill and block the stream. */
+		buf = realloc(uh->header_buf, uh->header_len + len + 1);
+		if (!buf) {
+			uclient_http_error(uh, UCLIENT_ERROR_INVALID_RESPONSE);
+			return NULL;
+		}
+
+		uh->header_buf = buf;
+		memcpy(buf + uh->header_len, data, len);
+		uh->header_len += len;
+		buf[uh->header_len] = 0;
+		ustream_consume(uh->us, len);
+
+		/* The empty line ends the headers without looking into the body. */
+		if (sep && (uh->header_len == 1 ||
+			    (uh->header_len == 2 && buf[0] == '\r'))) {
+			buf[0] = 0;
+			uh->header_len = 0;
+			return buf;
+		}
+	}
+
+	return NULL;
+}
+
 static void __uclient_notify_read(struct uclient_http *uh)
 {
 	struct uclient *uc = &uh->uc;
@@ -831,56 +893,20 @@
 	if (uh->state == HTTP_STATE_PROCESS_HEADERS)
 		return;
 
-	data = ustream_get_read_buf(uh->us, &len);
-	if (!data || !len)
-		return;
-
 	if (uh->state < HTTP_STATE_RECV_DATA) {
-		char *sep, *next;
-		int cur_len;
-
 		do {
-			sep = strchr(data, '\n');
-			if (!sep)
-				break;
-
-			next = sep + 1;
-			if (sep > data && sep[-1] == '\r')
-				sep--;
-
-			/* Check for multi-line HTTP headers */
-			if (sep > data) {
-				if (!*next)
-					return;
-
-				if (isspace((unsigned char)*next) && *next != '\r' && *next != '\n') {
-					sep[0] = ' ';
-					if (sep + 1 < next)
-						sep[1] = ' ';
-					continue;
-				}
-			}
-
-			*sep = 0;
-			cur_len = next - data;
-			uclient_parse_http_line(uh, data);
-			if (seq != uh->seq)
+			data = uclient_http_read_header_line(uh);
+			if (!data)
 				return;
 
-			ustream_consume(uh->us, cur_len);
-			len -= cur_len;
-
-			if (uh->eof)
+			uclient_parse_http_line(uh, data);
+			if (seq != uh->seq || uh->eof)
 				return;
-
-			data = ustream_get_read_buf(uh->us, &len);
-		} while (data && uh->state == HTTP_STATE_RECV_HEADERS);
-
-		if (!len)
-			return;
+		} while (uh->state == HTTP_STATE_RECV_HEADERS);
 	}
 
-	if (uh->eof)
+	data = ustream_get_read_buf(uh->us, &len);
+	if (!data || !len || uh->eof)
 		return;
 
 	if (uh->state == HTTP_STATE_RECV_DATA) {
@@ -1092,6 +1118,7 @@
 	uclient_http_free_ssl_ctx(uh);
 	blob_buf_free(&uh->headers);
 	blob_buf_free(&uh->meta);
+	free(uh->header_buf);
 	free(uh);
 }
 
@@ -1223,7 +1250,7 @@
 		errno = 0;
 		chunk_len = strtoll(data, &end, 16);
 		if (end == data || chunk_len < 0 || chunk_len > LONG_MAX || errno) {
-			uclient_http_error(uh, UCLIENT_ERROR_UNKNOWN);
+			uclient_http_error(uh, UCLIENT_ERROR_INVALID_RESPONSE);
 			return 0;
 		}
 		uh->read_chunked = chunk_len;
--- a/uclient-fetch.c
+++ b/uclient-fetch.c
@@ -532,6 +532,10 @@
 		ignore = !verify;
 		error_ret = 5;
 		break;
+	case UCLIENT_ERROR_INVALID_RESPONSE:
+		type = "Invalid response";
+		error_ret = 7;
+		break;
 	default:
 		error_ret = 1;
 		break;
--- a/uclient.c
+++ b/uclient.c
@@ -498,6 +498,8 @@
 		return "ssl cn mismatch";
 	case UCLIENT_ERROR_MISSING_SSL_CONTEXT:
 		return "missing ssl context";
+	case UCLIENT_ERROR_INVALID_RESPONSE:
+		return "invalid response";
 	default:
 		return "invalid error code";
 	}
--- a/uclient.h
+++ b/uclient.h
@@ -36,6 +36,7 @@
 	UCLIENT_ERROR_SSL_INVALID_CERT,
 	UCLIENT_ERROR_SSL_CN_MISMATCH,
 	UCLIENT_ERROR_MISSING_SSL_CONTEXT,
+	UCLIENT_ERROR_INVALID_RESPONSE,
 	__UCLIENT_ERROR_MAX
 };
 
