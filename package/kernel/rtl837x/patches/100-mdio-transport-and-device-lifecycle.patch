From: ViKing <viking.yfy@qq.com>
Date: Sat, 07 Nov 2026 11:20:00 +0800
Subject: [PATCH] rtl837x: preserve MDIO transport and device lifecycle

Keep bounded nested MDIO commands, errno propagation, reset polarity and
the existing DSA registration contract. Honor board prerequisites and
release DSA resources on failures and device removal.

Split from:
  package/kernel/rtl837x/patches/100-migrate-local-behavior-to-upstream-regmap.patch ([PATCH] rtl837x: migrate local board and forwarding policy to regmap)

Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/src/rtl837x_mdio.c
+++ b/src/rtl837x_mdio.c
@@ -11,31 +11,45 @@
 
 #include "rtl837x.h"
 
+static int rtl837x_mdio_wait(struct rtl837x_priv *priv)
+{
+	int val, ret;
+
+	ret = read_poll_timeout(__mdiobus_read, val,
+				val < 0 || !(val & BIT(2)), 10, 5000, false,
+				priv->bus, priv->mdio_addr, MDC_MDIO_CTRL_REG);
+	return ret ? ret : (val < 0 ? val : 0);
+}
+
 static int rtl837x_mdio_write(void *ctx, u32 reg, u32 val)
 {
 	struct rtl837x_priv *priv = ctx;
 	struct mii_bus *bus = priv->bus;
 	int ret;
 
-	mutex_lock(&bus->mdio_lock);
-
-	ret = bus->write(bus, priv->mdio_addr, MDC_MDIO_ADDR_REG, reg);
-	if (unlikely(ret))
-		goto out_unlock;
-
-	ret = bus->write(bus, priv->mdio_addr, MDC_MDIO_DATA_LOW, (val & 0xFFFF));
-	if (unlikely(ret))
-		goto out_unlock;
-
-	ret = bus->write(bus, priv->mdio_addr, MDC_MDIO_DATA_HIGH, ((val >> 16) & 0xFFFF));
-	if (unlikely(ret))
-		goto out_unlock;
-
-	ret = bus->write(bus, priv->mdio_addr, MDC_MDIO_CTRL_REG, MDC_MDIO_WRITE_CMD);
-	if (unlikely(ret))
-		goto out_unlock;
-
-	ret = 0;
+	mutex_lock_nested(&bus->mdio_lock, MDIO_MUTEX_NESTED);
+
+	ret = rtl837x_mdio_wait(priv);
+	if (ret)
+		goto out_unlock;
+
+	ret = __mdiobus_write(bus, priv->mdio_addr, MDC_MDIO_ADDR_REG, reg);
+	if (unlikely(ret))
+		goto out_unlock;
+
+	ret = __mdiobus_write(bus, priv->mdio_addr, MDC_MDIO_DATA_LOW, (val & 0xFFFF));
+	if (unlikely(ret))
+		goto out_unlock;
+
+	ret = __mdiobus_write(bus, priv->mdio_addr, MDC_MDIO_DATA_HIGH, ((val >> 16) & 0xFFFF));
+	if (unlikely(ret))
+		goto out_unlock;
+
+	ret = __mdiobus_write(bus, priv->mdio_addr, MDC_MDIO_CTRL_REG, MDC_MDIO_WRITE_CMD);
+	if (unlikely(ret))
+		goto out_unlock;
+
+	ret = rtl837x_mdio_wait(priv);
 out_unlock:
 	mutex_unlock(&bus->mdio_lock);
 	return ret;
@@ -47,21 +61,38 @@
 	struct mii_bus *bus = priv->bus;
 	int ret, val_l, val_h;
 
-	mutex_lock(&bus->mdio_lock);
-
-	ret = bus->write(bus, priv->mdio_addr, MDC_MDIO_ADDR_REG, reg);
-	if (unlikely(ret))
-		goto out_unlock;
-
-	ret = bus->write(bus, priv->mdio_addr, MDC_MDIO_CTRL_REG, MDC_MDIO_READ_CMD);
-	if (unlikely(ret))
-		goto out_unlock;
-
-	val_l = bus->read(bus, priv->mdio_addr, MDC_MDIO_DATA_LOW);
-	val_h = bus->read(bus, priv->mdio_addr, MDC_MDIO_DATA_HIGH);
-
-	*val = val_l & 0xffff;
-	*val |= (val_h & 0xffff) << 16;
+	*val = 0;
+
+	mutex_lock_nested(&bus->mdio_lock, MDIO_MUTEX_NESTED);
+
+	ret = rtl837x_mdio_wait(priv);
+	if (ret)
+		goto out_unlock;
+
+	ret = __mdiobus_write(bus, priv->mdio_addr, MDC_MDIO_ADDR_REG, reg);
+	if (unlikely(ret))
+		goto out_unlock;
+
+	ret = __mdiobus_write(bus, priv->mdio_addr, MDC_MDIO_CTRL_REG, MDC_MDIO_READ_CMD);
+	if (unlikely(ret))
+		goto out_unlock;
+
+	ret = rtl837x_mdio_wait(priv);
+	if (ret)
+		goto out_unlock;
+
+	val_l = __mdiobus_read(bus, priv->mdio_addr, MDC_MDIO_DATA_LOW);
+	val_h = __mdiobus_read(bus, priv->mdio_addr, MDC_MDIO_DATA_HIGH);
+	if (val_l < 0) {
+		ret = val_l;
+		goto out_unlock;
+	}
+	if (val_h < 0) {
+		ret = val_h;
+		goto out_unlock;
+	}
+
+	*val = (val_l & 0xffff) | ((val_h & 0xffff) << 16);
 	ret = 0;
 
 out_unlock:
@@ -185,6 +216,9 @@
 		.lock_arg = priv,
 	};
 
+	mutex_init(&priv->phy_lock);
+	mutex_init(&priv->sds_lock);
+	mutex_init(&priv->ocp_lock);
 	mutex_init(&priv->map_lock);
 	priv->map = devm_regmap_init(dev, NULL, priv, &rtl837x_mdio_regmap_config);
 	if (IS_ERR(priv->map)) {
@@ -205,6 +239,11 @@
 		priv->map_8224 = NULL;
 	}
 
+	priv->preserve_boot_config = of_property_read_bool(np, "realtek,preserve-boot-config");
+	priv->reinit_cpu_serdes = of_property_read_bool(np, "realtek,reinit-cpu-serdes");
+	if (priv->reinit_cpu_serdes && !priv->preserve_boot_config)
+		return -EINVAL;
+
 	priv->mdio_addr = mdiodev->addr;
 	priv->bus = mdiodev->bus;
 	priv->dev = dev;
@@ -222,22 +261,27 @@
 
 	dev_set_drvdata(dev, priv);
 
-	priv->reset = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_LOW);
+	priv->reset = devm_gpiod_get_optional(dev, "reset", priv->preserve_boot_config ? GPIOD_ASIS : GPIOD_OUT_HIGH);
 	if (IS_ERR(priv->reset)) {
 		dev_err(dev, "failed to get RESET GPIO\n");
 		ret = PTR_ERR(priv->reset);
 		goto err;
 	}
 
-	if (priv->reset) {
+	if (priv->reset && !priv->preserve_boot_config) {
 		// This chip takes a long time to fully reset
 		dev_dbg(dev, "asserted RESET\n");
+		gpiod_set_value_cansleep(priv->reset, 1);
+		usleep_range(50000, 51100);
 		gpiod_set_value_cansleep(priv->reset, 0);
 		usleep_range(50000, 51100);
-		gpiod_set_value_cansleep(priv->reset, 1);
-		usleep_range(50000, 51100);
 		dev_dbg(dev, "deasserted RESET\n");
 	}
+
+	priv->num_ports = RTL837X_MAX_PORT_COUNT;
+	ret = rtl837x_board_prepare(priv);
+	if (ret)
+		return dev_err_probe(dev, ret, "board initialization prerequisites unavailable\n");
 
 	ret = priv->ops->detect(priv);
 	if (ret) {
@@ -291,6 +335,16 @@
 	if (var->pl_mac_ops)
 		priv->ds->phylink_mac_ops = var->pl_mac_ops;
 
+	priv->ds->phys_mii_mask = GENMASK(7, 4);
+	priv->ds->configure_vlan_while_not_filtering = true;
+	/* The hardware egress VLAN filter also applies to standalone ports. */
+	priv->ds->needs_standalone_vlan_filtering = true;
+	priv->ds->untag_bridge_pvid = false;
+	priv->ds->fdb_isolation = true;
+	priv->ds->max_num_bridges = DSA_TAG_8021Q_MAX_NUM_BRIDGES;
+	priv->ds->ageing_time_min = 14000;
+	priv->ds->ageing_time_max = 800000;
+
 	ret = dsa_register_switch(priv->ds);
 	if (ret) {
 		dev_err(priv->dev, "unable to register switch ret = %d\n", ret);
@@ -301,16 +355,24 @@
 	if (of_property_read_bool(np, "gpio-controller")) {
 		ret = rtl837x_gpiochip_init(priv);
 		if (ret)
-			dev_err(priv->dev, "Failed to register gpiochip. ret = %d\n", ret);
+			goto err_unregister_switch;
 	}
 #endif /* CONFIG_GPIOLIB */
 
-	rtl837x_set_led(priv);
+	ret = rtl837x_board_led_init(priv);
+	if (ret)
+		goto err_unregister_switch;
+	ret = rtl837x_set_led(priv);
+	if (ret)
+		goto err_unregister_switch;
 
 	rtl837x_debug_proc_init(priv);
 
 	return 0;
+err_unregister_switch:
+	dsa_unregister_switch(priv->ds);
 err:
+	dev_set_drvdata(dev, NULL);
 	return ret;
 }
 
@@ -323,17 +385,12 @@
 
 	rtl837x_debug_proc_deinit(priv);
 
-	if (priv->ds->tag_8021q_ctx) {
-		rtnl_lock();
-		dsa_tag_8021q_unregister(priv->ds);
-		rtnl_unlock();
-	}
 
 	dsa_unregister_switch(priv->ds);
 
 	/* leave the device reset asserted */
 	if (priv->reset)
-		gpiod_set_value(priv->reset, 1);
+		gpiod_set_value_cansleep(priv->reset, 1);
 }
 
 static void rtl837x_mdio_shutdown(struct mdio_device *mdiodev)
@@ -368,4 +425,4 @@
 
 MODULE_LICENSE("GPL");
 MODULE_AUTHOR("StarField Xu <air_jinkela@163.com>");
-MODULE_DESCRIPTION("rtl8372n switch driver for MT7988");
+MODULE_DESCRIPTION("Realtek RTL8372N DSA switch driver");
