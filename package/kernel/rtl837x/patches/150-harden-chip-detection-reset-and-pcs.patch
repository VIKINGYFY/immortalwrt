From: ViKing <viking.yfy@qq.com>
Date: Sat, 07 Nov 2026 11:20:00 +0800
Subject: [PATCH] rtl8372n: preserve chip reset and CPU PCS behavior

Propagate chip access errors, preserve reset enables and retain the
board CPU PCS policy while using the upstream SerDes implementation.

Split from:
  package/kernel/rtl837x/patches/100-migrate-local-behavior-to-upstream-regmap.patch ([PATCH] rtl837x: migrate local board and forwarding policy to regmap)

Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/src/rtl8372n.c
+++ b/src/rtl8372n.c
@@ -258,6 +258,8 @@
 	enum switch_chip sw_chip;
 
 	ret = rtl837x_reg_read(priv, RTL837X_MODEL_NAME_INFO_ADDR, &val);
+	if (ret)
+		return ret;
 	dev_info(dev, "CHIP_ID: 0x%08x\n", val);
 
 	switch (val >> 8) {
@@ -314,15 +316,17 @@
 
 static int rtl8372n_soft_reset_chip(struct rtl837x_priv *priv)
 {
-	u32 tmp;
-
-	if (priv->write_reg_noack)
-		priv->write_reg_noack(priv, RTL837X_RST_GLB_CTRL_0_ADDR,
-			      FIELD_PREP(RTL837X_RST_GLB_CTRL_0_SW_CHIP_RST_MASK, 1));
+	u32 val;
+	int ret = rtl837x_reg_read(priv, RTL837X_RST_GLB_CTRL_0_ADDR, &val);
+	if (ret)
+		return ret;
+	ret = priv->write_reg_noack(priv, RTL837X_RST_GLB_CTRL_0_ADDR,
+		val | RTL837X_RST_GLB_CTRL_0_SW_CHIP_RST_MASK);
+	if (ret)
+		return ret;
 	msleep(250);
-	return regmap_read_poll_timeout(priv->map, RTL837X_RST_GLB_CTRL_0_ADDR, tmp,
-					!(tmp & RTL837X_RST_GLB_CTRL_0_SW_CHIP_RST_MASK),
-					20000, 1e6);
+	return regmap_read_poll_timeout(priv->map, RTL837X_RST_GLB_CTRL_0_ADDR, val,
+		!(val & RTL837X_RST_GLB_CTRL_0_SW_CHIP_RST_MASK), 20000, 1000000);
 }
 
 static int rtl8372n_reset_serdes(struct rtl837x_priv *priv)
@@ -656,7 +660,8 @@
 		case PHY_INTERFACE_MODE_10GBASER:
 			return LINK_INBAND_DISABLE;
 		case PHY_INTERFACE_MODE_USXGMII:
-			return LINK_INBAND_ENABLE;
+			/* The PCS also supports a forced MAC with fixed-link. */
+			return LINK_INBAND_ENABLE | LINK_INBAND_DISABLE;
 		default:
 			return 0;
 		}
@@ -753,6 +758,22 @@
 	struct rtl837x_priv *priv = _pcs->priv;
 	int port = _pcs->index;
 	u8 sds_idx = PORT_TO_SERDES_IDX(port);
+
+	if (priv->preserve_boot_config && dsa_is_cpu_port(priv->ds, port) &&
+	    !priv->reinit_cpu_serdes)
+		return 0;
+
+	if (priv->reinit_cpu_serdes && dsa_is_cpu_port(priv->ds, port)) {
+		/* Keep the board SDK's USXGMII NWay even with a fixed MAC. */
+		if (interface == PHY_INTERFACE_MODE_USXGMII)
+			neg_mode = PHYLINK_PCS_NEG_INBAND_ENABLED;
+
+		/* Preserve pause/media fields while forcing the board's 10G CPU MAC. */
+		ret = regmap_update_bits(priv->map, 0x6344 + port * 4,
+					GENMASK(6, 0), BIT(0) | BIT(1) | BIT(2) | (4 << 3));
+		if (ret)
+			return ret;
+	}
 
 	dev_dbg(priv->dev, "[%s]PCS config serdes(%d) mode(%s) neg_mode(0x%x)\n", __func__,
 			  sds_idx,
@@ -948,15 +969,15 @@
 	case PHY_INTERFACE_MODE_USXGMII:
 	case PHY_INTERFACE_MODE_10GBASER:
 		dev_dbg(priv->dev, "[%s]Reset Serdes RX R\n", __func__);
-		rtl837x_sds_reset_R(priv, PORT_TO_SERDES_IDX(port));
+		ret = rtl837x_sds_reset_R(priv, PORT_TO_SERDES_IDX(port));
 		break;
 	default:
 		dev_dbg(priv->dev, "[%s]Reset Serdes RX X\n", __func__);
-		rtl837x_sds_reset_X(priv, PORT_TO_SERDES_IDX(port));
-		break;
-	}
-
-	return 0;
+		ret = rtl837x_sds_reset_X(priv, PORT_TO_SERDES_IDX(port));
+		break;
+	}
+
+	return ret;
 }
 
 static void rtl8372n_sds_pcs_link_up(struct phylink_pcs *pcs, unsigned int neg_mode,
