From: ViKing <viking.yfy@qq.com>
Date: Sat, 07 Nov 2026 11:20:00 +0800
Subject: [PATCH] rtl8372n: preserve local FDB and MDB identities

Use upstream LUT operations with the existing VLAN1 fallback and CPU
FDB policy. Propagate lookup errors before deleting a table address.

Split from:
  package/kernel/rtl837x/patches/100-migrate-local-behavior-to-upstream-regmap.patch ([PATCH] rtl837x: migrate local board and forwarding policy to regmap)

Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/src/rtl8372n.c
+++ b/src/rtl8372n.c
@@ -1391,6 +1391,8 @@
 		// just return success
 		return 0;
 	}
+	if (ret)
+		return ret;
 	dev_dbg(priv->dev, "[%s]:deleted mac:%02X:%02X:%02X:%02X:%02X:%02X vid:%04d addr: %04d\n", __func__,
 					addr[0], addr[1], addr[2], addr[3], addr[4], addr[5],
 					vid, entry.addr);
@@ -1403,7 +1405,6 @@
 		    struct dsa_db db)
 {
 	struct rtl837x_priv *priv = ds->priv;
-	int ret;
 
 	if (db.type != DSA_DB_PORT && db.type != DSA_DB_BRIDGE)
 		return -EOPNOTSUPP;
@@ -1412,31 +1413,11 @@
 					db.type == DSA_DB_PORT ? "DSA_DB_PORT" : "DSA_DB_BRIDGE",
 					port, vid);
 
-	if (db.type == DSA_DB_BRIDGE && is_8021q_tag(priv->tag_proto)) {
-		/*
-		 * When the DSA tag protocol is DSA_TAG_PROTO_RTL837X_8021AD, the L2 VLAN
-		 * learned on the CPU port is the 802.1q DSA TAG rather than the port's own
-		 * VLAN ID.
-		 * We need add the correct fdb entry
-		 */
-		if (vid == 0) {
-			struct dsa_port *dp;
-
-			dsa_switch_for_each_user_port(dp, ds) {
-				/* Add static fdb entry */
-				ret = rtl8372n_port_fdb_static_add(priv, port, addr, dsa_tag_8021q_standalone_vid(dp));
-				if (ret)
-					return ret;
-			}
-		} else {
-			ret = rtl8372n_port_fdb_static_add(priv, port, addr, vid);
-			if (ret)
-				return ret;
-		}
-	} else {
-		return rtl8372n_port_fdb_static_add(priv, port, addr, vid);
-	}
-	return 0;
+	if (dsa_is_cpu_port(ds, port))
+		return 0;
+	vid = vid ?: 1;
+	return rtl8372n_port_fdb_static_add(priv, port, addr, vid);
+
 }
 
 static int
@@ -1445,7 +1426,6 @@
 		    struct dsa_db db)
 {
 	struct rtl837x_priv *priv = ds->priv;
-	int ret;
 
 	if (db.type != DSA_DB_PORT && db.type != DSA_DB_BRIDGE)
 		return -EOPNOTSUPP;
@@ -1453,23 +1433,11 @@
 	if (dsa_fdb_present_in_other_db(ds, port, addr, vid, db))
 		return 0;
 
-	if (db.type == DSA_DB_BRIDGE && is_8021q_tag(priv->tag_proto)) {
-		if (vid == 0) {
-			struct dsa_port *dp;
-
-			dsa_switch_for_each_user_port(dp, ds) {
-				/* Del static fdb entry */
-				ret = rtl8372n_port_fdb_static_del(priv, addr, dsa_tag_8021q_standalone_vid(dp));
-				if (ret)
-					return ret;
-			}
-		} else {
-			return rtl8372n_port_fdb_static_del(priv, addr, vid);
-		}
-	} else {
-		return rtl8372n_port_fdb_static_del(priv, addr, vid);
-	}
-	return 0;
+	if (dsa_is_cpu_port(ds, port))
+		return 0;
+	vid = vid ?: 1;
+	return rtl8372n_port_fdb_static_del(priv, addr, vid);
+
 }
 
 static int
@@ -1508,7 +1476,7 @@
 	struct rtl837x_priv *priv = ds->priv;
 	int ret;
 	const u8 *addr = mdb->addr;
-	u16 vid = mdb->vid;
+	u16 vid = mdb->vid ?: 1;
 	struct rtl837x_lut_entry entry = {0};
 
 	memcpy(entry.mc.key.mac_addr, addr, ETH_ALEN);
@@ -1551,7 +1519,7 @@
 	struct rtl837x_priv *priv = ds->priv;
 	int ret;
 	const u8 *addr = mdb->addr;
-	u16 vid = mdb->vid;
+	u16 vid = mdb->vid ?: 1;
 	struct rtl837x_lut_entry entry = {0};
 
 	dev_dbg(priv->dev, "[%s]:mac:%02X:%02X:%02X:%02X:%02X:%02X port:%d vid:%04d\n", __func__,
