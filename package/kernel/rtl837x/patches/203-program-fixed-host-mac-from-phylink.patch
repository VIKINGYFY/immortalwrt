From: ViKing <viking.yfy@qq.com>
Date: Sun, 08 Nov 2026 02:10:13 +0800
Subject: [PATCH] rtl837x: program fixed host MAC from phylink

A fixed CPU link cannot inherit its force-link, speed, duplex or pause bits from U-Boot after a switch reset. Program these fields from phylink link-up parameters and force link down on the matching callback. Apply this only to fixed CPU links using standard initialization; retain the upstream PHY and external-port behavior.

Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/src/rtl8372n.c
+++ b/src/rtl8372n.c
@@ -1139,6 +1139,33 @@
 		state->pause);
 }
 
+/* A fixed-link phylink has no PHY-polled MAC state. Program the host MAC
+ * from its link parameters instead of inheriting the bootloader force word.
+ */
+static int rtl8372n_fixed_mac(struct realtek_priv *priv, int port, bool link,
+			    int speed, int duplex, bool tx_pause, bool rx_pause)
+{
+	u32 value = BIT(0);
+	int code;
+
+	if (link) {
+		switch (speed) {
+		case SPEED_10: code = 0; break;
+		case SPEED_100: code = 1; break;
+		case SPEED_1000: code = 2; break;
+		case SPEED_10000: code = 4; break;
+		case SPEED_2500: code = 5; break;
+		case SPEED_5000: code = 6; break;
+		default: return -EINVAL;
+		}
+		value |= BIT(1) | (duplex == DUPLEX_FULL ? BIT(2) : 0) |
+			 (code << 3) | BIT(9) |
+			 (tx_pause ? BIT(7) : 0) | (rx_pause ? BIT(8) : 0);
+	}
+	return regmap_update_bits(priv->map, RTL837X_MAC_FORCE_MODE_REG(port),
+				  GENMASK(11, 0), value);
+}
+
 static void rtl8372n_phylink_mac_link_down(struct phylink_config *config,
 					   unsigned int mode,
 					   phy_interface_t interface)
@@ -1147,6 +1174,10 @@
 	struct dsa_port *dp = dsa_phylink_to_port(config);
 
 	priv = dp->ds->priv;
+	if (dsa_port_is_cpu(dp) && mode == MLO_AN_FIXED &&
+	    !priv->preserve_boot_config &&
+	    rtl8372n_fixed_mac(priv, dp->index, false, 0, 0, false, false))
+		dev_err(priv->dev, "failed to force host MAC down\n");
 
 	if (!rtl8372n_is_serdes_port(dp->index))
 		return;
@@ -1164,6 +1195,11 @@
 	struct dsa_port *dp = dsa_phylink_to_port(config);
 
 	priv = dp->ds->priv;
+	if (dsa_port_is_cpu(dp) && mode == MLO_AN_FIXED &&
+	    !priv->preserve_boot_config &&
+	    rtl8372n_fixed_mac(priv, dp->index, true, speed, duplex,
+			      tx_pause, rx_pause))
+		dev_err(priv->dev, "failed to set fixed host MAC parameters\n");
 
 	if (!rtl8372n_is_serdes_port(dp->index))
 		return;
