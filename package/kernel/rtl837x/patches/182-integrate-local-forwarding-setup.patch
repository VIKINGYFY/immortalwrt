 	ret = rtl837x_reg_bits_write(priv, RTL837X_L2_TBL_FLUSH_ALL_ADDR,
 				  RTL837X_L2_TBL_FLUSH_ALL_FLUSH_ALL_MASK, 1);
 	if (ret)
@@ -2199,6 +2026,10 @@
 	ret = rtl837x_reg_bits_write(priv, RTL837X_L2_LRN_PORT_CONSTRT_ACT_ADDR,
 			  RTL837X_L2_LRN_PORT_CONSTRT_ACT_LRN_ACT_MASK, 0
 			);
+	if (ret)
+		return ret;
+
+	ret = rtl8372n_set_ageing_time(ds, 300 * MSEC_PER_SEC);
 	if (ret)
 		return ret;
 
@@ -2219,14 +2050,15 @@
 	if (ret)
 		return ret;
 
+	ret = rtl837x_local_init(ds);
+	if (ret)
+		return ret;
+
 	rtnl_lock();
 	switch (priv->tag_proto) {
 	case DSA_TAG_PROTO_RTL837X_8021AD:
 		ret = rtl8372n_set_tag_8021q(ds);
 		break;
-	case DSA_TAG_PROTO_RTL8_4:
-		ret = rtl8372n_set_tag_rtl(ds);
