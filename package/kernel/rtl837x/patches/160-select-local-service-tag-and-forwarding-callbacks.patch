From: ViKing <viking.yfy@qq.com>
Date: Sat, 07 Nov 2026 11:20:00 +0800
Subject: [PATCH] rtl8372n: select the local service tag and forwarding callbacks

Use the existing dedicated RTL837X service transport and local policy.
Remove inactive tag switching and the superseded upstream VLAN/bridge
helpers. Keep per-port SVIDs and independent customer VLAN semantics.

Split from:
  package/kernel/rtl837x/patches/100-migrate-local-behavior-to-upstream-regmap.patch ([PATCH] rtl837x: migrate local board and forwarding policy to regmap)

Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/src/rtl8372n.c
+++ b/src/rtl8372n.c
@@ -242,7 +242,7 @@
 static bool is_8021q_tag(enum dsa_tag_protocol tag_proto)
 {
 	switch (tag_proto) {
-	case DSA_TAG_PROTO_MXL862_8021Q:
+	case DSA_TAG_PROTO_RTL837X_8021AD:
 		return true;
 	default:
 		return false;
@@ -448,15 +448,9 @@
 }
 
 static enum dsa_tag_protocol rtl8372n_get_tag_protocol(struct dsa_switch *ds,
-							int port,
-							enum dsa_tag_protocol mp)
-{
-	struct rtl837x_priv *priv = ds->priv;
-	struct device *dev = priv->dev;
-
-	dev_dbg(dev, "get_DSA_PROTO port:%d\n", port);
-
-	return priv->tag_proto;
+				int port, enum dsa_tag_protocol mp)
+{
+	return DSA_TAG_PROTO_RTL837X_8021AD;
 }
 
 static int rtl8372n_mdio_phy_read_c22(struct mii_bus *bus, int addr, int regnum)
@@ -1023,119 +1017,54 @@
 
 static int rtl8372n_set_tag_8021q(struct dsa_switch *ds)
 {
-	int ret;
 	struct rtl837x_priv *priv = ds->priv;
-
-	//  bit0: internal cpu; bit1: external cpu
+	int ret, idx;
+
+	ret = rtl837x_reg_bits_write(priv, RTL837X_CPU_TAG_CTRL_ADDR,
+		RTL837X_CPU_TAG_CTRL_EXT_CPUTAG_EN_MASK, 0);
+	if (ret)
+		return ret;
 	ret = rtl837x_reg_bits_write(priv, RTL837X_SVLAN_TRAP_CTRL_ADDR,
-			  RTL837X_SVLAN_TRAP_CTRL_CPU_PMSK_MASK, BIT(1)
-			);
-	if (ret)
-		return ret;
-
-	// Set S-VLAN upstream priority reference setting.
-	/*
-	 *	REF_INTERNAL_PRI = 0,
-	 *	REF_CTAG_PRI,
-	 *	REF_SVLAN_PRI,
-	 *	REF_PB_PRI,
-	 *	REF_PRI_END
-	 */
+		RTL837X_SVLAN_TRAP_CTRL_CPU_PMSK_MASK, BIT(1));
+	if (ret)
+		return ret;
 	ret = rtl837x_reg_bits_write(priv, RTL837X_VS_CTRL_ADDR,
-			  RTL837X_VS_CTRL_SPRISEL_MASK, 1
-			);
-	if (ret)
-		return ret;
-
-	// Drop packets received from the CPU port without an S-tag
-	/*
-	 *	UNTAG_DROP = 0,
-	 *	UNTAG_TRAP,
-	 *	UNTAG_ASSIGN,
-	 *	UNTAG_END
-	 */
+		RTL837X_VS_CTRL_SPRISEL_MASK, 1);
+	if (ret)
+		return ret;
 	ret = rtl837x_reg_bits_write(priv, RTL837X_VS_CTRL_ADDR,
-			  RTL837X_VS_CTRL_UNTAG_MASK, 0
-		);
-	if (ret)
-		return ret;
-
-	// Set custom TPID
-	ret = rtl837x_reg_write(priv, RTL837X_VS_GLB_CTRL_ADDR, ETH_P_8021Q);
-	if (ret)
-		return ret;
-
-	// Set cpu port as service port
+		RTL837X_VS_CTRL_UNTAG_MASK | RTL837X_VS_CTRL_UIFSEG_MASK, 0);
+	if (ret)
+		return ret;
+	ret = rtl837x_reg_write(priv, RTL837X_VS_GLB_CTRL_ADDR, ETH_P_8021AD);
+	if (ret)
+		return ret;
 	ret = rtl837x_reg_write(priv, RTL837X_VS_UPLINK_PORT_ADDR, dsa_cpu_ports(ds));
 	if (ret)
 		return ret;
-
-	for (int idx = 0; idx <= RTL837x_C2SIDXMAX;  idx++) {
-		ret = rtl837x_reg_write(priv, RTL837X_VLAN_C2S_ENTRY_ADDR(idx)+4, 0);
-		if (ret)
-			return ret;
-
+	for (idx = 0; idx <= RTL837x_C2SIDXMAX; idx++) {
+		ret = rtl837x_reg_write(priv, RTL837X_VLAN_C2S_ENTRY_ADDR(idx) + 4, 0);
+		if (ret)
+			return ret;
 		ret = rtl837x_reg_write(priv, RTL837X_VLAN_C2S_ENTRY_ADDR(idx), 0);
 		if (ret)
 			return ret;
 	}
-
-	// Set Port Ingress Tag Action
-	/*
-	 *	UNASSIGN_PBSVID = 0,
-	 *	UNASSIGN_TRAP,
-	 *	UNASSIGN_END
-	 */
-	ret = rtl837x_reg_bits_write(priv, RTL837X_VS_CTRL_ADDR,
-			  RTL837X_VS_CTRL_UIFSEG_MASK, 0
-		);
-	if (ret)
-		return ret;
-
-	ret = dsa_tag_8021q_register(ds, htons(ETH_P_8021Q));
-	if (ret)
-		return ret;
-
-	return 0;
+	ret = dsa_tag_8021q_register(ds, htons(ETH_P_8021AD));
+	if (ret)
+		return ret;
+	ret = rtl837x_local_bridge_init(ds);
+	if (ret)
+		dsa_tag_8021q_unregister(ds);
+	return ret;
 }
 
 static int rtl8372n_teardown_tag_8021q(struct dsa_switch *ds)
 {
 	struct rtl837x_priv *priv = ds->priv;
-	struct rtl8372n *chip_data = priv->chip_data;
-	struct dsa_port *dp = NULL;
-
 	if (ds->tag_8021q_ctx)
 		dsa_tag_8021q_unregister(ds);
-
-	// Clean service port
-	rtl837x_reg_write(priv, RTL837X_VS_UPLINK_PORT_ADDR, 0);
-
-	struct rtl837x_vlan_4k vlan4k = {0};
-
-	vlan4k.member = 0;
-	vlan4k.untag = 0;
-	vlan4k.fid = 0;
-
-	// Remove s-tag vlan entrys
-	for (int i = 0; i <= RTL8372N_VLAN_MAX; i++) {
-		if (chip_data->dsa_tag_8021q_vid[i]) {
-			vlan4k.vid = i;
-			chip_data->dsa_tag_8021q_vid[i] = false;
-			priv->ops->set_vlan_4k(priv, &vlan4k);
-		}
-	}
-
-	dsa_switch_for_each_user_port(dp, ds) {
-		rtl837x_reg_bits_write(priv, RTL837X_VS_PORT_DFLT_SVID_ADDR(dp->index),
-				  RTL837X_VS_PORT_DFLT_SVID_PORT_DFLT_SVID_MASK(dp->index), 0
-				);
-	}
-
-	rtl837x_reg_bits_write(priv, RTL837X_L2_TBL_FLUSH_ALL_ADDR,
-			  RTL837X_L2_TBL_FLUSH_ALL_FLUSH_ALL_MASK, 1
-			);
-	return 0;
+	return rtl837x_reg_write(priv, RTL837X_VS_UPLINK_PORT_ADDR, 0);
 }
 
 
