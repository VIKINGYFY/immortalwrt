From: ViKing <viking.yfy@qq.com>
Date: Sat, 07 Nov 2026 22:33:07 +0800
Subject: [PATCH] rtl837x: preserve board topology and leds

Keep conduit readiness, dual-switch dependency, pre-conduit quarantine and the masked board LED table.

Split from:
  package/kernel/rtl837x/patches/130-preserve-board-topology-and-led-initialization.patch ([PATCH] rtl837x: preserve board topology and LED initialization)
  package/kernel/rtl837x/patches/100-migrate-local-behavior-to-upstream-regmap.patch ([PATCH] rtl837x: migrate local board and forwarding policy to regmap)

Signed-off-by: ViKing <viking.yfy@qq.com>

--- /dev/null
+++ b/src/rtl837x_board.c
@@ -0,0 +1,142 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/* Board initialization retained from the local RTL837x integration. */
+#include <linux/device.h>
+#include <linux/netdevice.h>
+#include <linux/of_net.h>
+
+#include "rtl837x.h"
+
+#define RTL837X_PORT_ISOLATION_REG(_p) (0x50c0 + ((_p) << 2))
+
+int rtl837x_board_prepare(struct realtek_priv *priv)
+{
+	struct device_node *np = priv->dev->of_node;
+	struct device_node *ports, *port, *ethernet = NULL, *supplier_np;
+	struct mdio_device *supplier;
+	struct net_device *conduit;
+	u32 configured = 0, cpu = 0, index;
+	int ret = 0, cpus = 0;
+	bool ready;
+
+	ports = of_get_child_by_name(np, "ports");
+	if (!ports)
+		ports = of_get_child_by_name(np, "ethernet-ports");
+	if (!ports)
+		return -EINVAL;
+
+	for_each_available_child_of_node(ports, port) {
+		struct device_node *eth;
+
+		ret = of_property_read_u32(port, "reg", &index);
+		if (ret || index < 3 || index >= priv->num_ports) {
+			ret = -EINVAL;
+			of_node_put(port);
+			goto out;
+		}
+		configured |= BIT(index);
+		eth = of_parse_phandle(port, "ethernet", 0);
+		if (eth) {
+			cpus++;
+			cpu = index;
+			of_node_put(ethernet);
+			ethernet = eth;
+		}
+	}
+	if (cpus != 1 || (cpu != 3 && cpu != 8)) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	/* Close bootloader forwarding before deferring for the host MAC. */
+	if (of_property_read_bool(np, "realtek,quarantine-before-conduit")) {
+		for (index = 3; index < priv->num_ports; index++) {
+			u32 members = index == cpu ? configured & ~BIT(cpu) :
+				(configured & BIT(index) ? BIT(cpu) : 0);
+
+			ret = rtl837x_reg_write(priv,
+				RTL837X_PORT_ISOLATION_REG(index), members);
+			if (ret)
+				goto out;
+		}
+	}
+
+	rtnl_lock();
+	conduit = of_find_net_device_by_node(ethernet);
+	ready = conduit && conduit->reg_state == NETREG_REGISTERED &&
+		netif_device_present(conduit);
+	if (conduit)
+		put_device(&conduit->dev);
+	rtnl_unlock();
+	if (!ready) {
+		ret = -EPROBE_DEFER;
+		goto out;
+	}
+
+	supplier_np = of_parse_phandle(np, "realtek,init-after", 0);
+	if (supplier_np) {
+		supplier = of_mdio_find_device(supplier_np);
+		of_node_put(supplier_np);
+		ready = supplier && device_is_bound(&supplier->dev);
+		if (supplier)
+			put_device(&supplier->dev);
+		if (!ready)
+			ret = -EPROBE_DEFER;
+	}
+out:
+	of_node_put(ethernet);
+	of_node_put(ports);
+	return ret;
+}
+
+/* Masked board LED register settings from the existing board integration. */
+int rtl837x_board_led_init(struct realtek_priv *priv)
+{
+	static const struct { u32 reg, mask, value; } init[] = {
+		{ 0x65e0, 0x0000003f, 0x00000000 },
+		{ 0x65e0, 0x00000fc0, 0x00000040 },
+		{ 0x65e0, 0x0003f000, 0x00004000 },
+		{ 0x65e0, 0x00fc0000, 0x00140000 },
+		{ 0x65e0, 0x3f000000, 0x10000000 },
+		{ 0x65e4, 0x0000003f, 0x00000009 },
+		{ 0x65e4, 0x00000fc0, 0x00000300 },
+		{ 0x65e4, 0x00fc0000, 0x00500000 },
+		{ 0x65e4, 0x3f000000, 0x10000000 },
+		{ 0x65e8, 0x0000003f, 0x00000018 },
+		{ 0x65e8, 0x0003f000, 0x00014000 },
+		{ 0x65ec, 0x0000003f, 0x00000015 },
+		{ 0x65ec, 0x00fc0000, 0x00600000 },
+		{ 0x65f0, 0x00000fc0, 0x00000700 },
+		{ 0x65f0, 0x3f000000, 0x1c000000 },
+		{ 0x65f4, 0x0000003f, 0x0000001d },
+		{ 0x65f4, 0x00000fc0, 0x00000800 },
+		{ 0x65f4, 0x0003f000, 0x00021000 },
+		{ 0x65d8, 0x00000010, 0x00000010 },
+		{ 0x65d8, 0x00000100, 0x00000100 },
+		{ 0x65d8, 0x00000400, 0x00000400 },
+		{ 0x65d8, 0x00200000, 0x00200000 },
+		{ 0x6520, 0x00001e00, 0x00000400 },
+		{ 0x6520, 0x000001e0, 0x00000020 },
+		{ 0x6520, 0x0000000c, 0x00000004 },
+		{ 0x65f8, 0x00000003, 0x00000003 },
+		{ 0x65fc, 0xffffffff, 0x33333000 },
+		{ 0x6600, 0x0000000f, 0x00000003 },
+		{ 0x65dc, 0x3fffffff, 0x30200510 },
+		{ 0x7f8c, 0x3fffffff, 0x3fdffaef },
+		{ 0x654c, 0x0002ffff, 0x00000000 },
+		{ 0x6548, 0x0000ffff, 0x00000175 },
+		{ 0x6548, 0xffff0000, 0x01400000 },
+		{ 0x6528, 0x000000ff, 0x00000000 },
+		{ 0x65dc, 0x40000000, 0x40000000 },
+	};
+	int i, ret;
+
+	if (!of_property_read_bool(priv->dev->of_node, "realtek,rtl8372n-led-init"))
+		return 0;
+	for (i = 0; i < ARRAY_SIZE(init); i++) {
+		ret = regmap_update_bits(priv->map, init[i].reg,
+					 init[i].mask, init[i].value);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
