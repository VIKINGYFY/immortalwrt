From: ViKing <viking.yfy@qq.com>
Date: Sat, 07 Nov 2026 22:33:07 +0800
Subject: [PATCH] rtl837x: preserve boot and native forwarding setup

Preserve boot PHY/SerDes wiring and CPU force-link, wait for VLAN-table reset and initialize the native policy within the upstream chip/port setup.

Split from:
  package/kernel/rtl837x/patches/181-preserve-cold-and-boot-initialization.patch ([PATCH] rtl8372n: preserve cold and boot initialization)
  package/kernel/rtl837x/patches/182-integrate-local-forwarding-setup.patch ([PATCH] rtl8372n: integrate local forwarding setup)
  package/kernel/rtl837x/patches/100-migrate-local-behavior-to-upstream-regmap.patch ([PATCH] rtl837x: migrate local board and forwarding policy to regmap)

Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/src/rtl8372n.c
+++ b/src/rtl8372n.c
@@ -1946,6 +1946,9 @@ static int rtl8372n_setup_port(struct re
 	if (chip_info->port_feature[port] == RTL837X_PORT_FEATURE_NONEXIST)
 		return 0;
 
+	if (dsa_port_is_unused(dp))
+		return rtl8372n_port_set_isolation(priv, port, 0);
+
 	if (of_get_phy_mode(dn, &mode)) {
 		dev_warn(priv->dev,
 			 "Failed to get port(%d) phy-mode, Use PHY_INTERFACE_MODE_INTERNAL by default",
@@ -1961,15 +1964,17 @@ static int rtl8372n_setup_port(struct re
 			port_type = RTL837X_SMI_MAC_TYPE_PORT;
 	}
 
-	ret = regmap_update_bits(priv->map, RTL837X_SMI_MAC_TYPE_REG,
+	if (!priv->preserve_boot_config) {
+		ret = regmap_update_bits(priv->map, RTL837X_SMI_MAC_TYPE_REG,
 				 RTL837X_SMI_MAC_TYPE_MASK(port),
 				    port_type << __ffs(RTL837X_SMI_MAC_TYPE_MASK(port))
 				);
-	if (ret)
-		return ret;
+		if (ret)
+			return ret;
+	}
 
 	if (!dsa_port_is_unused(dp)) {
-		if (port_type == RTL837X_SMI_MAC_TYPE_PORT) {
+		if (port_type == RTL837X_SMI_MAC_TYPE_PORT && !priv->preserve_boot_config) {
 			// TODO?: may be we can add poll phy status?
 			port_priv->have_pcs = false;
 
@@ -1995,19 +2000,23 @@ static int rtl8372n_setup_port(struct re
 			port_priv->pcs.poll = true;
 		}
 
-		/* Use the polled (PHY/Serdes). */
-		ret = regmap_set_bits(priv->map, RTL837X_SMI_GLB_CTRL_REG,
+		if (!priv->preserve_boot_config) {
+			/* Use the polled PHY/SerDes state. */
+			ret = regmap_set_bits(priv->map, RTL837X_SMI_GLB_CTRL_REG,
 				      RTL837X_SMI_GLB_CTRL_POLLING_PORT_BIT(port)
 			);
-		if (ret)
-			return ret;
+			if (ret)
+				return ret;
+		}
 	}
 
-	/* Clean the force link bit */
-	ret = regmap_clear_bits(priv->map, RTL837X_MAC_FORCE_MODE_REG(port),
+	/* Clean user force-link without destroying the boot CPU link. */
+	if (!dsa_port_is_cpu(dp)) {
+		ret = regmap_clear_bits(priv->map, RTL837X_MAC_FORCE_MODE_REG(port),
 				RTL837X_MAC_FORCE_MODE_FORCE_LINK_MASK);
-	if (ret)
-		return ret;
+		if (ret)
+			return ret;
+	}
 
 	ret = regmap_write(priv->map, RTL837X_FC_PORT_ACT_CTRL_REG(port), 0x1050);
 	if (ret)
@@ -2232,13 +2241,12 @@ static void rtl8372n_teardown(struct dsa
 // TODO: init chip based on rtl837x_chip_info
 static int rtl8372n_setup(struct dsa_switch *ds)
 {
-	struct rtl8372n *chip_data;
 	struct realtek_priv *priv = ds->priv;
 	struct dsa_port *dp;
+	u32 val;
 	int cpu_dp_cnt = 0;
 	int ret;
 
-	chip_data = priv->chip_data;
 
 	dsa_switch_for_each_port(dp, ds) {
 		if (dsa_port_is_dsa(dp)) {
@@ -2269,33 +2277,45 @@ static int rtl8372n_setup(struct dsa_swi
 	}
 
 	//#cfg_FWD_INVLD_MAC_CTRL_EN,cfg_FWD_UNKN_OPCODE_EN
-	rtl837x_reg_bits_write(priv, RTL837X_MAC_L2_GLOBAL_CTRL_REG,
+	ret = rtl837x_reg_bits_write(priv, RTL837X_MAC_L2_GLOBAL_CTRL_REG,
 			       RTL837X_MAC_L2_GLOBAL_CTRL_FWD_UNKN_OPCODE_EN_MASK |
 			       RTL837X_MAC_L2_GLOBAL_CTRL_FWD_INVLD_MAC_EN_MASK,
 			       0b11);
+	if (ret)
+		return ret;
 
 	/* Set RS_LINK_FAULT_INDI_OFF to disable the link fault flag, which
 	 * resolves a DSC expansion issue on port4-port7 link down.
 	 */
-	rtl837x_reg_bits_write(priv, RTL837X_RS_LAYER_CONFIG_REG,
+	ret = rtl837x_reg_bits_write(priv, RTL837X_RS_LAYER_CONFIG_REG,
 			       RTL837X_RS_LAYER_CONFIG_RS_LINK_FAULT_INDI_OFF_MASK,
 			       1);
-
-	ret = rtl8372n_of_setup_phy_and_serdes(priv);
 	if (ret)
 		return ret;
 
+	if (!priv->preserve_boot_config) {
+		ret = rtl8372n_of_setup_phy_and_serdes(priv);
+		if (ret)
+			return ret;
+	}
+
 	msleep(20);
 
-	of_extra_init(ds);
+	ret = of_extra_init(ds);
+	if (ret)
+		return ret;
 
-	// enable SMI0/1/2 MDC clock output
-	rtl837x_reg_bits_write(priv, RTL837X_SMI_CTRL_REG,
+	if (!priv->preserve_boot_config) {
+		/* Enable SMI0/1/2 MDC clock output. */
+		ret = rtl837x_reg_bits_write(priv, RTL837X_SMI_CTRL_REG,
 			       RTL837X_SMI_CTRL_SMI0_MDC_EN_MASK |
 			  RTL837X_SMI_CTRL_SMI1_MDC_EN_MASK |
 			  RTL837X_SMI_CTRL_SMI2_MDC_EN_MASK,
 			 0xffffffff
 			);
+		if (ret)
+			return ret;
+	}
 
 	dsa_switch_for_each_port(dp, ds) {
 		ret = rtl8372n_setup_port(priv, dp->index);
@@ -2314,55 +2334,24 @@ static int rtl8372n_setup(struct dsa_swi
 				     RTL837X_VLAN_CTRL_TABLE_RST_MASK, 1);
 	if (ret)
 		return ret;
-
-	dsa_switch_for_each_user_port(dp, ds) {
-		/* Forward only to the CPU */
-		ret = rtl8372n_port_set_isolation(priv, dp->index,
-						  dsa_cpu_ports(ds));
-		if (ret)
-			return ret;
-	}
-
-	dsa_switch_for_each_cpu_port(dp, ds) {
-		ret = rtl8372n_port_set_isolation(priv, dp->index,
-						  dsa_user_ports(ds));
-		if (ret)
-			return ret;
-	}
+	ret = regmap_read_poll_timeout(priv->map, RTL837X_VLAN_CTRL_REG, val,
+				       !(val & RTL837X_VLAN_CTRL_TABLE_RST_MASK),
+				       10, 100000);
+	if (ret)
+		return dev_err_probe(priv->dev, ret, "VLAN table reset timed out\n");
 
 	dsa_switch_for_each_available_port(dp, ds) {
-		/* Flood every kind of frame to every port, as DSA expects for
-		 * standalone ports; port_bridge_flags changes it per bridge port.
-		 */
-		ret = rtl8372n_port_set_ucast_flood(priv, dp->index, true);
-		if (ret)
-			return ret;
+		int port = dp->index;
 
-		ret = rtl8372n_port_set_mcast_flood(priv, dp->index, true);
+		ret = rtl8372n_port_set_ucast_flood(priv, port, true);
 		if (ret)
 			return ret;
-
-		ret = rtl8372n_port_set_bcast_flood(priv, dp->index, true);
+		ret = rtl8372n_port_set_mcast_flood(priv, port, true);
 		if (ret)
 			return ret;
-
-		/* Disable vlan-filtering for all ports */
-		ret = rtl8372n_port_vlan_filtering(ds, dp->index, false, NULL);
-		if (ret) {
-			dev_err(priv->dev,
-				"Failed to disable vlan filtering on port %d\n",
-				dp->index);
-			return ret;
-		}
-
-		/* The switch default pvid is 1, clean it */
-		ret = rtl8372n_clean_pvid(priv, dp->index, 1);
-		if (ret) {
-			dev_err(priv->dev,
-				"Failed to clean pvid %d on port %d\n",
-				1, dp->index);
+		ret = rtl8372n_port_set_bcast_flood(priv, port, true);
+		if (ret)
 			return ret;
-		}
 	}
 
 	ret = rtl837x_lut_l2_flush_all(priv);
@@ -2376,6 +2365,28 @@ static int rtl8372n_setup(struct dsa_swi
 	if (ret)
 		return ret;
 
+	ret = regmap_update_bits(priv->map, 0x50e8, GENMASK(6, 3), 0);
+	if (ret)
+		return ret;
+	ret = rtl8372n_set_ageing_time(ds, 300 * MSEC_PER_SEC);
+	if (ret)
+		return ret;
+	/* Clear boot egress bypass before applying native membership. */
+	dsa_switch_for_each_port(dp, ds) {
+		int port = dp->index;
+		u32 mask = GENMASK(9, 0) << ((port % 3) * 10);
+
+		ret = regmap_update_bits(priv->map, 0x4eb8 + (port / 3) * 4, mask, 0);
+		if (ret)
+			return ret;
+		ret = regmap_update_bits(priv->map, 0x6728 + (port / 3) * 4, mask, 0);
+		if (ret)
+			return ret;
+	}
+	ret = rtl837x_local_init(ds);
+	if (ret)
+		return ret;
+
 	rtnl_lock();
 	switch (priv->tag_proto) {
 	case DSA_TAG_PROTO_RTL837X_8021AD:
