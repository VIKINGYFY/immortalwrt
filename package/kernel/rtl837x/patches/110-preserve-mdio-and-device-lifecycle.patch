From: ViKing <viking.yfy@qq.com>
Date: Sat, 07 Nov 2026 22:33:07 +0800
Subject: [PATCH] rtl837x: preserve mdio and device lifecycle

Keep bounded nested MDIO transactions, boot-preserving reset, board prerequisites, standalone VLAN filtering and complete cleanup while using the dev probe and variant model.

Split from:
  package/kernel/rtl837x/patches/100-mdio-transport-and-device-lifecycle.patch ([PATCH] rtl837x: preserve MDIO transport and device lifecycle)
  package/kernel/rtl837x/patches/100-migrate-local-behavior-to-upstream-regmap.patch ([PATCH] rtl837x: migrate local board and forwarding policy to regmap)

Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/src/rtl837x_mdio.c
+++ b/src/rtl837x_mdio.c
@@ -3,6 +3,7 @@
  * Copyright (C) 2025 StarField Xu <air_jinkela@163.com>
  */
 #include <linux/kernel.h>
+#include <linux/iopoll.h>
 #include <linux/module.h>
 #include <linux/device.h>
 #include <linux/of.h>
@@ -19,35 +20,45 @@
 #define REALTEK_RTL837X_MDIO_READ_CMD           0x1B
 #define REALTEK_RTL837X_MDIO_WRITE_CMD          0x19
 
+static int rtl837x_mdio_wait(struct realtek_priv *priv)
+{
+	int val, ret;
+
+	ret = read_poll_timeout(__mdiobus_read, val,
+				val < 0 || !(val & BIT(2)), 10, 5000, false,
+				priv->bus, priv->mdio_addr, REALTEK_RTL837X_MDIO_CTRL_REG);
+	return ret ? ret : (val < 0 ? val : 0);
+}
+
 static int rtl837x_mdio_write(void *ctx, u32 reg, u32 val)
 {
 	struct realtek_priv *priv = ctx;
 	struct mii_bus *bus = priv->bus;
 	int ret;
 
-	mutex_lock(&bus->mdio_lock);
+	mutex_lock_nested(&bus->mdio_lock, MDIO_MUTEX_NESTED);
 
-	ret = bus->write(bus, priv->mdio_addr,
-			 REALTEK_RTL837X_MDIO_ADDRESS_REG, reg);
+	ret = rtl837x_mdio_wait(priv);
 	if (ret)
 		goto out_unlock;
 
-	ret = bus->write(bus, priv->mdio_addr, REALTEK_RTL837X_MDIO_DATA_LOW,
-			 val & 0xFFFF);
-	if (ret)
+	ret = __mdiobus_write(bus, priv->mdio_addr, REALTEK_RTL837X_MDIO_ADDRESS_REG, reg);
+	if (unlikely(ret))
 		goto out_unlock;
 
-	ret = bus->write(bus, priv->mdio_addr, REALTEK_RTL837X_MDIO_DATA_HIGH,
-			 (val >> 16) & 0xFFFF);
-	if (ret)
+	ret = __mdiobus_write(bus, priv->mdio_addr, REALTEK_RTL837X_MDIO_DATA_LOW, (val & 0xFFFF));
+	if (unlikely(ret))
 		goto out_unlock;
 
-	ret = bus->write(bus, priv->mdio_addr, REALTEK_RTL837X_MDIO_CTRL_REG,
-			 REALTEK_RTL837X_MDIO_WRITE_CMD);
-	if (ret)
+	ret = __mdiobus_write(bus, priv->mdio_addr, REALTEK_RTL837X_MDIO_DATA_HIGH, ((val >> 16) & 0xFFFF));
+	if (unlikely(ret))
 		goto out_unlock;
 
-	ret = 0;
+	ret = __mdiobus_write(bus, priv->mdio_addr, REALTEK_RTL837X_MDIO_CTRL_REG, REALTEK_RTL837X_MDIO_WRITE_CMD);
+	if (unlikely(ret))
+		goto out_unlock;
+
+	ret = rtl837x_mdio_wait(priv);
 out_unlock:
 	mutex_unlock(&bus->mdio_lock);
 	return ret;
@@ -56,37 +67,41 @@
 static int rtl837x_mdio_read(void *ctx, u32 reg, u32 *val)
 {
 	struct realtek_priv *priv = ctx;
+	struct mii_bus *bus = priv->bus;
 	int ret, val_l, val_h;
-	struct mii_bus *bus;
 
-	bus = priv->bus;
+	*val = 0;
 
-	mutex_lock(&bus->mdio_lock);
+	mutex_lock_nested(&bus->mdio_lock, MDIO_MUTEX_NESTED);
 
-	ret = bus->write(bus, priv->mdio_addr,
-			 REALTEK_RTL837X_MDIO_ADDRESS_REG, reg);
+	ret = rtl837x_mdio_wait(priv);
 	if (ret)
 		goto out_unlock;
 
-	ret = bus->write(bus, priv->mdio_addr, REALTEK_RTL837X_MDIO_CTRL_REG,
-			 REALTEK_RTL837X_MDIO_READ_CMD);
+	ret = __mdiobus_write(bus, priv->mdio_addr, REALTEK_RTL837X_MDIO_ADDRESS_REG, reg);
+	if (unlikely(ret))
+		goto out_unlock;
+
+	ret = __mdiobus_write(bus, priv->mdio_addr, REALTEK_RTL837X_MDIO_CTRL_REG, REALTEK_RTL837X_MDIO_READ_CMD);
+	if (unlikely(ret))
+		goto out_unlock;
+
+	ret = rtl837x_mdio_wait(priv);
 	if (ret)
 		goto out_unlock;
 
-	val_l = bus->read(bus, priv->mdio_addr, REALTEK_RTL837X_MDIO_DATA_LOW);
+	val_l = __mdiobus_read(bus, priv->mdio_addr, REALTEK_RTL837X_MDIO_DATA_LOW);
+	val_h = __mdiobus_read(bus, priv->mdio_addr, REALTEK_RTL837X_MDIO_DATA_HIGH);
 	if (val_l < 0) {
 		ret = val_l;
 		goto out_unlock;
 	}
-
-	val_h = bus->read(bus, priv->mdio_addr, REALTEK_RTL837X_MDIO_DATA_HIGH);
 	if (val_h < 0) {
 		ret = val_h;
 		goto out_unlock;
 	}
 
-	*val = val_l & 0xffff;
-	*val |= (val_h & 0xffff) << 16;
+	*val = (val_l & 0xffff) | ((val_h & 0xffff) << 16);
 	ret = 0;
 
 out_unlock:
@@ -178,6 +193,11 @@
 		return ret;
 	}
 
+	priv->preserve_boot_config = of_property_read_bool(np, "realtek,preserve-boot-config");
+	priv->reinit_cpu_serdes = of_property_read_bool(np, "realtek,reinit-cpu-serdes");
+	if (priv->reinit_cpu_serdes && !priv->preserve_boot_config)
+		return -EINVAL;
+
 	priv->mdio_addr = mdiodev->addr;
 	priv->bus = mdiodev->bus;
 	priv->dev = dev;
@@ -196,14 +216,14 @@
 	dev_set_drvdata(dev, priv);
 
 	/* Request the reset asserted; the polarity comes from the DT flag */
-	priv->reset = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	priv->reset = devm_gpiod_get_optional(dev, "reset", priv->preserve_boot_config ? GPIOD_ASIS : GPIOD_OUT_HIGH);
 	if (IS_ERR(priv->reset)) {
 		dev_err(dev, "failed to get RESET GPIO\n");
 		ret = PTR_ERR(priv->reset);
 		return ret;
 	}
 
-	if (priv->reset) {
+	if (priv->reset && !priv->preserve_boot_config) {
 		/* This chip takes a long time to fully reset */
 		usleep_range(50000, 51100);
 		gpiod_set_value_cansleep(priv->reset, 0);
@@ -211,6 +231,11 @@
 		dev_dbg(dev, "deasserted RESET\n");
 	}
 
+	priv->num_ports = RTL837X_MAX_PORT_COUNT;
+	ret = rtl837x_board_prepare(priv);
+	if (ret)
+		return dev_err_probe(dev, ret, "board initialization prerequisites unavailable\n");
+
 	ret = priv->ops->detect(priv);
 	if (ret) {
 		dev_err(dev, "unable to detect switch\n");
@@ -228,6 +253,15 @@
 	if (var->pl_mac_ops)
 		priv->ds->phylink_mac_ops = var->pl_mac_ops;
 
+	priv->ds->phys_mii_mask = GENMASK(7, 4);
+	priv->ds->configure_vlan_while_not_filtering = true;
+	priv->ds->needs_standalone_vlan_filtering = true;
+	priv->ds->untag_bridge_pvid = false;
+	priv->ds->fdb_isolation = true;
+	priv->ds->max_num_bridges = DSA_TAG_8021Q_MAX_NUM_BRIDGES;
+	priv->ds->ageing_time_min = 14000;
+	priv->ds->ageing_time_max = 800000;
+
 	ret = dsa_register_switch(priv->ds);
 	if (ret) {
 		dev_err(priv->dev, "unable to register switch ret = %d\n", ret);
@@ -238,15 +272,24 @@
 	if (of_property_read_bool(np, "gpio-controller")) {
 		ret = rtl837x_gpiochip_init(priv);
 		if (ret)
-			dev_err(priv->dev, "Failed to register gpiochip. ret = %d\n", ret);
+			goto err_unregister_switch;
 	}
 #endif /* CONFIG_GPIOLIB */
 
-	rtl837x_set_led(priv);
+	ret = rtl837x_board_led_init(priv);
+	if (ret)
+		goto err_unregister_switch;
+	ret = rtl837x_set_led(priv);
+	if (ret)
+		goto err_unregister_switch;
 
 	rtl837x_debug_proc_init(priv);
 
 	return 0;
+err_unregister_switch:
+	dsa_unregister_switch(priv->ds);
+	dev_set_drvdata(dev, NULL);
+	return ret;
 }
 
 static void rtl837x_mdio_remove(struct mdio_device *mdiodev)
@@ -258,17 +301,12 @@
 
 	rtl837x_debug_proc_deinit(priv);
 
-	if (priv->ds->tag_8021q_ctx) {
-		rtnl_lock();
-		dsa_tag_8021q_unregister(priv->ds);
-		rtnl_unlock();
-	}
 
 	dsa_unregister_switch(priv->ds);
 
 	/* leave the device reset asserted */
 	if (priv->reset)
-		gpiod_set_value(priv->reset, 1);
+		gpiod_set_value_cansleep(priv->reset, 1);
 }
 
 static void rtl837x_mdio_shutdown(struct mdio_device *mdiodev)
