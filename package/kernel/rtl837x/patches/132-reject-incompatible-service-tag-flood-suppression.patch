From: ViKing <viking.yfy@qq.com>
Date: Sat, 07 Nov 2026 22:33:07 +0800
Subject: [PATCH] rtl837x: reject incompatible service tag flood suppression

Reject flood suppression for native service tagging: the egress miss masks also filter ordinary CPU-directed private-VLAN frames. Keep learning controls and default hardware forwarding, and reject the configuration before applying any register changes.

Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/src/rtl8372n.c
+++ b/src/rtl8372n.c
@@ -2194,6 +2194,21 @@
 	return RTL837X_MAC_MAX_LEN_MAX - VLAN_ETH_HLEN - ETH_FCS_LEN;
 }
 
+static int rtl8372n_check_bridge_flood(struct realtek_priv *priv,
+				       struct switchdev_brport_flags flags,
+				       struct netlink_ext_ack *extack)
+{
+	unsigned long flood = BR_FLOOD | BR_MCAST_FLOOD | BR_BCAST_FLOOD;
+
+	if (is_8021q_tag(priv->tag_proto) && (flags.mask & ~flags.val & flood)) {
+		/* EOPNOTSUPP would let the bridge accept a software-only change. */
+		NL_SET_ERR_MSG_MOD(extack,
+			"Flood suppression is unavailable with native service tags");
+		return -EINVAL;
+	}
+	return 0;
+}
+
 static int rtl8372n_port_pre_bridge_flags(struct dsa_switch *ds, int port,
 					  struct switchdev_brport_flags flags,
 					   struct netlink_ext_ack *extack)
@@ -2206,7 +2221,7 @@
 	if (flags.mask & ~RTL8372N_SUPPORTED_BRIDGE_FLAGS)
 		return -EINVAL;
 
-	return 0;
+	return rtl8372n_check_bridge_flood(priv, flags, extack);
 }
 
 static int rtl8372n_port_bridge_flags(struct dsa_switch *ds, int port,
@@ -2216,6 +2231,10 @@
 	struct realtek_priv *priv = ds->priv;
 	int ret;
 
+	ret = rtl8372n_check_bridge_flood(priv, flags, extack);
+	if (ret)
+		return ret;
+
 	if (flags.mask & BR_LEARNING) {
 		ret = rtl837x_lut_port_set_learning(priv, port,
 						    !!(flags.val & BR_LEARNING));
