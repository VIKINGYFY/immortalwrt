From: ViKing <viking.yfy@qq.com>
Date: Sat, 07 Nov 2026 22:33:07 +0800
Subject: [PATCH] rtl837x: scope debugfs to each switch

Avoid duplicate debugfs directories for two separate DSA trees and free seq_file state when files close.

Split from:
  package/kernel/rtl837x/patches/190-scope-debugfs-to-each-switch-device.patch ([PATCH] rtl837x: scope debugfs to each switch device)
  package/kernel/rtl837x/patches/100-migrate-local-behavior-to-upstream-regmap.patch ([PATCH] rtl837x: migrate local board and forwarding policy to regmap)

Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/src/rtl837x_dbg.c
+++ b/src/rtl837x_dbg.c
@@ -55,6 +55,7 @@
 	static const struct file_operations _##name##_rw_fops = { \
 		.owner = THIS_MODULE, \
 		.open = simple_debugfs_open, \
+		.release = single_release, \
 		.write = _##name##_rw_write, \
 		.read = _##name##_rw_read \
 	}
@@ -790,6 +791,7 @@
 static const struct file_operations _sds_page_dump_fops = {
 	.owner = THIS_MODULE,
 	.open = simple_debugfs_open,
+	.release = single_release,
 	.read = _sds_page_dump_read
 };
 
@@ -835,6 +837,7 @@
 static const struct file_operations _vlan_dump_fops = {
 	.owner = THIS_MODULE,
 	.open = simple_debugfs_open,
+	.release = single_release,
 	.read = _vlan_dump_read
 };
 
@@ -926,6 +929,7 @@
 static const struct file_operations _l2uc_dump_fops = {
 	.owner = THIS_MODULE,
 	.open = simple_debugfs_open,
+	.release = single_release,
 	.read = _l2uc_dump_read
 };
 
@@ -988,6 +992,7 @@
 static const struct file_operations _port_eee_status_dump_fops = {
 	.owner = THIS_MODULE,
 	.open = simple_debugfs_open,
+	.release = single_release,
 	.read = _port_eee_status_dump_read
 };
 
@@ -1047,6 +1052,7 @@
 static const struct file_operations _led_dump_fops = {
 	.owner = THIS_MODULE,
 	.open = simple_debugfs_open,
+	.release = single_release,
 	.read = _led_dump_read
 };
 
@@ -1054,7 +1060,7 @@
 {
 	char name[64];
 
-	snprintf(name, 64, "rtl837x-%d-ds", priv->ds->index);
+	snprintf(name, sizeof(name), "rtl837x-%s", dev_name(priv->dev));
 	priv->debugfs_parent = debugfs_create_dir(name, NULL);
 	debugfs_create_file("reg", 0600,
 			    priv->debugfs_parent, priv,
