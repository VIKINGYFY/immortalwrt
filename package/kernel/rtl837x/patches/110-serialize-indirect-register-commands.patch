+	ret = __rtl837x_sds_reg_read(priv, sds_idx, sds_page, sds_reg, &val);
 	if (ret)
 		return ret;
 
@@ -485,19 +489,19 @@
 	return 0;
 }
 
-int rtl837x_sds_reg_bits_write(struct rtl837x_priv *priv, u8 sds_idx, u16 sds_page, u16 sds_reg, u16 mask, u16 data)
+static int __rtl837x_sds_reg_bits_write(struct rtl837x_priv *priv, u8 sds_idx, u16 sds_page, u16 sds_reg, u16 mask, u16 data)
