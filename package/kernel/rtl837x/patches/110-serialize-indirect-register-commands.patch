-int rtl837x_phys_write_c45(struct rtl837x_priv *priv, u16 phy_mask, int devad, int regnum, u16 val)
+static int __rtl837x_phys_write_c45(struct rtl837x_priv *priv, u16 phy_mask, int devad, int regnum, u16 val)
 {
 	int ret;
 	u32 tmp;
@@ -372,17 +374,17 @@
 	return 0;
 }
 
