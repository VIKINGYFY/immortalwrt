+static int __rtl837x_sds_reg_read(struct rtl837x_priv *priv, u8 sds_idx, u16 sds_page, u16 sds_reg, u16 *pdata)
 {
 	int ret;
 	u32 val, tmp;
@@ -440,7 +442,7 @@
 	return 0;
 }
 
