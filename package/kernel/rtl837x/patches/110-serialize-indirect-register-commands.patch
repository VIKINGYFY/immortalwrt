 }
 
 int rtl837x_rtl8224_reg_bits_read(struct rtl837x_priv *priv, u32 reg, u32 mask, u32 *pval)
@@ -657,6 +661,11 @@
 	u32 tmp;
 
 	mutex_lock(&priv->ita_lock);
+
+	ret = regmap_read_poll_timeout(priv->map, RTL837X_ITA_CTRL0_ADDR, tmp,
+		!(tmp & RTL837X_ITA_CTRL0_TLB_EXECUTE_MASK), 10, 1000);
+	if (ret)
+		goto out;
 
 	ret = rtl837x_reg_write(priv, RTL837X_ITA_WRITE_DATA0_ADDR(0), vlan->val);
 	if (ret)
@@ -1440,3 +1449,114 @@
 
 	return 0;
 }
+
+/* Serialize complete indirect commands, rather than individual regmap I/O. */
+int rtl837x_phy_read_c45(struct rtl837x_priv *priv, int phy, int devad, int regnum, u16 *pval)
+{
+	int ret;
+
+	mutex_lock(&priv->phy_lock);
+	ret = __rtl837x_phy_read_c45(priv, phy, devad, regnum, pval);
+	mutex_unlock(&priv->phy_lock);
+	return ret;
+}
+
+int rtl837x_phys_write_c45(struct rtl837x_priv *priv, u16 phy_mask, int devad, int regnum, u16 val)
+{
+	int ret;
+
+	mutex_lock(&priv->phy_lock);
+	ret = __rtl837x_phys_write_c45(priv, phy_mask, devad, regnum, val);
+	mutex_unlock(&priv->phy_lock);
+	return ret;
+}
+
+int rtl837x_phy_write_c45(struct rtl837x_priv *priv, int phy, int devad, int regnum, u16 val)
+{
+	int ret;
+
+	mutex_lock(&priv->phy_lock);
+	ret = __rtl837x_phy_write_c45(priv, phy, devad, regnum, val);
+	mutex_unlock(&priv->phy_lock);
+	return ret;
+}
+
+int rtl837x_phy_bits_read_c45(struct rtl837x_priv *priv, int phy, int devad, int regnum, u16 mask, u16 *pdata)
+{
+	int ret;
+
+	mutex_lock(&priv->phy_lock);
+	ret = __rtl837x_phy_bits_read_c45(priv, phy, devad, regnum, mask, pdata);
+	mutex_unlock(&priv->phy_lock);
+	return ret;
+}
+
+int rtl837x_phy_bits_write_c45(struct rtl837x_priv *priv, int phy, int devad, int regnum, u16 mask, u16 data)
+{
+	int ret;
+
+	mutex_lock(&priv->phy_lock);
+	ret = __rtl837x_phy_bits_write_c45(priv, phy, devad, regnum, mask, data);
+	mutex_unlock(&priv->phy_lock);
+	return ret;
+}
+
+int rtl837x_sds_reg_read(struct rtl837x_priv *priv, u8 sds_idx, u16 sds_page, u16 sds_reg, u16 *pdata)
+{
+	int ret;
+
+	mutex_lock(&priv->sds_lock);
+	ret = __rtl837x_sds_reg_read(priv, sds_idx, sds_page, sds_reg, pdata);
+	mutex_unlock(&priv->sds_lock);
+	return ret;
+}
+
+int rtl837x_sds_reg_write(struct rtl837x_priv *priv, u8 sds_idx, u16 sds_page, u16 sds_reg, u16 data)
+{
+	int ret;
+
+	mutex_lock(&priv->sds_lock);
+	ret = __rtl837x_sds_reg_write(priv, sds_idx, sds_page, sds_reg, data);
+	mutex_unlock(&priv->sds_lock);
+	return ret;
+}
+
+int rtl837x_sds_reg_bits_read(struct rtl837x_priv *priv, u8 sds_idx, u16 sds_page, u16 sds_reg, u16 mask, u16 *pdata)
+{
+	int ret;
+
+	mutex_lock(&priv->sds_lock);
+	ret = __rtl837x_sds_reg_bits_read(priv, sds_idx, sds_page, sds_reg, mask, pdata);
+	mutex_unlock(&priv->sds_lock);
+	return ret;
+}
+
+int rtl837x_sds_reg_bits_write(struct rtl837x_priv *priv, u8 sds_idx, u16 sds_page, u16 sds_reg, u16 mask, u16 data)
+{
+	int ret;
+
+	mutex_lock(&priv->sds_lock);
+	ret = __rtl837x_sds_reg_bits_write(priv, sds_idx, sds_page, sds_reg, mask, data);
+	mutex_unlock(&priv->sds_lock);
+	return ret;
+}
+
+int rtl837x_phy_read_ocp(struct rtl837x_priv *priv, u16 phy, int regnum, u16 *pval)
+{
+	int ret;
+
+	mutex_lock(&priv->ocp_lock);
+	ret = __rtl837x_phy_read_ocp(priv, phy, regnum, pval);
+	mutex_unlock(&priv->ocp_lock);
+	return ret;
+}
+
+int rtl837x_phy_write_ocp(struct rtl837x_priv *priv, u16 phy, int regnum, u16 val)
+{
+	int ret;
+
+	mutex_lock(&priv->ocp_lock);
+	ret = __rtl837x_phy_write_ocp(priv, phy, regnum, val);
+	mutex_unlock(&priv->ocp_lock);
+	return ret;
+}
