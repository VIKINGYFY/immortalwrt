+static int __rtl837x_phy_write_ocp(struct rtl837x_priv *priv, u16 phy, int regnum, u16 val)
 {
 	int ret;
 	u32 tmp;
@@ -339,7 +341,7 @@
 	return rtl837x_phy_write_ocp(priv, phy, 0xA400 + (regnum * 2), val);
