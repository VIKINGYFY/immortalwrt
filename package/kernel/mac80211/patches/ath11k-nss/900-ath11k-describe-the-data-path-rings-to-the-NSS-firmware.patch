+++ b/drivers/net/wireless/ath/ath11k/core.c
@@ -2993,6 +2993,7 @@ struct ath11k_base *ath11k_core_alloc(st
 	init_completion(&ab->restart_completed);
 
 	ab->dev = dev;
+	ab->nss_soc = -1;
 	ab->hif.bus = bus;
 
