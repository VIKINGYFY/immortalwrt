--- a/drivers/net/wireless/ath/ath11k/core.h
+++ b/drivers/net/wireless/ath/ath11k/core.h
@@ -954,6 +954,8 @@ struct ath11k_base {
 	struct ath11k_wmi_base wmi_ab;
 	struct completion fw_ready;
