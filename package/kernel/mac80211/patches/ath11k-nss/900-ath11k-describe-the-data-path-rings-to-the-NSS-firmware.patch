--- a/drivers/net/wireless/ath/ath11k/dp.c
+++ b/drivers/net/wireless/ath/ath11k/dp.c
@@ -13,6 +13,12 @@
 #include "dp_rx.h"
 #include "peer.h"
 
+#include <linux/soc/qcom/nss_wifi.h>
+
+#define ATH11K_NSS_TARGET_IPQ8074	24
+#define ATH11K_NSS_TARGET_IPQ6018	25
+#define ATH11K_NSS_TARGET_QCN9074	26
+
 static void ath11k_dp_htt_htc_tx_complete(struct ath11k_base *ab,
 					  struct sk_buff *skb)
 {
@@ -877,6 +883,169 @@ done:
 }
 EXPORT_SYMBOL(ath11k_dp_service_srng);
 
+/* Describe this data path to the NSS firmware driver.
+ *
+ * The firmware can reap these rings itself, which takes the Wi-Fi data path
+ * off the host entirely, but it has to be told where they are. Everything it
+ * needs is already known here, so it is copied into a plain description and
+ * handed over once. Nothing is given away by describing it: the firmware is
+ * started by a separate deliberate act, and until then this driver owns its
+ * rings exactly as before.
+ *
+ * The ring register addresses this driver keeps are offsets into its own
+ * mapping, and the firmware has no such mapping - it writes them as absolute
+ * addresses. So they are handed over with the register window's physical base
+ * added, which is the one thing here that has to be converted rather than
+ * copied.
+ */
+/* The buffer manager the firmware names in a receive buffer it fills, as a
+ * release ring number. Read off the entries it writes, not assumed.
+ */
+
+/* The target as the firmware enumerates it, which is its own numbering and
+ * not this driver's hardware revision.
+ */
+static u32 ath11k_nss_target(struct ath11k_base *ab)
+{
+	switch (ab->hw_rev) {
+	case ATH11K_HW_IPQ8074_HW20:
+		return ATH11K_NSS_TARGET_IPQ8074;
+	case ATH11K_HW_IPQ6018_HW10:
+		return ATH11K_NSS_TARGET_IPQ6018;
+	case ATH11K_HW_QCN9074_HW10:
+		return ATH11K_NSS_TARGET_QCN9074;
+	default:
+		return 0;
+	}
+}
+
+static void ath11k_nss_wifi_ring(struct nss_wifi_ring *r,
+				 struct ath11k_base *ab, u32 ring_id)
+{
+	struct hal_srng *srng = &ab->hal.srng_list[ring_id];
+	u32 reg;
+	int i;
+
+	r->id = srng->ring_id;
+	r->dir = srng->ring_dir;
+	r->num_entries = srng->num_entries;
+	r->entry_size = srng->entry_size;
+	r->flags = srng->flags;
+	r->base = srng->ring_base_paddr;
+
+	/* An LMAC ring's pointers live in memory, not behind the bus. */
+	for (i = 0; i < ARRAY_SIZE(r->hwreg); i++) {
+		reg = srng->hwreg_base[i];
+		if (!(srng->flags & HAL_SRNG_FLAGS_LMAC_RING))
+			reg = ath11k_hif_window_offset(ab, reg);
+		r->hwreg[i] = ab->mem_pa + reg;
+	}
+}
+
+/* ath11k's own hw-restart. The NSS firmware's buffers sit in these rings, so
+ * a firmware that stops is freed and started again behind it.
+ */
+static void ath11k_nss_reset(void *priv)
+{
+	struct ath11k_base *ab = priv;
+
+	queue_work(ab->workqueue_aux, &ab->reset_work);
+}
+
+static void ath11k_nss_wifi_describe(struct ath11k_base *ab)
+{
+	struct ath11k_dp *dp = &ab->dp;
+	struct nss_wifi_soc *soc;
+	int i;
+
+	if (!ath11k_nss_target(ab))
+		return;
+
+	/* The firmware takes register addresses as 32 bits. */
+	if (ab->mem_pa > U32_MAX) {
+		ath11k_warn(ab, "registers at %pa are out of the NSS firmware's reach\n",
+			    &ab->mem_pa);
+		return;
+	}
+
+	soc = kzalloc(sizeof(*soc), GFP_KERNEL);
+	if (!soc)
+		return;
+
+	soc->dev_base = ab->mem_pa;
+	soc->external = ab->hif.bus == ATH11K_BUS_PCI;
+	soc->shadow_rd = ab->hal.rdp.paddr;
+	soc->shadow_wr = ab->hal.wrp.paddr;
+	soc->lmac_ring_start = HAL_SRNG_RING_ID_LMAC1_ID_START;
+	soc->target_type = ath11k_nss_target(ab);
+	soc->tlv_size = ab->hw_params.hal_desc_sz;
+	soc->rx_buf_len = DP_RX_BUFFER_SIZE;
+	soc->num_tcl = ab->hw_params.hal_params->num_tx_rings;
+	soc->num_reo = DP_REO_DST_RING_MAX;
+	soc->num_pdevs = ab->num_radios;
+	soc->priv = ab;
+	soc->reset = ath11k_nss_reset;
+
+	for (i = 0; i < soc->num_tcl; i++) {
+		ath11k_nss_wifi_ring(&soc->tcl[i], ab,
+				     dp->tx_ring[i].tcl_data_ring.ring_id);
+		ath11k_nss_wifi_ring(&soc->txcomp[i], ab,
+				     dp->tx_ring[i].tcl_comp_ring.ring_id);
+	}
+
+	for (i = 0; i < soc->num_reo; i++)
+		ath11k_nss_wifi_ring(&soc->reo_dest[i], ab,
+				     dp->reo_dst_ring[i].ring_id);
+
+	ath11k_nss_wifi_ring(&soc->reo_reinject, ab, dp->reo_reinject_ring.ring_id);
+	/* Not the release ring this driver reaps. The firmware fills the
+	 * receive-DMA ring from its own pool and names those buffers with its
+	 * own buffer manager, and the buffer manager is what decides which
+	 * release ring the hardware hands a buffer back on. Handing over the
+	 * ring the buffers name is the one the driver already owns: the value
+	 * the firmware writes into a receive entry is a buffer-manager id, and
+	 * a manager id is the release ring's number plus the first software
+	 * manager, not the number itself.
+	 */
+	ath11k_nss_wifi_ring(&soc->rx_rel, ab, dp->rx_rel_ring.ring_id);
+	ath11k_nss_wifi_ring(&soc->reo_exception, ab, dp->reo_except_ring.ring_id);
+
+	ab->nss_soc = nss_wifi_soc_register(soc);
+	if (ab->nss_soc < 0)
+		ath11k_warn(ab, "NSS firmware would not take the ring description\n");
+
+	kfree(soc);
+}
+
+
+static void ath11k_nss_wifi_describe_pdev(struct ath11k_base *ab, int id)
+{
+	struct ath11k *ar = ab->pdevs[id].ar;
+	struct nss_wifi_pdev pdev = {};
+
+	if (ab->nss_soc < 0)
+		return;
+
+	ath11k_nss_wifi_ring(&pdev.rxdma, ab,
+			     ar->dp.rx_refill_buf_ring.refill_buf_ring.ring_id);
+	pdev.radio_id = id;
+	/* The hardware MAC this radio's address-search table belongs to. The
+	 * transmit command carries it, and the search for a frame's peer runs
+	 * against that table alone, so a radio whose index is not its own
+	 * hardware MAC finds nothing and every frame is released unsent.
+	 */
+	pdev.lmac_id = ar->lmac_id;
+	/* The firmware holds a software descriptor for every buffer in flight,
+	 * so a pool the size of the ring cannot keep the ring full. It accepts
+	 * up to three ring depths.
+	 */
+	pdev.num_rx_swdesc = 3 * DP_RXDMA_BUF_RING_SIZE;
+	pdev.target_pdev_id = ar->pdev->pdev_id;
+
+	if (nss_wifi_pdev_register(ab->nss_soc, &pdev))
+		ath11k_warn(ab, "NSS firmware would not take radio %d\n", id);
+}
+
 void ath11k_dp_pdev_free(struct ath11k_base *ab)
 {
 	struct ath11k *ar;
@@ -919,6 +1088,14 @@ int ath11k_dp_pdev_alloc(struct ath11k_b
 	int ret;
 	int i;
 
+	/* Not from where the rest of the SoC's rings are allocated: the
+	 * reorder destination rings are set up later than that, and a
+	 * description taken there carries them as an address of zero with no
+	 * entries. The firmware accepts that, but neither receive nor transmit
+	 * completions then move.
+	 */
+	ath11k_nss_wifi_describe(ab);
+
 	/* TODO:Per-pdev rx ring unlike tx ring which is mapped to different AC's */
 	for (i = 0; i < ab->num_radios; i++) {
 		ar = ab->pdevs[i].ar;
@@ -934,6 +1111,8 @@ int ath11k_dp_pdev_alloc(struct ath11k_b
 				    i);
 			goto err;
 		}
+
+		ath11k_nss_wifi_describe_pdev(ab, i);
 	}
 
 	return 0;
@@ -1034,6 +1213,10 @@ void ath11k_dp_free(struct ath11k_base *
 	struct ath11k_dp *dp = &ab->dp;
 	int i;
 
+	if (ab->nss_soc >= 0)
+		nss_wifi_soc_unregister(ab->nss_soc);
+	ab->nss_soc = -1;
+
 	ath11k_dp_link_desc_cleanup(ab, dp->link_desc_banks,
 				    HAL_WBM_IDLE_LINK, &dp->wbm_idle_ring);
 
--- a/drivers/net/wireless/ath/ath11k/hif.h
+++ b/drivers/net/wireless/ath/ath11k/hif.h
@@ -12,6 +12,7 @@
 struct ath11k_hif_ops {
 	u32 (*read32)(struct ath11k_base *ab, u32 address);
 	void (*write32)(struct ath11k_base *ab, u32 address, u32 data);
+	u32 (*window_offset)(struct ath11k_base *ab, u32 offset);
 	int (*read)(struct ath11k_base *ab, void *buf, u32 start, u32 end);
 	void (*irq_enable)(struct ath11k_base *ab);
 	void (*irq_disable)(struct ath11k_base *ab);
@@ -109,6 +110,14 @@ static inline void ath11k_hif_write32(st
 	ab->hif.ops->write32(ab, address, data);
 }
 
+static inline u32 ath11k_hif_window_offset(struct ath11k_base *ab, u32 offset)
+{
+	if (!ab->hif.ops->window_offset)
+		return offset;
+
+	return ab->hif.ops->window_offset(ab, offset);
+}
+
 static inline int ath11k_hif_read(struct ath11k_base *ab, void *buf,
 				  u32 start, u32 end)
 {
--- a/drivers/net/wireless/ath/ath11k/pci.c
+++ b/drivers/net/wireless/ath/ath11k/pci.c
@@ -72,6 +72,13 @@ static u32 ath11k_pci_get_window_start(s
 		return ATH11K_PCI_WINDOW_START;
 }
 
+/* Where a register sits in the BAR under the static window map. */
+static u32 ath11k_pci_window_offset(struct ath11k_base *ab, u32 offset)
+{
+	return ath11k_pci_get_window_start(ab, offset) +
+	       (offset & ATH11K_PCI_WINDOW_RANGE_MASK);
+}
+
 static inline void ath11k_pci_select_window(struct ath11k_pci *ab_pci, u32 offset)
 {
 	struct ath11k_base *ab = ab_pci->ab;
@@ -583,6 +590,7 @@ static int ath11k_pci_claim(struct ath11
 	pci_set_master(pdev);
 
 	ab->mem_len = pci_resource_len(pdev, ATH11K_PCI_BAR_NUM);
+	ab->mem_pa = pci_resource_start(pdev, ATH11K_PCI_BAR_NUM);
 	ab->mem = pci_iomap(pdev, ATH11K_PCI_BAR_NUM, 0);
 	if (!ab->mem) {
 		ath11k_err(ab, "failed to map pci bar %d\n", ATH11K_PCI_BAR_NUM);
@@ -914,6 +922,7 @@ static const struct ath11k_hif_ops ath11
 	.stop = ath11k_pcic_stop,
 	.read32 = ath11k_pcic_read32,
 	.write32 = ath11k_pcic_write32,
+	.window_offset = ath11k_pci_window_offset,
 	.read = ath11k_pcic_read,
 	.power_down = ath11k_pci_power_down,
 	.power_up = ath11k_pci_power_up,
