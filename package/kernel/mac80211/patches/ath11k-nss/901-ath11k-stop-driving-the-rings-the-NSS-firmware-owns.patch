From: Julius Bairaktaris <julius@bairaktaris.de>
Date: Wed, 11 Nov 2026 16:11:45 +0800
Subject: [PATCH] ath11k: stop driving the rings the NSS firmware owns

The NSS firmware reaps and fills the data-path rings once its Wi-Fi data
plane is started, so this driver has to be off them before it is. It is not
enough to stop servicing them: a frame this driver puts on the transmit ring
completes with a software cookie the firmware resolves against its own
descriptor table, and a buffer this driver puts in the receive-DMA ring comes
back under a cookie the firmware never minted.

nss_offload, off by default, is read once at probe. Interrupt registration,
the data-path service loop and the MSI group lookup are all driven from
hw_params.ring_mask, which is a pointer inside a per-device copy of the
hardware table, so pointing it at a copy carrying only the reorder-status mask
is the whole of the handover for the seven it drops. The
receive-DMA pre-fill is skipped, hash-based receive steering is off because
the firmware pairs one reorder-destination ring with one radio's buffer pool,
and transmit is refused at the single site that produces an entry. The
reorder engine sends an unhashed frame to the ring its first destination
map gives the peer's default route, and that map is set so route n is
REO2SWn: the firmware reaps one ring per radio, REO2SW1 upward, and the
hash pattern sent the second radio's frames to REO2SW3, which nothing
reaps.

Management frames leave over WMI above the refusal, so a station still
associates. No data crosses the air while the offload is on.

Retain the shared driver error handling and integer TX return contract.
Only suppress ring allocation when NSS owns those rings.

Use the shared driver hardware revision name ATH11K_HW_IPQ8074_HW20.

Keep the final implementation of this responsibility directly; subsequent
repairs listed below are integrated without intermediate replacements.

Split from:
  918-ath11k-offload-the-QCN9074-to-the-NSS-firmware.patch - ath11k: offload the QCN9074 to the NSS firmware

Merged from:
  901-ath11k-stop-driving-the-rings-the-NSS-firmware-owns.patch - ath11k: stop driving the rings the NSS firmware owns
  918-ath11k-offload-the-QCN9074-to-the-NSS-firmware.patch - ath11k: offload the QCN9074 to the NSS firmware
  921-ath11k-defer-NSS-PHY-restart-until-ring-handover.patch - ath11k: defer NSS PHY restart until shared ring handover
  922-ath11k-allocate-host-TX-software-state-only-when-used.patch - wifi: ath11k: allocate host TX software state only when used

Assisted-by: Claude:claude-opus-5-5

Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/drivers/net/wireless/ath/ath11k/core.c
+++ b/drivers/net/wireless/ath/ath11k/core.c
@@ -38,6 +38,22 @@ bool ath11k_ftm_mode;
 module_param_named(ftm_mode, ath11k_ftm_mode, bool, 0444);
 MODULE_PARM_DESC(ftm_mode, "Boots up in factory test mode");
 
+bool ath11k_nss_offload;
+module_param_named(nss_offload, ath11k_nss_offload, bool, 0644);
+MODULE_PARM_DESC(nss_offload, "Hand the data-path rings to the NSS firmware");
+
+bool ath11k_nss_keep_mask;
+module_param_named(nss_keep_mask, ath11k_nss_keep_mask, bool, 0644);
+MODULE_PARM_DESC(nss_keep_mask, "Leave the ring mask alone while offloading");
+
+bool ath11k_nss_hash;
+module_param_named(nss_hash, ath11k_nss_hash, bool, 0644);
+MODULE_PARM_DESC(nss_hash, "Keep hash-based receive steering while offloading");
+
+bool ath11k_nss_prefill;
+module_param_named(nss_prefill, ath11k_nss_prefill, bool, 0644);
+MODULE_PARM_DESC(nss_prefill, "Fill the receive-DMA ring from here as well");
+
 static const struct ath11k_hw_params ath11k_hw_params[] = {
 	{
 		.hw_rev = ATH11K_HW_IPQ9574_HW10,
@@ -2626,7 +2642,8 @@ void ath11k_core_pre_reconfigure_recover
 	reinit_completion(&ab->driver_recovery);
 }
 
-static void ath11k_core_post_reconfigure_recovery(struct ath11k_base *ab)
+static void ath11k_core_post_reconfigure_recovery(struct ath11k_base *ab,
+						  bool restart)
 {
 	struct ath11k *ar;
 	struct ath11k_pdev *pdev;
@@ -2644,7 +2661,8 @@ static void ath11k_core_post_reconfigure
 		case ATH11K_STATE_ON:
 			ar->state = ATH11K_STATE_RESTARTING;
 			ath11k_core_halt(ar);
-			ieee80211_restart_hw(ar->hw);
+			if (restart)
+				ieee80211_restart_hw(ar->hw);
 			break;
 		case ATH11K_STATE_OFF:
 			ath11k_warn(ab,
@@ -2652,6 +2670,8 @@ static void ath11k_core_post_reconfigure
 				    i);
 			break;
 		case ATH11K_STATE_RESTARTING:
+			if (restart)
+				ieee80211_restart_hw(ar->hw);
 			break;
 		case ATH11K_STATE_RESTARTED:
 			ar->state = ATH11K_STATE_WEDGED;
@@ -2688,8 +2708,8 @@ static void ath11k_core_restart(struct w
 	if (ab->is_reset)
 		complete_all(&ab->reconfigure_complete);
 
-	if (!ab->is_reset)
-		ath11k_core_post_reconfigure_recovery(ab);
+	if (!ab->is_reset || ab->nss_offload)
+		ath11k_core_post_reconfigure_recovery(ab, true);
 
 	complete(&ab->restart_completed);
 }
@@ -2752,12 +2772,18 @@ static void ath11k_core_reset(struct wor
 	ath11k_core_pre_reconfigure_recovery(ab);
 
 	reinit_completion(&ab->reconfigure_complete);
-	ath11k_core_post_reconfigure_recovery(ab);
+	/* Quiesce every PHY before its rings are freed. In NSS mode defer
+	 * mac80211 restart until all shared instances can hand over the core;
+	 * its per-PHY restart holds RTNL and cannot wait for another instance.
+	 */
+	ath11k_core_post_reconfigure_recovery(ab, !ab->nss_offload);
 
-	ath11k_dbg(ab, ATH11K_DBG_BOOT, "waiting recovery start...\n");
+	if (!ab->nss_offload) {
+		ath11k_dbg(ab, ATH11K_DBG_BOOT, "waiting recovery start...\n");
 
-	time_left = wait_for_completion_timeout(&ab->recovery_start,
-						ATH11K_RECOVER_START_TIMEOUT_HZ);
+		time_left = wait_for_completion_timeout(&ab->recovery_start,
+					ATH11K_RECOVER_START_TIMEOUT_HZ);
+	}
 
 	ath11k_hif_irq_disable(ab);
 	ath11k_hif_ce_irq_disable(ab);
@@ -2788,6 +2814,29 @@ static int ath11k_init_hw_params(struct
 
 	ab->hw_params = *hw_params;
 
+	/* Interrupt registration, the service loop and the MSI group lookup
+	 * are driven from this mask alone, so an all-zero entry is the whole
+	 * of the handover for a ring type.
+	 *
+	 * Reorder status and monitor status stay here. The WLAN firmware
+	 * writes a status record into the monitor status ring for every PPDU
+	 * it receives; left unreplenished the ring runs dry and the radio
+	 * stops receiving, so a station's frames go unacknowledged.
+	 */
+	ab->nss_offload = ath11k_nss_offload &&
+			  (ab->hw_rev == ATH11K_HW_IPQ8074_HW20 ||
+			   ab->hw_rev == ATH11K_HW_IPQ6018_HW10 ||
+			   ab->hw_rev == ATH11K_HW_QCN9074_HW10);
+	if (ab->nss_offload && !ath11k_nss_keep_mask) {
+		const struct ath11k_hw_ring_mask *m = ab->hw_params.ring_mask;
+
+		memcpy(ab->nss_ring_mask.reo_status, m->reo_status,
+		       sizeof(m->reo_status));
+		memcpy(ab->nss_ring_mask.rx_mon_status, m->rx_mon_status,
+		       sizeof(m->rx_mon_status));
+		ab->hw_params.ring_mask = &ab->nss_ring_mask;
+	}
+
 	ret = of_property_read_u32(ab->dev->of_node,
 				   "qcom,ath11k-fw-memory-mode",
 				   &fw_mem_mode);
--- a/drivers/net/wireless/ath/ath11k/core.h
+++ b/drivers/net/wireless/ath/ath11k/core.h
@@ -63,6 +63,10 @@
 
 extern unsigned int ath11k_frame_mode;
 extern bool ath11k_ftm_mode;
+extern bool ath11k_nss_offload;
+extern bool ath11k_nss_prefill;
+extern bool ath11k_nss_hash;
+extern bool ath11k_nss_keep_mask;
 
 #define ATH11K_SCAN_TIMEOUT_HZ (20 * HZ)
 
@@ -1022,6 +1026,13 @@ struct ath11k_base {
 
 	struct ath11k_hw_params hw_params;
 
+	/* What hw_params.ring_mask points at while the firmware owns the
+	 * data-path rings.
+	 */
+	struct ath11k_hw_ring_mask nss_ring_mask;
+	/* ath11k_nss_offload, for a radio the NSS firmware drives */
+	bool nss_offload;
+
 	const struct firmware *cal_file;
 
 	/* Below regd's are protected by ab->data_lock */
--- a/drivers/net/wireless/ath/ath11k/dp.c
+++ b/drivers/net/wireless/ath/ath11k/dp.c
@@ -55,9 +55,17 @@ int ath11k_dp_peer_setup(struct ath11k *
 
 	/* NOTE: reo_dest ring id starts from 1 unlike mac_id which starts from 0 */
 	reo_dest = ar->dp.mac_id + 1;
+	/* Whether a peer's frames may be spread over the four reorder
+	 * destination rings. Pinning them to one was an assumption about how
+	 * the firmware pairs a ring with a radio's buffer pool, not a
+	 * measurement, and it is one of only two changes here that can reach
+	 * receive at all - so it is a parameter until it has been measured
+	 * both ways.
+	 */
 	ret = ath11k_wmi_set_peer_param(ar, addr, vdev_id,
 					WMI_PEER_SET_DEFAULT_ROUTING,
-					DP_RX_HASH_ENABLE | (reo_dest << 1));
+					((ar->ab->nss_offload && !ath11k_nss_hash) ?
+					 0 : DP_RX_HASH_ENABLE) | (reo_dest << 1));
 
 	if (ret) {
 		ath11k_warn(ab, "failed to set default routing %d peer :%pM vdev_id :%d\n",
@@ -1276,15 +1284,21 @@ int ath11k_dp_alloc(struct ath11k_base *
 	size = sizeof(struct hal_wbm_release_ring) * DP_TX_COMP_RING_SIZE;
 
 	for (i = 0; i < ab->hw_params.hal_params->num_tx_rings; i++) {
-		ret = ath11k_dp_tx_bufs_init(&dp->tx_ring[i]);
-		if (ret)
-			goto fail_cmn_srng_cleanup;
 		spin_lock_init(&dp->tx_ring[i].tx_idr_lock);
 		spin_lock_init(&dp->tx_ring[i].wake_tx_lock);
 		dp->tx_ring[i].tcl_data_ring_id = i;
 
 		dp->tx_ring[i].tx_status_head = 0;
 		dp->tx_ring[i].tx_status_tail = DP_TX_COMP_RING_SIZE - 1;
+		/* NSS owns data completions. Debug builds retain host storage
+		 * because their writable parameters can enable host TX later.
+		 * The DMA rings above still belong to the NSS firmware ABI.
+		 */
+		if (ab->nss_offload && !IS_ENABLED(CONFIG_NSS_WIFI_DEBUG))
+			continue;
+		ret = ath11k_dp_tx_bufs_init(&dp->tx_ring[i]);
+		if (ret)
+			goto fail_cmn_srng_cleanup;
 		dp->tx_ring[i].tx_status = kmalloc(size, GFP_KERNEL);
 		if (!dp->tx_ring[i].tx_status) {
 			ret = -ENOMEM;
--- a/drivers/net/wireless/ath/ath11k/dp_rx.c
+++ b/drivers/net/wireless/ath/ath11k/dp_rx.c
@@ -660,9 +660,12 @@ static int ath11k_dp_rxdma_pdev_buf_setu
 	struct dp_rxdma_ring *rx_ring = &dp->rx_refill_buf_ring;
 	int i, ret;
 
-	ret = ath11k_dp_rxdma_ring_buf_setup(ar, rx_ring, HAL_RXDMA_BUF);
-	if (ret)
-		return ret;
+	/* NSS supplies buffers for the rings it owns. */
+	if (!ab->nss_offload || ath11k_nss_prefill) {
+		ret = ath11k_dp_rxdma_ring_buf_setup(ar, rx_ring, HAL_RXDMA_BUF);
+		if (ret)
+			return ret;
+	}
 
 	if (ar->ab->hw_params.rxdma1_enable) {
 		rx_ring = &dp->rxdma_mon_buf_ring;
--- a/drivers/net/wireless/ath/ath11k/dp_tx.c
+++ b/drivers/net/wireless/ath/ath11k/dp_tx.c
@@ -131,7 +131,7 @@ static struct sk_buff *ath11k_dp_tx_buf_
 {
 	struct sk_buff *skb;
 
-	if (unlikely(id >= DP_TX_IDR_SIZE - 1))
+	if (unlikely(!tx_ring->bufs || id >= DP_TX_IDR_SIZE - 1))
 		return NULL;
 
 	skb = tx_ring->bufs[id];
@@ -850,6 +850,9 @@ int ath11k_dp_tx_completion_handler(stru
 	u32 msdu_id;
 	u8 mac_id, i;
 
+	if (!tx_ring->tx_status)
+		return 0;
+
 	spin_lock_bh(&status_ring->lock);
 
 	ath11k_hal_srng_access_begin(ab, status_ring);
--- a/drivers/net/wireless/ath/ath11k/hw.c
+++ b/drivers/net/wireless/ath/ath11k/hw.c
@@ -126,6 +126,15 @@ static void ath11k_hw_ipq8074_reo_setup(
 		HAL_HASH_ROUTING_RING_SW2 << 15 |
 		HAL_HASH_ROUTING_RING_SW3 << 18 |
 		HAL_HASH_ROUTING_RING_SW4 << 21;
+	/* Unhashed frames go to the ring this map gives their peer's default
+	 * route, mac_id + 1. The NSS firmware reaps REO2SW1 to REO2SWn for n
+	 * radios, so route n has to map to REO2SWn.
+	 */
+	u32 ix0_map = ab->nss_offload ?
+		      HAL_HASH_ROUTING_RING_SW1 << 3 |
+		      HAL_HASH_ROUTING_RING_SW2 << 6 |
+		      HAL_HASH_ROUTING_RING_SW3 << 9 |
+		      HAL_HASH_ROUTING_RING_SW4 << 12 : ring_hash_map;
 
 	val = ath11k_hif_read32(ab, reo_base + HAL_REO1_GEN_ENABLE);
 
@@ -147,7 +156,7 @@ static void ath11k_hw_ipq8074_reo_setup(
 
 	ath11k_hif_write32(ab, reo_base + HAL_REO1_DEST_RING_CTRL_IX_0,
 			   FIELD_PREP(HAL_REO_DEST_RING_CTRL_HASH_RING_MAP,
-				      ring_hash_map));
+				      ix0_map));
 	ath11k_hif_write32(ab, reo_base + HAL_REO1_DEST_RING_CTRL_IX_1,
 			   FIELD_PREP(HAL_REO_DEST_RING_CTRL_HASH_RING_MAP,
 				      ring_hash_map));
--- a/drivers/net/wireless/ath/ath11k/mac.c
+++ b/drivers/net/wireless/ath/ath11k/mac.c
@@ -6641,6 +6641,12 @@ static int ath11k_mac_tx(struct ieee8021
 		return ret;
 	}
 
+	/* Management has already left over WMI. NSS owns data TX. */
+	if (ar->ab->nss_offload) {
+		ieee80211_free_txskb(ar->hw, skb);
+		return 0;
+	}
+
 	if (control->sta)
 		arsta = ath11k_sta_to_arsta(control->sta);
 
@@ -7453,7 +7459,7 @@ static void ath11k_mac_vif_unref(struct
 	struct ath11k_skb_cb *skb_cb;
 	u32 id;
 
-	for (id = 0; id < DP_TX_IDR_SIZE - 1; id++) {
+	for (id = 0; tx_ring->bufs && id < DP_TX_IDR_SIZE - 1; id++) {
 		if (!tx_ring->bufs[id])
 			continue;
 
--- a/drivers/net/wireless/ath/ath11k/pci.c
+++ b/drivers/net/wireless/ath/ath11k/pci.c
@@ -733,6 +733,13 @@ static void ath11k_pci_coredump_download
 	void *buf;
 	u32 dump_seg_sz[FW_CRASH_DUMP_TYPE_MAX] = {};
 
+	/* An NSS-initiated reset can leave WLAN in mission mode. Waiting
+	 * for a nonexistent RDDM image delays the shared handover long enough
+	 * for the other WLAN instance to watchdog while its NSS is stopped.
+	 */
+	if (ab->nss_offload && mhi_get_exec_env(mhi_ctrl) != MHI_EE_RDDM)
+		return;
+
 	ath11k_mhi_coredump(mhi_ctrl, false);
 
 	len = ath11k_pci_coredump_calculate_size(ab, dump_seg_sz);
