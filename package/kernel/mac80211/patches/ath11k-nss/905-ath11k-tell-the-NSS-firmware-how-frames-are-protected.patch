From: Julius Bairaktaris <julius@bairaktaris.de>
Date: Wed, 11 Nov 2026 16:11:45 +0800
Subject: [PATCH] ath11k: tell the NSS firmware how frames are protected

The firmware builds the transmit descriptor, and the descriptor carries
the encryption the hardware is to apply. It takes that from the virtual
device, not from the frame, so nothing tells it until this does: left
unsaid the encryption is none, and a station that has just installed a
pairwise key discards every frame that follows. The symptom is an
association that authenticates and never authorises.

The firmware also drops what a peer it holds unauthorised sends, other
than the key exchange. The peer is authorised there when mac80211
authorises the station and unauthorised when mac80211 takes it back to
associated, so the firmware follows the station's port rather than its
keys: an open network installs no key, and a station whose 802.1X port
closes keeps its keys but must stop passing data.

Rebase this NSS integration onto the shared mac80211/ath11k patch
series while preserving the local host-path fixes.

Refresh against NSS VDEV registration error propagation.

Keep the final implementation of this responsibility directly; subsequent
repairs listed below are integrated without intermediate replacements.

Split from:
  919-ath11k-unwind-NSS-vdevs-and-check-peer-authorization.patch - ath11k: unwind NSS vdevs and propagate peer authorization errors

Merged from:
  905-ath11k-tell-the-NSS-firmware-how-frames-are-protected.patch - ath11k: tell the NSS firmware how frames are protected
  919-ath11k-unwind-NSS-vdevs-and-check-peer-authorization.patch - ath11k: unwind NSS vdevs and propagate peer authorization errors

Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/drivers/net/wireless/ath/ath11k/mac.c
+++ b/drivers/net/wireless/ath/ath11k/mac.c
@@ -6,6 +6,7 @@
 
 #include <net/mac80211.h>
 #include <linux/soc/qcom/nss_wifi.h>
+/* nss_wifi_vdev_security() */
 #include <net/cfg80211.h>
 #include <linux/etherdevice.h>
 #include <linux/bitfield.h>
@@ -4555,6 +4556,7 @@ static int ath11k_mac_op_set_key(struct
 	const u8 *peer_addr;
 	int ret = 0;
 	u32 flags = 0;
+	u16 nss_peer_id = 0;
 
 	/* BIP needs to be done in software */
 	if (key->cipher == WLAN_CIPHER_SUITE_AES_CMAC ||
@@ -4701,6 +4703,10 @@ static int ath11k_mac_op_set_key(struct
 	spin_lock_bh(&ab->base_lock);
 	peer = ath11k_peer_find(ab, arvif->vdev_id, peer_addr);
 	if (peer && cmd == SET_KEY) {
+		/* Read here because the firmware names a peer by it and the
+		 * calls that carry it cannot be made under this lock.
+		 */
+		nss_peer_id = peer->peer_id;
 		peer->keys[key->keyidx] = key;
 		if (key->flags & IEEE80211_KEY_FLAG_PAIRWISE) {
 			peer->ucast_keyidx = key->keyidx;
@@ -4749,6 +4755,33 @@ static int ath11k_mac_op_set_key(struct
 
 	spin_unlock_bh(&ab->base_lock);
 
+	/* The firmware builds the transmit descriptor, so the cipher the
+	 * hardware is to apply has to reach it. Left unsaid it is none, and a
+	 * station that has just installed a key discards everything that
+	 * follows.
+	 *
+	 * The device-wide cipher covers transmit. Receive undoes the
+	 * protection itself wherever the hardware cannot - every fragment and
+	 * every message integrity check - and consults a value held per peer,
+	 * so that one is sent as well, for the pairwise key and the group key
+	 * alike.
+	 */
+	if (ar->ab->nss_offload && cmd == SET_KEY) {
+		bool group = !(key->flags & IEEE80211_KEY_FLAG_PAIRWISE);
+		const u8 *mic = NULL;
+
+		if (key->cipher == WLAN_CIPHER_SUITE_TKIP &&
+		    key->keylen >= NL80211_TKIP_DATA_OFFSET_RX_MIC_KEY + 8)
+			mic = key->key + NL80211_TKIP_DATA_OFFSET_RX_MIC_KEY;
+
+		if (!group)
+			nss_wifi_vdev_security(arvif->nss_ifnum, key->cipher);
+
+		if (nss_peer_id)
+			nss_wifi_peer_security(ab->nss_soc, nss_peer_id, group,
+					       key->cipher, mic);
+	}
+
 exit:
 	mutex_unlock(&ar->conf_mutex);
 	return ret;
@@ -10205,6 +10238,8 @@ static int ath11k_mac_op_sta_state(struc
 	enum ieee80211_ap_reg_power power_type;
 	struct cur_regulatory_info *reg_info;
 	struct ath11k_peer *peer;
+	u16 peer_id;
+	bool peer_found;
 	int ret = 0;
 
 	/* cancel must be done outside the mutex to avoid deadlock */
@@ -10271,9 +10306,30 @@ static int ath11k_mac_op_sta_state(struc
 		spin_lock_bh(&ar->ab->base_lock);
 
 		peer = ath11k_peer_find(ar->ab, arvif->vdev_id, sta->addr);
+		peer_found = !!peer;
+		peer_id = peer ? peer->peer_id : 0;
+
+		spin_unlock_bh(&ar->ab->base_lock);
+
+		/* The firmware drops what an unauthorised peer sends, other
+		 * than the key exchange, and follows the station's port rather
+		 * than its keys: an open network installs none, and a key is
+		 * installed before the exchange that proves it has finished.
+		 */
+		if (ar->ab->nss_offload) {
+			ret = peer_found ?
+				nss_wifi_peer_authorize(ar->ab->nss_soc, peer_id, true) :
+				-ENOENT;
+			if (ret) {
+				ath11k_warn(ar->ab, "NSS peer authorization true failed: %d\n", ret);
+				goto out;
+			}
+		}
+
+		spin_lock_bh(&ar->ab->base_lock);
+		peer = ath11k_peer_find(ar->ab, arvif->vdev_id, sta->addr);
 		if (peer)
 			peer->is_authorized = true;
-
 		spin_unlock_bh(&ar->ab->base_lock);
 
 		if (vif->type == NL80211_IFTYPE_STATION && arvif->is_up) {
@@ -10315,9 +10371,21 @@ static int ath11k_mac_op_sta_state(struc
 		peer = ath11k_peer_find(ar->ab, arvif->vdev_id, sta->addr);
 		if (peer)
 			peer->is_authorized = false;
+		peer_found = !!peer;
+		peer_id = peer ? peer->peer_id : 0;
 
 		spin_unlock_bh(&ar->ab->base_lock);
 
+		if (ar->ab->nss_offload) {
+			ret = peer_found ?
+				nss_wifi_peer_authorize(ar->ab->nss_soc, peer_id, false) :
+				-ENOENT;
+			if (ret) {
+				ath11k_warn(ar->ab, "NSS peer authorization false failed: %d\n", ret);
+				goto out;
+			}
+		}
+
 		if (arsta->ptk_clear_pending)
 			ret = ath11k_mac_clear_ptk(arvif, sta);
 	} else if (old_state == IEEE80211_STA_ASSOC &&
@@ -10331,6 +10399,7 @@ static int ath11k_mac_op_sta_state(struc
 				    sta->addr);
 	}
 
+out:
 	mutex_unlock(&ar->conf_mutex);
 	return ret;
 }
