From: ViKing <viking.yfy@qq.com>
Date: Tue, 24 Nov 2026 21:53:24 +0800
Subject: [PATCH] wifi: ath11k: scope AP VLAN host mode to the selected buses

Three-address AP VLAN uses host raw and software group crypto.
Choose that mode for the affected firmware device before selecting
ring ownership. A separate eligible device can retain NSS routing,
Ethernet encapsulation and hardware crypto.

Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/drivers/net/wireless/ath/ath11k/core.c
+++ b/drivers/net/wireless/ath/ath11k/core.c
@@ -42,6 +42,11 @@ bool ath11k_nss_offload;
 module_param_named(nss_offload, ath11k_nss_offload, bool, 0644);
 MODULE_PARM_DESC(nss_offload, "Hand the data-path rings to the NSS firmware");
 
+static unsigned int ath11k_ap_vlan_host;
+module_param_named(ap_vlan_host, ath11k_ap_vlan_host, uint, 0644);
+MODULE_PARM_DESC(ap_vlan_host,
+		 "Buses using host raw and software crypto for AP VLAN (1: AHB, 2: PCIe)");
+
 bool ath11k_nss_host_tx;
 #ifdef CONFIG_NSS_WIFI_DEBUG
 module_param_named(nss_host_tx, ath11k_nss_host_tx, bool, 0644);
@@ -2429,9 +2434,11 @@ static int ath11k_core_start_firmware(st
 
 int ath11k_core_qmi_firmware_ready(struct ath11k_base *ab)
 {
+	unsigned int crypto_mode = ab->host_ap_vlan ? ATH11K_CRYPT_MODE_SW :
+						    ath11k_crypto_mode;
 	int ret;
 
-	switch (ath11k_crypto_mode) {
+	switch (crypto_mode) {
 	case ATH11K_CRYPT_MODE_SW:
 		set_bit(ATH11K_FLAG_HW_CRYPTO_DISABLED, &ab->dev_flags);
 		set_bit(ATH11K_FLAG_RAW_MODE, &ab->dev_flags);
@@ -2441,7 +2448,7 @@ int ath11k_core_qmi_firmware_ready(struc
 		clear_bit(ATH11K_FLAG_RAW_MODE, &ab->dev_flags);
 		break;
 	default:
-		ath11k_info(ab, "invalid crypto_mode: %d\n", ath11k_crypto_mode);
+		ath11k_info(ab, "invalid crypto_mode: %d\n", crypto_mode);
 		return -EINVAL;
 	}
 
@@ -2829,7 +2836,8 @@ static int ath11k_init_hw_params(struct
 	 * it receives; left unreplenished the ring runs dry and the radio
 	 * stops receiving, so a station's frames go unacknowledged.
 	 */
-	ab->nss_offload = ath11k_nss_offload &&
+	ab->host_ap_vlan = ath11k_ap_vlan_host & BIT(ab->hif.bus);
+	ab->nss_offload = ath11k_nss_offload && !ab->host_ap_vlan &&
 			  (ab->hw_rev == ATH11K_HW_IPQ8074_HW20 ||
 			   ab->hw_rev == ATH11K_HW_IPQ6018_HW10 ||
 			   ab->hw_rev == ATH11K_HW_QCN9074_HW10);
--- a/drivers/net/wireless/ath/ath11k/core.h
+++ b/drivers/net/wireless/ath/ath11k/core.h
@@ -1053,6 +1053,7 @@ struct ath11k_base {
 	struct ath11k_hw_ring_mask nss_ring_mask;
 	/* ath11k_nss_offload, for a radio the NSS firmware drives */
 	bool nss_offload;
+	bool host_ap_vlan;
 
 	const struct firmware *cal_file;
 
--- a/drivers/net/wireless/ath/ath11k/mac.c
+++ b/drivers/net/wireless/ath/ath11k/mac.c
@@ -7313,7 +7313,7 @@ static void ath11k_mac_op_update_vif_off
 	int ret;
 
 	param_id = WMI_VDEV_PARAM_TX_ENCAP_TYPE;
-	if (ath11k_frame_mode != ATH11K_HW_TXRX_ETHERNET ||
+	if (ab->host_ap_vlan || ath11k_frame_mode != ATH11K_HW_TXRX_ETHERNET ||
 	    (vif->type != NL80211_IFTYPE_STATION &&
 	     vif->type != NL80211_IFTYPE_AP))
 		vif->offload_flags &= ~(IEEE80211_OFFLOAD_ENCAP_ENABLED |
@@ -11420,7 +11420,7 @@ static int __ath11k_mac_register(struct
 	ieee80211_hw_set(ar->hw, SUPPORTS_TX_FRAG);
 	ieee80211_hw_set(ar->hw, REPORTS_LOW_ACK);
 
-	if (ath11k_frame_mode == ATH11K_HW_TXRX_ETHERNET) {
+	if (!ab->host_ap_vlan && ath11k_frame_mode == ATH11K_HW_TXRX_ETHERNET) {
 		ieee80211_hw_set(ar->hw, SUPPORTS_TX_ENCAP_OFFLOAD);
 		ieee80211_hw_set(ar->hw, SUPPORTS_RX_DECAP_OFFLOAD);
 	}
