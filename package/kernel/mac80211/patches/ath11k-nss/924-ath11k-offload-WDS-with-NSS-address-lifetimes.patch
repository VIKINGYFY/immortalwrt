+static void ath11k_nss_reconfig_ap(struct ath11k *ar)
+{
+	char *env[] = { "NSS_WIFI_AP_RECOVER=1", NULL };
+	struct ath11k_vif *arvif;
+
+	if (!ar->ab->nss_offload)
+		return;
+
+	/* Recreated NSS peers cannot resume the old encrypted TX state.
+	 * Let the AP authenticator establish fresh sessions after recovery.
+	 */
+	list_for_each_entry(arvif, &ar->arvifs, list) {
+		if (arvif->is_up && arvif->vdev_type == WMI_VDEV_TYPE_AP &&
+		    (arvif->rsnie_present || arvif->wpaie_present)) {
+			kobject_uevent_env(&ar->hw->wiphy->dev.kobj, KOBJ_CHANGE, env);
+			break;
+		}
+	}
+}
+
 static void
 ath11k_mac_op_reconfig_complete(struct ieee80211_hw *hw,
 				enum ieee80211_reconfig_type reconfig_type)
@@ -9715,12 +9794,16 @@ ath11k_mac_op_reconfig_complete(struct i
