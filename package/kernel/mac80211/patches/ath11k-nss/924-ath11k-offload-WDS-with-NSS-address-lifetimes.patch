+int ath11k_wmi_wds_update(struct ath11k *ar, const u8 *peer, const u8 *addr,
+			  u32 vdev, bool add)
+{
+	struct wmi_add_wds_entry_cmd *cmd;
+	struct sk_buff *skb;
+	u32 tag, cmd_id;
+	int ret;
+
+	skb = ath11k_wmi_alloc_skb(ar->wmi->wmi_ab, sizeof(*cmd));
+	if (!skb)
+		return -ENOMEM;
+	cmd = (void *)skb->data;
+	tag = add ? WMI_TAG_PEER_ADD_WDS_ENTRY_CMD : WMI_TAG_PEER_UPDATE_WDS_ENTRY_CMD;
+	cmd_id = add ? WMI_PEER_ADD_WDS_ENTRY_CMDID : WMI_PEER_UPDATE_WDS_ENTRY_CMDID;
+	cmd->tlv_header = FIELD_PREP(WMI_TLV_TAG, tag) |
+			  FIELD_PREP(WMI_TLV_LEN, sizeof(*cmd) - TLV_HDR_SIZE);
+	ether_addr_copy(cmd->peer_macaddr.addr, peer);
+	ether_addr_copy(cmd->wds_macaddr.addr, addr);
+	cmd->vdev_id = vdev;
+	cmd->flags = 1; /* Static: host owns aging and deletion. */
+	ret = ath11k_wmi_cmd_send(ar->wmi, skb, cmd_id);
+	if (ret)
+		dev_kfree_skb(skb);
+	return ret;
+}
+
+int ath11k_wmi_wds_delete(struct ath11k *ar, const u8 *addr, u32 vdev)
+{
+	struct wmi_remove_wds_entry_cmd *cmd;
+	struct sk_buff *skb;
+	int ret;
+
+	skb = ath11k_wmi_alloc_skb(ar->wmi->wmi_ab, sizeof(*cmd));
+	if (!skb)
+		return -ENOMEM;
+	cmd = (void *)skb->data;
+	cmd->tlv_header = FIELD_PREP(WMI_TLV_TAG, WMI_TAG_PEER_REMOVE_WDS_ENTRY_CMD) |
+		FIELD_PREP(WMI_TLV_LEN, sizeof(*cmd) - TLV_HDR_SIZE);
+	ether_addr_copy(cmd->wds_macaddr.addr, addr);
+	cmd->vdev_id = vdev;
+	ret = ath11k_wmi_cmd_send(ar->wmi, skb, WMI_PEER_REMOVE_WDS_ENTRY_CMDID);
+	if (ret)
+		dev_kfree_skb(skb);
+	return ret;
+}
