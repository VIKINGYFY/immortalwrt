@@ -0,0 +1,586 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/* Four-address learning runs in NAPI; NSS messages and WMI run in a worker.
+ * Keep IDs, MACs and a peer generation rather than pointers to WLAN peers.
+ */
+#include <linux/debugfs.h>
+#include <linux/seq_file.h>
+#include "core.h"
+#include "peer.h"
+#include "debug.h"
+#include "nss_wds.h"
+
+#define ATH11K_NSS_WDS_MAX 1024
+#define ATH11K_NSS_WDS_PENDING 256
+#define ATH11K_NSS_WDS_AGE (300 * HZ)
+#define ATH11K_NSS_AST_WDS 3
+#define ATH11K_NSS_AST_MEC 4
+
+enum ath11k_nss_wds_action {
+	WDS_LEARN,
+	WDS_MAP,
+	WDS_DEL,
+	WDS_ACTIVE,
+	WDS_EXPIRE,
+};
+
+struct ath11k_nss_wds_event {
+	struct list_head list;
+	struct nss_wifi_wds_peer p;
+	u64 generation;
+	enum ath11k_nss_wds_action action;
+};
+
+struct ath11k_nss_wds_entry {
+	struct list_head list;
+	struct nss_wifi_wds_peer p;
+	u64 generation;
+	unsigned long active;
+	bool mapped;
+};
+
+static bool ath11k_nss_wds_peer(struct ath11k_base *ab,
+				struct ath11k_nss_wds_event *e, u16 id)
+{
+	struct ath11k_peer *peer;
+
+	lockdep_assert_held(&ab->base_lock);
+	peer = ath11k_peer_find_by_id(ab, id);
+	if (!peer || !peer->is_authorized)
+		return false;
+	e->p.peer_id = id;
+	e->p.vdev_id = peer->vdev_id;
+	e->p.radio = peer->pdev_idx;
+	ether_addr_copy(e->p.peer, peer->addr);
+	e->generation = peer->nss_generation;
+	return true;
+}
+
+static void ath11k_nss_wds_queue(struct ath11k_base *ab,
+				 const struct ath11k_nss_wds_event *e)
+{
+	struct ath11k_nss_wds *w = &ab->nss_wds;
+	struct ath11k_nss_wds_event *copy;
+
+	copy = kmemdup(e, sizeof(*e), GFP_ATOMIC);
+	if (!copy)
+		return;
+	spin_lock_bh(&w->lock);
+	if (!w->active || w->pending >= ATH11K_NSS_WDS_PENDING) {
+		w->dropped++;
+		spin_unlock_bh(&w->lock);
+		kfree(copy);
+		return;
+	}
+	list_add_tail(&copy->list, &w->events);
+	w->pending++;
+	mod_delayed_work(ab->workqueue_aux, &w->work, 0);
+	spin_unlock_bh(&w->lock);
+}
+
+void ath11k_nss_wds_event(void *priv, struct net_device *dev,
+			  enum nss_wifi_wds_event ev,
+			  const struct nss_wifi_wds_info *info)
+{
+	struct ath11k_base *ab = priv;
+	struct ath11k_nss_wds_event e = {};
+	struct ath11k_vif *arvif;
+	struct ieee80211_vif *vif;
+	struct ath11k_peer *peer;
+	bool found;
+
+	if (!READ_ONCE(ab->nss_wds.active))
+		return;
+	if (ev == NSS_WIFI_WDS_ACTIVE || ev == NSS_WIFI_WDS_MEC_EXPIRE) {
+		e.action = ev == NSS_WIFI_WDS_ACTIVE ? WDS_ACTIVE : WDS_EXPIRE;
+		e.p.ast_idx = info->ast_idx;
+		e.p.radio = info->radio;
+		ether_addr_copy(e.p.addr, info->addr);
+		ath11k_nss_wds_queue(ab, &e);
+		return;
+	}
+	if (!dev || !dev->ieee80211_ptr)
+		return;
+	vif = wdev_to_ieee80211_vif(dev->ieee80211_ptr);
+	arvif = ath11k_vif_to_arvif(vif);
+	if (arvif->ar->ab != ab)
+		return;
+
+	spin_lock_bh(&ab->base_lock);
+	if (ev == NSS_WIFI_WDS_MEC) {
+		if (vif->type != NL80211_IFTYPE_STATION ||
+		    !dev->ieee80211_ptr->use_4addr) {
+			spin_unlock_bh(&ab->base_lock);
+			return;
+		}
+		peer = ath11k_peer_find(ab, arvif->vdev_id, arvif->bssid);
+		found = peer && ath11k_nss_wds_peer(ab, &e, peer->peer_id);
+		e.p.type = ATH11K_NSS_AST_MEC;
+	} else {
+		found = ath11k_nss_wds_peer(ab, &e, info->peer_id);
+		e.p.type = ATH11K_NSS_AST_WDS;
+	}
+	spin_unlock_bh(&ab->base_lock);
+	if (!found || e.p.vdev_id != arvif->vdev_id)
+		return;
+	if (info->addr4 && vif->type == NL80211_IFTYPE_AP)
+		ieee80211_rx_4addr_notify(vif, e.p.peer);
+	if (ev == NSS_WIFI_WDS_4ADDR ||
+	    (ev == NSS_WIFI_WDS_LEARN && !info->addr4) ||
+	    !is_valid_ether_addr(info->addr) ||
+	    ether_addr_equal(info->addr, vif->addr) ||
+	    ether_addr_equal(info->addr, e.p.peer))
+		return;
+	if (ev == NSS_WIFI_WDS_MEC) {
+		struct ath11k_nss_wds_entry *entry;
+
+		spin_lock_bh(&ab->nss_wds.lock);
+		list_for_each_entry(entry, &ab->nss_wds.entries, list)
+			if (entry->p.type == ATH11K_NSS_AST_MEC &&
+			    entry->generation == e.generation &&
+			    entry->p.vdev_id == e.p.vdev_id &&
+			    ether_addr_equal(entry->p.addr, info->addr)) {
+				entry->active = jiffies;
+				spin_unlock_bh(&ab->nss_wds.lock);
+				return;
+			}
+		spin_unlock_bh(&ab->nss_wds.lock);
+	}
+	e.action = WDS_LEARN;
+	ether_addr_copy(e.p.addr, info->addr);
+	ath11k_nss_wds_queue(ab, &e);
+}
+
+/* Record the source before the firmware transmits a group frame. The echo
+ * can race its asynchronous learning notification on another receive queue.
+ */
+void ath11k_nss_wds_mec_tx(struct ath11k_vif *arvif, struct sk_buff *skb)
+{
+	struct wireless_dev *wdev;
+	struct ethhdr *eth = (void *)skb->data;
+	struct nss_wifi_wds_info info = {};
+
+	if (arvif->vif->type != NL80211_IFTYPE_STATION || skb->len < ETH_HLEN ||
+	    !is_multicast_ether_addr(eth->h_dest))
+		return;
+	wdev = ieee80211_vif_to_wdev(arvif->vif);
+	if (!wdev || !wdev->netdev || !wdev->use_4addr)
+		return;
+	ether_addr_copy(info.addr, eth->h_source);
+	ath11k_nss_wds_event(arvif->ar->ab, wdev->netdev, NSS_WIFI_WDS_MEC, &info);
+}
+
+void ath11k_nss_wds_map(struct ath11k_base *ab, u8 vdev, u16 id,
+			const u8 *addr, u16 ast_idx)
+{
+	struct ath11k_nss_wds_event e = { .action = WDS_MAP };
+	bool found;
+
+	spin_lock_bh(&ab->base_lock);
+	found = ath11k_nss_wds_peer(ab, &e, id);
+	spin_unlock_bh(&ab->base_lock);
+	if (!found || e.p.vdev_id != vdev)
+		return;
+	ether_addr_copy(e.p.addr, addr);
+	e.p.ast_idx = ast_idx;
+	ath11k_nss_wds_queue(ab, &e);
+}
+
+void ath11k_nss_wds_unmap(struct ath11k_base *ab, u16 id, const u8 *addr)
+{
+	struct ath11k_nss_wds_event e = { .action = WDS_DEL };
+	bool found;
+
+	spin_lock_bh(&ab->base_lock);
+	found = ath11k_nss_wds_peer(ab, &e, id);
+	spin_unlock_bh(&ab->base_lock);
+	if (!found)
+		return;
+	ether_addr_copy(e.p.addr, addr);
+	ath11k_nss_wds_queue(ab, &e);
+}
+
+bool ath11k_nss_wds_mec(struct ath11k_base *ab, u32 vdev, const u8 *addr)
+{
+	struct ath11k_nss_wds_entry *entry;
+	struct ath11k_nss_wds_event *event;
+	bool found = false;
+
+	spin_lock_bh(&ab->nss_wds.lock);
+	list_for_each_entry(entry, &ab->nss_wds.entries, list)
+		if (entry->p.type == ATH11K_NSS_AST_MEC && entry->p.vdev_id == vdev &&
+		    ether_addr_equal(entry->p.addr, addr)) {
+			found = true;
+			break;
+		}
+	list_for_each_entry(event, &ab->nss_wds.events, list)
+		if (event->action == WDS_LEARN && event->p.type == ATH11K_NSS_AST_MEC &&
+		    event->p.vdev_id == vdev && ether_addr_equal(event->p.addr, addr))
+			found = true;
+	event = ab->nss_wds.learning;
+	if (event && event->action == WDS_LEARN && event->p.type == ATH11K_NSS_AST_MEC &&
+	    event->p.vdev_id == vdev && ether_addr_equal(event->p.addr, addr))
+		found = true;
+	if (found)
+		ab->nss_wds.mec_dropped++;
+	spin_unlock_bh(&ab->nss_wds.lock);
+	return found;
+}
+
+static void ath11k_nss_wds_delete(struct ath11k *ar,
+				  struct ath11k_nss_wds_entry *entry, bool wmi)
+{
+	struct ath11k_base *ab = ar->ab;
+
+	if (entry->p.type == ATH11K_NSS_AST_WDS) {
+		if (wmi)
+			ath11k_wmi_wds_delete(ar, entry->p.addr, entry->p.vdev_id);
+		nss_wifi_wds_peer(ab->nss_soc, NSS_WIFI_WDS_DEL, &entry->p);
+	}
+	spin_lock_bh(&ab->nss_wds.lock);
+	list_del(&entry->list);
+	ab->nss_wds.count--;
+	spin_unlock_bh(&ab->nss_wds.lock);
+	kfree(entry);
+}
+
+void ath11k_nss_wds_peer_delete(struct ath11k *ar, u32 vdev, const u8 *addr)
+{
+	struct ath11k_nss_wds_entry *entry, *tmp;
+	struct ath11k_vif *vlan;
+
+	lockdep_assert_held(&ar->conf_mutex);
+	mutex_lock(&ar->ab->nss_wds.mutex);
+	list_for_each_entry_safe(entry, tmp, &ar->ab->nss_wds.entries, list)
+		if (entry->p.vdev_id == vdev && ether_addr_equal(entry->p.peer, addr))
+			ath11k_nss_wds_delete(ar, entry, true);
+	mutex_unlock(&ar->ab->nss_wds.mutex);
+	list_for_each_entry(vlan, &ar->nss_vlans, nss_vlan_list)
+		if (vlan->vdev_id == vdev && ether_addr_equal(vlan->nss_wds_peer, addr)) {
+			struct wireless_dev *wdev = ieee80211_vif_to_wdev(vlan->vif);
+
+			vlan->nss_wds_generation = 0;
+			WRITE_ONCE(vlan->nss_ifnum, -1);
+			if (wdev && wdev->netdev)
+				nss_wifi_vdev_unregister(wdev->netdev);
+		}
+}
+
+static void ath11k_nss_wds_apply(struct ath11k *ar,
+				 struct ath11k_nss_wds_event *e)
+{
+	struct ath11k_base *ab = ar->ab;
+	struct ath11k_nss_wds_entry *entry = NULL, *it;
+	bool add = false;
+	int ret;
+
+	/* All modifications for this radio also hold conf_mutex. The list
+	 * lock protects NAPI's read-only MEC lookup; no message holds it.
+	 */
+	list_for_each_entry(it, &ab->nss_wds.entries, list)
+		if (it->p.radio == e->p.radio && ether_addr_equal(it->p.addr, e->p.addr)) {
+			entry = it;
+			break;
+		}
+	if (e->action == WDS_DEL) {
+		if (entry && entry->generation == e->generation)
+			ath11k_nss_wds_delete(ar, entry, false);
+		return;
+	}
+	if (e->action == WDS_MAP) {
+		if (!entry || entry->p.type == ATH11K_NSS_AST_MEC ||
+		    entry->generation != e->generation)
+			return;
+		spin_lock_bh(&ab->nss_wds.lock);
+		entry->p.ast_idx = e->p.ast_idx;
+		entry->active = jiffies;
+		spin_unlock_bh(&ab->nss_wds.lock);
+		ret = nss_wifi_wds_peer(ab->nss_soc, NSS_WIFI_WDS_MAP, &entry->p);
+		spin_lock_bh(&ab->nss_wds.lock);
+		entry->mapped = !ret;
+		spin_unlock_bh(&ab->nss_wds.lock);
+		if (ret)
+			ath11k_warn(ab, "WDS map %pM ast %u failed: %d\n",
+				    e->p.addr, e->p.ast_idx, ret);
+		return;
+	}
+	if (!entry) {
+		if (ab->nss_wds.count == ATH11K_NSS_WDS_MAX)
+			return;
+		entry = kzalloc(sizeof(*entry), GFP_KERNEL);
+		if (!entry)
+			return;
+		add = true;
+	} else if (entry->generation == e->generation && entry->p.type == e->p.type) {
+		WRITE_ONCE(entry->active, jiffies);
+		return;
+	} else if (entry->p.type != e->p.type) {
+		ath11k_nss_wds_delete(ar, entry, true);
+		ath11k_nss_wds_apply(ar, e);
+		return;
+	}
+	/* Every STA multicast receive is already an exception for mac80211
+	 * PN validation. Suppress its echo here, without a synthetic hardware
+	 * peer: retail 12.5 rejects the vendor MEC mapping sentinel.
+	 */
+	if (e->p.type == ATH11K_NSS_AST_MEC)
+		goto learned;
+
+	ret = nss_wifi_wds_peer(ab->nss_soc,
+				add ? NSS_WIFI_WDS_ADD : NSS_WIFI_WDS_UPDATE, &e->p);
+	if (!ret)
+		ret = ath11k_wmi_wds_update(ar, e->p.peer, e->p.addr, e->p.vdev_id, add);
+	if (ret) {
+		if (add) {
+			nss_wifi_wds_peer(ab->nss_soc, NSS_WIFI_WDS_DEL, &e->p);
+			kfree(entry);
+		} else {
+			nss_wifi_wds_peer(ab->nss_soc, NSS_WIFI_WDS_DEL, &e->p);
+			ath11k_nss_wds_delete(ar, entry, true);
+		}
+		ath11k_warn(ab, "WDS %pM peer %pM update failed: %d\n",
+			    e->p.addr, e->p.peer, ret);
+		return;
+	}
+learned:
+	spin_lock_bh(&ab->nss_wds.lock);
+	entry->p = e->p;
+	entry->generation = e->generation;
+	entry->active = jiffies;
+	entry->mapped = false;
+	if (add) {
+		list_add_tail(&entry->list, &ab->nss_wds.entries);
+		ab->nss_wds.count++;
+	}
+	spin_unlock_bh(&ab->nss_wds.lock);
+}
+
+static void ath11k_nss_wds_done(struct ath11k_nss_wds *w,
+				struct ath11k_nss_wds_event *e)
+{
+	spin_lock_bh(&w->lock);
+	w->learning = NULL;
+	spin_unlock_bh(&w->lock);
+	kfree(e);
+}
+
+static void ath11k_nss_wds_work(struct work_struct *work)
+{
+	struct ath11k_nss_wds *w = container_of(to_delayed_work(work),
+					      struct ath11k_nss_wds, work);
+	struct ath11k_base *ab = container_of(w, struct ath11k_base, nss_wds);
+	struct ath11k_nss_wds_event *e;
+	struct ath11k_nss_wds_entry *entry, *tmp;
+	struct ath11k_peer *peer;
+	struct ath11k *ar;
+	bool valid;
+	int i;
+
+	while (READ_ONCE(w->active)) {
+		spin_lock_bh(&w->lock);
+		e = list_first_entry_or_null(&w->events, struct ath11k_nss_wds_event, list);
+		if (e) {
+			list_del(&e->list);
+			w->pending--;
+			w->learning = e;
+		}
+		spin_unlock_bh(&w->lock);
+		if (!e)
+			break;
+		if (e->action == WDS_ACTIVE) {
+			spin_lock_bh(&w->lock);
+			list_for_each_entry(entry, &w->entries, list)
+				if (entry->mapped && entry->p.ast_idx == e->p.ast_idx)
+					entry->active = jiffies;
+			spin_unlock_bh(&w->lock);
+			ath11k_nss_wds_done(w, e);
+			continue;
+		}
+		if (e->action == WDS_EXPIRE) {
+			/* Convert firmware radio ID to our pdev index below. */
+			for (i = 0; i < ab->num_radios; i++)
+				if (ab->pdevs[i].pdev_id == e->p.radio)
+					break;
+			if (i < ab->num_radios) {
+				ar = ab->pdevs[i].ar;
+				if (!mutex_trylock(&ar->conf_mutex))
+					goto retry;
+				mutex_lock(&w->mutex);
+				list_for_each_entry_safe(entry, tmp, &w->entries, list)
+					if (entry->p.radio == i &&
+					    entry->p.type == ATH11K_NSS_AST_MEC &&
+					    ether_addr_equal(entry->p.addr, e->p.addr))
+						ath11k_nss_wds_delete(ar, entry, true);
+				mutex_unlock(&w->mutex);
+				mutex_unlock(&ar->conf_mutex);
+			}
+			ath11k_nss_wds_done(w, e);
+			continue;
+		}
+		if (e->p.radio >= ab->num_radios) {
+			ath11k_nss_wds_done(w, e);
+			continue;
+		}
+		ar = ab->pdevs[e->p.radio].ar;
+		if (!mutex_trylock(&ar->conf_mutex))
+			goto retry;
+		spin_lock_bh(&ab->base_lock);
+		peer = ath11k_peer_find_by_id(ab, e->p.peer_id);
+		valid = peer && peer->is_authorized && peer->nss_generation == e->generation &&
+			peer->vdev_id == e->p.vdev_id && ether_addr_equal(peer->addr, e->p.peer);
+		spin_unlock_bh(&ab->base_lock);
+		mutex_lock(&w->mutex);
+		if (valid)
+			ath11k_nss_wds_apply(ar, e);
+		mutex_unlock(&w->mutex);
+		mutex_unlock(&ar->conf_mutex);
+		ath11k_nss_wds_done(w, e);
+	}
+	/* Firmware activity reports keep active WDS entries alive. MEC entries
+	 * are removed on firmware ageout. Unmapped/idle entries are bounded.
+	 */
+	for (i = 0; READ_ONCE(w->active) && i < ab->num_radios; i++) {
+		ar = ab->pdevs[i].ar;
+		if (!ar || !mutex_trylock(&ar->conf_mutex))
+			continue;
+		mutex_lock(&w->mutex);
+		list_for_each_entry_safe(entry, tmp, &w->entries, list)
+			if (entry->p.radio == i &&
+			    time_after(jiffies, READ_ONCE(entry->active) + ATH11K_NSS_WDS_AGE))
+				ath11k_nss_wds_delete(ar, entry, true);
+		mutex_unlock(&w->mutex);
+		mutex_unlock(&ar->conf_mutex);
+	}
+	spin_lock_bh(&w->lock);
+	if (w->active)
+		queue_delayed_work(ab->workqueue_aux, &w->work, HZ);
+	spin_unlock_bh(&w->lock);
+	return;
+retry:
+	spin_lock_bh(&w->lock);
+	w->learning = NULL;
+	list_add(&e->list, &w->events);
+	w->pending++;
+	if (w->active)
+		queue_delayed_work(ab->workqueue_aux, &w->work, msecs_to_jiffies(20));
+	spin_unlock_bh(&w->lock);
+}
+
+void ath11k_nss_wds_init(struct ath11k_base *ab)
+{
+	spin_lock_init(&ab->nss_wds.lock);
+	mutex_init(&ab->nss_wds.mutex);
+	INIT_LIST_HEAD(&ab->nss_wds.entries);
+	INIT_LIST_HEAD(&ab->nss_wds.events);
+	INIT_DELAYED_WORK(&ab->nss_wds.work, ath11k_nss_wds_work);
+}
+
+void ath11k_nss_wds_start(struct ath11k_base *ab)
+{
+	WRITE_ONCE(ab->nss_wds.active, true);
+}
+
+void ath11k_nss_wds_stop(struct ath11k_base *ab)
+{
+	struct ath11k_nss_wds_event *event, *etmp;
+	struct ath11k_nss_wds_entry *entry, *tmp;
+	struct ath11k_nss_wds *w = &ab->nss_wds;
+
+	spin_lock_bh(&w->lock);
+	w->active = false;
+	spin_unlock_bh(&w->lock);
+	cancel_delayed_work_sync(&w->work);
+	mutex_lock(&w->mutex);
+	list_for_each_entry_safe(event, etmp, &w->events, list) {
+		list_del(&event->list);
+		kfree(event);
+	}
+	list_for_each_entry_safe(entry, tmp, &w->entries, list) {
+		if (entry->p.type == ATH11K_NSS_AST_WDS)
+			nss_wifi_wds_peer(ab->nss_soc, NSS_WIFI_WDS_DEL, &entry->p);
+		spin_lock_bh(&w->lock);
+		list_del(&entry->list);
+		spin_unlock_bh(&w->lock);
+		kfree(entry);
+	}
+	spin_lock_bh(&w->lock);
+	w->count = 0;
+	w->pending = 0;
+	w->learning = NULL;
+	spin_unlock_bh(&w->lock);
+	mutex_unlock(&w->mutex);
+}
+
+void ath11k_nss_wds_vlan_work(struct work_struct *work)
+{
+	struct ath11k_vif *vlan = container_of(work, struct ath11k_vif, nss_wds_work);
+	struct ath11k_vif *parent = vlan->nss_parent;
+	struct ath11k *ar = vlan->ar;
+	struct wireless_dev *wdev = ieee80211_vif_to_wdev(vlan->vif);
+	struct wireless_dev *p;
+	struct ath11k_peer *peer;
+	u16 id;
+	bool found;
+	int ret;
+
+	if (!parent || !wdev)
+		return;
+	mutex_lock(&ar->conf_mutex);
+	spin_lock_bh(&ar->ab->base_lock);
+	peer = ath11k_peer_find(ar->ab, parent->vdev_id, vlan->nss_wds_peer);
+	found = peer && peer->nss_generation == vlan->nss_wds_generation;
+	id = peer ? peer->peer_id : 0;
+	spin_unlock_bh(&ar->ab->base_lock);
+	if (!found)
+		goto out;
+	ret = ath11k_wmi_set_peer_param(ar, vlan->nss_wds_peer, parent->vdev_id,
+					WMI_PEER_USE_4ADDR, 1);
+	if (ret)
+		goto warn;
+	ret = ath11k_wmi_vdev_set_param_cmd(ar, parent->vdev_id,
+					    WMI_VDEV_PARAM_AP_ENABLE_NAWDS, 256);
+	if (ret)
+		goto warn;
+	p = ieee80211_vif_to_wdev(parent->vif);
+	ret = nss_wifi_wds_vdev_register(wdev->netdev, p->netdev, id, vlan->nss_wds_peer);
+	if (ret < 0)
+		goto warn;
+	WRITE_ONCE(vlan->nss_ifnum, ret);
+	goto out;
+warn:
+	ath11k_warn(ar->ab, "WDS VLAN %s peer %pM setup failed: %d\n",
+		    wdev->netdev->name, vlan->nss_wds_peer, ret);
+out:
+	mutex_unlock(&ar->conf_mutex);
+}
+
+#ifdef CPTCFG_ATH11K_DEBUGFS
+static int ath11k_nss_wds_show(struct seq_file *s, void *unused)
+{
+	struct ath11k *ar = s->private;
+	struct ath11k_nss_wds *w = &ar->ab->nss_wds;
+	struct ath11k_nss_wds_entry *entry;
+
+	spin_lock_bh(&w->lock);
+	seq_printf(s, "active=%u count=%u pending=%u dropped=%llu mec_dropped=%llu\n",
+		   w->active, w->count, w->pending, w->dropped, w->mec_dropped);
+	list_for_each_entry(entry, &w->entries, list)
+		if (entry->p.radio == ar->pdev_idx)
+			seq_printf(s, "%pM peer=%pM id=%u generation=%llu vdev=%u type=%u ast=%u mapped=%u idle_ms=%u\n",
+				   entry->p.addr, entry->p.peer, entry->p.peer_id,
+				   entry->generation, entry->p.vdev_id, entry->p.type,
+				   entry->p.ast_idx, entry->mapped,
+				   jiffies_to_msecs(jiffies - entry->active));
+	spin_unlock_bh(&w->lock);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(ath11k_nss_wds);
+#endif
