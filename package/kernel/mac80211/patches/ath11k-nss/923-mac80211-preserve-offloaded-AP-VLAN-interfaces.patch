 }
 EXPORT_SYMBOL(ieee80211_sta_uapsd_trigger);
 
+void ieee80211_rx_4addr_notify(struct ieee80211_vif *vif, const u8 *addr)
+{
+	struct ieee80211_sub_if_data *sdata = vif_to_sdata(vif);
+	struct sta_info *sta;
+
+	if (vif->type != NL80211_IFTYPE_AP)
+		return;
+	sta = sta_info_get_bss(sdata, addr);
+	if (!sta || !test_sta_flag(sta, WLAN_STA_AUTHORIZED) ||
+	    test_and_set_sta_flag(sta, WLAN_STA_4ADDR_EVENT))
+		return;
+	cfg80211_rx_unexpected_4addr_frame(sdata->dev, addr, 0, GFP_ATOMIC);
+}
+EXPORT_SYMBOL_GPL(ieee80211_rx_4addr_notify);
+
