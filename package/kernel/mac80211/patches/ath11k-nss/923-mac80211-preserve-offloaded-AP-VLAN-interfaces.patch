+static void ieee80211_reconfig_ap_vlan_4addr(struct ieee80211_local *local)
+{
+	struct sta_info *sta;
+
+	if (!ieee80211_hw_check(&local->hw, SUPPORTS_AP_VLAN_OFFLOAD))
+		return;
+
+	/* The offloaded VLAN can depend on its peer's restored security. */
+	list_for_each_entry(sta, &local->sta_list, list) {
+		if (sta->uploaded &&
+		    sta->sta_state == IEEE80211_STA_AUTHORIZED &&
+		    sta->sdata->vif.type == NL80211_IFTYPE_AP_VLAN &&
+		    sta->sdata->wdev.use_4addr)
+			drv_sta_set_4addr(local, sta->sdata, &sta->sta, true);
+	}
+}
