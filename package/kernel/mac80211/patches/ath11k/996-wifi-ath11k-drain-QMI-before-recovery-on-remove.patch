From: ViKing <viking.yfy@qq.com>
Date: Sun, 08 Nov 2026 10:23:51 +0800
Subject: [PATCH] wifi: ath11k: drain QMI before recovery on device removal

A QMI event that passed the unregister check can queue restart_work
after remove cancelled that work. Drain the event producer before the
restart consumer on AHB and PCI, including failed registration. Keep reset
and dump work quiescent before releasing radio, DMA or thermal resources.

Discard all queued events once unregistering starts instead of returning
with the rest of the event list still allocated. Reject a late restart
before it reconfigures resources owned by removal.

After releasing QMI callbacks and cancelling the worker, free any events
that were queued when cancellation prevented the worker from running.

Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/drivers/net/wireless/ath/ath11k/ahb.c
+++ b/drivers/net/wireless/ath/ath11k/ahb.c
@@ -1319,9 +1319,7 @@
 			ath11k_warn(ab, "failed to receive recovery response completion\n");
 	}
 
-	set_bit(ATH11K_FLAG_UNREGISTERING, &ab->dev_flags);
-	cancel_work_sync(&ab->restart_work);
-	cancel_work_sync(&ab->qmi.event_work);
+	ath11k_core_quiesce_recovery(ab);
 }
 
 static void ath11k_ahb_free_resources(struct ath11k_base *ab)
--- a/drivers/net/wireless/ath/ath11k/core.c
+++ b/drivers/net/wireless/ath/ath11k/core.c
@@ -2676,6 +2676,9 @@
 	struct ath11k_base *ab = container_of(work, struct ath11k_base, restart_work);
 	int ret;
 
+	if (test_bit(ATH11K_FLAG_UNREGISTERING, &ab->dev_flags))
+		return;
+
 	ret = ath11k_core_reconfigure_on_crash(ab);
 	if (ret) {
 		ath11k_err(ab, "failed to reconfigure driver on crash recovery\n");
@@ -2905,6 +2908,20 @@
 }
 EXPORT_SYMBOL(ath11k_core_init);
 
+void ath11k_core_quiesce_recovery(struct ath11k_base *ab)
+{
+	set_bit(ATH11K_FLAG_UNREGISTERING, &ab->dev_flags);
+
+	/* Reset may wait for FW events. Stop it before draining the event
+	 * producer, then cancel every restart it could have queued.
+	 */
+	cancel_work_sync(&ab->reset_work);
+	cancel_work_sync(&ab->qmi.event_work);
+	cancel_work_sync(&ab->restart_work);
+	cancel_work_sync(&ab->dump_work);
+}
+EXPORT_SYMBOL(ath11k_core_quiesce_recovery);
+
 void ath11k_core_deinit(struct ath11k_base *ab)
 {
 	mutex_lock(&ab->core_lock);
--- a/drivers/net/wireless/ath/ath11k/core.h
+++ b/drivers/net/wireless/ath/ath11k/core.h
@@ -1286,6 +1286,7 @@
 int ath11k_core_qmi_firmware_ready(struct ath11k_base *ab);
 int ath11k_core_pre_init(struct ath11k_base *ab);
 int ath11k_core_init(struct ath11k_base *ath11k);
+void ath11k_core_quiesce_recovery(struct ath11k_base *ab);
 void ath11k_core_deinit(struct ath11k_base *ath11k);
 struct ath11k_base *ath11k_core_alloc(struct device *dev, size_t priv_size,
 				      enum ath11k_bus bus);
--- a/drivers/net/wireless/ath/ath11k/pci.c
+++ b/drivers/net/wireless/ath/ath11k/pci.c
@@ -1190,7 +1190,9 @@
 
 	ath11k_pci_set_irq_affinity_hint(ab_pci, NULL);
 
-	if (test_bit(ATH11K_FLAG_QMI_FAIL, &ab->dev_flags)) {
+	ath11k_core_quiesce_recovery(ab);
+
+	if (!test_bit(ATH11K_FLAG_REGISTERED, &ab->dev_flags)) {
 		ath11k_pci_power_down(ab, false);
 		ath11k_debugfs_soc_destroy(ab);
 		ath11k_qmi_deinit_service(ab);
@@ -1198,10 +1200,6 @@
 		goto qmi_fail;
 	}
 
-	set_bit(ATH11K_FLAG_UNREGISTERING, &ab->dev_flags);
-
-	cancel_work_sync(&ab->reset_work);
-	cancel_work_sync(&ab->dump_work);
 	ath11k_core_deinit(ab);
 
 qmi_fail:
--- a/drivers/net/wireless/ath/ath11k/qmi.c
+++ b/drivers/net/wireless/ath/ath11k/qmi.c
@@ -3433,7 +3433,8 @@
 
 		if (test_bit(ATH11K_FLAG_UNREGISTERING, &ab->dev_flags)) {
 			kfree(event);
-			return;
+			spin_lock(&qmi->event_lock);
+			continue;
 		}
 
 		switch (event->type) {
@@ -3567,8 +3568,23 @@
 
 void ath11k_qmi_deinit_service(struct ath11k_base *ab)
 {
+	struct ath11k_qmi_driver_event *event;
+
 	qmi_handle_release(&ab->qmi.handle);
 	cancel_work_sync(&ab->qmi.event_work);
+
+	/* A cancelled worker can leave events that it never dequeued.
+	 * QMI callbacks and their worker have both stopped at this point.
+	 */
+	spin_lock(&ab->qmi.event_lock);
+	while (!list_empty(&ab->qmi.event_list)) {
+		event = list_first_entry(&ab->qmi.event_list,
+					 struct ath11k_qmi_driver_event, list);
+		list_del(&event->list);
+		kfree(event);
+	}
+	spin_unlock(&ab->qmi.event_lock);
+
 	destroy_workqueue(ab->qmi.event_wq);
 	ath11k_qmi_m3_free(ab);
 	ath11k_qmi_free_target_mem_chunk(ab);
