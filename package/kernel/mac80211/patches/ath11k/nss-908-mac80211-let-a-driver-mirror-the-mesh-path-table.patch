+/* A path the device forwards over and the stack never sees used. */
+static int mesh_path_offld_refresh(struct ieee80211_sub_if_data *sdata,
+				   const u8 *mda)
+{
+	struct mesh_path *mpath;
+
+	mpath = mesh_path_lookup(sdata, mda);
+	if (!mpath || !(mpath->flags & MESH_PATH_ACTIVE))
+		return -ENOENT;
+
+	if (!(mpath->flags & (MESH_PATH_RESOLVING | MESH_PATH_FIXED)))
+		mesh_queue_preq(mpath, PREQ_Q_F_START | PREQ_Q_F_REFRESH);
+
+	return 0;
+}
+
+/* The device found the destination behind a proxy as well. */
+static int mesh_path_offld_del(struct ieee80211_sub_if_data *sdata,
+			       const u8 *mda)
+{
+	if (!mesh_path_lookup(sdata, mda) || !mpp_path_lookup(sdata, mda))
+		return -ENOENT;
+
+	return mesh_path_del(sdata, mda);
+}
+
+/* A path the device holds expired, or has none: discover it, and on a
+ * forwarded frame tell the transmitter it was not forwarded.
+ */
+static int mesh_path_offld_resolve(struct ieee80211_sub_if_data *sdata,
+				   const u8 *mda, const u8 *ta, bool expired)
+{
+	struct mesh_path *mpath;
+
+	mpath = mesh_path_lookup(sdata, mda);
+	if (!mpath) {
+		mpath = mesh_path_add(sdata, mda);
+		if (IS_ERR(mpath))
+			return PTR_ERR(mpath);
+	}
+
+	if (expired) {
+		spin_lock_bh(&mpath->state_lock);
+		mpath->flags &= ~MESH_PATH_ACTIVE;
+		spin_unlock_bh(&mpath->state_lock);
+	}
+
+	if (!(mpath->flags & MESH_PATH_RESOLVING) &&
+	    mesh_path_sel_is_hwmp(sdata))
+		mesh_queue_preq(mpath, PREQ_Q_F_START);
+
+	if (ta && !is_zero_ether_addr(ta))
+		mesh_path_error_tx(sdata, sdata->u.mesh.mshcfg.element_ttl, mda,
+				   0, WLAN_REASON_MESH_PATH_NOFORWARD, ta);
+
+	return 0;
+}
+
+static int mesh_path_offld_mpp(struct ieee80211_sub_if_data *sdata,
+			       const u8 *da, const u8 *mda, bool add,
+			       bool offld)
+{
+	struct mesh_path *mppath;
+
+	mppath = mpp_path_lookup(sdata, da);
+	if (add)
+		return mppath ? -EEXIST : __mpp_path_add(sdata, da, mda, offld);
+
+	if (!mppath)
+		return -ENOENT;
+
+	spin_lock_bh(&mppath->state_lock);
+	if (!ether_addr_equal(mppath->mpp, mda))
+		memcpy(mppath->mpp, mda, ETH_ALEN);
+	mppath->exp_time = jiffies;
+	spin_unlock_bh(&mppath->state_lock);
+
+	return 0;
+}
+
+int ieee80211_mesh_path_offld_change_notify(struct ieee80211_vif *vif,
+					    const struct ieee80211_mesh_path_offld *path,
+					    enum ieee80211_mesh_path_offld_action action)
+{
+	struct ieee80211_sub_if_data *sdata = vif_to_sdata(vif);
+	int ret;
+
+	rcu_read_lock();
+
+	switch (action) {
+	case IEEE80211_MESH_PATH_OFFLD_ACTION_MPATH_REFRESH:
+		ret = mesh_path_offld_refresh(sdata, path->mesh_da);
+		break;
+	case IEEE80211_MESH_PATH_OFFLD_ACTION_MPATH_DEL:
+		ret = mesh_path_offld_del(sdata, path->mesh_da);
+		break;
+	case IEEE80211_MESH_PATH_OFFLD_ACTION_MPATH_EXP:
+		ret = mesh_path_offld_resolve(sdata, path->mesh_da, NULL, true);
+		break;
+	case IEEE80211_MESH_PATH_OFFLD_ACTION_PATH_NOT_FOUND:
+		ret = mesh_path_offld_resolve(sdata, path->da, path->ta, false);
+		break;
+	case IEEE80211_MESH_PATH_OFFLD_ACTION_MPP_LEARN:
+		ret = mesh_path_offld_mpp(sdata, path->da, path->mesh_da, true,
+					  true);
+		break;
+	case IEEE80211_MESH_PATH_OFFLD_ACTION_MPP_ADD:
+		ret = mesh_path_offld_mpp(sdata, path->da, path->mesh_da, true,
+					  false);
+		break;
+	case IEEE80211_MESH_PATH_OFFLD_ACTION_MPP_UPDATE:
+		ret = mesh_path_offld_mpp(sdata, path->da, path->mesh_da, false,
+					  false);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	rcu_read_unlock();
+
+	return ret;
+}
+EXPORT_SYMBOL(ieee80211_mesh_path_offld_change_notify);
