+/* For a device that forwards mesh frames itself. */
+void ieee80211_mesh_offld_config(struct ieee80211_sub_if_data *sdata)
+{
+	struct mesh_config *conf = &sdata->u.mesh.mshcfg;
+
+	sdata->vif.bss_conf.mesh_ttl = conf->dot11MeshTTL;
+	sdata->vif.bss_conf.mesh_path_refresh_time = conf->path_refresh_time;
+	sdata->vif.bss_conf.mesh_forwarding = conf->dot11MeshForwarding;
+}
