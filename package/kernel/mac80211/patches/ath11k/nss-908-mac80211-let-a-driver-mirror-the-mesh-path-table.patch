+/**
+ * mesh_path_offld - mirror a path table change into the driver
+ * @mpath: the path
+ * @cmd: what changed
+ * @old_next_hop: next hop before the change, or NULL if it did not change
+ *
+ * For a device that forwards mesh frames itself.
+ */
+void mesh_path_offld(struct mesh_path *mpath,
+		     enum ieee80211_mesh_path_offld_cmd cmd,
+		     const u8 *old_next_hop)
+{
+	struct ieee80211_sub_if_data *sdata = mpath->sdata;
+	struct ieee80211_mesh_path_offld p = {};
+	struct sta_info *next_hop;
+
+	if (!sdata->local->ops->config_mesh_offload_path)
+		return;
+
+	if (cmd >= IEEE80211_MESH_PATH_OFFLD_CMD_ADD_MPP) {
+		ether_addr_copy(p.mesh_da, mpath->mpp);
+		ether_addr_copy(p.da, mpath->dst);
+	} else {
+		ether_addr_copy(p.mesh_da, mpath->dst);
+	}
+
+	rcu_read_lock();
+	next_hop = rcu_dereference(mpath->next_hop);
+	if (next_hop)
+		ether_addr_copy(p.next_hop, next_hop->sta.addr);
+	rcu_read_unlock();
+
+	ether_addr_copy(p.old_next_hop, old_next_hop ?: p.next_hop);
+	p.metric = mpath->metric;
+	if (time_before(jiffies, mpath->exp_time))
+		p.exp_time = jiffies_to_msecs(mpath->exp_time - jiffies);
+	p.hop_count = mpath->hop_count;
+	p.flags = mpath->flags;
+	p.mesh_gate = mpath->is_gate;
+
+	drv_config_mesh_offload_path(sdata->local, sdata, cmd, &p);
+}
+
 static struct mesh_path *mpath_lookup(struct mesh_table *tbl, const u8 *dst,
 				      struct ieee80211_sub_if_data *sdata)
 {
 	struct mesh_path *mpath;
+	bool was_active;
 
 	mpath = rhashtable_lookup(&tbl->rhead, dst, mesh_rht_params);
 
 	if (mpath && mpath_expired(mpath)) {
 		spin_lock_bh(&mpath->state_lock);
+		was_active = mpath->flags & MESH_PATH_ACTIVE;
 		mpath->flags &= ~MESH_PATH_ACTIVE;
 		spin_unlock_bh(&mpath->state_lock);
+		if (was_active && tbl == &sdata->u.mesh.mesh_paths)
+			mesh_path_offld(mpath,
+					IEEE80211_MESH_PATH_OFFLD_CMD_UPDATE_MPATH,
+					NULL);
 	}
 	return mpath;
 }
@@ -713,14 +763,17 @@ struct mesh_path *mesh_path_add(struct i
 			return mpath;
 
 		new_mpath = mpath;
+	} else {
+		mesh_path_offld(new_mpath, IEEE80211_MESH_PATH_OFFLD_CMD_ADD_MPATH,
+				NULL);
 	}
 
 	sdata->u.mesh.mesh_paths_generation++;
 	return new_mpath;
 }
 
