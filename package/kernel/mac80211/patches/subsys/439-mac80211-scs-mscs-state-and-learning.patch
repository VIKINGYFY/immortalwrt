 		}
 		ieee80211_led_radio(local, true);
 		ieee80211_mod_tpt_led_trig(local,
@@ -1642,6 +1648,9 @@ int ieee80211_do_open(struct wireless_de
 		list_del(&sdata->u.vlan.list);
