 	airtime.o \
-	eht.o uhr.o nan.o
+	eht.o uhr.o nan.o \
+	scs.o
 
 mac80211-$(CPTCFG_MAC80211_LEDS) += led.o
 mac80211-$(CPTCFG_MAC80211_DEBUGFS) += \
--- a/net/mac80211/cfg.c
+++ b/net/mac80211/cfg.c
@@ -6251,6 +6251,8 @@ const struct cfg80211_ops mac80211_confi
 	.end_cac = ieee80211_end_cac,
