From: Felix Fietkau <nbd@nbd.name>
Date: Wed, 11 Nov 2026 16:11:45 +0800
Subject: [PATCH] wifi: mac80211: apply SCS and MSCS in software paths

Connect the final classifier to TX and RX, preserving explicit priorities and the software fallback behavior of offloaded Ethernet frames.

Split from:
  440-wifi-mac80211-classify-transmitted-MSDUs-with-SCS.patch - wifi: mac80211: classify transmitted MSDUs with SCS
  441-wifi-mac80211-learn-MSCS-flows-on-receive.patch - wifi: mac80211: learn MSCS flows on receive
  475-wifi-mac80211-mark-frames-whose-priority-does-not-fo.patch - wifi: mac80211: mark frames whose priority does not follow the DSCP

Merged from:
  440-wifi-mac80211-classify-transmitted-MSDUs-with-SCS.patch - wifi: mac80211: classify transmitted MSDUs with SCS
  441-wifi-mac80211-learn-MSCS-flows-on-receive.patch - wifi: mac80211: learn MSCS flows on receive
  475-wifi-mac80211-mark-frames-whose-priority-does-not-fo.patch - wifi: mac80211: mark frames whose priority does not follow the DSCP
  480-wifi-mac80211-keep-the-priority-of-an-802.3-frame-fo.patch - wifi: mac80211: keep the priority of an 802.3 frame for the slow path

Fixes: 96ae9cd02c0f ("mac80211: check and refresh aggregation session in encap offload tx")

Signed-off-by: Felix Fietkau <nbd@nbd.name>
Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/net/mac80211/mesh.c
+++ b/net/mac80211/mesh.c
@@ -800,7 +800,8 @@ bool ieee80211_mesh_xmit_fast(struct iee
 	if (!skb)
 		return true;
 
-	skb_set_queue_mapping(skb, ieee80211_select_queue(sdata, sta, skb));
+	skb_set_queue_mapping(skb,
+			      ieee80211_select_queue(sdata, sta, skb, NULL));
 
 	meshhdr = (struct ieee80211s_hdr *)entry->hdr;
 	if ((meshhdr->flags & MESH_FLAGS_AE) == MESH_FLAGS_AE_A5_A6) {
@@ -821,7 +822,7 @@ bool ieee80211_mesh_xmit_fast(struct iee
 
 	skb_push(skb, 2 * ETH_ALEN);
 	__ieee80211_xmit_fast(sdata, sta, &entry->fast_tx, skb, tid_tx,
-			      entry->mpath->dst, sdata->vif.addr);
+			      entry->mpath->dst, sdata->vif.addr, 0);
 
 	return true;
 }
--- a/net/mac80211/rx.c
+++ b/net/mac80211/rx.c
@@ -2815,6 +2815,9 @@ ieee80211_deliver_skb(struct ieee80211_r
 		u64_stats_update_end(&rx->link_sta->rx_stats.syncp);
 	}
 
+	if (rx->sta)
+		ieee80211_flow_learn(rx);
+
 	if ((sdata->vif.type == NL80211_IFTYPE_AP ||
 	     sdata->vif.type == NL80211_IFTYPE_AP_VLAN) &&
 	    !(sdata->flags & IEEE80211_SDATA_DONT_BRIDGE_PACKETS) &&
@@ -2949,7 +2952,7 @@ ieee80211_rx_mesh_fast_forward(struct ie
 	memcpy(&eth, skb->data, ETH_HLEN - 2);
 	skb_pull(skb, 2);
 	__ieee80211_xmit_fast(sdata, sta, &entry->fast_tx, skb, tid_tx,
-			      eth.h_dest, eth.h_source);
+			      eth.h_dest, eth.h_source, 0);
 	IEEE80211_IFSTA_MESH_CTR_INC(ifmsh, fwded_unicast);
 	IEEE80211_IFSTA_MESH_CTR_INC(ifmsh, fwded_frames);
 
@@ -4980,6 +4983,8 @@ static void ieee80211_rx_8023(struct iee
 	u64_stats_add(&stats->bytes, orig_len);
 	u64_stats_update_end(&stats->syncp);
 
+	ieee80211_flow_learn(rx);
+
 	if (fast_rx->internal_forward) {
 		struct sk_buff *xmit_skb = NULL;
 		if (is_multicast_ether_addr(da)) {
--- a/net/mac80211/tx.c
+++ b/net/mac80211/tx.c
@@ -3782,7 +3782,7 @@ void __ieee80211_xmit_fast(struct ieee80
 			   struct sta_info *sta,
 			   struct ieee80211_fast_tx *fast_tx,
 			   struct sk_buff *skb, bool ampdu,
-			   const u8 *da, const u8 *sa)
+			   const u8 *da, const u8 *sa, u32 ctrl_flags)
 {
 	struct ieee80211_local *local = sdata->local;
 	struct ieee80211_hdr *hdr = (void *)fast_tx->hdr;
@@ -3821,7 +3821,7 @@ void __ieee80211_xmit_fast(struct ieee80
 	info->control.vif = &sdata->vif;
 	info->flags = IEEE80211_TX_CTL_FIRST_FRAGMENT |
 		      IEEE80211_TX_CTL_DONTFRAG;
-	info->control.flags = IEEE80211_TX_CTRL_FAST_XMIT |
+	info->control.flags = IEEE80211_TX_CTRL_FAST_XMIT | ctrl_flags |
 			      u32_encode_bits(IEEE80211_LINK_UNSPECIFIED,
 					      IEEE80211_TX_CTRL_MLO_LINK);
 
@@ -3871,7 +3871,7 @@ free:
 static bool ieee80211_xmit_fast(struct ieee80211_sub_if_data *sdata,
 				struct sta_info *sta,
 				struct ieee80211_fast_tx *fast_tx,
-				struct sk_buff *skb)
+				struct sk_buff *skb, u32 ctrl_flags)
 {
 	u16 ethertype = (skb->data[12] << 8) | skb->data[13];
 	struct ieee80211_hdr *hdr = (void *)fast_tx->hdr;
@@ -3913,7 +3913,7 @@ static bool ieee80211_xmit_fast(struct i
 	skb_list_walk_safe(skb, skb, next) {
 		skb_mark_not_on_list(skb);
 		__ieee80211_xmit_fast(sdata, sta, fast_tx, skb, tid_tx,
-				      eth.h_dest, eth.h_source);
+				      eth.h_dest, eth.h_source, ctrl_flags);
 	}
 
 	return true;
@@ -4489,7 +4489,8 @@ void __ieee80211_subif_start_xmit(struct
 	if (IS_ERR(sta))
 		sta = NULL;
 
-	skb_set_queue_mapping(skb, ieee80211_select_queue(sdata, sta, skb));
+	skb_set_queue_mapping(skb, ieee80211_select_queue(sdata, sta, skb,
+							   &ctrl_flags));
 	ieee80211_aggr_check(sdata, sta, skb);
 
 	if (sta) {
@@ -4497,8 +4498,11 @@ void __ieee80211_subif_start_xmit(struct
 
 		fast_tx = rcu_dereference(sta->fast_tx);
 
+		/* The fast path sets its own link and control flags */
 		if (fast_tx &&
-		    ieee80211_xmit_fast(sdata, sta, fast_tx, skb))
+		    ieee80211_xmit_fast(sdata, sta, fast_tx, skb,
+					ctrl_flags &
+					IEEE80211_TX_CTRL_STREAM_CLASSIFIED))
 			goto out;
 	}
 
@@ -4815,10 +4819,12 @@ static void ieee80211_8023_xmit(struct i
 	struct tid_ampdu_tx *tid_tx = NULL;
 	struct sk_buff *seg, *next;
 	unsigned int skbs = 0, len = 0;
+	u32 priority = skb->priority;
+	u32 ctrl_flags = 0;
 	u16 queue;
 	u8 tid;
 
-	queue = ieee80211_select_queue(sdata, sta, skb);
+	queue = ieee80211_select_queue(sdata, sta, skb, &ctrl_flags);
 	skb_set_queue_mapping(skb, queue);
 
 	if (unlikely(test_bit(SCAN_SW_SCANNING, &local->scanning)) &&
@@ -4837,7 +4843,11 @@ static void ieee80211_8023_xmit(struct i
 		tid_tx = rcu_dereference(sta->ampdu_mlme.tid_tx[tid]);
 	if (tid_tx) {
 		if (!test_bit(HT_AGG_STATE_OPERATIONAL, &tid_tx->state)) {
-			/* fall back to non-offload slow path */
+			/*
+			 * fall back to non-offload slow path, which classifies
+			 * the frame again
+			 */
+			skb->priority = priority;
 			__ieee80211_subif_start_xmit(skb, dev, 0,
 						     IEEE80211_TX_CTRL_MLO_LINK_UNSPEC,
 						     NULL);
@@ -4873,6 +4883,7 @@ static void ieee80211_8023_xmit(struct i
 
 	info->flags |= IEEE80211_TX_CTL_HW_80211_ENCAP;
 	info->control.vif = &sdata->vif;
+	info->control.flags |= ctrl_flags;
 
 	if (key)
 		info->control.hw_key = &key->conf;
@@ -6819,7 +6830,7 @@ int ieee80211_tx_control_port(struct wip
 	}
 
 	if (!IS_ERR(sta)) {
-		u16 queue = ieee80211_select_queue(sdata, sta, skb);
+		u16 queue = ieee80211_select_queue(sdata, sta, skb, NULL);
 
 		skb_set_queue_mapping(skb, queue);
 
--- a/net/mac80211/wme.c
+++ b/net/mac80211/wme.c
@@ -10,6 +10,7 @@
 #include <linux/module.h>
 #include <linux/if_arp.h>
 #include <linux/types.h>
+#include <net/dsfield.h>
 #include <net/ip.h>
 #include <net/pkt_sched.h>
 
@@ -144,12 +145,37 @@ u16 ieee80211_select_queue_80211(struct
 	return ieee80211_downgrade_queue(sdata, NULL, skb);
 }
 
+/*
+ * Whether the priority of @skb is the one that the RFC 8325 mapping gives
+ * its DSCP, or 0 for a frame without a DSCP. A device that classifies an
+ * 802.3 frame by its DSCP itself arrives at that priority.
+ */
+static bool ieee80211_prio_follows_dscp(struct sk_buff *skb)
+{
+	unsigned int up = 0;
+
+	switch (skb->protocol) {
+	case htons(ETH_P_IP):
+		up = cfg80211_dscp_to_up(ipv4_get_dsfield(ip_hdr(skb)) >> 2,
+					 NULL);
+		break;
+	case htons(ETH_P_IPV6):
+		up = cfg80211_dscp_to_up(ipv6_get_dsfield(ipv6_hdr(skb)) >> 2,
+					 NULL);
+		break;
+	}
+
+	return skb->priority == up;
+}
+
 u16 ieee80211_select_queue(struct ieee80211_sub_if_data *sdata,
-			   struct sta_info *sta, struct sk_buff *skb)
+			   struct sta_info *sta, struct sk_buff *skb,
+			   u32 *ctrl_flags)
 {
 	const struct ethhdr *eth = (void *)skb->data;
 	struct mac80211_qos_map *qos_map;
 	bool qos;
+	u16 ac;
 
 	/* Ensure hash is set prior to potential SW encryption */
 	skb_get_hash(skb);
@@ -174,6 +200,16 @@ u16 ieee80211_select_queue(struct ieee80
 		goto downgrade;
 	}
 
+	/* A stream priority overrides the received one of a forwarded frame */
+	if (sta &&
+	    (sdata->vif.type == NL80211_IFTYPE_AP ||
+	     sdata->vif.type == NL80211_IFTYPE_AP_VLAN) &&
+	    ieee80211_flow_classify(sta, skb)) {
+		if (ctrl_flags)
+			*ctrl_flags |= IEEE80211_TX_CTRL_STREAM_CLASSIFIED;
+		goto downgrade;
+	}
+
 	/* use the data classifier to determine what 802.1d tag the
 	 * data frame has */
 	qos_map = rcu_dereference(sdata->qos_map);
@@ -181,7 +217,11 @@ u16 ieee80211_select_queue(struct ieee80
 					       &qos_map->qos_map : NULL);
 
  downgrade:
-	return ieee80211_downgrade_queue(sdata, sta, skb);
+	ac = ieee80211_downgrade_queue(sdata, sta, skb);
+	if (ctrl_flags && !ieee80211_prio_follows_dscp(skb))
+		*ctrl_flags |= IEEE80211_TX_CTRL_EXPLICIT_UP;
+
+	return ac;
 }
 
 /**
--- a/net/mac80211/wme.h
+++ b/net/mac80211/wme.h
@@ -14,7 +14,8 @@ u16 ieee80211_select_queue_80211(struct
 				 struct sk_buff *skb,
 				 struct ieee80211_hdr *hdr);
 u16 ieee80211_select_queue(struct ieee80211_sub_if_data *sdata,
-			   struct sta_info *sta, struct sk_buff *skb);
+			   struct sta_info *sta, struct sk_buff *skb,
+			   u32 *ctrl_flags);
 void ieee80211_set_qos_hdr(struct ieee80211_sub_if_data *sdata,
 			   struct sk_buff *skb);
 
