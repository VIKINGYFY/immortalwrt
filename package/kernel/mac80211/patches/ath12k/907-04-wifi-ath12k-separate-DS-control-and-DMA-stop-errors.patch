From: ViKing <viking.yfy@qq.com>
Subject: [PATCH] wifi: ath12k: separate DS control and DMA stop errors

Check peer routing submissions without skipping hardware draining.
Report control failures independently of proven DMA quiescence.
On unsafe DMA, detach all shared-engine callbacks before freeing
parents, retain DMA and bank/VP leases, and drop software VIF/dev
references so teardown cannot wait forever on the quarantine.

Signed-off-by: ViKing <viking.yfy@qq.com>
---
--- a/drivers/net/wireless/ath/ath12k/dp.c
+++ b/drivers/net/wireless/ath/ath12k/dp.c
@@ -1168,10 +1168,10 @@
 	struct ath12k_dp *dp = ath12k_ab_to_dp(ab);
 	int i;
 
-	if (dp->ds_quarantined)
-		return;
 	if (dp->ops->ds_cleanup && dp->ops->ds_cleanup(dp))
 		return;
+	if (dp->ds_quarantined)
+		return;
 
 	ath12k_dp_link_peer_rhash_tbl_destroy(dp);
 
@@ -1657,9 +1657,30 @@
 	return ret;
 }
 
+void ath12k_dp_ds_quarantine_group(struct ath12k_hw_group *ag)
+{
+	struct ath12k_dp *dp;
+	int i;
+
+	if (!ag)
+		return;
+	/* Every partner's RX pool can be referenced by the shared engine. */
+	set_bit(ATH12K_GROUP_FLAG_DS_QUARANTINED, &ag->flags);
+	for (i = 0; i < ATH12K_MAX_DEVICES; i++) {
+		dp = ag->dp_hw_grp.dp[i];
+		if (!dp)
+			continue;
+		dp->ds_quarantined = true;
+		if (dp->ops->ds_quarantine)
+			dp->ops->ds_quarantine(dp);
+	}
+}
+EXPORT_SYMBOL_GPL(ath12k_dp_ds_quarantine_group);
+
 int ath12k_dp_ds_stop_group(struct ath12k_hw_group *ag)
 {
 	struct ath12k_dp *dp;
+	bool dma_failed = false;
 	int i, ret = 0, err;
 
 	if (!ag)
@@ -1669,18 +1690,15 @@
 		if (!dp || !dp->ds || !dp->ops->ds_stop)
 			continue;
 		err = dp->ops->ds_stop(dp);
-		if (err)
+		if (!err)
+			continue;
+		if (!ret)
 			ret = err;
+		if (!dp->ops->ds_dma_stopped || !dp->ops->ds_dma_stopped(dp))
+			dma_failed = true;
 	}
-	if (!ret)
-		return 0;
-	/* A shared engine can still reach every partner's RX pool. Hold all
-	 * mappings in the group, rather than only the failing WLAN's rings.
-	 */
-	set_bit(ATH12K_GROUP_FLAG_DS_QUARANTINED, &ag->flags);
-	for (i = 0; i < ATH12K_MAX_DEVICES; i++)
-		if (ag->dp_hw_grp.dp[i])
-			ag->dp_hw_grp.dp[i]->ds_quarantined = true;
+	if (dma_failed)
+		ath12k_dp_ds_quarantine_group(ag);
 	return ret;
 }
 
