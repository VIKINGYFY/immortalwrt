 	.ds_stop = ath12k_wifi7_ds_stop,
+	.ds_dma_stopped = ath12k_wifi7_ds_dma_stopped,
+	.ds_quarantine = ath12k_wifi7_ds_quarantine,
 	.ds_peer_setup = ath12k_wifi7_ds_peer_setup,
 	.ds_sta_state = ath12k_wifi7_ds_sta_state,
 	.ds_vif_remove = ath12k_wifi7_ds_vif_remove,
@@ -205,7 +207,13 @@
 void ath12k_wifi7_dp_device_free(struct ath12k_dp *dp)
 {
 	/* An unquiesced DMA client retains its descriptor and buffer context. */
-	if (dp->ds || dp->ds_quarantined)
+	if (dp->ds || dp->ds_quarantined) {
+		/* Quarantine has detached callbacks and released software owners.
+		 * These are inert DMA allocations, not a retained parent lifetime.
+		 */
+		dp->ab = NULL;
+		dp->hal = NULL;
 		return;
+	}
 	kfree(dp);
 }
