 }
 
+bool ath12k_wifi7_ds_dma_stopped(struct ath12k_dp *dp)
+{
+	struct ath12k_ds *ds = READ_ONCE(dp->ds);
+
+	return !ds || READ_ONCE(ds->stopped);
+}
+
+void ath12k_wifi7_ds_quarantine(struct ath12k_dp *dp)
+{
+	struct ath12k_ds *ds = READ_ONCE(dp->ds);
+
+	if (!ds)
+		return;
+	mutex_lock(&ds->control_lock);
+	if (ds->handle)
+		qcom_ppe_ds_detach(ds->handle);
+	WRITE_ONCE(ds->faulted, true);
+	WRITE_ONCE(ds->quarantined, true);
+	mutex_unlock(&ds->control_lock);
+}
+
 int ath12k_wifi7_ds_cleanup(struct ath12k_dp *dp)
 {
 	struct ath12k_ds *ds = dp->ds;
@@ -1284,10 +1351,16 @@
 	cancel_work_sync(&ds->fault_work);
 	debugfs_remove(ds->debugfs);
 	ds->debugfs = NULL;
+	if (ds->quarantined)
+		goto quarantine;
 	if (ds->handle) {
 		ret = qcom_ppe_ds_unregister(ds->handle);
-		if (ret)
-			return ret;
+		if (ret) {
+			ath12k_dp_ds_quarantine_group(dp->ab->ag);
+			ath12k_wifi7_ds_quarantine(dp);
+			dp->ds_quarantined = true;
+			goto quarantine;
+		}
 		ds->handle = NULL;
 	}
 	WRITE_ONCE(ds->stopped, true);
@@ -1315,6 +1388,20 @@
 	dp->ds = NULL;
 	kfree(ds);
 	return 0;
+quarantine:
+	list_for_each_entry_safe(peer, tmp, &ds->peers, list) {
+		list_del(&peer->list);
+		dev_put(peer->dev);
+		kfree(peer);
+	}
+	for (i = 0; i < ATH12K_DS_VP_COUNT; i++) {
+		if (ds->vps[i].dev)
+			dev_put(ds->vps[i].dev);
+		ds->vps[i].dev = NULL;
+		ds->vps[i].vif = NULL;
+	}
+	ds->dp = NULL;
+	return -EIO;
 }
 
