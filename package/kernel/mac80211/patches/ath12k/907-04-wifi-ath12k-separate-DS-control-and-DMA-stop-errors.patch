+	}
 	for (i = 0; i < ATH12K_DS_VP_COUNT; i++)
-		if (ds->vps[i].dev)
-			qcom_ppe_ds_vp_route(ds->handle, ds->vps[i].port, false);
+		if (ds->vps[i].dev) {
+			err = qcom_ppe_ds_vp_route(ds->handle, ds->vps[i].port, false);
+			if (err)
