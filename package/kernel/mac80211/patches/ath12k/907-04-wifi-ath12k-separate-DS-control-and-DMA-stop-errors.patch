+static int ath12k_ds_peer_disable(struct ath12k_ds_peer *peer)
+{
+	int ret;
+
+	if (!peer->enabled ||
+	    test_bit(ATH12K_FLAG_CRASH_FLUSH, &peer->ar->ab->dev_flags))
+		return 0;
+	ret = ath12k_wmi_config_peer_ds(peer->ar, peer->addr, peer->vdev, 0, false);
+	if (!ret)
+		WRITE_ONCE(peer->enabled, false);
+	return ret;
+}
+
 static int ath12k_ds_peer_cpu(struct ath12k_ds *ds,
 			      struct ath12k_ds_peer *peer)
 {
-	int ret, error = 0;
+	int ret, error;
 
-	/* Repoint the VP before revoking its firmware peer route. */
 	ret = ath12k_ds_route_vif(ds, peer->vif, false);
-	if (peer->enabled) {
-		if (!test_bit(ATH12K_FLAG_CRASH_FLUSH, &peer->ar->ab->dev_flags))
-			error = ath12k_wmi_config_peer_ds(peer->ar, peer->addr,
-							peer->vdev, 0, false);
-		if (error) {
-			ath12k_ds_fault(ds);
-			if (!ret)
-				ret = error;
-		}
-		WRITE_ONCE(peer->enabled, false);
+	error = ath12k_ds_peer_disable(peer);
+	if (error) {
+		ath12k_ds_fault(ds);
+		if (!ret)
+			ret = error;
 	}
 	return ret;
 }
