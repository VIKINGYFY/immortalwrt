From: JiaY-shi <shi05275@163.com>
Date: Sun, 2 Aug 2026 13:30:00 +0800
Subject: [PATCH] wifi: ath12k: honor firmware ML peer ID limit

The valid ML peer ID range is platform dependent and is reported by
firmware in the MLO setup complete event.  The upstream driver ignores
this field and allocates IDs from the compile-time maximum, starting at
zero.  Current Qualcomm firmware reserves ID zero and expects the host to
stay inside the advertised range.  Sending an invalid ID can leave the
cross-chip peer mapping inconsistent.

Decode and validate the firmware limit, log the negotiated value, and
allocate non-zero IDs within that range.  A mixed-device group uses the
smallest limit reported by any partner.  Extend the host bitmap to the
1024 IDs supported by current Qualcomm platforms so IPQ5332 firmware
advertising 512 IDs is not needlessly capped.  Keep the previous 256-ID
limit as a conservative fallback for legacy or malformed events.

Initialize the group accumulator to the host capacity so valid 512-ID
firmware reports are preserved.  Legacy events without the extended field
still reduce the group to the conservative 256-ID fallback.

Signed-off-by: JiaY-shi <shi05275@163.com>
---
 drivers/net/wireless/ath/ath12k/core.h |  4 +++-
 drivers/net/wireless/ath/ath12k/mac.c  |  1 +
 drivers/net/wireless/ath/ath12k/peer.c | 23 ++++++++++++++---------
 drivers/net/wireless/ath/ath12k/wmi.c  | 59 ++++++++++++++++++++++++++----
 4 files changed, 72 insertions(+), 15 deletions(-)

--- a/drivers/net/wireless/ath/ath12k/core.h
+++ b/drivers/net/wireless/ath/ath12k/core.h
@@ -70,7 +70,8 @@
 #define ATH12K_INVALID_GROUP_ID  0xFF
 #define ATH12K_INVALID_DEVICE_ID 0xFF
 
-#define ATH12K_MAX_MLO_PEERS            256
+#define ATH12K_MAX_MLO_PEERS            1024
+#define ATH12K_DEFAULT_MAX_MLO_PEER_IDS 256
 #define ATH12K_MLO_PEER_ID_INVALID      0xFFFF
 #define ATH12K_MLO_PEER_ID_PENDING      0xFFFE
 
@@ -801,6 +802,8 @@ struct ath12k_hw {
 	u8 num_radio;
 
 	DECLARE_BITMAP(free_ml_peer_id_map, ATH12K_MAX_MLO_PEERS);
+	u16 max_ml_peer_ids;
+	u16 last_ml_peer_id;
 
 	struct ath12k_dp_hw dp_hw;
 
--- a/drivers/net/wireless/ath/ath12k/mac.c
+++ b/drivers/net/wireless/ath/ath12k/mac.c
@@ -15434,6 +15434,7 @@ static struct ath12k_hw *ath12k_mac_hw_a
 	ah = ath12k_hw_to_ah(hw);
 	ah->hw = hw;
 	ah->num_radio = num_pdev_map;
+	ah->max_ml_peer_ids = ATH12K_MAX_MLO_PEERS;
 
 	mutex_init(&ah->hw_mutex);
 	init_completion(&ah->peer_ml_id_done);
--- a/drivers/net/wireless/ath/ath12k/peer.c
+++ b/drivers/net/wireless/ath/ath12k/peer.c
@@ -339,22 +339,27 @@ int ath12k_peer_create(struct ath12k *ar
 
 u16 ath12k_peer_ml_alloc(struct ath12k_hw *ah)
 {
-	u16 ml_peer_id;
+	u16 ml_peer_id = ah->last_ml_peer_id;
+	int i;
 
 	lockdep_assert_wiphy(ah->hw->wiphy);
 
-	for (ml_peer_id = 0; ml_peer_id < ATH12K_MAX_MLO_PEERS; ml_peer_id++) {
+	for (i = 0; i < ah->max_ml_peer_ids; i++) {
+		ml_peer_id = (ml_peer_id + 1) % ah->max_ml_peer_ids;
+
+		/* ML peer ID zero is reserved by current firmware. */
+		if (!ml_peer_id)
+			continue;
+
 		if (test_bit(ml_peer_id, ah->free_ml_peer_id_map))
 			continue;
 
 		set_bit(ml_peer_id, ah->free_ml_peer_id_map);
-		break;
+		ah->last_ml_peer_id = ml_peer_id;
+		return ml_peer_id | ATH12K_PEER_ML_ID_VALID;
 	}
 
-	if (ml_peer_id == ATH12K_MAX_MLO_PEERS)
-		return ATH12K_MLO_PEER_ID_INVALID;
-
-	return ml_peer_id | ATH12K_PEER_ML_ID_VALID;
+	return ATH12K_MLO_PEER_ID_INVALID;
 }
 
 void ath12k_peer_ml_free(struct ath12k_hw *ah, struct ath12k_sta *ahsta)
--- a/drivers/net/wireless/ath/ath12k/wmi.c
+++ b/drivers/net/wireless/ath/ath12k/wmi.c
@@ -9603,24 +9603,51 @@ static void ath12k_wmi_gtk_offload_statu
 	rcu_read_unlock();
 }
 
+struct ath12k_wmi_mlo_setup_complete_event_v2 {
+	struct wmi_mlo_setup_complete_event base;
+	__le32 max_ml_peer_ids;
+} __packed;
+
+struct ath12k_wmi_mlo_setup_complete_parse {
+	const struct wmi_mlo_setup_complete_event *ev;
+	u16 len;
+};
+
+static int
+ath12k_wmi_mlo_setup_complete_parse(struct ath12k_base *ab, u16 tag, u16 len,
+				    const void *ptr, void *data)
+{
+	struct ath12k_wmi_mlo_setup_complete_parse *parse = data;
+
+	if (tag == WMI_TAG_MLO_SETUP_COMPLETE_EVENT) {
+		parse->ev = ptr;
+		parse->len = len;
+	}
+
+	return 0;
+}
+
 static void ath12k_wmi_event_mlo_setup_complete(struct ath12k_base *ab,
 						struct sk_buff *skb)
 {
 	const struct wmi_mlo_setup_complete_event *ev;
+	const struct ath12k_wmi_mlo_setup_complete_event_v2 *ev_v2;
+	struct ath12k_wmi_mlo_setup_complete_parse parse = {};
 	struct ath12k *ar = NULL;
 	struct ath12k_pdev *pdev;
-	const void **tb;
+	u32 max_ml_peer_ids;
 	int ret, i;
 
-	tb = ath12k_wmi_tlv_parse(ab, skb);
-	if (IS_ERR(tb)) {
-		ret = PTR_ERR(tb);
+	ret = ath12k_wmi_tlv_iter(ab, skb->data, skb->len,
+				  ath12k_wmi_mlo_setup_complete_parse,
+				  &parse);
+	if (ret) {
 		ath12k_warn(ab, "failed to parse mlo setup complete event tlv: %d\n",
 			    ret);
 		return;
 	}
 
-	ev = tb[WMI_TAG_MLO_SETUP_COMPLETE_EVENT];
+	ev = parse.ev;
 	if (!ev) {
 		ath12k_warn(ab, "failed to fetch mlo setup complete event\n");
 		return;
@@ -9645,6 +9672,28 @@ skip_lookup:
 	}
 
 	ar->mlo_setup_status = le32_to_cpu(ev->status);
+	max_ml_peer_ids = ATH12K_DEFAULT_MAX_MLO_PEER_IDS;
+	if (parse.len >= sizeof(*ev_v2)) {
+		ev_v2 = (const void *)ev;
+		max_ml_peer_ids = le32_to_cpu(ev_v2->max_ml_peer_ids);
+		if (max_ml_peer_ids < 2) {
+			ath12k_warn(ab, "invalid ML peer ID limit %u, using legacy limit %u\n",
+				    max_ml_peer_ids,
+				    ATH12K_DEFAULT_MAX_MLO_PEER_IDS);
+			max_ml_peer_ids = ATH12K_DEFAULT_MAX_MLO_PEER_IDS;
+		} else if (max_ml_peer_ids > ATH12K_MAX_MLO_PEERS) {
+			ath12k_warn(ab, "firmware ML peer ID limit %u exceeds host capacity %u, capping\n",
+				    max_ml_peer_ids, ATH12K_MAX_MLO_PEERS);
+			max_ml_peer_ids = ATH12K_MAX_MLO_PEERS;
+		}
+	}
+
+	ar->ah->max_ml_peer_ids = min_t(u16, ar->ah->max_ml_peer_ids,
+					max_ml_peer_ids);
+	if (ar->ah->last_ml_peer_id >= ar->ah->max_ml_peer_ids)
+		ar->ah->last_ml_peer_id = 0;
+	ath12k_info(ab, "firmware supports %u ML peer IDs, group limit %u\n",
+		    max_ml_peer_ids, ar->ah->max_ml_peer_ids);
 	complete(&ar->mlo_setup_done);
 }
 
