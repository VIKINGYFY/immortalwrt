From: ViKing <viking.yfy@qq.com>
Date: Tue, 24 Nov 2026 20:46:05 +0800
Subject: [PATCH] wifi: ath12k: keep AP VLAN peers on the host path

PPE Direct Switch delivers through the parent AP virtual port. The
software path must select the AP VLAN associated with the station.
Switch a station entering an AP VLAN to the host path, withdrawing
its Direct Switch route before mac80211 publishes the new interface.
Keep it on the host path for its peer lifetime and retain Direct Switch
for APs without AP VLAN peers. Recover the VLAN type when a peer is
created or reconstructed after a firmware restart.

Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/drivers/net/wireless/ath/ath12k/core.h
+++ b/drivers/net/wireless/ath/ath12k/core.h
@@ -543,6 +543,7 @@ struct ath12k_sta {
 	enum ieee80211_sta_state state;
 
 	bool enable_4addr;
+	bool ap_vlan;
 };
 
 #define ATH12K_HALF_20MHZ_BW	10
--- a/drivers/net/wireless/ath/ath12k/mac.c
+++ b/drivers/net/wireless/ath/ath12k/mac.c
@@ -7949,6 +7949,7 @@ int ath12k_mac_op_sta_state(struct ieee8
 	if (old_state == IEEE80211_STA_NOTEXIST &&
 	    new_state == IEEE80211_STA_NONE) {
 		memset(ahsta, 0, sizeof(*ahsta));
+		ahsta->ap_vlan = ieee80211_sta_uses_ap_vlan(sta);
 		ahsta->free_logical_link_idx_map = U16_MAX;
 
 		arsta = &ahsta->deflink;
@@ -8172,32 +8173,17 @@ out:
 }
 EXPORT_SYMBOL(ath12k_mac_op_sta_set_txpwr);
 
-void ath12k_mac_op_sta_set_4addr(struct ieee80211_hw *hw,
-				 struct ieee80211_vif *vif,
-				 struct ieee80211_sta *sta, bool enabled)
+static int ath12k_mac_update_sta_ds(struct ieee80211_hw *hw,
+				   struct ath12k_sta *ahsta)
 {
-	struct ath12k_sta *ahsta = ath12k_sta_to_ahsta(sta);
 	struct ath12k_link_sta *arsta;
 	struct ath12k_link_vif *arvif;
 	struct ath12k_dp *dp;
 	unsigned long links;
-	int link_id, ret;
+	int link_id, ret, error = 0;
 
 	lockdep_assert_wiphy(hw->wiphy);
 
-	/*
-	 * 4-address mode disabled option is available only for station
-	 * interface from mac80211, and we have wds_vdev_param for station
-	 * interface and target will not allow to disable the wds_vdev_param
-	 * during run time. So, add support only for enable case, for
-	 * disable case station interface needs to be reconnect.
-	 */
-	if (!enabled || ahsta->enable_4addr ||
-	    ath12k_mac_sta_set_4addr(hw->wiphy, ahsta))
-		return;
-
-	ahsta->enable_4addr = true;
-	/* Authorization may already have submitted a parent-AP DS route. */
 	links = ahsta->links_map;
 	for_each_set_bit(link_id, &links, IEEE80211_MLD_MAX_NUM_LINKS) {
 		arsta = wiphy_dereference(hw->wiphy, ahsta->link[link_id]);
@@ -8208,13 +8194,53 @@ void ath12k_mac_op_sta_set_4addr(struct
 		if (!dp->ops->ds_peer_setup)
 			continue;
 		ret = dp->ops->ds_peer_setup(arvif->ar, arvif, arsta);
-		if (ret)
+		if (ret) {
 			ath12k_warn(arvif->ar->ab,
-				    "failed to withdraw 4addr Direct Switch route: %d\n", ret);
+				    "failed to withdraw Direct Switch route: %d\n", ret);
+			if (!error)
+				error = ret;
+		}
 	}
+
+	return error;
+}
+
+void ath12k_mac_op_sta_set_4addr(struct ieee80211_hw *hw,
+				 struct ieee80211_vif *vif,
+				 struct ieee80211_sta *sta, bool enabled)
+{
+	struct ath12k_sta *ahsta = ath12k_sta_to_ahsta(sta);
+
+	lockdep_assert_wiphy(hw->wiphy);
+
+	/*
+	 * 4-address mode disabled option is available only for station
+	 * interface from mac80211, and we have wds_vdev_param for station
+	 * interface and target will not allow to disable the wds_vdev_param
+	 * during run time. So, add support only for enable case, for
+	 * disable case station interface needs to be reconnect.
+	 */
+	if (!enabled || ahsta->enable_4addr ||
+	    ath12k_mac_sta_set_4addr(hw->wiphy, ahsta))
+		return;
+
+	ahsta->enable_4addr = true;
+	ath12k_mac_update_sta_ds(hw, ahsta);
 }
 EXPORT_SYMBOL(ath12k_mac_op_sta_set_4addr);
 
+int ath12k_mac_op_sta_prepare_ap_vlan(struct ieee80211_hw *hw,
+				     struct ieee80211_vif *vif,
+				     struct ieee80211_sta *sta)
+{
+	struct ath12k_sta *ahsta = ath12k_sta_to_ahsta(sta);
+
+	/* Keep this peer on the VLAN-aware path until its lifetime ends. */
+	ahsta->ap_vlan = true;
+	return ath12k_mac_update_sta_ds(hw, ahsta);
+}
+EXPORT_SYMBOL(ath12k_mac_op_sta_prepare_ap_vlan);
+
 void ath12k_mac_op_link_sta_rc_update(struct ieee80211_hw *hw,
 				      struct ieee80211_vif *vif,
 				      struct ieee80211_link_sta *link_sta,
--- a/drivers/net/wireless/ath/ath12k/mac.h
+++ b/drivers/net/wireless/ath/ath12k/mac.h
@@ -255,6 +255,9 @@ int ath12k_mac_op_sta_state(struct ieee8
 int ath12k_mac_op_sta_set_txpwr(struct ieee80211_hw *hw,
 				struct ieee80211_vif *vif,
 				struct ieee80211_sta *sta);
+int ath12k_mac_op_sta_prepare_ap_vlan(struct ieee80211_hw *hw,
+				     struct ieee80211_vif *vif,
+				     struct ieee80211_sta *sta);
 void ath12k_mac_op_sta_set_4addr(struct ieee80211_hw *hw,
 				 struct ieee80211_vif *vif,
 				 struct ieee80211_sta *sta, bool enabled);
--- a/drivers/net/wireless/ath/ath12k/wifi7/hw.c
+++ b/drivers/net/wireless/ath/ath12k/wifi7/hw.c
@@ -1190,6 +1190,7 @@ static const struct ieee80211_ops ath12k
 	.sta_set_txpwr			= ath12k_mac_op_sta_set_txpwr,
 	.link_sta_rc_update		= ath12k_mac_op_link_sta_rc_update,
 	.sta_set_4addr                  = ath12k_mac_op_sta_set_4addr,
+	.sta_prepare_ap_vlan            = ath12k_mac_op_sta_prepare_ap_vlan,
 	.conf_tx                        = ath12k_mac_op_conf_tx,
 	.set_antenna			= ath12k_mac_op_set_antenna,
 	.get_antenna			= ath12k_mac_op_get_antenna,
--- a/drivers/net/wireless/ath/ath12k/wifi7/ppe_ds.c
+++ b/drivers/net/wireless/ath/ath12k/wifi7/ppe_ds.c
@@ -57,11 +57,12 @@ enum ath12k_ds_fallback {
 	ATH12K_DS_FALLBACK_MLO,
 	ATH12K_DS_FALLBACK_4ADDR,
 	ATH12K_DS_FALLBACK_CONTROL,
+	ATH12K_DS_FALLBACK_AP_VLAN,
 	ATH12K_DS_FALLBACK_MAX,
 };
 
 static const char * const ath12k_ds_fallback_names[] = {
-	"none", "unsupported-mlo", "four-address", "control-submit",
+	"none", "unsupported-mlo", "four-address", "control-submit", "ap-vlan",
 };
 
 struct ath12k_ds_buffer {
@@ -1121,6 +1122,7 @@ static int ath12k_ds_peer_update(struct
 	lockdep_assert_wiphy(ar->ah->hw->wiphy);
 	fallback = sta->mlo ? ATH12K_DS_FALLBACK_MLO :
 		   ahsta->enable_4addr ? ATH12K_DS_FALLBACK_4ADDR :
+		   ahsta->ap_vlan ? ATH12K_DS_FALLBACK_AP_VLAN :
 		   ATH12K_DS_FALLBACK_NONE;
 	mutex_lock(&ds->control_lock);
 	if (ds->stopped || ds->faulted)
@@ -1130,10 +1132,9 @@ static int ath12k_ds_peer_update(struct
 		    peer->vdev == arvif->vdev_id &&
 		    ether_addr_equal(peer->addr, arsta->addr)) {
 			peer->authorized |= authorized;
-			/* A four-address peer moves to an AP_VLAN after association.
-			 * Native DS owns only the parent AP netdevice and cannot
-			 * preserve that VLAN or learn the bridged source addresses.
-			 * Return the whole VAP to CPU before withdrawing its route.
+			/* Native DS delivers through the parent AP netdevice.
+			 * Return the VAP to CPU before withdrawing a peer route
+			 * which cannot preserve its VLAN or four-address state.
 			 */
 			if (peer->fallback != fallback && fallback)
 				ds->fallback_events[fallback]++;
@@ -1213,7 +1214,8 @@ unlock:
 int ath12k_wifi7_ds_peer_setup(struct ath12k *ar, struct ath12k_link_vif *arvif,
 			       struct ath12k_link_sta *arsta)
 {
-	if (!ath12k_wifi7_ds_hw1_compat(ar->ab) && !arsta->ahsta->enable_4addr)
+	if (!ath12k_wifi7_ds_hw1_compat(ar->ab) &&
+	    !arsta->ahsta->enable_4addr && !arsta->ahsta->ap_vlan)
 		return 0;
 	return ath12k_ds_peer_update(ar, arvif, arsta, false);
 }
