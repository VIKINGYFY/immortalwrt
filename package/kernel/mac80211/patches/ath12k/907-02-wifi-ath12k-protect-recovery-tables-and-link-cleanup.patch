From: ViKing <viking.yfy@qq.com>
Subject: [PATCH] wifi: ath12k: protect recovery tables and uncreated link cleanup

Publish and detach peer and station tables under the locks held by their
users, freeing detached tables outside the spinlocks. Initialize shared
DP locks once at allocation and treat detached tables as empty. Keep
crash-flush set after any failed recovery, and skip radio-dependent work
for uncreated scan links and ML stations without a radio.

Based on Timofey Maykov's 311, 312, 314 and 315 patches at 162478370a9b.
Retain the local ML peer quarantine and CE/WMI recovery barriers.

[viking.yfy@qq.com: complete imported patch metadata]
Signed-off-by: ViKing <viking.yfy@qq.com>
---
--- a/drivers/net/wireless/ath/ath12k/core.c
+++ b/drivers/net/wireless/ath/ath12k/core.c
@@ -1729,6 +1729,10 @@
 	ret = ath12k_core_reconfigure_on_crash(ab);
 	if (ret) {
 		ath12k_err(ab, "failed to reconfigure driver on crash recovery\n");
+		/* The rings are half torn down, keep WMI and data from
+		 * reaching them until the next reset.
+		 */
+		set_bit(ATH12K_FLAG_CRASH_FLUSH, &ab->dev_flags);
 		return;
 	}
 
--- a/drivers/net/wireless/ath/ath12k/dp.c
+++ b/drivers/net/wireless/ath/ath12k/dp.c
@@ -1538,10 +1538,13 @@
 	spin_lock_init(&dp->reo_cmd_lock);
 	spin_lock_init(&dp->reo_rxq_flush_lock);
 
-	spin_lock_init(&dp->dp_lock);
+	/* dp_lock and link_peer_rhash_tbl_lock are set up once when dp is
+	 * allocated. This runs again on firmware recovery while mac80211
+	 * callbacks may hold them.
+	 */
+	spin_lock_bh(&dp->dp_lock);
 	INIT_LIST_HEAD(&dp->peers);
-
-	mutex_init(&dp->link_peer_rhash_tbl_lock);
+	spin_unlock_bh(&dp->dp_lock);
 
 	dp->reo_cmd_cache_flush_count = 0;
 	dp->idle_link_rbm =
--- a/drivers/net/wireless/ath/ath12k/dp_peer.c
+++ b/drivers/net/wireless/ath/ath12k/dp_peer.c
@@ -62,6 +62,10 @@
 {
 	lockdep_assert_held(&dp->dp_lock);
 
+	/* NULL while firmware recovery rebuilds the datapath */
+	if (!dp->rhead_peer_addr)
+		return NULL;
+
 	return rhashtable_lookup_fast(dp->rhead_peer_addr, addr,
 				      dp->rhash_peer_addr_param);
 }
@@ -251,7 +255,9 @@
 		goto err_free;
 	}
 
+	spin_lock_bh(&dp->dp_lock);
 	dp->rhead_peer_addr = rhash_addr_tbl;
+	spin_unlock_bh(&dp->dp_lock);
 
 	return 0;
 
@@ -274,14 +280,23 @@
 
 void ath12k_dp_link_peer_rhash_tbl_destroy(struct ath12k_dp *dp)
 {
+	struct rhashtable *tbl;
+
 	guard(mutex)(&dp->link_peer_rhash_tbl_lock);
 
-	if (!dp->rhead_peer_addr)
+	/* Readers use the table only under dp_lock, so once the pointer is
+	 * cleared under it nobody can still be inside the old table.
+	 */
+	spin_lock_bh(&dp->dp_lock);
+	tbl = dp->rhead_peer_addr;
+	dp->rhead_peer_addr = NULL;
+	spin_unlock_bh(&dp->dp_lock);
+
+	if (!tbl)
 		return;
 
-	rhashtable_destroy(dp->rhead_peer_addr);
-	kfree(dp->rhead_peer_addr);
-	dp->rhead_peer_addr = NULL;
+	rhashtable_destroy(tbl);
+	kfree(tbl);
 }
 
 static int ath12k_dp_link_peer_rhash_insert(struct ath12k_dp *dp,
@@ -291,6 +306,9 @@
 
 	lockdep_assert_held(&dp->dp_lock);
 
+	if (!dp->rhead_peer_addr)
+		return -ENODEV;
+
 	tmp = rhashtable_lookup_get_insert_fast(dp->rhead_peer_addr, &peer->rhash_addr,
 						dp->rhash_peer_addr_param);
 	if (!tmp)
@@ -308,6 +326,9 @@
 
 	lockdep_assert_held(&dp->dp_lock);
 
+	if (!dp->rhead_peer_addr)
+		return 0;
+
 	ret = rhashtable_remove_fast(dp->rhead_peer_addr, &peer->rhash_addr,
 				     dp->rhash_peer_addr_param);
 	if (ret && ret != -ENOENT)
--- a/drivers/net/wireless/ath/ath12k/mac.c
+++ b/drivers/net/wireless/ath/ath12k/mac.c
@@ -5900,7 +5900,7 @@
 		links_map = ahvif->links_map;
 		for_each_set_bit(link_id, &links_map, ATH12K_NUM_MAX_LINKS) {
 			arvif = wiphy_dereference(hw->wiphy, ahvif->link[link_id]);
-			if (!arvif)
+			if (!arvif || !arvif->is_created)
 				continue;
 
 			ar = arvif->ar;
@@ -7393,7 +7393,7 @@
 	bool is_recovery = false;
 	unsigned long links;
 	struct ath12k *ar;
-	int ret;
+	int i, ret;
 	u8 link_id;
 
 	lockdep_assert_wiphy(ah->hw->wiphy);
@@ -7417,16 +7417,27 @@
 	for_each_set_bit(link_id, &links, IEEE80211_MLD_MAX_NUM_LINKS) {
 		arvif = wiphy_dereference(ah->hw->wiphy, ahvif->link[link_id]);
 		arsta = wiphy_dereference(ah->hw->wiphy, ahsta->link[link_id]);
-		if (!arvif || !arsta)
+		if (!arsta)
 			continue;
 
-		ar = arvif->ar;
-
-		ath12k_mac_station_post_remove(ar, arvif, arsta);
-
-		spin_lock_bh(&ar->ab->base_lock);
-		ath12k_link_sta_rhash_delete(ar->ab, arsta);
-		spin_unlock_bh(&ar->ab->base_lock);
+		ar = arvif ? arvif->ar : NULL;
+		if (ar) {
+			ath12k_mac_station_post_remove(ar, arvif, arsta);
+
+			spin_lock_bh(&ar->ab->base_lock);
+			ath12k_link_sta_rhash_delete(ar->ab, arsta);
+			spin_unlock_bh(&ar->ab->base_lock);
+		} else {
+			/* A failed vdev creation can leave the station listed
+			 * on a radio even though its link has no radio. Unlink
+			 * it from every table before freeing the station.
+			 */
+			for_each_ar(ah, ar, i) {
+				spin_lock_bh(&ar->ab->base_lock);
+				ath12k_link_sta_rhash_delete(ar->ab, arsta);
+				spin_unlock_bh(&ar->ab->base_lock);
+			}
+		}
 
 		ath12k_mac_free_unassign_link_sta(ah, ahsta, link_id);
 	}
--- a/drivers/net/wireless/ath/ath12k/peer.c
+++ b/drivers/net/wireless/ath/ath12k/peer.c
@@ -563,6 +563,9 @@
 
 	lockdep_assert_held(&ab->base_lock);
 
+	if (!ab->rhead_sta_addr)
+		return -ENODEV;
+
 	tmp = rhashtable_lookup_get_insert_fast(ab->rhead_sta_addr, &arsta->rhash_addr,
 						ab->rhash_sta_addr_param);
 	if (!tmp)
@@ -580,6 +583,9 @@
 
 	lockdep_assert_held(&ab->base_lock);
 
+	if (!ab->rhead_sta_addr)
+		return 0;
+
 	ret = rhashtable_remove_fast(ab->rhead_sta_addr, &arsta->rhash_addr,
 				     ab->rhash_sta_addr_param);
 	if (ret && ret != -ENOENT)
@@ -646,7 +652,9 @@
 		goto err_free;
 	}
 
+	spin_lock_bh(&ab->base_lock);
 	ab->rhead_sta_addr = rhash_addr_tbl;
+	spin_unlock_bh(&ab->base_lock);
 
 	return 0;
 
@@ -658,12 +666,19 @@
 
 void ath12k_link_sta_rhash_tbl_destroy(struct ath12k_base *ab)
 {
-	if (!ab->rhead_sta_addr)
-		return;
+	struct rhashtable *tbl;
 
-	rhashtable_destroy(ab->rhead_sta_addr);
-	kfree(ab->rhead_sta_addr);
+	/* Users hold base_lock, clear the pointer under it before freeing */
+	spin_lock_bh(&ab->base_lock);
+	tbl = ab->rhead_sta_addr;
 	ab->rhead_sta_addr = NULL;
+	spin_unlock_bh(&ab->base_lock);
+
+	if (!tbl)
+		return;
+
+	rhashtable_destroy(tbl);
+	kfree(tbl);
 }
 
 struct ath12k_link_sta *ath12k_link_sta_find_by_addr(struct ath12k_base *ab,
@@ -671,6 +686,10 @@
 {
 	lockdep_assert_held(&ab->base_lock);
 
+	/* NULL while firmware recovery rebuilds the driver state */
+	if (!ab->rhead_sta_addr)
+		return NULL;
+
 	return rhashtable_lookup_fast(ab->rhead_sta_addr, addr,
 				      ab->rhash_sta_addr_param);
 }
--- a/drivers/net/wireless/ath/ath12k/wifi7/dp.c
+++ b/drivers/net/wireless/ath/ath12k/wifi7/dp.c
@@ -194,6 +194,10 @@
 
 	dp->ops = &ath12k_wifi7_dp_arch_ops;
 
+	spin_lock_init(&dp->dp_lock);
+	INIT_LIST_HEAD(&dp->peers);
+	mutex_init(&dp->link_peer_rhash_tbl_lock);
+
 	return dp;
 }
 
