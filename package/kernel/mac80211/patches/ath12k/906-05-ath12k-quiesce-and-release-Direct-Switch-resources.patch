+void ath12k_dp_ds_quarantine_group(struct ath12k_hw_group *ag)
+{
+	struct ath12k_dp *dp;
+	int i;
+
+	if (!ag)
+		return;
+	/* Every partner's RX pool can be referenced by the shared engine. */
+	set_bit(ATH12K_GROUP_FLAG_DS_QUARANTINED, &ag->flags);
+	for (i = 0; i < ATH12K_MAX_DEVICES; i++) {
+		dp = ag->dp_hw_grp.dp[i];
+		if (!dp)
+			continue;
+		dp->ds_quarantined = true;
+		if (dp->ops->ds_quarantine)
+			dp->ops->ds_quarantine(dp);
+	}
+}
+EXPORT_SYMBOL_GPL(ath12k_dp_ds_quarantine_group);
+
+int ath12k_dp_ds_stop_group(struct ath12k_hw_group *ag)
+{
+	struct ath12k_dp *dp;
+	bool dma_failed = false;
+	int i, ret = 0, err;
+
+	if (!ag)
+		return 0;
+	for (i = 0; i < ATH12K_MAX_DEVICES; i++) {
+		dp = ag->dp_hw_grp.dp[i];
+		if (!dp || !dp->ds || !dp->ops->ds_stop)
+			continue;
+		err = dp->ops->ds_stop(dp);
+		if (!err)
+			continue;
+		if (!ret)
+			ret = err;
+		if (!dp->ops->ds_dma_stopped || !dp->ops->ds_dma_stopped(dp))
+			dma_failed = true;
+	}
+	if (dma_failed)
+		ath12k_dp_ds_quarantine_group(ag);
+	return ret;
+}
