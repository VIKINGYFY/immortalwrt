 void ath12k_wifi7_dp_device_free(struct ath12k_dp *dp)
 {
+	/* An unquiesced DMA client retains its descriptor and buffer context. */
+	if (dp->ds || dp->ds_quarantined) {
+		/* Quarantine has detached callbacks and released software owners.
+		 * These are inert DMA allocations, not a retained parent lifetime.
+		 */
+		dp->ab = NULL;
+		dp->hal = NULL;
+		return;
+	}
 	kfree(dp);
 }
