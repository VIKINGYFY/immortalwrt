+int ath12k_wifi7_ds_stop(struct ath12k_dp *dp)
+{
+	struct ath12k_ds *ds = READ_ONCE(dp->ds);
+	struct ath12k_ds_peer *peer;
+	int i, err, control_error = 0, ret = 0;
+
+	if (!ds)
+		return 0;
+	if (current_work() != &ds->fault_work)
+		cancel_work_sync(&ds->fault_work);
+	mutex_lock(&ds->control_lock);
+	if (ds->quarantined) {
+		ret = -ESHUTDOWN;
+		goto unlock;
+	}
+	if (ds->stopped) {
+		ret = ds->stop_control_error;
+		goto unlock;
+	}
+	for (i = 0; i < ATH12K_DS_VP_COUNT; i++)
+		if (ds->vps[i].reserved) {
+			err = qcom_ppe_ds_vp_route(ds->handle, ds->vps[i].port, false);
+			if (err)
+				ath12k_warn(dp->ab,
+					    "DS VP CPU route failed: %d; stop will retry\n", err);
+		}
+	list_for_each_entry(peer, &ds->peers, list) {
+		err = ath12k_ds_peer_disable(peer);
+		if (err && !control_error)
+			control_error = err;
+	}
+	ds->stop_control_error = control_error;
+	if (ds->reo_ready) {
+		ath12k_wifi7_hal_ds_disable(dp->ab, ath12k_ds_srng(ds, &ds->reo));
+		/* Observe the final DMA head writeback before EDMA drains. */
+		usleep_range(1000, 2000);
+		if (ds->handle)
+			qcom_ppe_ds_sync(ds->handle);
+	}
+	if (ds->handle)
+		ret = qcom_ppe_ds_stop(ds->handle);
+	if (ds->tcl_ready)
+		ath12k_wifi7_hal_ds_disable(dp->ab, ath12k_ds_srng(ds, &ds->tcl));
+	if (!ret)
+		WRITE_ONCE(ds->stopped, true);
+	if (!ret) {
+		for_each_set_bit(i, &ds->reo_mapped, ATH12K_MAX_DEVICES) {
+			struct ath12k_dp *partner = dp->ab->ag->dp_hw_grp.dp[i];
+			u32 reg = HAL_SEQ_WCSS_UMAC_REO_REG +
+				  HAL_REO1_DEST_RING_CTRL_IX_0;
+			u32 val;
+
+			if (!partner ||
+			    test_bit(ATH12K_FLAG_CRASH_FLUSH, &partner->ab->dev_flags))
+				continue;
+			val = ath12k_hif_read32(partner->ab, reg);
+			val = (val & ~GENMASK(27, 24)) | ds->reo_map[i];
+			ath12k_hif_write32(partner->ab, reg, val);
+		}
+		ds->reo_mapped = 0;
+	}
+	if (control_error) {
+		ath12k_warn(dp->ab, "DS CPU peer routing unconfirmed: %d\n", control_error);
+		if (!ret)
+			ret = control_error;
+	}
+unlock:
+	mutex_unlock(&ds->control_lock);
+	return ret;
+}
+
+bool ath12k_wifi7_ds_dma_stopped(struct ath12k_dp *dp)
+{
+	struct ath12k_ds *ds = READ_ONCE(dp->ds);
+
+	return !ds || READ_ONCE(ds->stopped);
+}
+
+void ath12k_wifi7_ds_quarantine(struct ath12k_dp *dp)
+{
+	struct ath12k_ds *ds = READ_ONCE(dp->ds);
+
+	if (!ds)
+		return;
+	mutex_lock(&ds->control_lock);
+	if (ds->handle)
+		qcom_ppe_ds_detach(ds->handle);
+	WRITE_ONCE(ds->faulted, true);
+	WRITE_ONCE(ds->quarantined, true);
+	mutex_unlock(&ds->control_lock);
+}
+
+int ath12k_wifi7_ds_cleanup(struct ath12k_dp *dp)
+{
+	struct ath12k_ds *ds = dp->ds;
+	struct ath12k_ds_peer *peer, *tmp;
+	int ret, i;
+
+	if (!ds)
+		return 0;
+	cancel_work_sync(&ds->fault_work);
+	debugfs_remove(ds->debugfs);
+	ds->debugfs = NULL;
+	if (ds->quarantined)
+		goto quarantine;
+	if (ds->handle) {
+		ret = qcom_ppe_ds_unregister(ds->handle);
+		if (ret) {
+			ath12k_dp_ds_quarantine_group(dp->ab->ag);
+			ath12k_wifi7_ds_quarantine(dp);
+			dp->ds_quarantined = true;
+			goto quarantine;
+		}
+		ds->handle = NULL;
+	}
+	WRITE_ONCE(ds->stopped, true);
+	list_for_each_entry_safe(peer, tmp, &ds->peers, list) {
+		list_del(&peer->list);
+		hash_del(&peer->hash);
+		dev_put(peer->dev);
+		kfree(peer);
+	}
+	for (i = 0; i < ATH12K_DS_VP_COUNT; i++) {
+		if (!ds->vps[i].reserved)
+			continue;
+		ath12k_dp_tx_put_bank_profile(dp, ds->vps[i].bank);
+		if (ds->vps[i].dev)
+			dev_put(ds->vps[i].dev);
+	}
+	/* The caller must already have synchronized WLAN IRQ/NAPI and stopped
+	 * WLAN DMA before releasing the shared rings and completion buffers.
+	 */
+	if (ds->complete_ready)
+		ath12k_dp_srng_cleanup(dp->ab, &ds->complete);
+	if (ds->reo_ready)
+		ath12k_dp_srng_cleanup(dp->ab, &ds->reo);
+	if (ds->tcl_ready)
+		ath12k_dp_srng_cleanup(dp->ab, &ds->tcl);
+	ath12k_ds_free_buffers(ds);
+	dp->ds = NULL;
+	kfree(ds);
+	return 0;
+quarantine:
+	list_for_each_entry_safe(peer, tmp, &ds->peers, list) {
+		list_del(&peer->list);
+		hash_del(&peer->hash);
+		dev_put(peer->dev);
+		kfree(peer);
+	}
+	for (i = 0; i < ATH12K_DS_VP_COUNT; i++) {
+		if (ds->vps[i].dev)
+			dev_put(ds->vps[i].dev);
+		ds->vps[i].dev = NULL;
+		ds->vps[i].vif = NULL;
+	}
+	ds->dp = NULL;
+	return -EIO;
+}
+
+int ath12k_wifi7_ds_setup(struct ath12k_dp *dp)
+{
+	struct qcom_ppe_ds_config config = {};
+	struct ath12k_ds *ds;
+	int ret, i;
+
+	if (!qcom_ppe_ds_available())
+		return 0;
+	if (dp->ab->hw_rev != ATH12K_HW_QCN9274_HW10 &&
+	    dp->ab->hw_rev != ATH12K_HW_QCN9274_HW20)
+		return 0;
+	/* Unknown HW1 firmware and raw RX keep the ordinary CPU datapath. */
+	if (dp->ab->hw_rev == ATH12K_HW_QCN9274_HW10 &&
+	    (!ath12k_wifi7_ds_hw1_compat(dp->ab) ||
+	     test_bit(ATH12K_FLAG_RAW_MODE, &dp->ab->dev_flags)))
+		return 0;
+
+	dp->ds_rx_bidir = true;
+	ds = kzalloc(sizeof(*ds), GFP_KERNEL);
+	if (!ds)
+		return -ENOMEM;
+	ds->dp = dp;
+	mutex_init(&ds->control_lock);
+	spin_lock_init(&ds->peer_lock);
+	INIT_LIST_HEAD(&ds->peers);
+	hash_init(ds->peer_vps);
+	ds->hw1_compat = ath12k_wifi7_ds_hw1_compat(dp->ab);
+	INIT_WORK(&ds->fault_work, ath12k_ds_fault_work);
+	spin_lock_init(&ds->tx_lock);
+	spin_lock_init(&ds->rx_lock);
+	INIT_LIST_HEAD(&ds->free_buffers);
+	for (i = 0; i < ATH12K_MAX_DEVICES; i++)
+		INIT_LIST_HEAD(&ds->pending_rx[i]);
+	dp->ds = ds;
+	ret = ath12k_ds_alloc_buffers(ds);
+	if (ret)
+		goto fail;
+	ret = ath12k_dp_srng_setup(dp->ab, &ds->tcl, HAL_PPE2TCL, 0, 0,
+				   ATH12K_DS_RING_ENTRIES);
+	if (ret)
+		goto fail;
+	ds->tcl_ready = true;
+	ret = ath12k_dp_srng_setup(dp->ab, &ds->reo, HAL_REO2PPE, 0, 0,
+				   ATH12K_DS_RING_ENTRIES);
+	if (ret)
+		goto fail;
+	ds->reo_ready = true;
+	ret = ath12k_dp_srng_setup(dp->ab, &ds->complete, HAL_WBM2SW_RELEASE,
+				   HAL_WBM2SW_DS_RING_NUM, 0, ATH12K_DS_RING_ENTRIES);
+	if (ret)
+		goto fail;
+	ds->complete_ready = true;
+	config.wlan_dev = dp->dev;
+	config.ops = &ath12k_ds_ops;
+	config.priv = ds;
+	config.ppe2tcl = ath12k_ds_srng(ds, &ds->tcl)->ring_base_paddr;
+	config.reo2ppe = ath12k_ds_srng(ds, &ds->reo)->ring_base_paddr;
+	config.ppe2tcl_count = ATH12K_DS_RING_ENTRIES;
+	config.reo2ppe_count = ATH12K_DS_RING_ENTRIES;
+	config.buffer_size = ATH12K_DS_BUFFER_SIZE;
+	ds->handle = qcom_ppe_ds_register(&config);
+	if (IS_ERR(ds->handle)) {
+		ret = PTR_ERR(ds->handle);
+		ds->handle = NULL;
+		goto fail;
+	}
+	/* Registration only. VP/peer setup must complete before starting DMA. */
+	if (dp->ab->debugfs_soc)
+		ds->debugfs = debugfs_create_file("direct_switch", 0400,
+						 dp->ab->debugfs_soc, ds,
+						 &ath12k_ds_stats_fops);
+	ath12k_info(dp->ab, "native PPE Direct Switch rings registered (CPU fallback until authorization)\n");
+	return 0;
+
+fail:
+	ath12k_wifi7_ds_cleanup(dp);
+	return ret;
+}
