From: ViKing <viking.yfy@qq.com>
Date: Mon, 09 Nov 2026 19:10:00 +0800
Subject: [PATCH] wifi: ath12k: keep four-address peers on the CPU path

Native DS binds the parent AP netdevice and resolves destinations through
the station AST. A WDS peer moves to an AP_VLAN and carries source addresses
behind that peer, which this direct path cannot represent.

Track four-address peers as an explicit fallback, withdraw their DS route
when 4addr is enabled, and retain CPU delivery for the whole VAP while
such a peer exists. Refresh the route through ds_peer_setup without
inventing a new authorization transition.

Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/drivers/net/wireless/ath/ath12k/mac.c
+++ b/drivers/net/wireless/ath/ath12k/mac.c
@@ -8177,6 +8177,11 @@
 				 struct ieee80211_sta *sta, bool enabled)
 {
 	struct ath12k_sta *ahsta = ath12k_sta_to_ahsta(sta);
+	struct ath12k_link_sta *arsta;
+	struct ath12k_link_vif *arvif;
+	struct ath12k_dp *dp;
+	unsigned long links;
+	int link_id, ret;
 
 	lockdep_assert_wiphy(hw->wiphy);
 
@@ -8187,9 +8192,25 @@
 	 * during run time. So, add support only for enable case, for
 	 * disable case station interface needs to be reconnect.
 	 */
-	if (enabled && !ahsta->enable_4addr) {
-		if (!ath12k_mac_sta_set_4addr(hw->wiphy, ahsta))
-			ahsta->enable_4addr = true;
+	if (!enabled || ahsta->enable_4addr ||
+	    ath12k_mac_sta_set_4addr(hw->wiphy, ahsta))
+		return;
+
+	ahsta->enable_4addr = true;
+	/* Authorization may already have submitted a parent-AP DS route. */
+	links = ahsta->links_map;
+	for_each_set_bit(link_id, &links, IEEE80211_MLD_MAX_NUM_LINKS) {
+		arsta = wiphy_dereference(hw->wiphy, ahsta->link[link_id]);
+		if (!arsta || !arsta->arvif || !arsta->arvif->ar)
+			continue;
+		arvif = arsta->arvif;
+		dp = ath12k_ab_to_dp(arvif->ar->ab);
+		if (!dp->ops->ds_peer_setup)
+			continue;
+		ret = dp->ops->ds_peer_setup(arvif->ar, arvif, arsta);
+		if (ret)
+			ath12k_warn(arvif->ar->ab,
+				    "failed to withdraw 4addr Direct Switch route: %d\n", ret);
 	}
 }
 EXPORT_SYMBOL(ath12k_mac_op_sta_set_4addr);
--- a/drivers/net/wireless/ath/ath12k/wifi7/ppe_ds.c
+++ b/drivers/net/wireless/ath/ath12k/wifi7/ppe_ds.c
@@ -54,12 +54,13 @@
 enum ath12k_ds_fallback {
 	ATH12K_DS_FALLBACK_NONE,
 	ATH12K_DS_FALLBACK_MLO,
+	ATH12K_DS_FALLBACK_4ADDR,
 	ATH12K_DS_FALLBACK_CONTROL,
 	ATH12K_DS_FALLBACK_MAX,
 };
 
 static const char * const ath12k_ds_fallback_names[] = {
-	"none", "unsupported-mlo", "control-submit",
+	"none", "unsupported-mlo", "four-address", "control-submit",
 };
 
 struct ath12k_ds_buffer {
@@ -1045,7 +1046,9 @@
 	if (!ds)
 		return 0;
 	lockdep_assert_wiphy(ar->ah->hw->wiphy);
-	fallback = sta->mlo ? ATH12K_DS_FALLBACK_MLO : ATH12K_DS_FALLBACK_NONE;
+	fallback = sta->mlo ? ATH12K_DS_FALLBACK_MLO :
+		   ahsta->enable_4addr ? ATH12K_DS_FALLBACK_4ADDR :
+		   ATH12K_DS_FALLBACK_NONE;
 	mutex_lock(&ds->control_lock);
 	if (ds->stopped || ds->faulted)
 		goto unlock;
@@ -1054,7 +1057,19 @@
 		    peer->vdev == arvif->vdev_id &&
 		    ether_addr_equal(peer->addr, arsta->addr)) {
 			peer->authorized |= authorized;
-			if (authorized && !peer->enabled && !fallback) {
+			/* A four-address peer moves to an AP_VLAN after association.
+			 * Native DS owns only the parent AP netdevice and cannot
+			 * preserve that VLAN or learn the bridged source addresses.
+			 * Return the whole VAP to CPU before withdrawing its route.
+			 */
+			if (peer->fallback != fallback && fallback)
+				ds->fallback_events[fallback]++;
+			peer->fallback = fallback;
+			if (fallback) {
+				ret = ath12k_ds_peer_cpu(ds, peer);
+				goto unlock;
+			}
+			if (authorized && !peer->enabled) {
 				port = ath12k_ds_bind_vif(ds, arvif);
 				if (port < 0) {
 					ret = port;
@@ -1125,7 +1140,7 @@
 int ath12k_wifi7_ds_peer_setup(struct ath12k *ar, struct ath12k_link_vif *arvif,
 			       struct ath12k_link_sta *arsta)
 {
-	if (!ath12k_wifi7_ds_hw1_compat(ar->ab))
+	if (!ath12k_wifi7_ds_hw1_compat(ar->ab) && !arsta->ahsta->enable_4addr)
 		return 0;
 	return ath12k_ds_peer_update(ar, arvif, arsta, false);
 }
