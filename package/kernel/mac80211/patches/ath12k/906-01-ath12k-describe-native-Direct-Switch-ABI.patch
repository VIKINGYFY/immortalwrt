+#ifdef CPTCFG_ATH12K_PPE_DS_SUPPORT
+void ath12k_wifi7_hal_ds_disable(struct ath12k_base *ab, struct hal_srng *srng)
+{
+	u32 offset, reg, misc;
+	unsigned long flags;
+
+	offset = srng->ring_dir == HAL_SRNG_DIR_SRC ?
+		 HAL_TCL1_RING_MISC_OFFSET(&ab->hal) :
+		 ath12k_wifi7_hal_reo1_ring_misc_offset(&ab->hal);
+	spin_lock_irqsave(&srng->lock, flags);
+	reg = srng->hwreg_base[HAL_SRNG_REG_GRP_R0] + offset;
+	misc = ath12k_hif_read32(ab, reg);
+	ath12k_hif_write32(ab, reg, misc & ~BIT(6));
+	ath12k_hif_read32(ab, reg);
+	spin_unlock_irqrestore(&srng->lock, flags);
+}
+
+/* Only called for empty rings before enabling peer/VP routing. */
+void ath12k_wifi7_hal_ds_set_indices(struct ath12k_base *ab,
+				    struct hal_srng *srng, u16 index)
+{
+	u32 offset, reg, misc, words = index * srng->entry_size;
+	unsigned long flags;
+
+	if (srng->ring_dir == HAL_SRNG_DIR_SRC)
+		offset = HAL_TCL1_RING_MISC_OFFSET(&ab->hal);
+	else
+		offset = ath12k_wifi7_hal_reo1_ring_misc_offset(&ab->hal);
+	spin_lock_irqsave(&srng->lock, flags);
+	reg = srng->hwreg_base[HAL_SRNG_REG_GRP_R0] + offset;
+	misc = ath12k_hif_read32(ab, reg);
+	ath12k_hif_write32(ab, reg, misc & ~BIT(6));
+	ath12k_hif_read32(ab, reg);
+	if (srng->ring_dir == HAL_SRNG_DIR_SRC) {
+		srng->u.src_ring.hp = words;
+		srng->u.src_ring.reap_hp = (words + srng->ring_size -
+					  srng->entry_size) % srng->ring_size;
+		srng->u.src_ring.cached_tp = words;
+		WRITE_ONCE(*srng->u.src_ring.tp_addr, words);
+	} else {
+		srng->u.dst_ring.tp = words;
+		srng->u.dst_ring.cached_hp = words;
+		WRITE_ONCE(*srng->u.dst_ring.hp_addr, words);
+	}
+	dma_wmb();
+	reg = srng->hwreg_base[HAL_SRNG_REG_GRP_R2];
+	ath12k_hif_write32(ab, reg, words);
+	ath12k_hif_write32(ab, reg + HAL_REO1_RING_TP_OFFSET, words);
+	reg = srng->hwreg_base[HAL_SRNG_REG_GRP_R0] + offset;
+	ath12k_hif_write32(ab, reg, misc);
+	spin_unlock_irqrestore(&srng->lock, flags);
+}
+#endif
