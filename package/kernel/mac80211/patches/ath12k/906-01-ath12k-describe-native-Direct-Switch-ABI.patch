+	if (!skb)
+		return -ENOMEM;
+	cmd = (void *)skb->data;
+	memset(cmd, 0, sizeof(*cmd));
+	cmd->tlv_header = ath12k_wmi_tlv_cmd_hdr(0x3ea, sizeof(*cmd));
+	ether_addr_copy(cmd->mac.addr, addr);
