+	if (!enable && source_vp && ar->ab->hw_rev == ATH12K_HW_QCN9274_HW10)
+		routing = 2;
+	cmd->routing = cpu_to_le32(routing);
+	cmd->service_code = cpu_to_le32(12);
+	cmd->source_vp = cpu_to_le32(source_vp);
+	cmd->vdev_id = cpu_to_le32(vdev_id);
+	ret = ath12k_wmi_cmd_send(ar->wmi, skb, WMI_PEER_CONFIG_PPE_DS_CMDID);
+	if (ret)
+		dev_kfree_skb(skb);
+	return ret;
