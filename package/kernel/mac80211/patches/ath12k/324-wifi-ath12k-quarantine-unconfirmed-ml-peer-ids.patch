 drivers/net/wireless/ath/ath12k/core.h    |   1 +
 drivers/net/wireless/ath/ath12k/dp_cmn.h  |   2 +-
 drivers/net/wireless/ath/ath12k/dp_peer.c |   2 +-
 drivers/net/wireless/ath/ath12k/mac.c     |  46 ++++++--
 drivers/net/wireless/ath/ath12k/peer.c    | 124 +++++++++++++++++----
