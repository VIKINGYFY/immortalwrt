--- a/drivers/net/wireless/ath/ath12k/core.h
+++ b/drivers/net/wireless/ath/ath12k/core.h
@@ -802,6 +802,7 @@ struct ath12k_hw {
 	u8 num_radio;
 
 	DECLARE_BITMAP(free_ml_peer_id_map, ATH12K_MAX_MLO_PEERS);
+	DECLARE_BITMAP(quarantined_ml_peer_id_map, ATH12K_MAX_MLO_PEERS);
 	u16 max_ml_peer_ids;
 	u16 last_ml_peer_id;
 
