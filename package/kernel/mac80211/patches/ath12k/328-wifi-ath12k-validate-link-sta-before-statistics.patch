From 366554f9b8031c1ad697359588940d439123cf02 Mon Sep 17 00:00:00 2001
From: Harish Rachakonda <rachakon@qti.qualcomm.com>
Date: Wed, 17 Sep 2025 11:47:43 +0530
Subject: [PATCH] wifi: ath12k: validate link STA before reading statistics

link_sta->sta can already be cleared while a link is being removed.  Do not
derive the driver station object from that pointer until it has been checked.
This avoids a host crash if a station statistics request races MLO link
cleanup.

Adapted to the current upstream ath12k statistics implementation.

Signed-off-by: Harish Rachakonda <rachakon@qti.qualcomm.com>
Signed-off-by: JiaY-shi <shi05275@163.com>
---
 drivers/net/wireless/ath/ath12k/mac.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

--- a/drivers/net/wireless/ath/ath12k/mac.c
+++ b/drivers/net/wireless/ath/ath12k/mac.c
@@ -14018,7 +14018,7 @@ void ath12k_mac_op_link_sta_statistics(s
 				       struct ieee80211_link_sta *link_sta,
 				       struct link_station_info *link_sinfo)
 {
-	struct ath12k_sta *ahsta = ath12k_sta_to_ahsta(link_sta->sta);
+	struct ath12k_sta *ahsta;
 	struct ath12k_fw_stats_req_params params = {};
 	struct ath12k_dp_link_peer *peer;
 	struct ath12k_link_sta *arsta;
@@ -14026,6 +14026,11 @@ void ath12k_mac_op_link_sta_statistics(s
 	s8 signal;
 	bool db2dbm;
 
+	if (!link_sta->sta)
+		return;
+
+	ahsta = ath12k_sta_to_ahsta(link_sta->sta);
+
 	lockdep_assert_wiphy(hw->wiphy);
 
 	arsta = wiphy_dereference(hw->wiphy, ahsta->link[link_sta->link_id]);
