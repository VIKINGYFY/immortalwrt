-	for (i = 0, mlo_idx = 0; i < ab->qmi.mem_seg_count; i++) {
-		if (ab->qmi.target_mem[i].type == MLO_GLOBAL_MEM_REGION_TYPE) {
-			if (ab->qmi.target_mem[i].paddr)
-				ath12k_qmi_free_mlo_mem_chunk(ab,
-							      &ab->qmi.target_mem[i],
-							      mlo_idx);
-			mlo_idx++;
-		} else {
-			if (test_bit(ATH12K_FLAG_FIXED_MEM_REGION, &ab->dev_flags)) {
-				ab->qmi.target_mem[i].v.ioaddr = NULL;
-			} else {
-				if (!ab->qmi.target_mem[i].v.addr)
-					continue;
-				dma_free_coherent(ab->dev,
-						  ab->qmi.target_mem[i].prev_size,
-						  ab->qmi.target_mem[i].v.addr,
-						  ab->qmi.target_mem[i].paddr);
-				ab->qmi.target_mem[i].v.addr = NULL;
-			}
-		}
+	for (i = 0; i < ARRAY_SIZE(ab->qmi.target_mem); i++) {
+		chunk = &ab->qmi.target_mem[i];
+		ath12k_qmi_free_dma_chunk(ab, chunk);
+		chunk->v.addr = NULL;
+		chunk->paddr = 0;
+		chunk->dma_allocated = false;
 	}
 
 	if (!ag->num_started && ag->mlo_mem.init_done) {
@@ -2828,6 +2833,7 @@
 		ag->mlo_mem.init_done = false;
 		ag->mlo_mem.mlo_mem_size = 0;
 		ag->mlo_mem.fixed_mem = false;
+		put_device(ag->mlo_mem.alloc_dev);
 		ag->mlo_mem.alloc_dev = NULL;
 	}
 }
@@ -2835,6 +2841,10 @@
 static int ath12k_qmi_alloc_chunk(struct ath12k_base *ab,
 				  struct target_mem_chunk *chunk)
 {
+	/* Fixed mappings and group-owned MLO views are not DMA allocations. */
+	if (!chunk->dma_allocated)
+		chunk->v.addr = NULL;
+
 	/* Firmware reloads in recovery/resume.
 	 * In such cases, no need to allocate memory for FW again.
 	 */
@@ -2844,9 +2854,7 @@
 			goto this_chunk_done;
 
 		/* cannot reuse the existing chunk */
-		dma_free_coherent(ab->dev, chunk->prev_size,
-				  chunk->v.addr, chunk->paddr);
-		chunk->v.addr = NULL;
+		ath12k_qmi_free_dma_chunk(ab, chunk);
 	}
 
 	chunk->v.addr = dma_alloc_coherent(ab->dev,
@@ -2869,6 +2877,12 @@
 	}
 	chunk->prev_type = chunk->type;
 	chunk->prev_size = chunk->size;
+	chunk->dma_allocated = true;
+	if (test_bit(ATH12K_FLAG_FIXED_MEM_REGION, &ab->dev_flags) &&
+	    (chunk->type == M3_DUMP_REGION_TYPE ||
+	     chunk->type == CALDB_MEM_REGION_TYPE))
+		ath12k_info(ab, "allocated firmware memory type %u addr %pad size %u\n",
+			    chunk->type, &chunk->paddr, chunk->size);
 this_chunk_done:
 	return 0;
 }
@@ -2885,12 +2899,14 @@
 
 	for (i = 0; i < ag->num_devices; i++) {
 		partner_ab = ag->ab[i];
-		if (!partner_ab ||
-		    !test_bit(ATH12K_FLAG_FIXED_MEM_REGION,
-			      &partner_ab->dev_flags))
+		if (!partner_ab)
 			continue;
 
-		fixed_mem = true;
+		/* MLO memory may be reserved independently of the host DDR. */
+		if (of_property_match_string(partner_ab->dev->of_node,
+					     "memory-region-names",
+					     "mlo-global-mem") >= 0)
+			fixed_mem = true;
 
 		*rmem = ath12k_core_get_rmem_by_name(partner_ab, "mlo-global-mem");
 		if (*rmem)
@@ -2902,15 +2918,17 @@
 
 static int ath12k_qmi_assign_mlo_mem_chunk(struct ath12k_base *ab,
 					    struct target_mem_chunk *chunk,
-					    int idx, size_t offset, u32 size)
