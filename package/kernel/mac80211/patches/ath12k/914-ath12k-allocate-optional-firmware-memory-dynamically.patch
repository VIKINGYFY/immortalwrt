From: ViKing <viking.yfy@qq.com>
Date: Sun, 08 Nov 2026 10:27:29 +0800
Subject: [PATCH] wifi: ath12k: allocate optional firmware memory dynamically

Keep fixed AHB host DDR and explicitly named reserved regions. Allocate
M3 dump and CALDB on demand when no region is supplied. Track DMA
ownership per segment so fixed mappings and coherent buffers are released
with the matching API, including shortened recovery requests.

Allow a dynamic shared MLO pool independently of fixed AHB host DDR.
Allocate one pool for the complete firmware request and return offset
views so partners can use different segment boundaries. Keep the owning
device referenced until the group releases its last allocation.
Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/drivers/net/wireless/ath/ath12k/qmi.c
+++ b/drivers/net/wireless/ath/ath12k/qmi.c
@@ -2744,6 +2744,20 @@
 		ab->qmi.fixed_mem[i].used = false;
 }
 
+static void ath12k_qmi_free_dma_chunk(struct ath12k_base *ab,
+				      struct target_mem_chunk *chunk)
+{
+	if (!chunk->dma_allocated)
+		return;
+
+	dma_free_coherent(ab->dev, chunk->prev_size,
+			  chunk->v.addr, chunk->paddr);
+	chunk->v.addr = NULL;
+	chunk->paddr = 0;
+	chunk->prev_size = 0;
+	chunk->dma_allocated = false;
+}
+
 static void ath12k_qmi_prune_fixed_mem(struct ath12k_base *ab)
 {
 	int i;
@@ -2752,6 +2766,9 @@
 		if (!ab->qmi.fixed_mem[i].used)
 			ath12k_qmi_unmap_fixed_mem(ab, &ab->qmi.fixed_mem[i]);
 	}
+
+	for (i = ab->qmi.mem_seg_count; i < ARRAY_SIZE(ab->qmi.target_mem); i++)
+		ath12k_qmi_free_dma_chunk(ab, &ab->qmi.target_mem[i]);
 }
 
 static int ath12k_qmi_map_fixed_mem(struct ath12k_base *ab, int idx,
@@ -2779,6 +2796,7 @@
 		mem->type = type;
 	}
 
+	ath12k_qmi_free_dma_chunk(ab, chunk);
 	mem->used = true;
 	chunk->paddr = mem->paddr;
 	chunk->v.ioaddr = mem->ioaddr;
@@ -2791,32 +2809,19 @@
