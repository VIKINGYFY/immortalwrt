+static int ath12k_qmi_get_mlo_reserved_mem(struct ath12k_hw_group *ag,
+					    struct reserved_mem **rmem)
+{
+	struct ath12k_base *partner_ab;
+	bool fixed_mem = false;
+	int i;
+
+	lockdep_assert_held(&ag->mutex);
+	*rmem = NULL;
+
+	for (i = 0; i < ag->num_devices; i++) {
+		partner_ab = ag->ab[i];
+		if (!partner_ab)
+			continue;
+
+		/* MLO memory may be reserved independently of the host DDR. */
+		if (of_property_match_string(partner_ab->dev->of_node,
+					     "memory-region-names",
+					     "mlo-global-mem") >= 0)
+			fixed_mem = true;
+
+		*rmem = ath12k_core_get_rmem_by_name(partner_ab, "mlo-global-mem");
+		if (*rmem)
+			return 0;
+	}
+
+	return fixed_mem ? -ENODEV : 0;
+}
+
+static int ath12k_qmi_assign_mlo_mem_chunk(struct ath12k_base *ab,
+					    struct target_mem_chunk *chunk,
+					    size_t offset, u32 size)
+{
+	struct ath12k_hw_group *ag = ab->ag;
+	struct target_mem_chunk *mlo_chunk;
+	struct reserved_mem *rmem;
+	u32 total_size;
+	int i, ret;
+
+	lockdep_assert_held(&ag->mutex);
+
+	ath12k_qmi_free_dma_chunk(ab, chunk);
+	ret = ath12k_qmi_get_mlo_reserved_mem(ag, &rmem);
+	if (ret) {
+		ath12k_err(ab, "fixed MLO memory is missing from device tree\n");
+		return ret;
+	}
+
+	if (rmem) {
+		mlo_chunk = &ag->mlo_mem.chunk[0];
+		if (!mlo_chunk->v.ioaddr) {
+			mlo_chunk->paddr = rmem->base;
+			mlo_chunk->size = rmem->size;
+			mlo_chunk->type = MLO_GLOBAL_MEM_REGION_TYPE;
+			mlo_chunk->v.ioaddr = ioremap(rmem->base, rmem->size);
+			if (!mlo_chunk->v.ioaddr) {
+				memset(mlo_chunk, 0, sizeof(*mlo_chunk));
+				return -EIO;
+			}
+
+			ag->mlo_mem.fixed_mem = true;
+			memset_io(mlo_chunk->v.ioaddr, 0, mlo_chunk->size);
+			ath12k_info(ab, "mapped fixed MLO memory addr %pa size %u\n",
+				    &mlo_chunk->paddr, mlo_chunk->size);
+		}
+
+		if (offset > mlo_chunk->size || size > mlo_chunk->size - offset) {
+			ath12k_err(ab,
+				   "MLO request offset %zu size %u exceeds reserved size %u\n",
+				   offset, size, mlo_chunk->size);
+			return -EINVAL;
+		}
+
+		chunk->paddr = mlo_chunk->paddr + offset;
+		chunk->v.ioaddr = (u8 __iomem *)mlo_chunk->v.ioaddr + offset;
+		chunk->size = size;
+		chunk->type = MLO_GLOBAL_MEM_REGION_TYPE;
+		return 0;
+	}
+
+	/* Firmware partners can describe the same shared memory with different
+	 * segment boundaries. Allocate one group-owned pool and return views.
+	 */
+	mlo_chunk = &ag->mlo_mem.chunk[0];
+	if (!mlo_chunk->paddr) {
+		total_size = 0;
+		for (i = 0; i < ab->qmi.mem_seg_count; i++) {
+			if (ab->qmi.target_mem[i].type != MLO_GLOBAL_MEM_REGION_TYPE)
+				continue;
+			if (ab->qmi.target_mem[i].size > U32_MAX - total_size)
+				return -EINVAL;
+			total_size += ab->qmi.target_mem[i].size;
+		}
+		if (!total_size || total_size > INT_MAX ||
+		    (ag->mlo_mem.mlo_mem_size &&
+				    total_size != ag->mlo_mem.mlo_mem_size))
+			return -EINVAL;
+
+		mlo_chunk->size = total_size;
+		mlo_chunk->type = MLO_GLOBAL_MEM_REGION_TYPE;
+		ret = ath12k_qmi_alloc_chunk(ab, mlo_chunk);
+		if (ret)
+			return ret;
+		ag->mlo_mem.alloc_dev = get_device(ab->dev);
+		memset(mlo_chunk->v.addr, 0, mlo_chunk->size);
+		ath12k_info(ab, "allocated MLO memory addr %pad size %u\n",
+			    &mlo_chunk->paddr, mlo_chunk->size);
+	}
+
+	if (offset > mlo_chunk->size || size > mlo_chunk->size - offset)
+		return -EINVAL;
+
+	chunk->paddr = mlo_chunk->paddr + offset;
+	chunk->v.addr = (u8 *)mlo_chunk->v.addr + offset;
+	chunk->size = size;
+	chunk->type = MLO_GLOBAL_MEM_REGION_TYPE;
+
+	return 0;
+}
