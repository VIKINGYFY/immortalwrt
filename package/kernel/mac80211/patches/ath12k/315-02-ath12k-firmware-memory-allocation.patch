 	}
 
 	chunk->v.addr = dma_alloc_coherent(ab->dev,
@@ -2629,27 +2719,155 @@ static int ath12k_qmi_alloc_chunk(struct
 	}
 	chunk->prev_type = chunk->type;
 	chunk->prev_size = chunk->size;
+	chunk->dma_allocated = true;
+	if (test_bit(ATH12K_FLAG_FIXED_MEM_REGION, &ab->dev_flags) &&
+	    (chunk->type == M3_DUMP_REGION_TYPE ||
+	     chunk->type == CALDB_MEM_REGION_TYPE))
+		ath12k_info(ab, "allocated firmware memory type %u addr %pad size %u\n",
+			    chunk->type, &chunk->paddr, chunk->size);
 this_chunk_done:
 	return 0;
