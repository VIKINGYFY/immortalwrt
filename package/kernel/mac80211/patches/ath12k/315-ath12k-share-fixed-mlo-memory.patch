From: JiaY-shi <shi05275@163.com>
Date: Sat, 25 Jul 2026 18:00:00 +0800
Subject: [PATCH] wifi: ath12k: share fixed MLO memory in mixed bus groups

IPQ5332 firmware uses fixed QMI memory and reserves its MLO global memory
in device tree. The fixed memory assignment path does not handle MLO
memory requests, so an IPQ5332/QCN9274 WSI group cannot give both devices
the same global memory addresses.

The two firmwares can also describe the same global buffer with different
segment boundaries. IPQ5332 requests one contiguous segment, while QCN9274
splits the request after falling back to smaller QMI memory chunks. Map
the fixed region once and derive every segment address from its cumulative
offset so both layouts reference the same physical range.

Record the allocation type and DMA owner on the group rather than deriving
it from the device which happens to release the memory; mixed AHB/PCI
groups can otherwise unmap the shared memory with the wrong API.

Signed-off-by: JiaY-shi <shi05275@163.com>
---
 drivers/net/wireless/ath/ath12k/core.h |   2 +
 drivers/net/wireless/ath/ath12k/qmi.c  | 248 ++++++++++++++++++++++++++------
 2 files changed, 202 insertions(+), 48 deletions(-)

--- a/drivers/net/wireless/ath/ath12k/core.h
+++ b/drivers/net/wireless/ath/ath12k/core.h
@@ -885,6 +885,8 @@ struct ath12k_mlo_memory {
 	struct target_mem_chunk chunk[ATH12K_QMI_WLANFW_MAX_NUM_MEM_SEG_V01];
 	int mlo_mem_size;
 	bool init_done;
+	bool fixed_mem;
+	struct device *alloc_dev;
 };
 
 struct ath12k_hw_link {
--- a/drivers/net/wireless/ath/ath12k/qmi.c
+++ b/drivers/net/wireless/ath/ath12k/qmi.c
@@ -2505,11 +2505,16 @@ void ath12k_qmi_reset_mlo_mem(struct ath
 	for (i = 0; i < ARRAY_SIZE(ag->mlo_mem.chunk); i++) {
 		mlo_chunk = &ag->mlo_mem.chunk[i];
 
-		if (mlo_chunk->v.addr)
-			/* TODO: Mode 0 recovery is the default mode hence resetting the
-			 * whole memory region for now. Once Mode 1 support is added, this
-			 * needs to be handled properly
-			 */
+		if (!mlo_chunk->v.addr)
+			continue;
+
+		/* TODO: Mode 0 recovery is the default mode hence resetting the
+		 * whole memory region for now. Once Mode 1 support is added, this
+		 * needs to be handled properly
+		 */
+		if (ag->mlo_mem.fixed_mem)
+			memset_io(mlo_chunk->v.ioaddr, 0, mlo_chunk->size);
+		else
 			memset(mlo_chunk->v.addr, 0, mlo_chunk->size);
 	}
 }
@@ -2520,38 +2525,37 @@ static void ath12k_qmi_free_mlo_mem_chun
 {
 	struct ath12k_hw_group *ag = ab->ag;
 	struct target_mem_chunk *mlo_chunk;
-	bool fixed_mem;
+	struct device *alloc_dev;
 
 	lockdep_assert_held(&ag->mutex);
 
 	if (!ag->mlo_mem.init_done || ag->num_started)
 		return;
 
-	if (idx >= ARRAY_SIZE(ag->mlo_mem.chunk)) {
+	if (ag->mlo_mem.fixed_mem) {
+		mlo_chunk = &ag->mlo_mem.chunk[0];
+		if (!idx && mlo_chunk->v.ioaddr) {
+			iounmap(mlo_chunk->v.ioaddr);
+			memset(mlo_chunk, 0, sizeof(*mlo_chunk));
+		}
+	} else if (idx >= ARRAY_SIZE(ag->mlo_mem.chunk)) {
 		ath12k_warn(ab, "invalid index for MLO memory chunk free: %d\n", idx);
 		return;
-	}
+	} else {
+		mlo_chunk = &ag->mlo_mem.chunk[idx];
+		if (!mlo_chunk->v.addr)
+			goto clear_chunk;
 
-	fixed_mem = test_bit(ATH12K_FLAG_FIXED_MEM_REGION, &ab->dev_flags);
-	mlo_chunk = &ag->mlo_mem.chunk[idx];
-
-	if (fixed_mem && mlo_chunk->v.ioaddr) {
-		iounmap(mlo_chunk->v.ioaddr);
-		mlo_chunk->v.ioaddr = NULL;
-	} else if (mlo_chunk->v.addr) {
-		dma_free_coherent(ab->dev,
+		alloc_dev = ag->mlo_mem.alloc_dev ?: ab->dev;
+		dma_free_coherent(alloc_dev,
 				  mlo_chunk->size,
 				  mlo_chunk->v.addr,
 				  mlo_chunk->paddr);
-		mlo_chunk->v.addr = NULL;
+		memset(mlo_chunk, 0, sizeof(*mlo_chunk));
 	}
 
-	mlo_chunk->paddr = 0;
-	mlo_chunk->size = 0;
-	if (fixed_mem)
-		chunk->v.ioaddr = NULL;
-	else
-		chunk->v.addr = NULL;
+clear_chunk:
+	chunk->v.addr = NULL;
 	chunk->paddr = 0;
 	chunk->size = 0;
 }
@@ -2563,9 +2567,11 @@ static void ath12k_qmi_free_target_mem_c
 
 	for (i = 0, mlo_idx = 0; i < ab->qmi.mem_seg_count; i++) {
 		if (ab->qmi.target_mem[i].type == MLO_GLOBAL_MEM_REGION_TYPE) {
-			ath12k_qmi_free_mlo_mem_chunk(ab,
-						      &ab->qmi.target_mem[i],
-						      mlo_idx++);
+			if (ab->qmi.target_mem[i].paddr)
+				ath12k_qmi_free_mlo_mem_chunk(ab,
+							      &ab->qmi.target_mem[i],
+							      mlo_idx);
+			mlo_idx++;
 		} else {
 			if (test_bit(ATH12K_FLAG_FIXED_MEM_REGION, &ab->dev_flags) &&
 			    ab->qmi.target_mem[i].v.ioaddr) {
@@ -2586,6 +2592,8 @@ static void ath12k_qmi_free_target_mem_c
 	if (!ag->num_started && ag->mlo_mem.init_done) {
 		ag->mlo_mem.init_done = false;
 		ag->mlo_mem.mlo_mem_size = 0;
+		ag->mlo_mem.fixed_mem = false;
+		ag->mlo_mem.alloc_dev = NULL;
 	}
 }
 
@@ -2630,9 +2638,118 @@ this_chunk_done:
 	return 0;
 }
 
+static int ath12k_qmi_get_mlo_reserved_mem(struct ath12k_hw_group *ag,
+					    struct reserved_mem **rmem)
+{
+	struct ath12k_base *partner_ab;
+	bool fixed_mem = false;
+	int i;
+
+	lockdep_assert_held(&ag->mutex);
+	*rmem = NULL;
+
+	for (i = 0; i < ag->num_devices; i++) {
+		partner_ab = ag->ab[i];
+		if (!partner_ab ||
+		    !test_bit(ATH12K_FLAG_FIXED_MEM_REGION,
+			      &partner_ab->dev_flags))
+			continue;
+
+		fixed_mem = true;
+
+		/* The IPQ5332 binding defines MLO global memory as region 3. */
+		*rmem = ath12k_core_get_reserved_mem(partner_ab, 3);
+		if (*rmem)
+			return 0;
+	}
+
+	return fixed_mem ? -ENODEV : 0;
+}
+
+static int ath12k_qmi_assign_mlo_mem_chunk(struct ath12k_base *ab,
+					    struct target_mem_chunk *chunk,
+					    int idx, size_t offset, u32 size)
+{
+	struct ath12k_hw_group *ag = ab->ag;
+	struct target_mem_chunk *mlo_chunk;
+	struct reserved_mem *rmem;
+	int ret;
+
+	lockdep_assert_held(&ag->mutex);
+
+	ret = ath12k_qmi_get_mlo_reserved_mem(ag, &rmem);
+	if (ret) {
+		ath12k_err(ab, "fixed MLO memory is missing from device tree\n");
+		return ret;
+	}
+
+	if (rmem) {
+		mlo_chunk = &ag->mlo_mem.chunk[0];
+		if (!mlo_chunk->v.ioaddr) {
+			mlo_chunk->paddr = rmem->base;
+			mlo_chunk->size = rmem->size;
+			mlo_chunk->type = MLO_GLOBAL_MEM_REGION_TYPE;
+			mlo_chunk->v.ioaddr = ioremap(rmem->base, rmem->size);
+			if (!mlo_chunk->v.ioaddr) {
+				memset(mlo_chunk, 0, sizeof(*mlo_chunk));
+				return -EIO;
+			}
+
+			ag->mlo_mem.fixed_mem = true;
+			memset_io(mlo_chunk->v.ioaddr, 0, mlo_chunk->size);
+			ath12k_info(ab, "mapped fixed MLO memory addr %pa size %u\n",
+				    &mlo_chunk->paddr, mlo_chunk->size);
+		}
+
+		if (offset > mlo_chunk->size || size > mlo_chunk->size - offset) {
+			ath12k_err(ab,
+				   "MLO request offset %zu size %u exceeds reserved size %u\n",
+				   offset, size, mlo_chunk->size);
+			return -EINVAL;
+		}
+
+		chunk->paddr = mlo_chunk->paddr + offset;
+		chunk->v.ioaddr = (u8 __iomem *)mlo_chunk->v.ioaddr + offset;
+		chunk->size = size;
+		chunk->type = MLO_GLOBAL_MEM_REGION_TYPE;
+		return 0;
+	}
+
+	if (idx >= ARRAY_SIZE(ag->mlo_mem.chunk)) {
+		ath12k_err(ab, "invalid index for MLO memory chunk: %d\n", idx);
+		return -EINVAL;
+	}
+
+	mlo_chunk = &ag->mlo_mem.chunk[idx];
+	if (mlo_chunk->paddr) {
+		if (size != mlo_chunk->size) {
+			ath12k_err(ab,
+				   "QMI MLO chunk %d size %u differs from %u\n",
+				   idx, size, mlo_chunk->size);
+			return -EINVAL;
+		}
+	} else {
+		mlo_chunk->size = size;
+		mlo_chunk->type = MLO_GLOBAL_MEM_REGION_TYPE;
+		ret = ath12k_qmi_alloc_chunk(ab, mlo_chunk);
+		if (ret)
+			return ret;
+		if (!ag->mlo_mem.alloc_dev)
+			ag->mlo_mem.alloc_dev = ab->dev;
+		memset(mlo_chunk->v.addr, 0, mlo_chunk->size);
+	}
+
+	chunk->paddr = mlo_chunk->paddr;
+	chunk->v.addr = mlo_chunk->v.addr;
+	chunk->size = size;
+	chunk->type = MLO_GLOBAL_MEM_REGION_TYPE;
+
+	return 0;
+}
+
 static int ath12k_qmi_alloc_target_mem_chunk(struct ath12k_base *ab)
 {
-	struct target_mem_chunk *chunk, *mlo_chunk;
+	struct target_mem_chunk *chunk;
 	struct ath12k_hw_group *ag = ab->ag;
 	int i, mlo_idx, ret;
 	int mlo_size = 0;
@@ -2642,6 +2759,8 @@ static int ath12k_qmi_alloc_target_mem_c
 	if (!ag->mlo_mem.init_done) {
 		memset(ag->mlo_mem.chunk, 0, sizeof(ag->mlo_mem.chunk));
 		ag->mlo_mem.init_done = true;
+		ag->mlo_mem.fixed_mem = false;
+		ag->mlo_mem.alloc_dev = NULL;
 	}
 
 	ab->qmi.target_mem_delayed = false;
@@ -2673,25 +2792,11 @@ static int ath12k_qmi_alloc_target_mem_c
 				goto err;
 			}
 
-			mlo_chunk = &ag->mlo_mem.chunk[mlo_idx];
-			if (mlo_chunk->paddr) {
-				if (chunk->size != mlo_chunk->size) {
-					ath12k_err(ab, "QMI MLO chunk memory allocation failure for index %d, requested size %d is more than allocated size %d",
-						   mlo_idx, chunk->size, mlo_chunk->size);
-					ret = -EINVAL;
-					goto err;
-				}
-			} else {
-				mlo_chunk->size = chunk->size;
-				mlo_chunk->type = chunk->type;
-				ret = ath12k_qmi_alloc_chunk(ab, mlo_chunk);
-				if (ret)
-					goto err;
-				memset(mlo_chunk->v.addr, 0, mlo_chunk->size);
-			}
-
-			chunk->paddr = mlo_chunk->paddr;
-			chunk->v.addr = mlo_chunk->v.addr;
+			ret = ath12k_qmi_assign_mlo_mem_chunk(ab, chunk, mlo_idx,
+							mlo_size - chunk->size,
+							chunk->size);
+			if (ret)
+				goto err;
 			mlo_idx++;
 
 			break;
@@ -2735,12 +2840,24 @@ err:
 
 static int ath12k_qmi_assign_target_mem_chunk(struct ath12k_base *ab)
 {
+	struct target_mem_chunk *chunk;
+	struct ath12k_hw_group *ag = ab->ag;
 	struct reserved_mem *rmem;
 	size_t avail_rmem_size;
 	u32 bdf_addr_offset;
-	int i, idx, ret;
+	int i, idx, mlo_idx, ret;
+	int mlo_size = 0;
+
+	mutex_lock(&ag->mutex);
 
-	for (i = 0, idx = 0; i < ab->qmi.mem_seg_count; i++) {
+	if (!ag->mlo_mem.init_done) {
+		memset(ag->mlo_mem.chunk, 0, sizeof(ag->mlo_mem.chunk));
+		ag->mlo_mem.init_done = true;
+		ag->mlo_mem.fixed_mem = false;
+		ag->mlo_mem.alloc_dev = NULL;
+	}
+
+	for (i = 0, idx = 0, mlo_idx = 0; i < ab->qmi.mem_seg_count; i++) {
 		switch (ab->qmi.target_mem[i].type) {
 		case HOST_DDR_REGION_TYPE:
 			rmem = ath12k_core_get_reserved_mem(ab, 0);
@@ -2862,6 +2979,28 @@ static int ath12k_qmi_assign_target_mem_
 			ab->qmi.target_mem[idx].type = ab->qmi.target_mem[i].type;
 			idx++;
 			break;
+		case MLO_GLOBAL_MEM_REGION_TYPE:
+			chunk = &ab->qmi.target_mem[i];
+			mlo_size += chunk->size;
+			if (ag->mlo_mem.mlo_mem_size &&
+			    mlo_size > ag->mlo_mem.mlo_mem_size) {
+				ath12k_err(ab,
+					   "QMI MLO memory request %d exceeds allocated size %d\n",
+					   mlo_size, ag->mlo_mem.mlo_mem_size);
+				ret = -EINVAL;
+				goto out;
+			}
+
+			ret = ath12k_qmi_assign_mlo_mem_chunk(ab,
+							&ab->qmi.target_mem[idx],
+							mlo_idx,
+							mlo_size - chunk->size,
+							chunk->size);
+			if (ret)
+				goto out;
+			idx++;
+			mlo_idx++;
+			break;
 		case M3_DUMP_REGION_TYPE:
 			rmem = ath12k_core_get_reserved_mem(ab, 1);
 			if (!rmem) {
@@ -2900,9 +3039,22 @@ static int ath12k_qmi_assign_target_mem_
 	}
 	ab->qmi.mem_seg_count = idx;
 
+	if (!ag->mlo_mem.mlo_mem_size) {
+		ag->mlo_mem.mlo_mem_size = mlo_size;
+	} else if (ag->mlo_mem.mlo_mem_size != mlo_size) {
+		ath12k_err(ab,
+			   "QMI MLO memory size error, expected %d requested %d\n",
+			   ag->mlo_mem.mlo_mem_size, mlo_size);
+		ret = -EINVAL;
+		goto out;
+	}
+
+	mutex_unlock(&ag->mutex);
+
 	return 0;
 out:
 	ath12k_qmi_free_target_mem_chunk(ab);
+	mutex_unlock(&ag->mutex);
 	return ret;
 }
 
