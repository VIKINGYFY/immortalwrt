From: ViKing <viking.yfy@qq.com>
Subject: [PATCH] wifi: ath12k: bound low-memory RX buffer allocation

On BE6500, allocation profiling shows network page fragments steadily
growing while QMI/DMA owners and TX pending remain stable. Long-lived RX
buffers pin shared 32 KiB pages. Slab-backed skb data can reuse individual
freed objects instead of allocating new page fragments for every refill.

For boards already opting into qcom,ath12k-low-memory, use slab-backed
data/CE/monitor RX buffers and a 2048-entry host RX DMA ring. Preserve NET_SKB_PAD,
GFP_ATOMIC and existing firmware memory/WMI contracts. Other boards retain
4096 entries and dev_alloc_skb, including the existing firmware low profile.
Reserve headroom to align an empty RX skb: skb_pull refuses a positive
length while skb->len is zero. Publish an RX skb owner only after a hardware
descriptor is available.
The always-active RX monitor refill paths follow the same allocator policy
and align empty skb data with skb_reserve before DMA mapping. Leave the
existing monitor ring sizes, TLV filters and NAPI accounting unchanged.
Expose the selected allocator and ring size in the read-only memory ledger.

Signed-off-by: ViKing <viking.yfy@qq.com>
---
--- a/drivers/net/wireless/ath/ath12k/core.c
+++ b/drivers/net/wireless/ath/ath12k/core.c
@@ -47,6 +47,7 @@ ath12k_mem_profile_based_param ath12k_me
 		.max_client_dbs = 128,
 		.max_client_dbs_sbs = 128,
 		.dp_params = {
+			.rx_buf_ring_size = 4096,
 			.tx_comp_ring_size = 32768,
 			.rxdma_monitor_buf_ring_size = 4096,
 			.rxdma_monitor_dst_ring_size = 8192,
@@ -61,6 +62,7 @@ ath12k_mem_profile_based_param ath12k_me
 		.max_client_dbs = 64,
 		.max_client_dbs_sbs = 64,
 		.dp_params = {
+			.rx_buf_ring_size = 4096,
 			.tx_comp_ring_size = 16384,
 			.rxdma_monitor_buf_ring_size = 256,
 			.rxdma_monitor_dst_ring_size = 512,
@@ -1848,6 +1850,11 @@ int ath12k_core_pre_init(struct ath12k_b
 		ab->host_profile_param = *param;
 		ab->host_profile_param.dp_params =
 			ath12k_mem_profile_based_param[ATH12K_QMI_MEMORY_MODE_LOW_512_M].dp_params;
+		/* RX DMA rings are configured to the host-selected size through
+		 * HTT. Leave firmware peer capacity and reserved DDR unchanged.
+		 */
+		ab->host_profile_param.dp_params.rx_buf_ring_size = 2048;
+		ab->low_memory_rx = true;
 		param = &ab->host_profile_param;
 	}
 	ab->profile_param = param;
--- a/drivers/net/wireless/ath/ath12k/core.h
+++ b/drivers/net/wireless/ath/ath12k/core.h
@@ -945,6 +945,7 @@ struct ath12k_wsi_info {
 };
 
 struct ath12k_dp_profile_params {
+	u32 rx_buf_ring_size;
 	u32 tx_comp_ring_size;
 	u32 rxdma_monitor_buf_ring_size;
 	u32 rxdma_monitor_dst_ring_size;
@@ -1171,6 +1172,7 @@ struct ath12k_base {
 	struct ath12k_reg_freq reg_freq_6ghz;
 	const struct ath12k_mem_profile_based_param *profile_param;
 	struct ath12k_mem_profile_based_param host_profile_param;
+	bool low_memory_rx;
 	enum ath12k_qmi_mem_mode target_mem_mode;
 
 	/* FIXME: Define this field in a ag equivalent object available
@@ -1281,6 +1283,20 @@ struct ath12k_fw_stats_pdev {
 	s32 mpdu_errs;
 };
 
+static inline struct sk_buff *ath12k_alloc_rx_skb(struct ath12k_base *ab,
+					       unsigned int len)
+{
+	struct sk_buff *skb;
+
+	if (!ab->low_memory_rx)
+		return dev_alloc_skb(len);
+
+	skb = alloc_skb(len + NET_SKB_PAD, GFP_ATOMIC);
+	if (skb)
+		skb_reserve(skb, NET_SKB_PAD);
+	return skb;
+}
+
 int ath12k_core_qmi_firmware_ready(struct ath12k_base *ab);
 void ath12k_core_hw_group_cleanup(struct ath12k_hw_group *ag);
 int ath12k_core_pre_init(struct ath12k_base *ab);
--- a/drivers/net/wireless/ath/ath12k/dp_rx.c
+++ b/drivers/net/wireless/ath/ath12k/dp_rx.c
@@ -114,15 +114,15 @@ int ath12k_dp_rx_bufs_replenish(struct a
 	}
 
 	while (num_remain > 0) {
-		skb = dev_alloc_skb(DP_RX_BUFFER_SIZE +
+		skb = ath12k_alloc_rx_skb(ab, DP_RX_BUFFER_SIZE +
 				    DP_RX_BUFFER_ALIGN_SIZE);
 		if (!skb)
 			break;
 
 		if (!IS_ALIGNED((unsigned long)skb->data,
 				DP_RX_BUFFER_ALIGN_SIZE)) {
-			skb_pull(skb,
-				 PTR_ALIGN(skb->data, DP_RX_BUFFER_ALIGN_SIZE) -
+			skb_reserve(skb,
+				    PTR_ALIGN(skb->data, DP_RX_BUFFER_ALIGN_SIZE) -
 				 skb->data);
 		}
 
@@ -138,13 +138,13 @@ int ath12k_dp_rx_bufs_replenish(struct a
 		if (!rx_desc)
 			goto fail_dma_unmap;
 
-		rx_desc->skb = skb;
 		cookie = rx_desc->cookie;
 
 		desc = ath12k_hal_srng_src_get_next_entry(ab, srng);
 		if (!desc)
 			goto fail_dma_unmap;
 
+		rx_desc->skb = skb;
 		list_del(&rx_desc->list);
 		ATH12K_SKB_RXCB(skb)->paddr = paddr;
 
@@ -1702,7 +1702,7 @@ int ath12k_dp_rx_alloc(struct ath12k_bas
 	ret = ath12k_dp_srng_setup(ab,
 				   &dp->rx_refill_buf_ring.refill_buf_ring,
 				   HAL_RXDMA_BUF, 0, 0,
-				   DP_RXDMA_BUF_RING_SIZE);
+				   ab->profile_param->dp_params.rx_buf_ring_size);
 	if (ret) {
 		ath12k_warn(ab, "failed to setup rx_refill_buf_ring\n");
 		return ret;
--- a/drivers/net/wireless/ath/ath12k/ce.c
+++ b/drivers/net/wireless/ath/ath12k/ce.c
@@ -69,7 +69,7 @@ static int ath12k_ce_rx_post_pipe(struct
 
 	spin_lock_bh(&ab->ce.ce_lock);
 	while (pipe->rx_buf_needed) {
-		skb = dev_alloc_skb(pipe->buf_sz);
+		skb = ath12k_alloc_rx_skb(ab, pipe->buf_sz);
 		if (!skb) {
 			ret = -ENOMEM;
 			goto exit;
--- a/drivers/net/wireless/ath/ath12k/dp_mon.c
+++ b/drivers/net/wireless/ath/ath12k/dp_mon.c
@@ -44,15 +44,15 @@ struct sk_buff
 	struct sk_buff *skb;
