From: JiaY-shi <shi05275@163.com>
Date: Thu, 23 Jul 2026 23:30:00 +0800
Subject: [PATCH] wifi: ath12k: support legacy userPD boot info

Older IPQ5332 multi-PD firmware requires the host to describe each userPD
in SMEM item 507 before the rootPD starts. Newer firmware no longer needs
this table because ath12k loads and starts the userPD directly.

Add an opt-in DT quirk for boards using the older firmware ABI. Derive the
userPD entry address and image size from its MDT header instead of putting
board-specific addresses in the driver.

Signed-off-by: JiaY-shi <shi05275@163.com>
---
 drivers/net/wireless/ath/ath12k/ahb.c | 110 +++++++++++++++++++++++++++
 1 file changed, 110 insertions(+)

--- a/drivers/net/wireless/ath/ath12k/ahb.c
+++ b/drivers/net/wireless/ath/ath12k/ahb.c
@@ -11,6 +11,7 @@
 #include <linux/platform_device.h>
 #include <linux/remoteproc.h>
 #include <linux/soc/qcom/mdt_loader.h>
+#include <linux/soc/qcom/smem.h>
 #include <linux/soc/qcom/smem_state.h>
 #include "ahb.h"
 #include "debug.h"
@@ -20,6 +21,30 @@
 #define ATH12K_MAX_UPDS 1
 #define ATH12K_UPD_IRQ_WRD_LEN  18
 
+#define ATH12K_USERPD_BOOT_INFO_REMOTE_PID	1
+#define ATH12K_USERPD_BOOT_INFO_SMEM_ID		507
+#define ATH12K_USERPD_BOOT_INFO_SMEM_SIZE	4096
+#define ATH12K_USERPD_BOOT_INFO_VERSION		2
+#define ATH12K_USERPD_BOOT_INFO_TYPE		2
+
+struct ath12k_userpd_boot_info_header {
+	u8 type;
+	u8 length;
+} __packed;
+
+struct ath12k_userpd_boot_info_entry {
+	struct ath12k_userpd_boot_info_header header;
+	u8 pid;
+	__le32 boot_addr;
+	__le32 data_size;
+} __packed;
+
+struct ath12k_userpd_boot_info {
+	__le16 version;
+	__le16 data_len;
+	struct ath12k_userpd_boot_info_entry entry;
+} __packed;
+
 static struct ath12k_ahb_driver *ath12k_ahb_family_drivers[ATH12K_DEVICE_FAMILY_MAX];
 static const char ath12k_userpd_irq[][9] = {"spawn",
 				     "ready",
@@ -352,6 +377,85 @@ static int ath12k_ahb_get_firmware_name(
 	return 0;
 }
 
+static int ath12k_ahb_prepare_userpd_boot_info(struct ath12k_base *ab)
+{
+	struct ath12k_ahb *ab_ahb = ath12k_ab_to_ahb(ab);
+	struct ath12k_userpd_boot_info boot_info = {};
+	const struct elf32_hdr *ehdr;
+	const struct firmware *fw;
+	char fw_name[ATH12K_USERPD_FW_NAME_LEN];
+	ssize_t image_size;
+	size_t smem_size;
+	void *smem;
+	int ret;
+
+	if (!of_property_read_bool(ab->dev->of_node,
+				   "qcom,legacy-userpd-bootinfo"))
+		return 0;
+
+	ret = ath12k_ahb_get_firmware_name(ab, 0, fw_name, sizeof(fw_name));
+	if (ret)
+		return ret;
+
+	ret = request_firmware(&fw, fw_name, ab->dev);
+	if (ret)
+		return ret;
+
+	if (fw->size < sizeof(*ehdr)) {
+		ret = -EINVAL;
+		goto out_release_fw;
+	}
+
+	ehdr = (const struct elf32_hdr *)fw->data;
+	if (memcmp(ehdr->e_ident, ELFMAG, SELFMAG) ||
+	    ehdr->e_ident[EI_CLASS] != ELFCLASS32) {
+		ret = -EINVAL;
+		goto out_release_fw;
+	}
+
+	image_size = qcom_mdt_get_size(fw);
+	if (image_size <= 0 || image_size > U32_MAX) {
+		ret = image_size < 0 ? image_size : -EFBIG;
+		goto out_release_fw;
+	}
+
+	boot_info.version = cpu_to_le16(ATH12K_USERPD_BOOT_INFO_VERSION);
+	boot_info.data_len = cpu_to_le16(sizeof(boot_info.entry));
+	boot_info.entry.header.type = ATH12K_USERPD_BOOT_INFO_TYPE;
+	boot_info.entry.header.length = sizeof(boot_info.entry) -
+					sizeof(boot_info.entry.header);
+	boot_info.entry.pid = ab_ahb->userpd_id + 1;
+	boot_info.entry.boot_addr = cpu_to_le32(ehdr->e_entry);
+	boot_info.entry.data_size = cpu_to_le32(image_size);
+
+	ret = qcom_smem_alloc(ATH12K_USERPD_BOOT_INFO_REMOTE_PID,
+			      ATH12K_USERPD_BOOT_INFO_SMEM_ID,
+			      ATH12K_USERPD_BOOT_INFO_SMEM_SIZE);
+	if (ret && ret != -EEXIST)
+		goto out_release_fw;
+
+	smem = qcom_smem_get(ATH12K_USERPD_BOOT_INFO_REMOTE_PID,
+			     ATH12K_USERPD_BOOT_INFO_SMEM_ID, &smem_size);
+	if (IS_ERR(smem)) {
+		ret = PTR_ERR(smem);
+		goto out_release_fw;
+	}
+	if (smem_size < sizeof(boot_info)) {
+		ret = -ENOSPC;
+		goto out_release_fw;
+	}
+
+	memset_io(smem, 0, smem_size);
+	memcpy_toio(smem, &boot_info, sizeof(boot_info));
+	ath12k_info(ab, "legacy userPD boot info pid %u addr 0x%x size 0x%x\n",
+		    boot_info.entry.pid, ehdr->e_entry, (u32)image_size);
+	ret = 0;
+
+out_release_fw:
+	release_firmware(fw);
+	return ret;
+}
+
 static int ath12k_ahb_power_up(struct ath12k_base *ab)
 {
 	struct ath12k_ahb *ab_ahb = ath12k_ab_to_ahb(ab);
@@ -882,6 +986,12 @@ static int ath12k_ahb_boot_root_pd(struc
 	unsigned long time_left;
 	int ret;
 
+	ret = ath12k_ahb_prepare_userpd_boot_info(ab);
+	if (ret) {
+		ath12k_err(ab, "failed to prepare legacy userPD boot info: %d\n", ret);
+		return ret;
+	}
+
 	ret = rproc_boot(ab_ahb->tgt_rproc);
 	if (ret < 0) {
 		ath12k_err(ab, "RootPD boot failed\n");
