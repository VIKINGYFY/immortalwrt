+/* Mapping ownership is independent of the latest firmware request/views.
+ * All fields are protected by the hardware group mutex.
+ */
+struct ath12k_qmi_fixed_mem {
+	void __iomem *ioaddr;
+	phys_addr_t paddr;
+	u32 size;
+	u32 type;
+	bool used;
+};
