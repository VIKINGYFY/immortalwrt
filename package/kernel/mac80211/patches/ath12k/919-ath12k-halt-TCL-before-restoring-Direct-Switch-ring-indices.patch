From: ViKing <viking.yfy@qq.com>
Date: Mon, 09 Nov 2026 23:10:00 +0800
Subject: [PATCH] wifi: ath12k: halt TCL before restoring Direct Switch indices

PPE retains its EDMA producer and consumer indices when WLAN restarts.
After real Direct Switch traffic, restoring those nonzero ring pointers
while TCL is running can leave the WiFi transmit path stalled. The APs
return, but EAPOL transmissions stop completing and peer deletion and
subsequent creation time out.

Follow QSDK's nonzero-index initialization sequence: halt the PPE2TCL
pipeline, wait for halt status with a bounded timeout, restore the empty
ring pointers, then restore the previous halt control. Propagate a halt
failure to transport registration instead of publishing unconfirmed
indices. The cold-start zero-index path keeps its existing sequence.

Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/drivers/net/wireless/ath/ath12k/wifi7/hal.c
+++ b/drivers/net/wireless/ath/ath12k/wifi7/hal.c
@@ -3,6 +3,7 @@
  * Copyright (c) 2018-2021 The Linux Foundation. All rights reserved.
  * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
  */
+#include <linux/iopoll.h>
 #include "hw.h"
 #include "hal_desc.h"
 #include "../hal.h"
@@ -142,11 +143,28 @@
 }
 
 /* Only called for empty rings before enabling peer/VP routing. */
-void ath12k_wifi7_hal_ds_set_indices(struct ath12k_base *ab,
+int ath12k_wifi7_hal_ds_set_indices(struct ath12k_base *ab,
 				    struct hal_srng *srng, u16 index)
 {
 	u32 offset, reg, misc, words = index * srng->entry_size;
 	unsigned long flags;
+	u32 control_reg = HAL_SEQ_WCSS_UMAC_TCL_REG + HAL_TCL1_RING_CMN_CTRL_REG;
+	u32 control = 0, value;
+	int ret;
+
+	/* PPE retains EDMA indices across WLAN reset. Halt the TCL pipeline
+	 * before restoring nonzero pointers, as QSDK does for these rings.
+	 */
+	if (index) {
+		control = ath12k_hif_read32(ab, control_reg);
+		ath12k_hif_write32(ab, control_reg, control | HAL_TCL_PPE2TCL_RING_HALT);
+		ret = read_poll_timeout(ath12k_hif_read32, value, value & HAL_TCL_PPE2TCL_RING_HALT_STATUS,
+				1000, 100000, false, ab, control_reg);
+		if (ret) {
+			ath12k_hif_write32(ab, control_reg, control);
+			return ret;
+		}
+	}
 
 	if (srng->ring_dir == HAL_SRNG_DIR_SRC)
 		offset = HAL_TCL1_RING_MISC_OFFSET(&ab->hal);
@@ -175,6 +193,9 @@
 	reg = srng->hwreg_base[HAL_SRNG_REG_GRP_R0] + offset;
 	ath12k_hif_write32(ab, reg, misc);
 	spin_unlock_irqrestore(&srng->lock, flags);
+	if (index)
+		ath12k_hif_write32(ab, control_reg, control);
+	return 0;
 }
 #endif
 
--- a/drivers/net/wireless/ath/ath12k/wifi7/hal.h
+++ b/drivers/net/wireless/ath/ath12k/wifi7/hal.h
@@ -44,6 +44,8 @@
 
 /* SW2TCL(x) R0 ring configuration address */
 #define HAL_TCL1_RING_CMN_CTRL_REG		0x00000020
+#define HAL_TCL_PPE2TCL_RING_HALT			BIT(10)
+#define HAL_TCL_PPE2TCL_RING_HALT_STATUS		BIT(18)
 #define HAL_TCL1_RING_DSCP_TID_MAP		0x00000240
 
 #define HAL_TCL1_RING_BASE_LSB(hal) \
--- a/drivers/net/wireless/ath/ath12k/wifi7/ppe_ds.c
+++ b/drivers/net/wireless/ath/ath12k/wifi7/ppe_ds.c
@@ -167,11 +167,17 @@
 static int ath12k_ds_start_indices(void *priv, u16 tcl, u16 reo)
 {
 	struct ath12k_ds *ds = priv;
+	int ret;
+
+	ret = ath12k_wifi7_hal_ds_set_indices(ds->dp->ab,
+					ath12k_ds_srng(ds, &ds->tcl), tcl);
+	if (ret)
+		return ret;
+	ret = ath12k_wifi7_hal_ds_set_indices(ds->dp->ab,
+					ath12k_ds_srng(ds, &ds->reo), reo);
+	if (ret)
+		return ret;
 
-	ath12k_wifi7_hal_ds_set_indices(ds->dp->ab,
-				       ath12k_ds_srng(ds, &ds->tcl), tcl);
-	ath12k_wifi7_hal_ds_set_indices(ds->dp->ab,
-				       ath12k_ds_srng(ds, &ds->reo), reo);
 	ds->hw1_reo = reo;
 	return 0;
 }
--- a/drivers/net/wireless/ath/ath12k/wifi7/ppe_ds.h
+++ b/drivers/net/wireless/ath/ath12k/wifi7/ppe_ds.h
@@ -13,7 +13,7 @@
 #ifdef CPTCFG_ATH12K_PPE_DS_SUPPORT
 bool ath12k_wifi7_ds_hw1_compat(struct ath12k_base *ab);
 bool ath12k_wifi7_ds_hw1_registered(struct ath12k_base *ab);
-void ath12k_wifi7_hal_ds_set_indices(struct ath12k_base *ab,
+int ath12k_wifi7_hal_ds_set_indices(struct ath12k_base *ab,
 				    struct hal_srng *srng, u16 index);
 void ath12k_wifi7_hal_ds_disable(struct ath12k_base *ab, struct hal_srng *srng);
 int ath12k_wifi7_ds_stop(struct ath12k_dp *dp);
