From: ViKing <viking.yfy@qq.com>
Date: Wed, 11 Nov 2026 16:11:45 +0800
Subject: [PATCH] wifi: ath12k: allocate and release low-memory host resources

Consolidate consecutive changes within this functional responsibility.
Retain the final implementation and its error handling directly.

Remove the unused host-only qcom,ath12k-low-memory profile override.
Keep normal firmware memory profiles, RX allocation and fixed-memory
ownership. Boards choose slab RX independently through qcom,rx-skb-slab.

Keep the final implementation of this responsibility directly; subsequent
repairs listed below are integrated without intermediate replacements.

Split from:
  338-ath12k-low-memory-host-resources.patch - wifi: ath12k: allocate and release low-memory host resources

Merged from:
  338-ath12k-low-memory-host-resources.patch - wifi: ath12k: allocate and release low-memory host resources
  351-wifi-ath12k-refill-rx-buffers-and-expose-progress.patch - wifi: ath12k: service RX returns and refill buffers
  910-ath12k-allow-slab-backed-rx-buffers.patch - wifi: ath12k: allow slab-backed RX buffers independently

Previous merged from (338-ath12k-low-memory-host-resources.patch):
  338-ath12k-allow-low-memory-host-datapath.patch
  339-ath12k-fix-fixed-memory-request-lifetime.patch
  340-ath12k-bound-low-memory-rx-buffer-allocation.patch

Signed-off-by: JiaY-shi <shi05275@163.com>
Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/drivers/net/wireless/ath/ath12k/ahb.c
+++ b/drivers/net/wireless/ath/ath12k/ahb.c
@@ -705,13 +705,28 @@ static int ath12k_ahb_config_ext_irq(str
 				irq_grp->irqs[num_irq++] = reo2host_exception;
 
 			if (ring_mask->rx_wbm_rel[i] & BIT(j) &&
-			    num_irq < ATH12K_EXT_IRQ_NUM_MAX)
-				irq_grp->irqs[num_irq++] = wbm2host_rx_release;
+			    num_irq < ATH12K_EXT_IRQ_NUM_MAX) {
+				irq_idx = wbm2host_rx_release;
+				/* IPQ5332 returns RX errors through WBM SW3. The
+				 * legacy RX release vector is a separate error
+				 * ring; the fourth completion vector serves SW3.
+				 */
+				if (ab->hw_rev == ATH12K_HW_IPQ5332_HW10)
+					irq_idx = wbm2host_tx_completions_ring1 -
+						  HAL_WBM2SW_REL_ERR_RING_NUM;
+				irq_grp->irqs[num_irq++] = irq_idx;
+			}
 
 			if (ring_mask->reo_status[i] & BIT(j) &&
 			    num_irq < ATH12K_EXT_IRQ_NUM_MAX)
 				irq_grp->irqs[num_irq++] = reo2host_status;
 
+			if (ring_mask->host2rxdma[i] & BIT(j) &&
+			    j < ab->hw_params->max_radios &&
+			    num_irq < ATH12K_EXT_IRQ_NUM_MAX)
+				irq_grp->irqs[num_irq++] =
+					host2rxdma_host_buf_ring_mac1 - j;
+
 			if (ring_mask->rx_mon_dest[i] & BIT(j) &&
 			    num_irq < ATH12K_EXT_IRQ_NUM_MAX)
 				irq_grp->irqs[num_irq++] =
@@ -725,14 +740,18 @@ static int ath12k_ahb_config_ext_irq(str
 
 			irq = platform_get_irq_byname(ab->pdev,
 						      irq_name[irq_idx]);
+			if (irq < 0)
+				return irq;
 			ab->irq_num[irq_idx] = irq;
 			irq_set_status_flags(irq, IRQ_NOAUTOEN | IRQ_DISABLE_UNLAZY);
 			ret = devm_request_irq(ab->dev, irq,
 					       ath12k_ahb_ext_interrupt_handler,
 					       IRQF_TRIGGER_RISING,
 					       irq_name[irq_idx], irq_grp);
-			if (ret)
+			if (ret) {
 				ath12k_warn(ab, "failed request_irq for %d\n", irq);
+				return ret;
+			}
 		}
 	}
 
