 #include "core.h"
 #include "dp_tx.h"
 #include "debug.h"
@@ -1212,13 +1214,28 @@ static const struct file_operations fops
 	.llseek = default_llseek,
 };
 
+static void ath12k_debugfs_create_base_file(struct ath12k_base *ab,
+					   const char *name, umode_t mode,
+					   const struct file_operations *fops)
+{
+	struct dentry *existing;
+
+	/* SoC files outlive a firmware recovery and keep the same base owner. */
+	existing = debugfs_lookup(name, ab->debugfs_soc);
+	if (existing) {
+		dput(existing);
+		return;
+	}
+
+	debugfs_create_file(name, mode, ab->debugfs_soc, ab, fops);
+}
+
 void ath12k_debugfs_pdev_create(struct ath12k_base *ab)
 {
-	debugfs_create_file("simulate_fw_crash", 0600, ab->debugfs_soc, ab,
-			    &fops_simulate_fw_crash);
-
-	debugfs_create_file("device_dp_stats", 0400, ab->debugfs_soc, ab,
-			    &fops_device_dp_stats);
+	ath12k_debugfs_create_base_file(ab, "simulate_fw_crash", 0600,
+				       &fops_simulate_fw_crash);
+	ath12k_debugfs_create_base_file(ab, "device_dp_stats", 0400,
+				       &fops_device_dp_stats);
 }
 
