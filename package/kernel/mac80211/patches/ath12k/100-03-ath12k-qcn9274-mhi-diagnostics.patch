From: ViKing <viking.yfy@qq.com>
Subject: [PATCH] ath12k: log QCN9274 hardware and MHI firmware selection

Record the QCN9274 TCSR revision and the MHI board/single-dualmac firmware
selection once during probe. This distinguishes silicon revision and
firmware payload selection without adding polling or repeated log output.

[viking.yfy@qq.com: complete imported patch metadata]
Signed-off-by: ViKing <viking.yfy@qq.com>
---

--- a/drivers/net/wireless/ath/ath12k/mhi.c
+++ b/drivers/net/wireless/ath/ath12k/mhi.c
@@ -188,7 +188,7 @@ int ath12k_mhi_register(struct ath12k_pc
 {
 	struct ath12k_base *ab = ab_pci->ab;
 	struct mhi_controller *mhi_ctrl;
-	unsigned int board_id;
+	unsigned int board_id = ATH12K_BOARD_ID_DEFAULT;
 	int ret;
 	bool dualmac = false;
 
@@ -242,6 +242,14 @@ int ath12k_mhi_register(struct ath12k_pc
 		}
 	}
 
+	if (ab->hw_rev == ATH12K_HW_QCN9274_HW10 ||
+	    ab->hw_rev == ATH12K_HW_QCN9274_HW20)
+		ath12k_info(ab,
+			    "QCN9274 MHI selection: hw_rev=%u board_id=0x%x dualmac=%u source=%s size=%zu\n",
+			    ab->hw_rev, board_id, dualmac,
+			    mhi_ctrl->fw_image ? mhi_ctrl->fw_image : "firmware-N.bin",
+			    mhi_ctrl->fw_sz);
+
 	ret = ath12k_mhi_get_msi(ab_pci);
 	if (ret) {
 		ath12k_err(ab, "failed to get msi for mhi\n");
--- a/drivers/net/wireless/ath/ath12k/wifi7/pci.c
+++ b/drivers/net/wireless/ath/ath12k/wifi7/pci.c
@@ -9,6 +9,7 @@
 #include "../pci.h"
 #include "pci.h"
 #include "../core.h"
+#include "../debug.h"
 #include "../hif.h"
 #include "../mhi.h"
 #include "hw.h"
@@ -86,6 +87,8 @@ void ath12k_wifi7_pci_read_hw_version(st
 	soc_hw_version = ath12k_pci_read32(ab, TCSR_SOC_HW_VERSION);
 	*major = u32_get_bits(soc_hw_version, TCSR_SOC_HW_VERSION_MAJOR_MASK);
 	*minor = u32_get_bits(soc_hw_version, TCSR_SOC_HW_VERSION_MINOR_MASK);
+	ath12k_info(ab, "QCN9274 TCSR hardware version: raw=0x%08x major=%u minor=%u\n",
+		    soc_hw_version, *major, *minor);
 }
 
 static int ath12k_wifi7_pci_probe(struct pci_dev *pdev,
