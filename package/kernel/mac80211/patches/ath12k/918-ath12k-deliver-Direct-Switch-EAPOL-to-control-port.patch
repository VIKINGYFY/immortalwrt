From: ViKing <viking.yfy@qq.com>
Date: Mon, 09 Nov 2026 18:57:00 +0800
Subject: [PATCH] wifi: ath12k: deliver Direct Switch EAPOL to the control port

Direct Switch returns decrypted EAPOL as Ethernet frames through the PPE
virtual port. That path bypasses mac80211's nl80211 control-port receive
handling. PTK renewal replies reach the bridge instead of hostapd, which
then retries and disconnects the station.

Register an ingress hook on each DS AP virtual port. Deliver only unicast
EAPOL from a matching authorized, submitted peer to the owning interface's
control port, and consume it only after successful delivery. Other traffic
and interfaces without a control-port owner retain the ordinary path.

Unregister and synchronize the hook before releasing its VAP or DS state,
including quarantine cleanup. Count successful control-port deliveries.

On QCN9274 HW2, the per-VAP hook completes repeated 20-second PTK renewals
with zero-loss gateway traffic while DS remains enabled. A same-association
handoff-disable control reproduces disconnection and packet loss.

Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/drivers/net/wireless/ath/ath12k/wifi7/ppe_ds.c
+++ b/drivers/net/wireless/ath/ath12k/wifi7/ppe_ds.c
@@ -8,6 +8,7 @@
  * normal completions recycle buffers without passing payloads to mac80211.
  */
 #include <linux/module.h>
+#include <linux/netfilter.h>
 #include <linux/hashtable.h>
 #include <linux/delay.h>
 #include <linux/debugfs.h>
@@ -71,6 +72,8 @@
 };
 
 struct ath12k_ds_vp {
+	struct nf_hook_ops control_hook;
+	bool control_registered;
 	struct ath12k_vif *vif;
 	struct net_device *dev;
 	int port, bank;
@@ -90,6 +93,7 @@
 };
 
 struct ath12k_ds {
+	atomic64_t control_rx;
 	struct ath12k_dp *dp;
 	struct qcom_ppe_ds *handle;
 	struct dp_srng tcl, reo, complete;
@@ -594,6 +598,7 @@
 	seq_printf(seq, "tx_complete:%lld rx_recycled:%lld bad_cookie:%lld tx_exception:%lld\n",
 		   atomic64_read(&ds->tx_completed), atomic64_read(&ds->rx_recycled),
 		   atomic64_read(&ds->bad_cookie), atomic64_read(&ds->tx_exception));
+	seq_printf(seq, "control_port_rx:%lld\n", atomic64_read(&ds->control_rx));
 	seq_printf(seq, "tx_acked:%lld tx_dropped:%lld\n",
 		   atomic64_read(&ds->tx_acked), atomic64_read(&ds->tx_dropped));
 	for (i = 0; i < ATH12K_DS_VP_COUNT; i++)
@@ -899,6 +904,58 @@
 	return ret;
 }
 
+/* DS RX bypasses mac80211. Keep encrypted EAPOL on the owning AP's
+ * nl80211 control port before the bridge can consume it.
+ */
+static unsigned int ath12k_ds_control_rx(void *priv, struct sk_buff *skb,
+				       const struct nf_hook_state *state)
+{
+	struct ath12k_ds *ds = priv;
+	struct net_device *dev = state->in;
+	struct ath12k_ds_peer *peer;
+	const struct ethhdr *eth;
+	bool authorized = false;
+	int mac_len;
+
+	if (skb->protocol != cpu_to_be16(ETH_P_PAE) ||
+	    !dev || !dev->ieee80211_ptr || READ_ONCE(ds->stopped) ||
+	    READ_ONCE(ds->faulted) || !skb_mac_header_was_set(skb))
+		return NF_ACCEPT;
+	mac_len = skb->data - skb_mac_header(skb);
+	if (mac_len < ETH_HLEN || (unsigned int)mac_len > skb_headroom(skb))
+		return NF_ACCEPT;
+	eth = eth_hdr(skb);
+	if (!ether_addr_equal(eth->h_dest, dev->dev_addr))
+		return NF_ACCEPT;
+
+	spin_lock_bh(&ds->peer_lock);
+	hash_for_each_possible(ds->peer_vps, peer, hash,
+			       ether_addr_to_u64(eth->h_source)) {
+		if (peer->dev == dev && READ_ONCE(peer->enabled) &&
+		    READ_ONCE(peer->authorized) &&
+		    ether_addr_equal(peer->addr, eth->h_source)) {
+			authorized = true;
+			break;
+		}
+	}
+	spin_unlock_bh(&ds->peer_lock);
+	if (!authorized || !cfg80211_rx_control_port(dev, skb, false, -1))
+		return NF_ACCEPT;
+
+	atomic64_inc(&ds->control_rx);
+	dev_kfree_skb_any(skb);
+	return NF_STOLEN;
+}
+
+static void ath12k_ds_control_unregister(struct ath12k_ds_vp *vp)
+{
+	if (!vp->control_registered)
+		return;
+	nf_unregister_net_hook(dev_net(vp->dev), &vp->control_hook);
+	synchronize_net();
+	vp->control_registered = false;
+}
+
 static int ath12k_ds_bind_vif(struct ath12k_ds *ds, struct ath12k_link_vif *arvif)
 {
 	struct ath12k_vif *vif = arvif->ahvif;
@@ -949,6 +1006,16 @@
 	dev_hold(vp->dev);
 	vp->port = port;
 	vp->bank = bank;
+	vp->control_hook.hook = ath12k_ds_control_rx;
+	vp->control_hook.priv = ds;
+	vp->control_hook.pf = NFPROTO_NETDEV;
+	vp->control_hook.hooknum = NF_NETDEV_INGRESS;
+	vp->control_hook.dev = vp->dev;
+	vp->control_hook.priority = INT_MIN;
+	ret = nf_register_net_hook(dev_net(vp->dev), &vp->control_hook);
+	if (ret)
+		return ret;
+	vp->control_registered = true;
 	return port;
 }
 
@@ -1228,6 +1295,7 @@
 				vp = &ds->vps[i];
 				if (vp->vif != arvif->ahvif)
 					continue;
+				ath12k_ds_control_unregister(vp);
 				vp->vif = NULL;
 				vp->closing = true;
 				if (vp->dev) {
@@ -1259,6 +1327,7 @@
 			if (vp->vif != arvif->ahvif)
 				continue;
 			if (before) {
+				ath12k_ds_control_unregister(vp);
 				vp->closing = true;
 				ret = qcom_ppe_ds_vp_route(ds->handle, vp->port, false);
 				for (retry = 0; !ret && retry < 200; retry++) {
@@ -1402,6 +1471,9 @@
 
 	if (!ds)
 		return 0;
+	for (i = 0; i < ATH12K_DS_VP_COUNT; i++)
+		ath12k_ds_control_unregister(&ds->vps[i]);
+
 	cancel_work_sync(&ds->fault_work);
 	debugfs_remove(ds->debugfs);
 	ds->debugfs = NULL;
