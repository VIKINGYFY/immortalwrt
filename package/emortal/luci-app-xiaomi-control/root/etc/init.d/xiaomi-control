#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later

START=95
STOP=01
USE_PROCD=1

supported_board() {
	case "$(board_name)" in
		xiaomi,be10000|xiaomi,be10000-es) return 0 ;;
	esac
	return 1
}

start_service() {
	supported_board || return 0

	procd_open_instance
	procd_set_param command /usr/bin/ucode /usr/libexec/xiaomi-control.uc
	procd_set_param file /etc/config/xiaomi-control
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger xiaomi-control
}

service_stopped() {
	local path

	supported_board || return 0
	for path in /sys/bus/i2c/devices/*-002f/hwmon/hwmon*/pwm1; do
		[ ! -e "$path" ] || echo 255 > "$path"
	done
	for path in /sys/class/leds/*:ambient/brightness; do
		[ ! -e "$path" ] || echo 0 > "$path"
	done
	rm -f /var/run/xiaomi-control.json /var/run/xiaomi-control.json.tmp
}
