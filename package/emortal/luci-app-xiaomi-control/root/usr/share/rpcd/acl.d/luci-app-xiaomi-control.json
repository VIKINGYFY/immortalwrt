{
	"luci-app-xiaomi-control": {
		"description": "Grant access to Xiaomi fan, RGB lighting and NFC control",
		"read": {
			"uci": [ "xiaomi-control", "wireless" ],
			"ubus": { "service": [ "list" ], "system": [ "board" ], "file": [ "read" ] },
			"file": {
				"/var/run/xiaomi-control.json": [ "read" ],
				"/tmp/run/xiaomi-control.json": [ "read" ],
				"/var/run/xiaomi-nfc.json": [ "read" ],
				"/tmp/run/xiaomi-nfc.json": [ "read" ]
			}
		},
		"write": {
			"uci": [ "xiaomi-control" ]
		}
	}
}
