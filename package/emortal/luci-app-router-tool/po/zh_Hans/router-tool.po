#: package/emortal/luci-app-router-tool/htdocs/luci-static/resources/tools/router-tool.js:513
msgid "Device is not active"
msgstr "设备未激活"

#: package/emortal/luci-app-router-tool/htdocs/luci-static/resources/tools/router-tool.js:617
msgid "Dismiss"
msgstr "关闭"

#: package/emortal/luci-app-router-tool/htdocs/luci-static/resources/tools/router-tool.js:632
msgid ""
"Manual changes are preserved. Concurrent edits to the same settings or "
"incompatible device assignments stop the switch."
msgstr "保留手动修改；同时修改同一设置或设备分配冲突时会停止切换。"

#: package/emortal/luci-app-router-tool/htdocs/luci-static/resources/tools/router-tool.js:631
msgid ""
"Manually enable to bridge all Ethernet ports and obtain IPv4/IPv6 from the "
"upstream router; disable to restore the previous settings. When disabled, "
"PPPoE automatically uses main-router mode and other WAN protocols use sub-"
"router mode."
msgstr ""
"手动启用后将全部网口桥接，从上级获取 IPv4/IPv6；取消后恢复之前的设置。未启用"
"时，PPPoE 自动采用主路由模式，其他 WAN 协议采用子路由模式。"

#: package/emortal/luci-app-router-tool/htdocs/luci-static/resources/tools/router-tool.js:120
msgid "Mode switch refused: ambiguous matching configuration sections:"
msgstr "已停止模式切换：以下配置节存在多个匹配项："

#: package/emortal/luci-app-router-tool/htdocs/luci-static/resources/tools/router-tool.js:178
msgid ""
"Mode switch refused: an AP snapshot exists while AP mode is disabled. "
"Restore AP mode and use LuCI to switch back."
msgstr ""
"已停止模式切换：AP 模式已关闭但仍有 AP 快照，请恢复 AP 模式后通过 LuCI 关闭。"

#: package/emortal/luci-app-router-tool/htdocs/luci-static/resources/tools/router-tool.js:181
msgid ""
"Mode switch refused: configuration changed while this page was open. Reload "
"the page."
msgstr "已停止模式切换：打开页面后设备配置已发生变化，请刷新页面。"

#: package/emortal/luci-app-router-tool/htdocs/luci-static/resources/tools/router-tool.js:125
msgid "Mode switch refused: reserved section already exists at"
msgstr "已停止模式切换：以下保留配置节已存在："

#: package/emortal/luci-app-router-tool/htdocs/luci-static/resources/tools/router-tool.js:166
msgid ""
"Mode switch refused: saved configuration snapshot is missing or invalid."
msgstr "已停止模式切换：配置快照缺失或无效。"

#: package/emortal/luci-app-router-tool/htdocs/luci-static/resources/tools/router-tool.js:110
#: package/emortal/luci-app-router-tool/htdocs/luci-static/resources/tools/router-tool.js:579
msgid "Mode switch refused: section type changed at"
msgstr "已停止模式切换：以下配置节的类型已改变："

#: package/emortal/luci-app-router-tool/htdocs/luci-static/resources/tools/router-tool.js:404
msgid ""
"Mode switch refused: the active WAN device is still part of the LAN bridge. "
"Review device assignments."
msgstr "已停止模式切换：启用的 WAN 设备仍在 LAN 网桥中，请检查设备分配。"

#: package/emortal/luci-app-router-tool/htdocs/luci-static/resources/tools/router-tool.js:172
#: package/emortal/luci-app-router-tool/htdocs/luci-static/resources/tools/router-tool.js:198
msgid "Mode switch refused: user changed related options:"
msgstr "已停止模式切换：以下相关选项已被用户修改："

#: package/emortal/luci-app-router-tool/htdocs/luci-static/resources/tools/router-tool.js:511
msgid "Operating bandwidth"
msgstr "实际频宽"

#: package/emortal/luci-app-router-tool/htdocs/luci-static/resources/tools/router-tool.js:448
msgid "Operating channel outside the candidate list"
msgstr "实际信道不在候选中"

#: package/emortal/luci-app-router-tool/root/usr/share/ucode/luci/controller/admin/router_tool.uc:89
msgid ""
"Other changes overlap with your saved settings. Revert the pending changes "
"and reload the page."
msgstr "其他操作修改了您已保存的同一设置。请撤销待应用的更改，然后刷新页面。"

#: package/emortal/luci-app-router-tool/root/usr/share/ucode/luci/controller/admin/router_tool.uc
msgid "Another configuration change is waiting for confirmation. Confirm it or wait for it to roll back."
msgstr "另一批配置变更正在等待确认。请确认该变更，或等待其自动回滚。"

#: package/emortal/luci-app-router-tool/root/usr/share/ucode/luci/controller/admin/router_tool.uc:118
#: package/emortal/luci-app-router-tool/root/usr/share/ucode/luci/controller/admin/router_tool.uc:150
