#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# On-demand state only: no configuration writes, traffic or service reloads.

section() {
	printf '\n=== %s ===\n' "$1"
}

section identity
date -Is
cat /proc/sys/kernel/random/boot_id
cat /tmp/sysinfo/board_name
cat /etc/openwrt_release
cat /proc/uptime

section router-tool
for option in auto_role ap_mode ula_cleanup_done offload_defaults_done steering_defaults_done; do
	value=$(uci -q get "router-tool.main.$option")
	printf '%s=%s\n' "$option" "$value"
done
for option in packet_steering steering_flows; do
	value=$(uci -q get "network.@globals[0].$option")
	printf '%s=%s\n' "$option" "$value"
done
printf 'configuration_transaction_pending=%s\n' "$([ -s /etc/router-tool/pending.json ] && echo 1 || echo 0)"
for option in flow_offloading flow_offloading_hw; do
	printf '%s=%s\n' "$option" "$(uci -q get "firewall.@defaults[0].$option")"
done
for file in /var/run/router-tool-status /var/run/router-tool-log-error /var/run/router-tool-log-pending /var/run/router-tool-log-wireless-pending /var/run/router-tool-log-wireless-board /var/run/router-tool-reload-pending; do
	[ -r "$file" ] || continue
	printf '%s: ' "$file"
	cat "$file"
	printf '\n'
done

section wireless
ubus call network.wireless status | ucode -e '
import { readfile } from "fs";
for (let name, radio in json(readfile("/dev/stdin")) || {})
	print(sprintf("%J\n", { radio: name, up: radio.up, pending: radio.pending,
		disabled: radio.disabled, retry_setup_failed: radio.retry_setup_failed,
		interfaces: map(radio.interfaces || [], iface => ({ section: iface.section, ifname: iface.ifname })) }));
'

section interfaces
for interface in lan wan wan6; do
	printf '%s\n' "$interface"
	ubus call "network.interface.$interface" status 2>&1
done

section services
for service in dnsmasq odhcpd; do
	ubus call service list "{\"name\":\"$service\"}" 2>&1
done

section dhcp-configuration
. /lib/functions.sh
show_pool() {
	local name="$1" option value
	printf '[%s]\n' "$name"
	for option in interface ignore dhcpv4 start limit leasetime force dynamicdhcp dynamicdhcpv4 ra dhcpv6 ndp master; do
		config_get value "$name" "$option"
		[ -z "$value" ] || printf '%s=%s\n' "$option" "$value"
	done
}
config_load dhcp
config_foreach show_pool dhcp
printf 'maindhcp=%s\n' "$(uci -q get dhcp.odhcpd.maindhcp)"

section effective-dhcpv4
for file in /var/etc/dnsmasq.conf.*; do
	[ -r "$file" ] || continue
	printf '%s\n' "$file"
	sed -n '/^dhcp-/p; /^no-dhcp-interface=/p; /^interface=/p; /^except-interface=/p; /^bind-/p; /^dhcp-leasefile=/p' "$file"
done
for file in /var/run/dnsmasq*.dhcp; do
	[ -r "$file" ] || continue
	printf '%s: ' "$file"
	cat "$file"
	printf '\n'
done

section udp-listeners
netstat -ulnp 2>&1

section dnsmasq-processes
for pid in $(pidof dnsmasq); do
	[ -r "/proc/$pid/status" ] || continue
	sed -n '/^Name:/p; /^State:/p; /^Pid:/p; /^PPid:/p; /^SigIgn:/p; /^SigCgt:/p' "/proc/$pid/status"
done

section recent-dhcp-events
logread | grep -E 'dnsmasq|odhcpd|router-tool' | tail -n 160

section offload-resources
for file in /sys/kernel/debug/*/flow_resources /sys/kernel/debug/ppe/resource_stats /sys/kernel/debug/ppe/reason_counters /sys/kernel/debug/*edma*/matrix_snapshot; do
	[ -r "$file" ] || continue
	printf '%s\n' "$file"
	cat "$file"
done

section nss-offload-resources
for file in /sys/kernel/debug/*nss*/flows; do
	[ -r "$file" ] || continue
	printf '%s\n' "$file"
	# Keep resource and failure summaries without dumping connection tuples.
	sed -n '/^bound /p; /^buffers /p; /^rejected/p; /^resource /p; /^capacity /p; /^retirement /p; /^sweep /p; /^bridged /p' "$file"
done

exit 0
