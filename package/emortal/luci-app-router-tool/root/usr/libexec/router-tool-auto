#!/usr/bin/ucode
'use strict';
import { cursor } from 'uci';
import { readfile, open, mkdir, stat, writefile, unlink } from 'fs';
import { connect } from 'ubus';
import { openlog, syslog, closelog, LOG_PID, LOG_DAEMON, LOG_DEBUG, LOG_INFO, LOG_NOTICE, LOG_WARNING, LOG_ERR } from 'log';
import { synchronize } from '/usr/share/router-tool/auto.uc';
import { synchronize_wireless } from '/usr/share/router-tool/wireless.uc';
import { read_snapshot, check_snapshot } from '/usr/share/router-tool/snapshot.uc';
import { configuration, transaction, save_transaction, commit_transaction } from '/usr/share/router-tool/transaction.uc';

const transaction_path = '/etc/router-tool/pending.json';

function format_addresses(value) {
	if (type(value) == 'array')
		return join(', ', map(value, address => sprintf('%J', address)));
	return sprintf('%J', value);
}

// Keep interface events quiet unless the state or the failure changes.
function log_once(priority, key, message) {
	let path = '/var/run/router-tool-log-' + key;
	if (readfile(path) == message) return;
	syslog(priority, '%s', message);
	writefile(path, message);
}

openlog('router-tool', LOG_PID, LOG_DAEMON);
let stage = 'configuration lock';
let lock;
let committed = [];
try {
	lock = open('/var/lock/router-tool.lock', 'a');
	if (!lock || !lock.lock('x')) die('Cannot lock router tool configuration');
	if (stat('/etc/uci-defaults/90-router-tool-migrate'))
		die('Router tool configuration migration is pending; complete the uci-defaults script first');
	// LuCI uses session-specific deltas. Also avoid consuming unapplied CLI edits.
	for (let config in [ 'network', 'dhcp', 'firewall', 'router-tool' ])
		if (stat('/tmp/.uci/' + config)?.size) {
			log_once(LOG_NOTICE, 'pending', 'Unapplied CLI changes found; automatic configuration is deferred');
			closelog();
			exit(0);
		}
	unlink('/var/run/router-tool-log-pending');
	stage = 'configuration loading';
	mkdir('/var/run/router-tool-delta', 0700);
	// Recompute an interrupted transaction from committed state. This
	// directory belongs exclusively to this helper, under the same lock.
	for (let config in [ 'network', 'dhcp', 'firewall', 'wireless', 'router-tool' ])
		unlink('/var/run/router-tool-delta/' + config);
	let uci = cursor('/etc/config', '/var/run/router-tool-delta', '');
	function commit(state) {
		return commit_transaction(state, transaction_path,
			name => { stage = 'commit ' + name; },
			name => { push(committed, name); syslog(LOG_INFO, '%s', 'Committed configuration: ' + name); },
			cursor('/etc/config', '/var/run/router-tool-delta', ''));
	}
	if (stat(transaction_path)) {
		stage = 'transaction recovery';
		// A previously deferred wireless edit must not be consumed on recovery.
		if (stat('/tmp/.uci/wireless')?.size || stat('/tmp/.uci/router-tool')?.size)
			die('Unapplied wireless or router-tool changes defer transaction recovery');
		let recovered = commit(json(readfile(transaction_path)));
		syslog(LOG_NOTICE, '%s', 'Recovered interrupted configuration transaction');
		if (length(recovered)) print(join(' ', recovered), '\n');
		closelog();
		exit(0);
	}
	let before = configuration(uci);
	let changed = [];
	let ap = uci.get('router-tool', 'main', 'ap_mode') == '1';
	let missing_snapshot = ap && !uci.get('router-tool', 'main', 'ap_state');
	if (missing_snapshot) {
		let marker = '/var/run/router-tool-ap-warning';
		// Interface events may be frequent; warn at most once per boot.
		if (!stat(marker)) {
			writefile(marker, '1\n');
			syslog(LOG_WARNING, '%s', 'AP mode flag is set without a saved LuCI snapshot; automatic AP conversion is skipped');
		}
		closelog();
		exit(0);
	}
	if (!ap && uci.get('router-tool', 'main', 'ap_state'))
		die('Mode switch refused: an AP snapshot exists while AP mode is disabled; restore AP mode and use LuCI to switch back');
	if (ap) check_snapshot(uci, read_snapshot(uci.get('router-tool', 'main', 'ap_state'), 'ap'));
	let upstream = [];
	if (!ap) {
		try {
			let bus = connect();
			let status = bus?.call('network.interface.wan', 'status', {});
			if (status?.up && status.proto == uci.get('network', 'wan', 'proto'))
				upstream = map(status['ipv4-address'] || [], address => `${address.address}/${address.mask}`);
			bus?.disconnect();
			if (status) unlink('/var/run/router-tool-log-wan');
			else log_once(LOG_DEBUG, 'wan', 'WAN status is unavailable; LAN subnet check awaits the next interface event');
		}
		catch (e) {
			log_once(LOG_WARNING, 'wan', 'WAN status query failed; LAN subnet check deferred: ' + e.message);
		}
	}
	stage = 'preset loading';
	let data = json(readfile('/usr/share/router-tool/auto.json'));
	if (!data) die('Cannot read router tool presets');
	stage = 'preset synchronization';
	let previous_lan = uci.get('network', 'lan', 'ipaddr');
	let release = readfile('/etc/openwrt_release') || '';
	let target = match(release, /(^|\n)DISTRIB_TARGET=['"]?([^'"\r\n]+)/)?.[2];
	for (let config in synchronize(uci, data, upstream, target))
		if (index(changed, config) < 0) push(changed, config);
	stage = 'wireless defaults';
	if (stat('/tmp/.uci/wireless')?.size) {
		log_once(LOG_NOTICE, 'wireless-pending', 'Unapplied CLI wireless changes found; wireless defaults are deferred');
	}
	else {
		unlink('/var/run/router-tool-log-wireless-pending');
		let board = null;
		let text = readfile('/etc/board.json');
		try {
			if (text) board = json(text);
			unlink('/var/run/router-tool-log-wireless-board');
		}
		catch (e) {
			log_once(LOG_WARNING, 'wireless-board', 'Wireless board capabilities are invalid; defaults deferred: ' + e.message);
		}
		if (board) {
			let wireless_changed = synchronize_wireless(uci, board);
			if (wireless_changed) for (let config in wireless_changed)
				if (index(changed, config) < 0) push(changed, config);
		}
	}
	if (length(changed)) {
		log_once(LOG_INFO, 'update', 'Applying configuration updates: ' + join(' ', changed));
		let next_lan = uci.get('network', 'lan', 'ipaddr');
		if (sprintf('%J', previous_lan) != sprintf('%J', next_lan))
			log_once(LOG_NOTICE, 'lan', sprintf('LAN subnet overlaps WAN; changing %s to %s', format_addresses(previous_lan), format_addresses(next_lan)));
	}
	if (length(changed)) {
		stage = 'transaction persistence';
		let pending = transaction(uci, before);
		save_transaction(transaction_path, pending);
		changed = commit(pending);
	}
	let mode = ap ? 'ap' : uci.get('network', 'wan', 'proto') == 'pppoe' ? 'main' : 'sub';
	let status = sprintf('%J', { mode: missing_snapshot ? 'ap-pending' : mode,
		lan_proto: uci.get('network', 'lan', 'proto'), lan_address: uci.get('network', 'lan', 'ipaddr') });
	if (readfile('/var/run/router-tool-status') != status) {
		if (!missing_snapshot)
			syslog(LOG_INFO, '%s', sprintf('Configuration mode: %s; LAN protocol: %s; LAN IPv4: %s',
				mode, uci.get('network', 'lan', 'proto'), format_addresses(uci.get('network', 'lan', 'ipaddr'))));
		writefile('/var/run/router-tool-status', status);
	}
	if (readfile('/var/run/router-tool-log-error'))
		syslog(LOG_NOTICE, '%s', 'Automatic configuration recovered from the previous failure');
	unlink('/var/run/router-tool-log-error');
	unlink('/var/run/router-tool-log-update');
	unlink('/var/run/router-tool-log-lan');
	// stdout is the init script's reload protocol, never a diagnostic stream.
	if (length(changed)) print(join(' ', changed), '\n');
}
catch (e) {
	let message = 'Failed during ' + stage + ': ' + e.message;
	log_once(LOG_ERR, 'error', message);
	warn('router-tool: ' + message + '\n');
	// The service retains reload requests for files already committed even
	// when a later commit fails. It dispatches them after a successful retry.
	if (length(committed)) print(join(' ', committed), '\n');
	closelog();
	exit(1);
}
closelog();
