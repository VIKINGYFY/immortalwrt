#!/bin/sh /etc/rc.common

START=19
STOP=89
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/tmi-poe run
	procd_set_param file /etc/config/tmi-poe
	procd_set_param term_timeout 8
	procd_set_param stdout 1
	procd_set_param stderr 1
	# Do not repeatedly reset PoE after a missing controller or failed init.
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger tmi-poe
}

reload_service() {
	# The daemon validates the complete new policy before touching hardware.
	if procd_running tmi-poe; then
		procd_send_signal tmi-poe '*' HUP
	else
		start
	fi
}
