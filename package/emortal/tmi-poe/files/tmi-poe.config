config poe 'main'
	option enabled '1'
	# Normal logs report transitions once; enable raw diagnostics only if needed.
	# option debug '0'
	# Automatic af/at and Class4+ PD detection; no forced power-on.
	# Set class4plus to 0 only to restrict detection to standard af/at.
	# option class4plus '1'
	# Omit budget_mw to use the factory board budget (P5 60000; P8 105000).
	# Lower budgets are accepted; values above the board limit are rejected.
	# These defaults require the original supply: P5 53V/1.25A, P8 53V/2.3A.
	# With a smaller replacement supply, allow for router power and losses.
	# Example: conservative starting budget for P8 using 53V/1.25A:
	# option budget_mw '30000'
	# list disabled_ports 'lan1'
