#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_service() {
	[ "$(board_name)" = "verizon,cr1000a" ] || return 0

	local helper
	# Independent one-shot instances: optional data storage cannot block LAN.
	for helper in rtl aqr mmc; do
		procd_open_instance "$helper"
		procd_set_param command /lib/$helper/init.sh
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	done
}
