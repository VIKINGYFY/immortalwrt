#!/bin/sh /etc/rc.common
# The radios choose ring ownership at probe. Changing it requires a reboot.
# shellcheck disable=SC2034
START=19
USE_PROCD=1

PENDING=/etc/nss-wifi.pending
LOCK=/var/run/nss-wifi-start.lock

wifi_load_host() {
	nss_module_present ath11k && modprobe ath11k 2>/dev/null
	nss_module_present ath11k_ahb && modprobe ath11k_ahb 2>/dev/null
	nss_module_present ath11k_pci && modprobe ath11k_pci 2>/dev/null
	return 0
}

nss_module_present() {
	local file

	for file in /lib/modules/"$(uname -r)"/"$1".ko*; do
		[ -f "$file" ] && return 0
	done
	return 1
}

# An ath10k AIoT radio can register a PHY before the ath11k service starts.
# Only ath11k owns the WLAN rings whose offload mode is fixed at probe.
wifi_ath11k_probed() {
	local phy driver

	for phy in /sys/class/ieee80211/phy*; do
		[ -e "$phy/device/driver" ] || continue
		driver=$(readlink -f "$phy/device/driver" 2>/dev/null) || continue
		case "$driver" in
			*/ath11k|*/ath11k_pci) return 0 ;;
		esac
	done
	return 1
}

# A multi-profile build can include ath11k but omit it from this image.
# Check both the installed integration and the physical, enabled targets.
# Keep crash dumps available without holding AHB recovery until userspace
# releases an inline dump (up to five minutes on an unattended router).
wifi_prepare_recovery() {
	local node mode

	for node in /sys/class/remoteproc/remoteproc*; do
		grep -qsE 'qcom,ipq(6018|8074)-wcss-sec-pil' \
			"$node/device/of_node/compatible" || continue
		[ -r "$node/coredump" ] || continue
		read -r mode < "$node/coredump" || continue
		[ "$mode" = inline ] || continue
		if ! echo enabled > "$node/coredump"; then
			logger -t nss-wifi "cannot enable nonblocking AHB crash dumps"
			return 1
		fi
	done
	return 0
}

nss_wlan_buses() {
	local node status vendor device start end flags wlan=0

	if [ "$(cat /usr/share/nss-wifi/wlan 2>/dev/null)" != 1 ] ||
	   ! nss_module_present ath11k; then
		echo 0
		return
	fi
	if nss_module_present ath11k_ahb; then
		for node in /proc/device-tree/soc*/wifi@*; do
			grep -qsE 'qcom,ipq(8074|6018)-wifi' "$node/compatible" || continue
			status=
			[ ! -e "$node/status" ] || status=$(tr -d '\000' < "$node/status")
			case "$status" in
				''|ok|okay) wlan=$((wlan | 1)) ;;
				*) continue ;;
			esac
		done
	fi
	if nss_module_present ath11k_pci; then
		for node in /sys/bus/pci/devices/*; do
			read -r vendor < "$node/vendor" 2>/dev/null || continue
			read -r device < "$node/device" 2>/dev/null || continue
			[ "$vendor:$device" = 0x17cb:0x1104 ] || continue
			read -r start end flags < "$node/resource" || continue
			[ "$((start))" -le 4294967295 ] || continue
			wlan=$((wlan | 2))
		done
	fi
	echo "$wlan"
}

nss_state_has() {
	local state
	[ -r "$dir/state" ] || return 1
	read -r state < "$dir/state" || return 1
	case " $state " in
		*" $1 "*) return 0 ;;
	esac
	return 1
}

nss_start() {
	local dir fw i token wlan

	dir=/sys/bus/platform/devices/39000000.nss
	# Check before touching pending or boot: repeated service actions must
	# leave an already healthy data plane and its boot guard intact.
	if nss_state_has ready=1; then
		[ "$(uci -q get nss-wifi.general.offload)" = 1 ] ||
			logger -t nss-wifi "offload is running; reboot to apply the changed setting"
		return 0
	fi
	if nss_state_has running=1; then
		logger -t nss-wifi "core is running with incomplete WLAN state; reboot to recover"
		return 1
	fi
	[ "$(uci -q get nss-wifi.general.offload)" = 1 ] || {
		wifi_load_host
		return 0
	}
	[ -e "$PENDING" ] && {
		logger -t nss-wifi "offload skipped: $(cat "$PENDING"); remove $PENDING to retry after reboot"
		wifi_load_host
		return 0
	}
	wlan=$(nss_wlan_buses)
	if [ "$wlan" -ne 0 ] && wifi_ath11k_probed; then
		logger -t nss-wifi "WLAN already probed; reboot to select offload"
		return 1
	fi
	token="$(cat /proc/sys/kernel/random/boot_id):$$"
	echo "$token" > "$PENDING"
	sync
	# OpenWrt modprobe ignores arguments after the module name. The
	# directory loader applies parameters while resolving dependencies.
	mkdir "$LOCK/modules" || return 1
	printf 'nss-wifi-drv wlan=%s\n' "$wlan" > "$LOCK/modules/nss-wifi"
	kmodloader "$LOCK/modules/" 2>/dev/null
	rm -f "$LOCK/modules/nss-wifi"
	rmdir "$LOCK/modules"
	[ -e "$dir/state" ] || {
		logger -t nss-wifi "no NSS core; using the host path"
		rm -f "$PENDING"
		wifi_load_host
		return 0
	}
	if [ "$(cat /sys/module/nss_wifi_drv/parameters/wlan)" != "$wlan" ]; then
		logger -t nss-wifi "WLAN bus selection already fixed; reboot to apply it"
		return 1
	fi
	fw=$(uci -q get nss-wifi.general.firmware) &&
		printf %s "$fw" > /sys/module/nss_wifi_drv/parameters/firmware
	if [ "$wlan" -ne 0 ]; then
		modprobe ath11k 2>/dev/null
		if ! echo 1 > /sys/module/ath11k/parameters/nss_offload 2>/dev/null; then
			logger -t nss-wifi "ath11k offload unavailable; using the host path"
			rm -f "$PENDING"
			wifi_load_host
			return 0
		fi
		if ! echo 2 > /sys/module/ath11k/parameters/frame_mode 2>/dev/null; then
			echo 0 > /sys/module/ath11k/parameters/nss_offload 2>/dev/null
			rm -f "$PENDING"
			wifi_load_host
			return 0
		fi
		if [ "$((wlan & 1))" -ne 0 ]; then
			wifi_prepare_recovery || return 1
			modprobe ath11k_ahb 2>/dev/null
		fi
		[ "$((wlan & 2))" -eq 0 ] || modprobe ath11k_pci 2>/dev/null
	else
		# Other ath11k hardware can still use its host path. A NO WIFI
		# image has none of these modules, so this loads nothing there.
		if nss_module_present ath11k; then
			modprobe ath11k 2>/dev/null
			[ ! -e /sys/module/ath11k/parameters/nss_offload ] ||
				echo 0 > /sys/module/ath11k/parameters/nss_offload
		fi
	fi
	i=0
	while [ "$i" -lt 60 ]; do
		nss_state_has rings_ready=1 && break
		sleep 1
		i=$((i + 1))
	done
	if ! nss_state_has rings_ready=1; then
		echo "WLAN ring descriptions incomplete" > "$PENDING"
		logger -t nss-wifi "WLAN ring descriptions incomplete; NSS remains stopped"
		return 1
	fi
	if ! echo 1 > "$dir/boot"; then
		echo "NSS core boot failed" > "$PENDING"
		logger -t nss-wifi "NSS core boot failed"
		return 1
	fi
	if [ "$wlan" -ne 0 ] && ! echo 1 > "$dir/wifi_start"; then
		echo "WiFiLi initialization incomplete" > "$PENDING"
		logger -t nss-wifi "WiFiLi initialization incomplete; reboot to recover"
		return 1
	fi
	if ! nss_state_has ready=1; then
		echo "NSS data plane incomplete" > "$PENDING"
		logger -t nss-wifi "NSS data plane incomplete; reboot to recover"
		return 1
	fi
	[ "$wlan" -ne 0 ] || logger -t nss-wifi "non-WLAN offload ready; no ath11k bus required"
	# Probe any remaining host-only bus after NSS has finished its handover.
	wifi_load_host
	# An older checker cannot clear a newer boot's failure marker.
	(
	 # The delayed checker must not retain rc.common/procd's flock.
	 # BusyBox ash supports the same fd 1000 used by procd.sh.
	 # shellcheck disable=SC3023
	 exec 1000>&-
	 sleep 120
	 [ "$(cat "$PENDING" 2>/dev/null)" = "$token" ] &&
	 nss_state_has ready=1 || exit 0
	 rm -f "$PENDING"
	 sync
	 logger -t nss-wifi "bring-up survived; NSS data plane ready"
	) </dev/null >/dev/null 2>&1 &
}

start_service() {
	local owner ret
	if ! mkdir "$LOCK" 2>/dev/null; then
		owner=$(cat "$LOCK/pid" 2>/dev/null)
		if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then
			rm -f "$LOCK/modules/nss-wifi"
			rmdir "$LOCK/modules" 2>/dev/null
			rm -f "$LOCK/pid"
			rmdir "$LOCK" 2>/dev/null
			mkdir "$LOCK" 2>/dev/null || return 1
		else
			logger -t nss-wifi "another bring-up is in progress"
			return 1
		fi
	fi
	echo $$ > "$LOCK/pid"
	nss_start
	ret=$?
	rm -f "$LOCK/pid"
	rmdir "$LOCK" 2>/dev/null
	return "$ret"
}

reload_service() {
	start_service
}

stop_service() {
	logger -t nss-wifi "WLAN ring ownership is chosen at probe; reboot to change it"
}
