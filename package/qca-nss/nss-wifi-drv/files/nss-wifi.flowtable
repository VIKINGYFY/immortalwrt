#!/bin/sh
# fw4 include and NSS startup hook. Upstream fw4 now discovers L3 devices,
# including raw-IP modems, so no separate flowtable edits are needed here.
# A selected bridge scope belongs to nf_flowtable; stop the independent
# fallback learner so it cannot re-learn connections on excluded bridges.

param=/sys/module/nss_wifi_drv/parameters/bridge_offload
[ -w "$param" ] || exit 0
bridge_offload=1
for option in flow_offloading flow_offloading_hw; do
	value=$(uci -q get "firewall.@defaults[0].$option")
	case "$value" in 1|true|on|yes) ;; *) bridge_offload=0 ;; esac
done
value=$(uci -q get 'firewall.@defaults[0].flow_offloading_bridge')
case "$value" in 0|false|off|no) bridge_offload=0 ;; esac
for option in flow_offloading_bridge_devices flow_offloading_bridge_exclude; do
	[ -z "$(uci -q get "firewall.@defaults[0].$option")" ] || bridge_offload=0
done
printf '%s\n' "$bridge_offload" > "$param" || {
	logger -t nss-wifi "failed to apply firewall bridge scope"
	exit 1
}
