# NSS data path. '1' enables NSS at boot, including USB/raw-IP forwarding
# without Wi-Fi. Supported ath11k buses are selected when installed and
# physically available; a NO WIFI image starts no WLAN instances.
# Anything else leaves NSS stopped and the radios on their host path.
#
#	uci set nss-wifi.general.offload='0'; uci commit nss-wifi; reboot
#
# The decision is a module parameter the radios read at probe, so it cannot be
# changed without a reboot.
#
# 'firmware' is the NSS firmware line booted: '12.5', or '11.4', the line that
# forwards an 802.11s mesh.
# Both firmware lines negotiate 4096 connections per address family by default
# (8192 combined). The automatic payload ceiling is 24576 with WLAN, 16384
# without it. Override before reboot, e.g. option param 'connections=1024'.
# Connections allow 1024 steps up to 4096. A rejected table handover stops NSS.
config general 'general'
	option offload '1'
	option firmware '12.5'
