#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

RGB_UCODE=/usr/libexec/be10000-rgb.uc

is_be10000()
{
[ "$(board_name)" = "xiaomi,be10000" ]
}

set_off()
{
local led

for led in red green blue; do
[ -e "/sys/class/leds/$led:ambient/brightness" ] &&
echo 0 >"/sys/class/leds/$led:ambient/brightness"
done
}

start_service()
{
is_be10000 || return 0
[ -x "$RGB_UCODE" ] || return 1

procd_open_instance
procd_set_param command "$RGB_UCODE"
procd_set_param respawn 3600 5 5
procd_set_param stdout 1
procd_set_param stderr 1
procd_close_instance
}

service_triggers()
{
procd_add_reload_trigger be10000_rgb
}

stop_service()
{
is_be10000 && set_off
}
