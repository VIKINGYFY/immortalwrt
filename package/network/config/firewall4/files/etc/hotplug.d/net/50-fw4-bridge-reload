#!/bin/sh
#
# A recreated Wi-Fi AP interface loses its flowtable hooks. Refresh existing
# routed and bridge flowtables when the new interface is missing.

[ "$ACTION" = "add" ] || exit 0
/etc/init.d/firewall enabled || exit 0

case "${DEVICENAME}" in
	phy*-ap*|wl*-ap*|ap-mld*) ;;
	*) exit 0 ;;
esac

needs_reload() {
	local spec listing

	for spec in "inet fw4 ft" "bridge fw4 fb"; do
		set -- $spec
		listing="$(nft list flowtable "$@" 2>/dev/null)" || continue
		printf '%s\n' "$listing" | grep -Fq "\"${DEVICENAME}\"" || return 0
	done

	return 1
}

(
	exec 9>/var/lock/fw4-bridge-reload.lock
	# Queue concurrent additions so an event during a reload is not lost.
	flock 9 || exit 0
	needs_reload || exit 0
	sleep 2
	needs_reload || exit 0
	/etc/init.d/firewall reload >/dev/null 2>&1
) &

exit 0
