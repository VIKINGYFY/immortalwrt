From: ViKing <viking.yfy@qq.com>
Date: Tue, 17 Nov 2026 11:53:00 +0800
Subject: [PATCH] firewall4: preserve active rules and state on render failure

A renderer can fail after emitting a valid table flush. Piping that partial
output into nft clears the active rules even though reload reports failure.
Render the complete batch under the firewall lock before applying it. Save
and restore the previous state when rendering or nft application fails.
Stage set reloads too, retaining the lock until the nft transaction finishes.

Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/root/sbin/fw4
+++ b/root/sbin/fw4
@@ -27,16 +27,38 @@ start() {
 			reload)
 				[ ! -f $STATE ] && die "The fw4 firewall does not appear to be loaded."
 
-				# Delete state to force reloading ubus state
-				rm -f $STATE
+				# Reload ubus state only after saving the active state below.
 			;;
 		esac
 
-		ACTION=start \
-			utpl -S $MAIN | nft $VERBOSE -f $STDIN || return $?
+		local batch saved had_state=0 result
+		batch=$(mktemp /tmp/fw4-start.XXXXXX) || return 1
+		saved=$(mktemp /tmp/fw4-state.XXXXXX) || { rm -f "$batch"; return 1; }
+		if [ -f "$STATE" ]; then
+			cp -p "$STATE" "$saved" || { rm -f "$batch" "$saved"; return 1; }
+			had_state=1
+		fi
+		rm -f "$STATE"
 
-		ACTION=includes \
-			utpl -S $MAIN
+		# A failed renderer can emit a valid flush prefix. Never apply it.
+		ACTION=start utpl -S $MAIN > "$batch"
+		result=$?
+		if [ "$result" -eq 0 ]; then
+			nft $VERBOSE -f "$batch"
+			result=$?
+		fi
+		if [ "$result" -ne 0 ]; then
+			if [ "$had_state" -eq 1 ]; then
+				cp -p "$saved" "$STATE"
+			else
+				rm -f "$STATE"
+			fi
+		else
+			ACTION=includes utpl -S $MAIN
+			result=$?
+		fi
+		rm -f "$batch" "$saved"
+		return "$result"
 	} 1000>$LOCK
 }
 
@@ -107,8 +129,20 @@ flush() {
 }
 
 reload_sets() {
-	ACTION=reload-sets \
-		flock -x $LOCK utpl -S $MAIN | nft $VERBOSE -f $STDIN || return $?
+	{
+		flock -x 1000
+
+		local batch result
+		batch=$(mktemp /tmp/fw4-sets.XXXXXX) || return 1
+		ACTION=reload-sets utpl -S $MAIN > "$batch"
+		result=$?
+		if [ "$result" -eq 0 ]; then
+			nft $VERBOSE -f "$batch"
+			result=$?
+		fi
+		rm -f "$batch"
+		return "$result"
+	} 1000>$LOCK
 }
 
 lookup() {
