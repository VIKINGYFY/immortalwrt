#!/bin/sh

# Retry configured ath12k radios when their PHY becomes available.

[ "${ACTION}" = "add" ] || exit 0
# wifi config may already have renamed the PHY in 10-wifi-detect.
# Its parent device remains stable across that rename.
grep -qsE '^DRIVER=ath12k(_wifi7)?_(pci|ahb)$' \
	"/sys${DEVPATH%/ieee80211/*}/uevent" || exit 0

ucode - <<'EOF'
import { realpath } from 'fs';
import { connect } from 'ubus';
import { find_phy } from 'wifi.utils';

let devpath = getenv('DEVPATH');
let pos = index(devpath, '/ieee80211/');
if (pos < 0)
	exit(0);

let device = realpath('/sys' + substr(devpath, 0, pos));
let bus = connect();
if (!device || !bus)
	exit(0);

let status = bus.call('network.wireless', 'status', {});
for (let radio, state in status) {
	if (state.up || state.disabled || !state.autostart ||
	    (!state.pending && !state.retry_setup_failed))
		continue;

	let phy = find_phy(state.config, true);
	if (!phy || realpath(`/sys/class/ieee80211/${phy}/device`) != device)
		continue;

	// netifd queues a retry when PHY arrival overlaps a running setup.
	bus.call('network.wireless', 'retry', { device: radio });
}
EOF
