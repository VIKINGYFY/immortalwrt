+static bool nl80211_read_phandle(const char *path, uint32_t *phandle)
+{
+	int fd = open(path, O_RDONLY);
+	ssize_t n;
+
+	if (fd < 0)
+		return false;
+
+	n = read(fd, phandle, sizeof(*phandle));
+	close(fd);
+	return n == sizeof(*phandle);
+}
+
+static bool nl80211_pci_is_wsi_peer(const char *phy, const char *pci_path)
+{
+	glob_t local_endpoints, peer_endpoints;
+	char path[PATH_MAX];
+	int i, j;
+	bool linked = false;
+
+	snprintf(path, sizeof(path),
+	         "/sys/class/ieee80211/%s/device/of_node/ports/*/endpoint*/remote-endpoint",
+	         phy);
+	if (glob(path, 0, NULL, &local_endpoints))
+		return false;
+
+	snprintf(path, sizeof(path), "%s/of_node/ports/*/endpoint*/phandle", pci_path);
+	if (glob(path, 0, NULL, &peer_endpoints))
+	{
+		globfree(&local_endpoints);
+		return false;
+	}
+
+	for (i = 0; i < local_endpoints.gl_pathc && !linked; i++)
+	{
+		uint32_t remote;
+
+		if (!nl80211_read_phandle(local_endpoints.gl_pathv[i], &remote))
+			continue;
+
+		for (j = 0; j < peer_endpoints.gl_pathc; j++)
+		{
+			uint32_t peer;
+
+			if (nl80211_read_phandle(peer_endpoints.gl_pathv[j], &peer) &&
+			    remote == peer)
+			{
+				linked = true;
+				break;
+			}
+		}
+	}
+
+	globfree(&peer_endpoints);
+	globfree(&local_endpoints);
+	return linked;
+}
+
+static bool nl80211_get_wsi_pci_hardware(const char *ifname,
+					 struct iwinfo_hardware_entry *result)
+{
+	char path[PATH_MAX], value[16];
+	char *phy = nl80211_ifname2phy(ifname);
+	glob_t devices;
+	int i;
+	bool found = false;
+	bool ambiguous = false;
+
+	if (!phy || glob("/sys/bus/pci/devices/*", 0, NULL, &devices))
+		return false;
+
+	for (i = 0; i < devices.gl_pathc; i++)
+	{
+		struct iwinfo_hardware_id id = {};
+		const struct iwinfo_hardware_entry *hw;
+		struct iwinfo_hardware_entry candidate;
+		const char *pci_path = devices.gl_pathv[i];
+
+		if (!nl80211_pci_is_wsi_peer(phy, pci_path))
+			continue;
+
+		snprintf(path, sizeof(path), "%s/vendor", pci_path);
+		if (nl80211_readstr(path, value, sizeof(value)) <= 0 ||
+		    !(id.vendor_id = strtoul(value, NULL, 16)))
+			continue;
+
+		snprintf(path, sizeof(path), "%s/device", pci_path);
+		if (nl80211_readstr(path, value, sizeof(value)) <= 0 ||
+		    !(id.device_id = strtoul(value, NULL, 16)))
+			continue;
+
+		snprintf(path, sizeof(path), "%s/subsystem_vendor", pci_path);
+		if (nl80211_readstr(path, value, sizeof(value)) > 0)
+			id.subsystem_vendor_id = strtoul(value, NULL, 16);
+
+		snprintf(path, sizeof(path), "%s/subsystem_device", pci_path);
+		if (nl80211_readstr(path, value, sizeof(value)) > 0)
+			id.subsystem_device_id = strtoul(value, NULL, 16);
+
+		hw = iwinfo_hardware(&id);
+		if (!hw || !hw->vendor_name[0] || !hw->device_name[0] || hw->compatible[0])
+			continue;
+
+		candidate = *hw;
+		if (!found)
+		{
+			*result = candidate;
+			found = true;
+		}
+		else if (strcmp(result->vendor_name, candidate.vendor_name) ||
+		         strcmp(result->device_name, candidate.device_name))
+		{
+			ambiguous = true;
+			break;
+		}
+	}
+
+	globfree(&devices);
+	return found && !ambiguous;
+}
+
 static int nl80211_get_hardware_name(const char *ifname, char *buf)
 {
 	const struct iwinfo_hardware_entry *hw;
+	struct iwinfo_hardware_entry embedded, pci;
+	int frequency;
 
 	if (!(hw = nl80211_get_hardware_entry(ifname)))
 		sprintf(buf, "Generic MAC80211");
 	else
-		sprintf(buf, "%s %s", hw->vendor_name, hw->device_name);
+	{
+		embedded = *hw;
+		if (embedded.compatible[0] &&
+		    !nl80211_get_frequency(ifname, &frequency) &&
+		    frequency >= 4900 && frequency < 7125 &&
+		    nl80211_get_wsi_pci_hardware(ifname, &pci))
+			sprintf(buf, "%s %s", pci.vendor_name, pci.device_name);
+		else
+			sprintf(buf, "%s %s", embedded.vendor_name, embedded.device_name);
+	}
 
 	return 0;
 }
