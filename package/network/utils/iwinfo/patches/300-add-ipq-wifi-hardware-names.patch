+static int nl80211_radio_idx_from_uci(const char *name)
+{
+	struct uci_section *s;
+	const char *opt;
+	char *end;
+	long index = -1;
+
+	s = iwinfo_uci_get_radio(name, "mac80211");
+	if (s && (opt = uci_lookup_option_string(uci_ctx, s, "radio")))
+	{
+		index = strtol(opt, &end, 10);
+		if (!*opt || *end || index < 0 || index >= 32)
+			index = -1;
+	}
+
+	iwinfo_uci_free();
+	return index;
+}
