+struct nl80211_radio_range {
+	uint32_t start;
+	uint32_t end;
+	struct nl80211_radio_range *next;
+};
+
+struct nl80211_radio_filter {
+	uint32_t mask;
+	bool found;
+	bool failed;
+	struct nl80211_radio_range *ranges;
+};
+
+static void nl80211_radio_filter_free(struct nl80211_radio_filter *filter)
+{
+	struct nl80211_radio_range *range;
+
+	while ((range = filter->ranges))
+	{
+		filter->ranges = range->next;
+		free(range);
+	}
+}
+
+static int nl80211_get_radio_filter_cb(struct nl_msg *msg, void *arg)
+{
+	struct nl80211_radio_filter *filter = arg;
+	struct nlattr **attr = nl80211_parse(msg);
+	struct nlattr *tb[NL80211_WIPHY_RADIO_ATTR_MAX + 1];
+	struct nlattr *freq[NL80211_WIPHY_RADIO_FREQ_ATTR_MAX + 1];
+	struct nlattr *radio, *item;
+	int rem, rem_item;
+	uint32_t index;
+
+	if (!attr[NL80211_ATTR_WIPHY_RADIOS])
+		return NL_SKIP;
+
+	nla_for_each_nested(radio, attr[NL80211_ATTR_WIPHY_RADIOS], rem)
+	{
+		nla_parse(tb, NL80211_WIPHY_RADIO_ATTR_MAX,
+		          nla_data(radio), nla_len(radio), NULL);
+		if (!tb[NL80211_WIPHY_RADIO_ATTR_INDEX])
+			continue;
+
+		index = nla_get_u32(tb[NL80211_WIPHY_RADIO_ATTR_INDEX]);
+		if (index >= 32 || !(filter->mask & (1U << index)))
+			continue;
+
+		filter->found = true;
+		nla_for_each_nested(item, radio, rem_item)
+		{
+			struct nl80211_radio_range *range;
+
+			if (nla_type(item) != NL80211_WIPHY_RADIO_ATTR_FREQ_RANGE)
+				continue;
+
+			nla_parse(freq, NL80211_WIPHY_RADIO_FREQ_ATTR_MAX,
+			          nla_data(item), nla_len(item), NULL);
+			if (!freq[NL80211_WIPHY_RADIO_FREQ_ATTR_START] ||
+			    !freq[NL80211_WIPHY_RADIO_FREQ_ATTR_END])
+				continue;
+
+			range = calloc(1, sizeof(*range));
+			if (!range)
+			{
+				filter->failed = true;
+				return NL_SKIP;
+			}
+
+			range->start = nla_get_u32(freq[NL80211_WIPHY_RADIO_FREQ_ATTR_START]);
+			range->end = nla_get_u32(freq[NL80211_WIPHY_RADIO_FREQ_ATTR_END]);
+			range->next = filter->ranges;
+			filter->ranges = range;
+		}
+	}
+
+	return NL_SKIP;
+}
+
+static int nl80211_get_radio_filter(const char *ifname,
+				   struct nl80211_radio_filter *filter)
+{
+	struct nl80211_msg_conveyor *cv;
+	struct nl80211_if_data data = {};
+	int index = nl80211_radio_idx_from_uci(ifname);
+	int flags, ret;
+
+	if (index >= 0)
+		filter->mask = 1U << index;
+	else if (nl80211_is_ifname(ifname))
+	{
+		nl80211_get_if_data(ifname, &data);
+		filter->mask = data.radio_mask;
+	}
+
+	if (!filter->mask)
+		return 0;
+
+	flags = nl80211_get_protocol_features(ifname) &
+		NL80211_PROTOCOL_FEATURE_SPLIT_WIPHY_DUMP ? NLM_F_DUMP : 0;
+	cv = nl80211_msg(ifname, NL80211_CMD_GET_WIPHY, flags);
+	if (!cv)
+		return -1;
+
+	NLA_PUT_FLAG(cv->msg, NL80211_ATTR_SPLIT_WIPHY_DUMP);
+	ret = nl80211_send(cv, nl80211_get_radio_filter_cb, filter);
+	return ret || filter->failed ? -1 : 0;
+
+nla_put_failure:
+	nl80211_free(cv);
+	return -1;
+}
+
+static bool nl80211_radio_freq_allowed(const struct nl80211_radio_filter *filter,
+				      uint32_t mhz)
+{
+	struct nl80211_radio_range *range;
+	uint64_t khz = (uint64_t)mhz * 1000;
+
+	if (!filter->found)
+		return true;
+
+	for (range = filter->ranges; range; range = range->next)
+		if (khz >= range->start && khz <= range->end)
+			return true;
+
+	return false;
+}
+
+static bool nl80211_radio_band_allowed(const struct nl80211_radio_filter *filter,
+				      struct nlattr *band)
+{
+	struct nlattr *tb[NL80211_BAND_ATTR_MAX + 1];
+	struct nlattr *freq[NL80211_FREQUENCY_ATTR_MAX + 1];
+	struct nlattr *item;
+	int rem;
+
+	if (!filter->found)
+		return true;
+
+	nla_parse(tb, NL80211_BAND_ATTR_MAX, nla_data(band), nla_len(band), NULL);
+	if (!tb[NL80211_BAND_ATTR_FREQS])
+		return false;
+
+	nla_for_each_nested(item, tb[NL80211_BAND_ATTR_FREQS], rem)
+	{
+		nla_parse(freq, NL80211_FREQUENCY_ATTR_MAX,
+		          nla_data(item), nla_len(item), NULL);
+		if (freq[NL80211_FREQUENCY_ATTR_FREQ] &&
+		    nl80211_radio_freq_allowed(filter,
+		        nla_get_u32(freq[NL80211_FREQUENCY_ATTR_FREQ])))
+			return true;
+	}
+
+	return false;
+}
