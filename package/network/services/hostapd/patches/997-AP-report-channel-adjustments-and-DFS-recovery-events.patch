From: ViKing <viking.yfy@qq.com>
Date: Fri, 27 Nov 2026 17:39:39 +0800
Subject: [PATCH] AP: report channel adjustments and DFS recovery events

Retain observed causes of channel changes and 20 MHz fallback.

Notify the ucode policy when a DFS non-occupancy period ends or station and AP state changes.

Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/src/ap/hostapd.h
+++ b/src/ap/hostapd.h
@@ -678,6 +678,7 @@
 		HAPD_IFACE_NO_IR,
 		HAPD_IFACE_ENABLED
 	} state;
+	const char *channel_reason;
 
 #ifdef CONFIG_MESH
 	struct mesh_conf *mconf;
--- a/src/ap/hostapd.c
+++ b/src/ap/hostapd.c
@@ -5980,6 +5980,8 @@
 		   iface->conf ? iface->conf->bss[0]->iface : "N/A",
 		   hostapd_state_text(iface->state), hostapd_state_text(s));
 	iface->state = s;
+	if (iface->num_bss && iface->bss && iface->bss[0])
+		hostapd_ucode_bss_cb(iface->bss[0], "dfs_update");
 }
 
 
--- a/src/ap/sta_info.c
+++ b/src/ap/sta_info.c
@@ -40,6 +40,7 @@
 #include "vlan.h"
 #include "wps_hostapd.h"
 #include "robust_av.h"
+#include "ucode.h"
 
 static void ap_sta_remove_in_other_bss(struct hostapd_data *hapd,
 				       struct sta_info *sta);
@@ -522,6 +523,8 @@
 #endif /* CONFIG_IEEE80211BE */
 
 	hapd->num_sta--;
+	if (hapd->iface->state == HAPD_IFACE_ENABLED)
+		hostapd_ucode_bss_cb(hapd, "dfs_update");
 	if (sta->nonerp_set) {
 		sta->nonerp_set = 0;
 		hapd->iface->num_sta_non_erp--;
@@ -1246,6 +1249,8 @@
 	sta->next = hapd->sta_list;
 	hapd->sta_list = sta;
 	hapd->num_sta++;
+	if (hapd->iface->state == HAPD_IFACE_ENABLED)
+		hostapd_ucode_bss_cb(hapd, "dfs_update");
 	ap_sta_hash_add(hapd, sta);
 	ap_sta_remove_in_other_bss(hapd, sta);
 	sta->last_seq_ctrl = WLAN_INVALID_MGMT_SEQ;
--- a/src/ap/dfs.c
+++ b/src/ap/dfs.c
@@ -20,6 +20,7 @@
 #include "drivers/driver.h"
 #include "dfs.h"
 #include "hw_features.h"
+#include "ucode.h"
 #include "crypto/crypto.h"
 
 
@@ -909,6 +910,7 @@
 		wpa_printf(MSG_DEBUG, "DFS %d chans unavailable - choose other channel: %s",
 			   res, res ? "yes": "no");
 		if (res) {
+			iface->channel_reason = "dfs_nop";
 			if (dfs_set_valid_channel(iface, skip_radar) < 0) {
 				hostapd_set_state(iface, HAPD_IFACE_DFS);
 				return 0;
@@ -1599,6 +1601,7 @@
 		if (!dfs_are_channels_overlapped(iface, freq, chan_width,
 						 cf1, cf2))
 			return 0;
+		iface->channel_reason = "dfs_radar";
 	}
 
 	if (hostapd_dfs_background_start_channel_switch(iface, freq)) {
@@ -1633,6 +1636,7 @@
 	/* TODO add correct implementation here */
 	set_dfs_state(iface, freq, ht_enabled, chan_offset, chan_width,
 		      cf1, cf2, HOSTAPD_CHAN_DFS_USABLE);
+	hostapd_ucode_bss_cb(iface->bss[0], "dfs_update");
 
 	if (iface->state == HAPD_IFACE_DFS && !iface->cac_started) {
 		/* Handle cases where all channels were initially unavailable */
--- a/src/ap/hw_features.c
+++ b/src/ap/hw_features.c
@@ -350,6 +350,8 @@
 
 static void ieee80211n_switch_pri_sec(struct hostapd_iface *iface)
 {
+	if (!iface->channel_reason)
+		iface->channel_reason = "ht_coexistence";
 	if (iface->conf->secondary_channel > 0) {
 		iface->conf->channel += 4;
 		iface->freq += 20;
@@ -461,6 +463,7 @@
 			wpa_printf(MSG_DEBUG,
 				   "HE: 40 MHz channel width is not supported in 2.4 GHz; clear secondary channel configuration");
 			iface->conf->secondary_channel = 0;
+			iface->channel_reason = "channel_blocks";
 		}
 	}
 #endif /* CONFIG_IEEE80211AX */
@@ -473,6 +476,8 @@
 		hostapd_set_oper_centr_freq_seg1_idx(iface->conf, 0);
 		hostapd_set_oper_chwidth(iface->conf, CONF_OPER_CHWIDTH_USE_HT);
 		res = 1;
+		if (!iface->channel_reason)
+			iface->channel_reason = oper40 ? "channel_blocks" : "ht_coexistence";
 		wpa_printf(MSG_INFO, "Fallback to 20 MHz");
 	}
 
@@ -600,6 +605,7 @@
 
 	wpa_printf(MSG_DEBUG,
 		   "Failed to request a scan in device, bringing up in HT20 mode");
+	iface->channel_reason = "ht_scan_failed";
 	hostapd_set_oper_centr_freq_seg0_idx(iface->conf, 0);
 	hostapd_set_oper_centr_freq_seg1_idx(iface->conf, 0);
 	hostapd_set_oper_chwidth(iface->conf, CONF_OPER_CHWIDTH_USE_HT);
