--- a/wpa_supplicant/dpp_supplicant.c
+++ b/wpa_supplicant/dpp_supplicant.c
@@ -4572,24 +4572,54 @@
 #endif /* CONFIG_DPP3 */
 
 
+static bool wpas_dpp_pmksa_exists(struct wpa_supplicant *wpa_s,
+				  struct wpa_ssid *ssid, struct wpa_bss *bss)
+{
+	const u8 *mld_addr;
+
+	/* A PMKSA of another AKM, e.g., from SAE while the AP did not offer
+	 * DPP, cannot be used for a DPP association. */
+	if (!wpa_sm_pmksa_cache_get(wpa_s->wpa, bss->bssid, NULL, ssid,
+				    WPA_KEY_MGMT_DPP))
+		return false;
+
+	/* An MLD association looks up the PMKSA by the AP MLD address. */
+	mld_addr = wpa_bss_assoc_mld_addr(wpa_s, bss, ssid);
+	if (mld_addr &&
+	    !wpa_sm_pmksa_cache_get(wpa_s->wpa, mld_addr, NULL, ssid,
+				    WPA_KEY_MGMT_DPP))
+		return false;
+
+	return true;
+}
+
+
+bool wpas_dpp_intro_needed(struct wpa_supplicant *wpa_s, struct wpa_ssid *ssid,
+			   struct wpa_bss *bss)
+{
+	const u8 *rsn;
+	struct wpa_ie_data ied;
+
+	if (!(ssid->key_mgmt & WPA_KEY_MGMT_DPP))
+		return false; /* Not using DPP AKM */
+	rsn = wpa_bss_get_rsne(wpa_s, bss, ssid, false);
+	if (rsn && wpa_parse_wpa_ie(rsn, 2 + rsn[1], &ied) == 0 &&
+	    !(ied.key_mgmt & WPA_KEY_MGMT_DPP))
+		return false; /* AP does not support DPP AKM */
+	return !wpas_dpp_pmksa_exists(wpa_s, ssid, bss);
+}
+
+
