From: Felix Fietkau <nbd@nbd.name>
Date: Thu, 19 Nov 2026 00:29:39 +0800
Subject: [PATCH] nl80211: report the channel of an MLD link in channel_info()

cfg80211 reports the channel of an interface with valid links only per
link, under NL80211_ATTR_MLO_LINKS of NL80211_CMD_GET_INTERFACE.
nl80211_channel_info() reads the top level, so it reports frequency 0
for an MLD and every OCV user fails. A non-AP MLD with OCV never
connects: "Cannot determine operating class and channel for OCI
element" at EAPOL-Key message 2/4.

Give the channel_info() driver op a link ID and read the channel of
that link for an MLD. The AP passes the link of the hapd, since the
link BSSs of an AP MLD share one driver interface. A station caller
that names no link gets the channel of the association link.

Signed-off-by: Felix Fietkau <nbd@nbd.name>

Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/src/ap/ap_drv_ops.h
+++ b/src/ap/ap_drv_ops.h
@@ -447,7 +447,8 @@
 {
 	if (!hapd->driver || !hapd->driver->channel_info)
 		return -1;
-	return hapd->driver->channel_info(hapd->drv_priv, ci);
+	return hapd->driver->channel_info(hapd->drv_priv,
+					  hostapd_mld_link_id(hapd), ci);
 }
 
 static inline int
--- a/src/ap/hostapd.h
+++ b/src/ap/hostapd.h
@@ -1094,6 +1094,15 @@
 
 #endif /* CONFIG_IEEE80211BE */
 
+static inline int hostapd_mld_link_id(struct hostapd_data *hapd)
+{
+#ifdef CONFIG_IEEE80211BE
+	if (hapd->conf->mld_ap)
+		return hapd->mld_link_id;
+#endif /* CONFIG_IEEE80211BE */
+	return -1;
+}
+
 u16 hostapd_get_punct_bitmap(struct hostapd_data *hapd);
 
 void hostapd_get_oper_chan_info_of_bss(struct hostapd_data *hapd,
--- a/src/drivers/driver.h
+++ b/src/drivers/driver.h
@@ -5069,10 +5069,12 @@
 	/**
 	 * channel_info - Get parameters of the current operating channel
 	 * @priv: Private driver interface data
+	 * @link_id: Link ID of an MLD link, or -1 for a non-MLD interface
 	 * @channel_info: Channel info structure
 	 * Returns: 0 on success, negative (<0) on failure
 	 */
-	int (*channel_info)(void *priv, struct wpa_channel_info *channel_info);
+	int (*channel_info)(void *priv, int link_id,
+			    struct wpa_channel_info *channel_info);
 
 #ifdef ANDROID
 	/**
--- a/src/drivers/driver_nl80211.c
+++ b/src/drivers/driver_nl80211.c
@@ -2076,18 +2076,46 @@
 }
 
 
+struct nl80211_channel_info_arg {
+	int link_id;
+	struct wpa_channel_info *ci;
+};
+
+
 static int get_channel_info(struct nl_msg *msg, void *arg)
 {
-	struct nlattr *tb[NL80211_ATTR_MAX + 1] = { 0 };
+	struct nlattr *msg_tb[NL80211_ATTR_MAX + 1] = { 0 };
+	struct nlattr *link_tb[NL80211_ATTR_MAX + 1];
+	struct nlattr **tb = msg_tb;
 	struct genlmsghdr *gnlh = nlmsg_data(nlmsg_hdr(msg));
-	struct wpa_channel_info *chan_info = arg;
+	struct nl80211_channel_info_arg *ci_arg = arg;
+	struct wpa_channel_info *chan_info = ci_arg->ci;
+	struct nlattr *link;
+	int rem;
 
-	nla_parse(tb, NL80211_ATTR_MAX, genlmsg_attrdata(gnlh, 0),
+	nla_parse(msg_tb, NL80211_ATTR_MAX, genlmsg_attrdata(gnlh, 0),
 		  genlmsg_attrlen(gnlh, 0), NULL);
 
 	os_memset(chan_info, 0, sizeof(struct wpa_channel_info));
 	chan_info->chanwidth = CHAN_WIDTH_UNKNOWN;
 
+	/* cfg80211 reports the channel of an MLD per link only */
+	if (ci_arg->link_id >= 0 && msg_tb[NL80211_ATTR_MLO_LINKS]) {
+		tb = NULL;
+		nla_for_each_nested(link, msg_tb[NL80211_ATTR_MLO_LINKS], rem) {
+			nla_parse(link_tb, NL80211_ATTR_MAX, nla_data(link),
+				  nla_len(link), NULL);
+			if (link_tb[NL80211_ATTR_MLO_LINK_ID] &&
+			    nla_get_u8(link_tb[NL80211_ATTR_MLO_LINK_ID]) ==
+			    ci_arg->link_id) {
+				tb = link_tb;
+				break;
+			}
+		}
+		if (!tb)
+			return NL_SKIP;
+	}
+
 	if (tb[NL80211_ATTR_WIPHY_FREQ])
 		chan_info->frequency =
 			nla_get_u32(tb[NL80211_ATTR_WIPHY_FREQ]);
@@ -2129,14 +2157,19 @@
 }
 
 
-static int nl80211_channel_info(void *priv, struct wpa_channel_info *ci)
+static int nl80211_channel_info(void *priv, int link_id,
+				struct wpa_channel_info *ci)
 {
 	struct i802_bss *bss = priv;
 	struct wpa_driver_nl80211_data *drv = bss->drv;
+	struct nl80211_channel_info_arg arg = {
+		.link_id = link_id,
+		.ci = ci,
+	};
 	struct nl_msg *msg;
 
 	msg = nl80211_bss_msg(bss, 0, NL80211_CMD_GET_INTERFACE);
-	return send_and_recv_resp(drv, msg, get_channel_info, ci);
+	return send_and_recv_resp(drv, msg, get_channel_info, &arg);
 }
 
 
--- a/wpa_supplicant/driver_i.h
+++ b/wpa_supplicant/driver_i.h
@@ -546,11 +546,14 @@
 }
 
 static inline int wpa_drv_channel_info(struct wpa_supplicant *wpa_s,
+				       int link_id,
 				       struct wpa_channel_info *ci)
 {
-	if (wpa_s->driver->channel_info)
-		return wpa_s->driver->channel_info(wpa_s->drv_priv, ci);
-	return -1;
+	if (!wpa_s->driver->channel_info)
+		return -1;
+	if (link_id < 0 && wpa_s->valid_links)
+		link_id = wpa_s->mlo_assoc_link_id;
+	return wpa_s->driver->channel_info(wpa_s->drv_priv, link_id, ci);
 }
 
 static inline int wpa_drv_pktcnt_poll(struct wpa_supplicant *wpa_s,
