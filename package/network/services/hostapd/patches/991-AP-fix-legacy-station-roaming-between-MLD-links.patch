+}
+
+
+int skip_prune_for_partner_links(struct hostapd_data *hapd,
+				 struct sta_info *sta)
+{
+#ifdef CONFIG_IEEE80211BE
+	struct sta_info *link_sta;
+	struct sta_info *new_sta;
+	struct hostapd_data *lhapd;
+
+	if (!hapd->conf->mld_ap)
+		return 0;
+
+	new_sta = ap_get_sta(hapd, sta->addr);
+	if (!new_sta)
+		return 0;
+
+	for_each_mld_link(lhapd, hapd) {
+		if (hapd == lhapd)
+			continue;
+
+		link_sta = ap_get_sta(lhapd, sta->addr);
+		if (link_sta == sta) {
+			if (!ap_sta_is_mld(hapd, new_sta) ||
+			    !ap_sta_is_mld(lhapd, sta)) {
+				wpa_printf(MSG_DEBUG,
+					   "Skip kernel delete on link %d for STA "
+					   MACSTR, hapd->mld_link_id,
+					   MAC2STR(sta->addr));
+				sta->skip_kernel_delete = true;
+			}
+			return 1;
+		}
+	}
+#endif /* CONFIG_IEEE80211BE */
+
+	return 0;
 }
 
 
@@ -389,7 +428,7 @@
 	ap_sta_free_wpa_sm(hapd, sta);
 	/* ap_free_sta() of the earlier association link station clears the
 	 * state machine of all its partner link stations, this one included. */
-	res = ap_sta_re_add(hapd, sta);
+	res = ap_sta_re_add(hapd, sta, 0);
 	sta->wpa_sm = sm;
 	if (res < 0)
 		return -1;
@@ -2393,9 +2432,13 @@
 
 
