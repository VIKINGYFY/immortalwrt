-		ap_sta_remove_link_sta(hapd, sta);
 	}
 #endif /* CONFIG_IEEE80211BE */
 
@@ -2525,6 +2571,7 @@
 	}
 
 	sta->added_unassoc = 1;
+	sta->skip_kernel_delete = false;
 	return 0;
 }
 
