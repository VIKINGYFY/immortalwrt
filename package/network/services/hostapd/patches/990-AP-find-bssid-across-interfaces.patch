Fix: resolve the BSSID of an unexpected (4-address/WDS) frame across all
hostapd interfaces, not just the one the event was reported on.
Upstream submission: deploy/0001-hostapd-AP-find-BSSID-*.patch

--- a/src/ap/drv_callbacks.c
+++ b/src/ap/drv_callbacks.c
@@ -1967,7 +1967,34 @@
 					const u8 *bssid, const u8 *addr,
 					int wds)
 {
+	struct hostapd_data *orig_hapd = hapd;
+
 	hapd = get_hapd_bssid(hapd->iface, bssid, -1);
+
+	/*
+	 * With multiple BSSes on a single wiphy (e.g. an MLD interface next
+	 * to plain AP interfaces) each BSS can live on its own
+	 * hostapd_iface. The unexpected-frame event is reported on whichever
+	 * interface received it, so the BSSID may belong to a different
+	 * hostapd_iface of the same process. Search the remaining interfaces
+	 * before giving up, otherwise 4-address (WDS) stations never get
+	 * their AP_VLAN interface created.
+	 */
+	if (hapd == NULL && orig_hapd->iface->interfaces) {
+		size_t i;
+
+		for (i = 0; i < orig_hapd->iface->interfaces->count; i++) {
+			struct hostapd_data *h;
+
+			h = get_hapd_bssid(orig_hapd->iface->interfaces->iface[i],
+					   bssid, -1);
+			if (h && h != HAPD_BROADCAST) {
+				hapd = h;
+				break;
+			}
+		}
+	}
+
 	if (hapd == NULL || hapd == HAPD_BROADCAST)
 		return;
 
