#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Shared CSR8811/Nordic startup; power on without advertising.

START=60
USE_PROCD=1

start_service() {
	case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in
	arista,c-230|arista,c-260) ;;
	arista,c-360) /usr/sbin/arista-bluetooth; return ;;
	*) return 0 ;;
	esac
	procd_open_instance
	procd_set_param command /usr/sbin/arista-bluetooth
	procd_set_param respawn 3600 10 5
	procd_set_param stderr 1
	procd_close_instance
}
