#!/bin/sh /etc/rc.common
# dfs-look: moves a 5 GHz radio that started outside DFS to a DFS channel
# only after a look, where that is clearly better (see /usr/sbin/dfs-look)

START=99
USE_PROCD=1

start_service() {
	[ "$(uci -q get dfs-look.main.enabled)" = 1 ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/dfs-look
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger dfs-look wireless
}
